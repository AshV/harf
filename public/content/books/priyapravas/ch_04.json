{
  "book_id": "priyapravas",
  "chapter_id": "ch_04",
  "number": 4,
  "title": "चौथा सर्ग — गोकुल में प्रभात व विरह-जागरण",
  "word_count": 1340,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; द्रुतविलम्बित छन्द"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "&#8288;  &#8288; विशद - गोकुल - ग्राम समीप ही।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "&#8288;  &#8288; बहु - बसे यक सुन्दर - ग्राम मे।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;  &#8288; म्वपरिवार समेत उपेन्द्र मे। ,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  &#8288; नियमते वृपभानु - नरेश थे।।१।।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "यह प्रतिष्ठित - गोप सुमेर थे।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अधिक - आहत थे नृप - नन्द से।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "ब्रज-धरा इनके धन-मान में।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अवनि मे प्रति - गौरविता रही ।।२।।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "&#8288;  &#8288; यक सुता उनकी अति - दिव्य धी।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "&#8288;  &#8288; रमणि -वन्द - शिरोमणि गधिका ।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "&#8288;  &#8288; सुयश - सौरभ से जिनके सदा।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "&#8288;  &#8288; व्रज - धग बहु - सौरभवान थी ।।३।।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; मार्दूलविक्रीडित छन्द"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "रुपोद्यान प्रफुल्ल - प्राय - कलिका केन्द्र - विम्बानना ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तन्वगी कल - हासिनी सुरमिका कीड़ा - कला पुत्तली।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "शोभा-वारिधि की अमूल्य-मरिण सी लावण्य-लीला-गयी ।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "श्रीराधा - मृदुभाषिणी मृगहगी-माधुर्य की मूर्ति थीं ॥४॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "फुले कंज - समान मंजु - दृगता थी मत्तता कारिणी।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "मौन मी कमनीय - कान्ति तन की थी नटि उगपिनी ।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "राधा की मुमकान की मधुरता धी मुग्धता-मर्ति सी।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "काली-कुंचिन - लम्बमान-पलक थी मानमोन्मादिनी ।।५।।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "नाना-भाव-विभाव-हाव-कुशला आमोद आपूरिता।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "लीला-लोल-कटाक्ष - पात-निपुणा भ्रूभगिमा - पंडिता ।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "वादिवादि समोद - वादन : परा आभूपणभूषिता ।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "राधा थी सुमुखी विशाल - नयना आनन्द-आन्दोलिता ॥३॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "लाली थी करती सरोज - पग की भूपृष्ठ को भूपिता ।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "विम्बा विद्रम को अकान्त करती थी रक्तता ओष्ट की ।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "होत्फुल्ल - मुखारविन्द - गरिमा सौदर्यआधार थी ।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "राधा की कमनीय कान्त छवि थी कामांगना मोहिनी ॥७॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "सवस्त्रा - सदलकृता गुणयुता - सर्वत्र सम्मानिता ।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "रोगी वृद्ध जनोपकारनिरता सच्छास्त्र चिन्तापरा ।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "सद्भावातिरता अनन्य:- हृदया सत्प्रेम - संपोपिका ।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "राधा थी सुमना प्रसन्नवदना स्त्रीजाति - रत्नोपमा ॥८॥"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "&#8288;  &#8288; द्रुतविलंबित छन्द"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "&#8288; यह विचित्र - सुता वृपभानु की।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "&#8288; व्रज - विभूपण मे अनुरक्त थी।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "&#8288; सहृदया यह सुन्दर - बालिका।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "&#8288; परम - कृष्ण - समर्पित-चित्त थी॥९॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "&#8288;  &#8288; ब्रज - धराधिप औ वृपभानु मे ।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "&#8288;  &#8288; अतुलनीय परम्पर - प्रीति थी ।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "&#8288;  &#8288; इसलिए उनका परिवार भी ।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "&#8288;  &#8288; बहु परस्पर प्रेम - निबद्ध था ॥१०॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "&#8288; जब नितान्त - अबोध मुकुन्द थे ।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "&#8288; विलसते जब केवल अक में ।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "&#8288; वह तभी वृषभानु निकेत मे ।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "&#8288; प्रति समादर साथ गृहीत थे ॥११॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "&#8288; छविवती - दुहिता वृषभानु की ।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "&#8288; निपट थी जिस काल पयोमुखी ।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "&#8288; वह तभी ब्रज - भूप कुटुम्ब की ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "&#8288; परम - कौतुक - पुत्तलिका रही ॥१२।।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "यह अलौकिक - बालक-बालिका ।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "जब हुए कल-क्रीडन-योग्य थे ।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "परम - तन्मय हो बहु प्रेम से ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "तव परस्पर थे मिल खेलते ।।१३।।‌"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "&#8288; कलित - क्रीड़न से इनके कभी ।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "&#8288; ललित हो उठना गृह - नन्द का ।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "&#8288; उमड़ सी पडती विधी कभी ।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "&#8288; वर - निकेतन मे वृषभानु के ।।१४।‌।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "जब कभी कल -क्रीडन - सुत्र से ।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "चरण - नृपुर श्री कटि-किंकिगी ।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "सदन मे बजती अति - मंजु थी ।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "किलकनी तब थी कल-वादिता ॥१५॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "&#8288; युगल का वय माथ सनेह भी ।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "&#8288; निपट-नीरवता सह था बढ़ा ।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "&#8288; फिर यही वर - बाल सनेह ही ।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "&#8288; प्रणय में परिवर्तित था हुआ ॥१६॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "बलवती कुछ थी इतनी हुई ।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "कुॅबरि - प्रेम - लता उर - भूमि में ।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "शयन भोजन क्या, सब कालही ।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "यह बनी रहती छवि - मत्त थी ।।१७।।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "&#8288;  &#8288; वचन की रचना रस से भरी।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "&#8288;  &#8288; प्रिय मुखांबुज की रमणीयता।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "&#8288;  &#8288; उतरती न कभी चित से रही।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "&#8288;  &#8288; सरलता, अतिप्रीति, सुशोलता ॥१८॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "&#8288; मधुपुरी बलवीर प्रयाण के।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "&#8288; हृदय-शेल-स्वरूप प्रसंग से।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "&#8288; न उबरी यह बेलि विनोद की।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "&#8288; विधि अहो भवदीय विडम्बना॥१९॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288;  शार्दूलविक्रीड़ित छन्द"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "काले कुत्सित कीट का कुसुम मे कोई नहीं काम था।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "काँटे से कमनीय कज कृति मे क्या है न कोई कमी।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "पोरो मे कब ईख की विपुलता है ग्रथियो की भली।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "हा! दुर्दैव प्रगल्भते अपटुता तू ने कहाँ की नहीं॥२०॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288;  द्रुतविलम्बित छन्द"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "&#8288; कमल का दल भी हिम-पात से।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "&#8288; दलित हो पड़ता सब काल है।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "&#8288; कल कलानिधि को खल राहु भी।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "&#8288; निगलता करता, बहु क्लान्त है॥२१॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "&#8288;  &#8288; कुसुम सी सुप्रफुल्लित बालिका।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "&#8288;  &#8288; हृदय भी न रहा सुप्रफुल्ल ही।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "&#8288;  &#8288; वह मलीन सकल्मष हो गया।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "&#8288;  &#8288; प्रिय मुकुन्द प्रवास-प्रसंग से॥२२॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "&#8288; सुख जहाँ निज दिव्य स्वरूप से।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "&#8288; विलसता करता कल-नृत्य है।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "&#8288; अहह सो अति-सुन्दर सद्म भी।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "&#8288; बच नहीं सकता दुखलेश से॥२३॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "&#8288; सब सुखाकर श्रीवृषभानुजा ।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "&#8288; सदन-सज्जित-शोभन-स्वर्ग सा ।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "&#8288; तुरत ही दुख के लवलेश से ।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "&#8288; मलिन शोकनिमज्जित हो गया ॥२४॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "जब हुई श्रुति - गोचर सूचना ।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "ब्रज धराधिप तात प्रयाण की ।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "उस घड़ी ब्रज - वल्लभ प्रेमिका ।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "निकट थी प्रथिता. ललिता सखी ॥२५॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "&#8288; विकसिता-कलिका हिमपात से ।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "&#8288; तुरत ज्यो बनती अति म्लान है ।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "&#8288; सुन प्रसंग मुकुन्द प्रवास का ।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "&#8288; मलिन त्यो वृषभानुसुता हुईं ॥२६॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "नयन से बरसा कर वारि को ।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "बन गई पहले बहु बावली ।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "निज सखी ललिता मुख देख के ।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "दुखकथा फिर यो कहने लगी ॥२७॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; मालिनी छन्द"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "&#8288; कल कुवलयो के से नेत्रवाले रसीले ।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "&#8288; वररचिते फेबीले पीत कौशेय शोभी ।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "&#8288; गुणगण मणिमाली मंजुभाषी सजीले ।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "&#8288; वह परम छबीले लाडिले नन्दजी के ॥२८॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "यदि कल मथुरा को प्रात ही जा रहे है ।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "विन मुख अवलोके प्राण कैसे रहेगे ।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "युग सम घटिकाये बार की बीतती थी ।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "सखि! दिवस हमारे बीत कैसे सकेगे ॥२९॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "&#8288; जन मन कलपाना में बुग जानती हूँ ।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "&#8288; परदुख अवलोके में न होती सुनी हैं ।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "&#8288; कहकर कटु वाने जी न भूले जलाया ।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "&#8288; फिर यह दुखदायी बात मैंने सुनी क्या ? ॥३०॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "अयि सखि! अवलोके खिन्नता तू कहेगी ।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "प्रिय स्वजन किसी के क्या न जात कही है ।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "पर हृदय न जाने दग्ध क्या हो रहा है ।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "सब जगत में है शुन्य होता दिखाना ॥३१॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "&#8288; यह सकल दिशायें आज रो सी रही हैं ।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "&#8288; यह सदन हमारा, हैं हमे काट खाता ।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "&#8288; मन उचट रहा है चैन पाता नहीं है ।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "&#8288; विजन-विपिन में हैं भागता सा दिखाना ॥३२॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "मदनरत न जाने कौन स्यो है बुलाना ।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "गति पलट रही है भाग्य की क्या हमारे ।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "उस! कसक समाई जा रही है कहाँ की ।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "सखि! हृदय हमारा दग्ध क्यों हो रहा है ।।३३।।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "&#8288; मधुपुर-पति ने है प्यार ही मे बुलाया ।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "&#8288; पर पुशल हमे तो न होती दिखाती ।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "&#8288; प्रिय-बिरह - घटायें घेरती आ रही हैं ।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "&#8288; घहर  घहर देखो हैं, कलेजा कांपाती ॥३४।।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "हृदयय चरण में तो में चढ़ा ही चुकी हैं ।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "सविधि - यग्णु की थी कामना और मेरी ।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "पर सफल हमे हो हैं न होती दिखाती ।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "वह, कब टलता है भाग्य में जो लिया हैं ॥३५॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "&#8288; और रह रह किरणें जो फुटती है दिखाई ।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "&#8288; वह मिप उनके व्या ठोश बने हमें हैं ।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "&#8288; कर वह अथवा यो शान्ति का बढ़ाने ।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "&#8288; विपुल - व्यथित जीयो की व्याथा मोचने को ।।४३।।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "दुख - अनल - शिखायें व्योम में फूटती है।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "यह किस दुनिया का हैं कलेजा जलाती ।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "ग्रहह अहह देखो दृटता है न तारा ।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "पतन दिलजले के गान का हो रहा है ।।४३।।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "&#8288; चमक चमक तारे धीर देते हमें है।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "&#8288; सखि! मुझ दुखिया की बात भी क्या सुनेंग?"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "&#8288; पर - दिन - रात - होए ठौर को जो न छोड़ें ।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "&#8288; निशि विगत न होगी बात मेरी बनेगी  ।।४४।।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "उदुगण थिर से क्यो हो गये दीखते हैं ।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "यह विनय हमारी कान में क्या पड़ी है ?"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "रह! रह! इनमें क्यो रंग आ जा रहा है ।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "कुछ सखि! इनको भी हो रही  बेकली है ।।४५।।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "&#8288; सखि! मुख अब तारे क्यो छिपाने लगे है ।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "&#8288; वह दुख लखने की ताव क्या है न लाते ।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "&#8288; परम - विफल होके आपदा टालने मे ।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "&#8288; बह मुख अपना हैं लाज से या छिपात ।।४८॥"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "क्षितिज निकट कैसी लालिमा दीखती है ।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "वह रुधिर रहा है कौन सी कामिनी का ।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "विहग विकल हो हो वोलने क्यो लगे है ।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "सखि! सकल दिशा मे आग सीक्यो लगी है।।४९।।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "&#8288; सब समझ गई मै काल की क्रूरता को ।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "&#8288; पल पल वह मेरा है कलेजा कॅपाता ।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "&#8288; अब नभ उगलेगा आग का एक गोला । -"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "&#8288; सकल-व्रज-धरा को फूँक देता जलाता ॥५०॥"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; मन्दाक्रान्ता छन्द"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "हा! हा! ऑखो मम-दुख-दशा देख ली औ न सोची ।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "बाते मेरी कमलिनिपते । कान की भी न तू ने ।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "जो देवेगा अवनितल को नित्य का सा उजाला ।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "तेरा होना उदय व्रज मे तो अँधेरा करेगा ।।५१।।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "नाना बाते दुख शमन को प्यार से थी सुनाती ।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "धीरे धीरे नयन - जल थी पोछती राधिका का ।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "हा! हा! प्यारी दुखित मत हो यो कभी थी सुनाती ।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "रोती रोती विकल ललिता, आप होती कभी थी ॥५२॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "सूखा जाता कमल - मुख था होठ नीला हुआ था ।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "दोनो ऑखे विपुल जल मे डूबती जा रही थी ।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "शंकाये थी विकल करती कॉपता था कलेजा ।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "खिन्ना दीना परम - मलिना उन्मना राधिका थी ।।५२।।"
    }
  ]
}