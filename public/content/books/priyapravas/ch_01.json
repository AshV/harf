{
  "book_id": "priyapravas",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "प्रथम सर्ग — दिवस का अवसान व गोकुल की विरह-व्यथा",
  "word_count": 1107,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; द्रुतविलम्बित छन्द"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "&#8288; दिवस का अवसान समीप था ।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "&#8288; गगन था कुछ लोहित हो चला ।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288; तरु-शिखा पर थी अब राजती ।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288; कमलिनी-कुल-बल्लभ की प्रभा ।।१।।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "विपिन धीर विहंगम - पृन्न का ।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पनिनाद विवर्तित था हुया ।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "ध्वनिमयी - विविधा विदगावली ।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "राही नभ - गण्टल मध्य धी ॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "&#8288; अधिक और ई नभ - लालिमा ।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "दसों दिशा पनुर्गजन हो गई ।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सफल - पादप - पुष्प हरीतिगा ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "चरगिमा विनिमरिजन मी हुई ॥३॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "&#8288; झलकने पुलिनों पर भी लगी ।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "&#8288; गगन के तल की यह लालिमा ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "&#8288; मरि सरोवर के जल मे पडी ।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "&#8288; अरुणता अतिही रमणीय थी ॥४॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "अचल के शिखरो पर जा चढ़ी ।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "किरण पादप-शीश-विहारिणी ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तरणि - विम्ब तिरोहित हो चला ।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "गगन - मण्डल मध्य शनै: शनै: ॥५॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "&#8288; ध्वनि-मयी कर के गिरि - कन्दरा ।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "&#8288; कलित-कानन केलि निकुञ्ज को ।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "&#8288; बज उठी मुरली इस काल ही ।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "&#8288; तरणिजा-तट-राजित-कुञ्ज मे ॥६॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "क्वणित मंजु विषाण हुए कई ।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "रणित श्रृंग हुए बहु साथ ही ।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "फिर समाहित -प्रान्तर - भाग मे ।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "सुन पडा स्वर धावित - धेनु का ॥७॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "&#8288; निमिष मे वन-व्यापित-वीथिका ।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "&#8288; विविध - धेनु - विभूषित हो गई ।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "&#8288; धवल-धूसर-वत्स-समूह भी ।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "&#8288; विलसता जिनके दल साथ था ।।८॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "जब हुए समवेत शनैः शनैः ।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "सकल गोप सधेनु समण्डली ।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "तब चले ब्रज - भूषण को लिये ।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "अति अलकृत-गोकुल-ग्राम को ॥९॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "&#8288; गगन मंडल में रज छा गई ।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "&#8288; दश - दिशा बहु - शब्दामय हुई ।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "&#8288; विशुद-गोकुल के प्रति - गेह में ।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "&#8288; वह चला बर-स्त्रोत विनोद का ।।१०।।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "सकल बाहर घाकृत से रहे ।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "सर्दियों - मानव गोकुल - ग्राम के ।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "प्रिय दिनान्न विन्नोकन ही पड़ी ।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "व्रत-विशपण - दर्शन - लालसा ॥११॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "&#8288; सुन पड़ा स्वर दरों वन वेग्गु का ।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "&#8288; सकत - ग्राम समुत्सुक हो उठा ।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "&#8288; हृदय - पत्र निनादित हो गया ।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "&#8288; तुरंत ही विनयचित भाव से ‌।।१२।।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "बहु युवा युवती गृह - बालिका ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "विपुल -बाला वृद्ध वयस्क भी ।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "विवश से निकले नित गेहूं से ।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "साहस का दृघ- गोचन के लिए ।।१३।।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "&#8288; इधर गोकुल से जानना पड़ी ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "&#8288; उमगती पड़ती अति मोद में ।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "&#8288; उधर या पहुँची बलवीर की ।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "&#8288; विपुल - धेनु -विमांहित म्मपति ।।१४।‌"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "&#8288; अतसि - पुष्प अलंकृतकारिणी ।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "&#8288; शरद नील - सरोरुह रजिनी ।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "&#8288; नवल-सुन्दर-श्यास-शरीर की ।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "&#8288; सजल-नीरद सी कल-कान्ति थी ॥१६॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "अति - समुत्तम अग समूह था ।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "मुकुर - मंजुल औ मनभावना ।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "सतत थी जिसमे सुकुमारता ।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "सरसता प्रतिविम्बित हो रही ॥१७॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "&#8288; बिलसता कटि मे पट पीत था ।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "&#8288; रुचिर - वस्त्र - विभूषित गात था ।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "&#8288; लस रही उर मे बनमाल थी ।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "&#8288; कल - दुकूल - अलंकृत स्कध था ।।१८।।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "मकर-केतन के कल - केतु से ।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "लसित थे वर - कुण्डल कान मे ।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "घिर रही जिनकी सब ओर थी ।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "विविध - भावमयी अलकावली ।।१९।।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "&#8288; मुकुट मस्तक का शिखि - पक्ष का ।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "&#8288; मधुरिमामय था वहु मञ्जु था ।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "&#8288; असित रन । समान सुरजिता ।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "&#8288; सतत थी जिसकी वर - चन्द्रिका ॥२०॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "विशद उज्ज्वल-उन्नत भाल मे ।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "विलसती कल केसर - खौर थी ।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "असित - पंकज के दल में यथा ।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "रज - सुरंजित पीत - सरोज की ॥२१॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "&#8288; मधुरता -सब था मृदु - घोलना ।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "&#8288; अमृत - सिंचित सी मुस्कान थी ।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "&#8288; समझ थी जन - मानस मोहिनी ।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "&#8288; कमल - लोचन की कमनीवना ।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "सबल-जानु विलम्विन वायु थी ।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "पति-सुपुष्ट-समुन्नत व्यर्थ था ।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "का किशोर-कला लालिमा था ।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "मुख प्रकृतिक पुष्प-समान था ।।२३।।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "&#8288; सरस - जन समूह सहेलियां ।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "&#8288; सहचरी मन मोहन मुंह की ।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "&#8288; रविकांत - जननी कल-नादिनी ।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "&#8288; मुर्तियां थी पर में मधुवर्षिणी ।।२४।।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "विलायती मुख की छवि पुंजता ।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "छिटकनी विति के वन की छटा ।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "बगरती घर दीप्ती दिसन्न में ।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "विनित में कर कान्वि सी ।।२५।।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "&#8288; मुदित बेचक की एक मन्हली ।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "&#8288; जब प्रजाधिस सम्मुख जा पड़ी ।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "&#8288; विलखते सुख कि कवि रो लगी ‌।।२६।।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "&#8288; उछलते शिशु थे अति हर्ष से ।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "&#8288; युवक थे रस की निधि लूटते ।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "&#8288; जरठ को फल लोचन का मिला ।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "&#8288; निरख के सुपमा सुखमूल की ॥२८॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "बहु-विनोदित थी व्रज - वालिका ।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "तरुणियाँ सव थी तृण तोड़ती।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "बलि गई बहु बार वयोवती।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "छवि विभूति विलोक ब्रजेन्दु की ।।२९।।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "&#8288; मुरलिका कर - पंकज मे लसी ।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "&#8288; जब अचानक थी वजती कभी ।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "&#8288; तव सुधारस मंजु - प्रवाह मे ।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "&#8288; जन - समागम था अवगाहता ॥३०॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "ढिग सुशोभित श्रीवलराम थे ।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "निकट गोप - कुमार - समूह था ।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "विविध गातवती गरिमामयी ।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "सुरभि थी सव ओर विराजती ।।३१।‌।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "&#8288; बज रहे बहु - श्रृंग विपाण थे"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "&#8288; करिणत. हो उठता वर-वेणु था ।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "&#8288; सरस - राग - समूह अलाप से ।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "&#8288; रसवती - वन थी मुदिता- दिशा ॥३२॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "विविध - भाव - विमुग्ध बनी हुई।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "मुदित थी बहु दर्शक - मण्डली ।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "अति मनोहर थी वनती कभी ।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "बज किसी कटि की कलकिकिणी ॥३३॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "&#8288; इधर था इस भांति समा बंधा ।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "&#8288; उधर व्योम हुआ कुछ और ही ।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "&#8288; अब न था उसमें रवि रजता ।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "&#8288; किरण भी न सुशोभित थी कहीं ।।३४।।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "अरुणिमा-जगती- ब्रज-रंजिनी ।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "बहन थी करती अब लालिमा ।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "मलिन थी नव-राय मयी-दिशा ।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "अबनि थी तमसाकृत हो रही ।।३५।।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "&#8288; तिमिर की वह भृतन - व्यापिनी ।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "&#8288; तरुण-धार विकास - विरोधिनी ।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "&#8288; जन-समूह-विलोचन के लिए ।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "&#8288; बन गई प्रति-मुर्ति विगम की ।।३६।।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "वृतिमती उतनी अब थी नहीं ।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "नयन की अति द्विव्य वनीनिका ।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "अब नहीं वह भी विलोकती ।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "मधुमयी कवि श्रीधरश्याम की ।।३७।।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "&#8288; वह आभापुर्ण नभ की ‌।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "&#8288; सह  खुशी न नभसन्न तारिका ।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "&#8288; वह विलाश विवद्धन के लिए ।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "&#8288; निखरते नभ नत्यन में सभी ।।३८।।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "&#8288; खग - समूह न था अब बोलता ।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "&#8288; विटप थे बहु नीरव हो गये ।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "&#8288; मधुर मंजुल मत्त अलाप के ।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "&#8288; अव न यत्र बने तरु - वृन्द थे ॥४०॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "विहग औ विटपी - कुल मौनता ।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "प्रकट थी करती इस म्मर्म को ।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "श्रवण को वह नीरव थे बने ।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "करुण अंतिम - वादन वेणु का ॥४१॥"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "&#8288; विहग - नीरवता - उपरांत ही ।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "&#8288; रुक गया स्वर श्रृंग विषाण का ।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "&#8288; कल-अलाप समापित हो गया ।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "&#8288; पर रही बजती वर-वंशिका ॥४२॥"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "विविध - म्मर्मभरी करुणामयी ।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "ध्वनि वियोग-विराग-विवोधिनी ।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "कुछ घड़ी रह व्याप्त दिगन्त मे ।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "फिर समीरण मे वह भी मिली ॥४३।।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "&#8288; ब्रज-धरा - जन जीवन - यंत्रिका ।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "&#8288; विटप - वेलि-विनोदित-कारिणी ।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "&#8288; मुरलिका जन - मानस - मोहिनी ।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "&#8288; अहह नीरवता निहिता हुई ॥४४॥"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "प्रथम ही तम की करतूत से ।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "छवि न लोचन थे अवलोकते ।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "अव निनाद रुके कल - वेणु का ।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "श्रवण पान न था करता सुधा ।।४५।।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "&#8288; इस लिए रखना - जन - वृन्थ की ।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "&#8288; सरस - भाव समुत्सुकना पड़ी ।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "&#8288; प्रथम गौरव से करने लगी ।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "&#8288; ब्रज - बिनृषण की गुण मागिता ‌।‌।४६।‌।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "जब दशा वह थी जन - वृन्द की ।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "जलज लोचन थे तब के ।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "सहित गोपन गोप  समुह के ।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "अवनि - योग्य गोकुल ग्राम में ।।४७।।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "&#8288; कुछ घड़ी वह शान्त करता हुई ।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "&#8288; फिर हुआ उसका अवलान भी ।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "&#8288; प्रथम थी वह दुम मची जान ।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "&#8288; जब वहां घटना सुनसान था ।।४८।।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "कर विदुग्नि लोचन लालसा ।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "स्वर प्रसिद्ध सुवा सूचि को मिला ।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "गुण -गयी रसनेन्द्रय को बना ।"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "गृह गये अब दर्शक वृन्द भी ।।४९।।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "&#8288; प्रथम थी स्वर की लहरी जहाँ ‌।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "&#8288; पवन में अधिकाधिक गुंजती ।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "&#8288; अब वहाँ पर नीग्यता गई ।।५०।।"
    }
  ]
}