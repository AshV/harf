{
  "book_id": "priyapravas",
  "chapter_id": "ch_02",
  "number": 2,
  "title": "दूसरा सर्ग — माता यशोदा का वात्सल्य-विलाप",
  "word_count": 1571,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "प्रथम सर्ग"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "प्रियप्रवास    (1914)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        तृतीय सर्ग   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; द्रुतविलम्बित छन्द"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  &#8288; गत हुई अव थी द्वि - घटी निशा।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "&#8288;  &#8288; तिमिर - पूरित थी सब मेदिनी ।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "&#8288;  &#8288; बहु विमुग्ध करी वन थी लसी ।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "&#8288;  &#8288; गगन मण्डल तारक - मालिका ।।१।।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "तम ढके तरु थे दिखला रहे ।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "तमस - पादप से जन - बुन्द को ।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "सकल गोकुल गेह - समूह भी ।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तिमिर-निर्मित सा इस काल था ॥२॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "&#8288;  &#8288; इस तमो - मय गेह - समूह का ।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "&#8288;  &#8288; अति - प्रकाशित सर्व - सुकक्ष था ।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "&#8288;  &#8288; विविध ज्योति-निधान-प्रदीप थे ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "&#8288;  &#8288; तिमिर - व्यापकता हरते जहाँ ॥३॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "इस प्रभा - मय- मजुल- कक्ष मे ।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "सदन की करके सकला क्रिया ।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "कथन थी करती कुल - कामिनी ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "कलित कीर्ति ब्रजाधिप-तात की ॥४॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "&#8288; सदन-सम्मुख के कल ज्योति से ।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "&#8288; ज्वलित थे जितने वर-बैठके ।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "&#8288; पुरुष-जाति वहाँ समवेत हो ।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "&#8288; सुगुण-वर्णन में अनुरक्त थी ॥५॥"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "रमणियाँ सब ले गृह–बालिका ।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "पुरुष लेकर बालक – मंडली ।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "कथन थे करते कल – कंठ से ।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "ब्रज – विभूषण की विरदावली ॥६॥"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "&#8288; सब पड़ोस कहीं समवेत था ।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "&#8288; सदन के सब थे इकठे कहीं ।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "&#8288; मिलित थे नरनारि ़ हुए ।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "&#8288; चयन को कुसुमावलि कीर्ति की॥७॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "रसवती रसना बल से कहीं ।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "कथित थी कथनीय गुणावली ।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "मधुर राग सधे स्वर ताल में ।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "कलित कीर्ति अलापित थी कहीं ॥८॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "&#8288; बज रहे मृदु मंद मृदंग थे ।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "&#8288; ध्वनित हो उठता करताल था ।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "&#8288; सरस वादन से वर बीन के ।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "&#8288; विपुल था मधु-वर्षण हो रहा ॥९॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "प्रति निकेतन से कल - नाद की ।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "निकलती लहरी इस काल थी ।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "मधुमयी गलियाँ सब थीं बनी ।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "ध्वनित सा कुल गोकुल-ग्राम था ।१०॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "&#8288; सुन पड़ी ध्वनि एक इसी घडी ।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "&#8288; अति - अनर्थकरी इस ग्राम मे ।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "&#8288; विपुल वादित वाद्य - विशेष से ।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "&#8288; निकलती अव जो अविराम थी ॥११॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "मनुज एक विघोषक वाद्य की ।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "प्रथम था करता वहु ताडना ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "फिर मुकुन्द - प्रवास - प्रसग यो ।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "कथन था करता स्वर - तार से ।।१२।।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "&#8288; अमित - विक्रम कस नरेश ने ।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "&#8288; धनुष - यज्ञ विलोकन के लिये ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "&#8288; कल समादर से ब्रज - भूप को ।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "&#8288; कुँवर संग निमंत्रित है किया ॥१३॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "यह निमंत्रण लेकर आज ही ।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "सुत - स्वफल्क समागत है हुए ।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "कल प्रभात हुए मथुरापुरी ।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "गमन भी अवधारित हो चुका ॥१४॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "&#8288; इस सुविस्तृत - गोकुल ग्राम मे ।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "&#8288; निवसते जितने वर - गोप है ।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "&#8288; सकल को उपढौकन आदि ले ।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "&#8288; उचित है चलना मथुरापुरी ॥१५।।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "इसलिये यह भूपनिदेश है ।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "सकल - गोप समाहित हो सुना ।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "सव प्रबन्ध हुआ निशि मे रहे ।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "कल प्रभात हुए न विलम्ब हो ॥१६॥"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "&#8288; निमिप मे यह भीपण घोपणा ।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "&#8288; रजनि - अक-कलंकित - कारिणी ।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "&#8288; मृदु - समीरण के सहकार से ।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "&#8288; अखिल गोकुल - ग्राममयी हुई ।।१७।।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "कमल - लोचन कृष्ण-वियोग की ।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "अशनि - पात - समा यह सूचना ।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "परम - आकुल - गोकुल के लिये ।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "अति - अनिष्टकरी - घटना हुई ॥१८॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "&#8288; चकित भीत अचेतन सी बनी ।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "&#8288; कॅप उठी कुलमानव - मण्डली ।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "&#8288; कुटिलता कर याद नृशस की ।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "&#8288; प्रवल और हुई उर वेदना ।।१९।।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "कुछ घड़ी पहले जिस भूमि मे ।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "प्रवहमान प्रमोद - प्रवाह था ।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "अब उसी रस - प्लावित भूमि मे ।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "बह चला खर स्रोत विषाद का ॥२०॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "&#8288; कर रहे जितने कल गान थे ।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "&#8288; तुरत वे प्रति - कुण्ठित हो उठे ।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "&#8288; अब अलाम अलौकिक कठ के ।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "&#8288; ध्वनित थे करते न दिगन्त को ‌‌।।२१।।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "उतर तार गये बहु वीन के ।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "मधुरता न रही मुरजादि मे ।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "विवशता - वश वादक - बुन्द के ।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "गिर गये कर के करताल भी ।।२२।।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "&#8288; सकल - ग्रामवधू कल कठता ।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "&#8288; परम - दारुण - कातरता वनी ।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "&#8288; हृदय की उनकी प्रिय - लालसा ।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "&#8288; विविध - तर्क वितर्क - मयी हुई ।।२३।।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "दुख भरी उर - कुत्सित - भावना ।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "मथन मानस को करने लगी ।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "करुण - प्लावित लोचन कोण मे ।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "झलकने जल के कण भी लगे ॥२४॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "&#8288; नव - उमंग - मयी पुर - बालिका ।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "&#8288; मलिन और सशकित हो गई ।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "&#8288; अति- प्रफुल्लित वालक - वृन्द का ।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "&#8288; वदन - मण्डल भी कुम्हला गया ।।२५।।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "ब्रज - धराधिप तात प्रभात ही ।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "कल हमे तज के मथुरा चले ।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "असहनीय जहाँ सुनिये वही ।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "बस यही चरचा इस काल थी ।।२६।।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "&#8288; सब परस्पर थे कहते यही ।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "&#8288; कसल - नेत्र निमंत्रित क्यो हुए ।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "&#8288; कुछ स्ववन्धु समेत ब्रजेश का ।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "&#8288; गमन ही, सव भॉति यथेष्ट था ।।२७॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "पर निमंत्रित जो प्रिय है हुए ।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "कपट भी इसमे कुछ है सही ।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "दुरभिसंधि नृशंस - नृपाल कीक्ष।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "अव न है व्रज - मण्डल मे छिपी ॥२८॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "&#8288; विवश है करती विधि वामता ।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "&#8288; कुछ बुरे दिन हैं मज - भूमि के ।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "&#8288; हम सभी श्रनिहीं - हतभाग्य हैं ।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "&#8288; उपजती नित जो नव - व्याधि है ।।२९।।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "किन परिश्रम और प्रयन्न से ।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "कर सुरोत्तम की परिमेवना ।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "इस जराजित - जीवन - काल मे ।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "महर को सुत का मुख्य है दिन्या ॥३०॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "&#8288; सुअन भी सुर विप्र प्रसाद से ।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "&#8288; प्रति अपूर्व अलौकिक है मिला ।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "&#8288; निज गुणाबलि ने इम काल जो ।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "&#8288; ब्रज - धरा - जन जीवन-प्राण है ॥३१॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "पर बड़े दुख की यह बात है ।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "विपद जो अब भी टलती नहीं ।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "अग्रह है कहते बनती नहीं ।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "परम - दग्धकरी उर की व्यथा ॥३२॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "&#8288; जनम की तिथि में बलवीर की ।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "&#8288; बहु - उपद्रय है प्रज में ।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "&#8288; विकटना जिन की अब भी नहीं ।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "&#8288; हदय में अपसारित हो सकी ॥३३॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "पग्म - पातक की प्रतिमृति सी ।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "पति पावनतामय - पृतना ।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "पग - अपेय पिला कर श्याम को।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "कर चुकी ब्रज भूमि विनाश थी ।।३४।।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "&#8288; पर किसो चिर-संचित-पुण्य से ।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "&#8288; गरल अमृत अर्भक को हुआ ।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "&#8288; विष-मयी वह हो कर आप ही ।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "&#8288; कवल काल - भुजंगम का हुई ॥३५॥"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "फिर अचानक धूलिमयी महा ।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "दिवस एक प्रचंड हवा चली ।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "श्रवण से जिस की गुरु - गर्जना ।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "कॅप उठा सहसा उर दिग्वधू ॥३६॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "&#8288; उपल वृष्टि हुई तम छा गया ।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "&#8288; पट गई महि कंकर - पात से ।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "&#8288; गड़गड़ाहट वारिद - व्यूह की।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "&#8288; ककुभ से परिपूरित हो गई ॥३७।।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "उखड़ पेड़ गये जड़ से कई ।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "गिर पड़ी अवनी पर डालियाँ ।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "शिखर भग्न हुए उजड़ी छते ।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "हिल गये सब पुष्ट निकेत भी ॥३८।।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "&#8288; बहु रजोमय आनन हो गया ।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "&#8288; भर गये युग - लोचन धूलि से ।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "&#8288; पवन - वाहित - पांशु - प्रहार से ।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "&#8288; गत बुरी ब्रज - मानव की हुई ॥३९॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "घिर गया इतना तम - तोम था ।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "दिवस था जिससे निशि हो गया ।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "पवन - गजेन औ धन-नाद से ।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "कप उठी व्रज - सर्व वसुन्धरा ॥४०॥"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "&#8288; प्रकृति थी जब यो कुपिता महा ।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "&#8288; हरि अदृश्य अचानक हो गये ।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "&#8288; सदन में जिन से ब्रज- भूप के ।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "&#8288; अनि - भवानककन्दन हो उठा ॥४१॥"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "सकल - गोकुल था या ना दुखी ।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "प्रयल - वेग प्रभंजन आदि में ।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "अब दशा सुन नन्द - निकेत की ।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "परि - समारत सा वह हो गया ॥४२॥"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "&#8288; पर व्यतीत हुए द्विवटी टली ।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "&#8288; यह उणावरतीय विटन्चना ।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "&#8288; पवन - वंग रुका नम भी हटा ।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "&#8288; जलय - जाल तिराहिन हा गया ।।४३॥"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "प्रकृति शान्त हुई पर व्योम में ।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "चमकने रवि की फिरण लगी ।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "निफट ही नित सुन्दर सत्य के ।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "बिलख हसी हरि भी मिले ॥४४॥"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "&#8288; प्रति पुगतन - गुण्य ब्रजेश का।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "&#8288; उदय या हम काल स्वयं हुआ ।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "&#8288; पतिन हो खर वायु - प्रकोप में ।"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "&#8288; कुसुम कोमल बालक जो बचा ।‌।४२।।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "संकरट - पान प्रजाधिप पास ही ।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "पनन अर्जून में नरः गज का ।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "पकाना मनापम सच से ।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "सब बकासूर एवं बलवीर को ।।४३॥"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "&#8288; वधन - उद्यम दुर्जय - वत्स का ।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "&#8288; कुटिलता अघ - संज्ञक - सर्प की ।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "&#8288; विकट घोटक की अपकारिता ।"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "&#8288; हरि निपातन यत्न ‘अरिष्ट' का ॥४७॥"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "कपट - रूप - प्रलम्ब प्रवचना ।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "खलपना - पशुपालक - व्योम का ।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "अहह ए सब घोर अनर्थ थे। ।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "व्रज - विभूषण है जिनसे बचे ॥४८॥"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "&#8288; पर दुरन्त - नराधिप कंस ने ।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "&#8288; अब कुचक्र भयंकर है रचा ।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "&#8288; युगल - बालक सग ब्रजेश जो ।"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "&#8288; कल निमंत्रित है मुख मे हुए ॥४९।।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "गमन जो न करे बनती नहीं ।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "गमन से सब भॉति विपत्ति है ।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "जटिलता इस कौशल जाल की ।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "अहह है अति कष्ट-प्रदायिनी ॥५०॥"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "&#8288; प्रणतपाल कृपानिधि श्रीपते ।"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "&#8288; फलद है प्रभु का पद - पद्म ही ।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "&#8288; दुख-पयोनिधि  का वही ।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "&#8288; जगत मे परमोत्तम पोत है ।।५१।।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "विषम संकट में व्रज है पड़ा ।"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "पर हमे अवलम्बन है वही ।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "निबिड़ पामरता, तम हो चला ।"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "पर प्रभो वल है नख - ज्योति का ॥५२॥"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "&#8288; विपद ज्यो बहुधा कितनी टली।"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "&#8288; प्रभु कृपावल त्यो यह भी टले।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "&#8288; दुखित मानस का करुणानिधे।"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "&#8288; अति विनीत निवेदन है यही॥५३॥"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "ब्रज-विभाकर ही अवलम्ब है।"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "हम सशंकित प्राणि-समूह के।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "यदि हुआ कुछ भी प्रतिकूल तो।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "ब्रज-धरा तमसावृत हो चुकी॥५४॥"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "&#8288; पुरुष यो करते अनुताप थे।"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "&#8288; अधिक थी व्यथिता ब्रज-नारियाँ।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "&#8288; वन अपार-विषाद-उपेत वे।"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "&#8288; विलख थीं दृग-वारि विमोचती॥५५॥"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "दुख प्रकाशन का क्रम नारि का।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "अधिक था नर के अनुसार ही।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "पर विलाप कलाप विसूरना।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "विलखना उन मे अतिरिक्त था॥५६॥"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "&#8288; ब्रज-धरा-जन की निशि साथ ही।"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "&#8288; विकलता परिवर्ध्दित हो चली।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "&#8288; तिमिर साथ विमोहक-शोक भी।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "&#8288; प्रबल था पलही पल हो रहा ॥५७॥"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "विशद-गोकुल बीच विपाद की।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "अति-असयत जो लहरे उठी।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "बहु विवर्ध्दित हो निशि-मध्य ही।"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "ब्रज-धरातलव्यापित वे हुई॥५८॥"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "&#8288; विलसती अब थी न प्रफुल्लता ।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "&#8288; न वह हास विलास विनोद था ।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "&#8288; हृदय कम्पित थी करती महा ।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "&#8288; दुखमयी ब्रज-भूमि - विभीपिका ।।५९।।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "तिमिर था घिरता बहु नित्य ही ।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "पर घिरा तम जो निशि आज की ।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "उस विषाद - महातम से कभी ।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "रहित हो न सकी ब्रज की धरा ॥६०॥"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "&#8288; बहु - भयंकर थी यह यामिनी ।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "&#8288; बिलपते ब्रज भूतल के लिये ।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "&#8288; तिमिर मे जिसके उसका शशी ।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "&#8288; बहु - कला युत होकर खो चला ॥६१।।"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "घहरती घिरती दुख की घटा ।"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "यह अचानक जो निशि मे उठी ।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "वह ब्रजांगण मे चिरकाल ही ।"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "बरसती बन लोचनवारि थी ॥६२।।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "&#8288; ब्रज-धरा-जन के उर मध्य जो ।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "&#8288; विरह - जात लगी यह कालिमा ।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "&#8288; तनिक धो न सका उस को कभी ।"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "&#8288; नयन का वहु - वारि - प्रवाह भी ।।६।।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "सुखद थे बहु जो जन के लिये ।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "फिर नही ब्रज के दिन वे फिरे ।"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "मलिनता न समुज्वलता हुई ।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "दुख-निशा न हुई सुख की निशा ॥६४॥"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "&#8288;  &#8288; ______"
    }
  ]
}