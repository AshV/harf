{
  "book_id": "kural-kavya",
  "chapter_id": "ch_166",
  "number": 166,
  "title": "परिच्छेदः ५४ निश्विन्ततात्यागः",
  "word_count": 131,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "५३ बन्धुता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        परिच्छेदः ५५ न्यायशासनम्   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ५४"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "निश्विन्ततात्यागः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अचिकित्स्याल्पसन्तोषाञ्जाता चिन्ताविहीनता।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नूनं निन्द्यतमा लोके निस्सीमक्रोधतोऽप्यहो॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "यथैव प्रतिभां हन्ति लोके दुष्टा दरिद्रता।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "वैभवञ्च तथा हन्ति निर्भयस्त्यानभावना   &#91; १ &#93;   ॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "नित्यनिश्चिन्तचित्तानां वैभवं नैव जायते।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "अन्तिमो ह्येष सर्वेषामाम्नायानां विनिश्चयः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कातरस्य जनस्याहो कोऽर्थो दुर्गेण सिध्यति।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "को गुणः प्रचुरैरर्थैरेवमेव प्रमादिनः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "प्रमत्तपुरुषो नित्यं स्वरक्षायै निसर्गतः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "दोषं करोति पश्चाञ्च संकटस्थो विषीदति॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "प्रागेव ना   &#91; २ &#93;    प्रबुद्धश्वेत् सर्वैं: साकं सुवृत्तये।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अतो नास्ति परा काचित् सुवार्ता जगतीतले॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "समाहितस्य सर्वत्र यस्यास्ति मनसो गतिः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अशम्यं तस्य कि लोके वर्तते गुणशालिनः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "विजैः प्रदर्शितं कार्यमाशु कुर्वीत भृपतिः।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अन्यथा जन्मपर्यन्तं प्रायश्चित्तं न विद्यते॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "प्रमादेन यथा भद्र व्यामोहो मानसे भवेत्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तेन दोषेण नष्टानां चिन्त्यस तदा दशाम्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "विधत्ते यः पुरो   &#91; ३ &#93;    दृष्टेनिजध्येयं निरन्तरम्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "सहजा एव तत्पक्षे सिद्धाः सन्ति मनोरथाः॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    आलस्यम्।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "↑    नर.।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "↑    अग्रे।"
    }
  ]
}