  "number": 112,
  "title": "परिच्छेदः १०२ लज्जाशीलता",
  "word_count": 117,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१०१ निरुपयोगिधनम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १०३ कुलोन्नतिः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः १०२"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "लज्जाशीलता"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "भद्रो जिहृेति लोकेऽस्मिन् प्रमादादेव सर्वदा।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सुन्दरीणामतो भिन्ना लज्जा भवति सर्वथा॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "इयं लज्जैव मर्त्येषु वर्तते भेदकारिणी।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अन्यथा सदृशाः सर्वे वस्त्रसन्तानभुक्तिभिः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "वसन्ति सर्वदेहेऽस्मिन् प्राणा यद्यपि देहिनाम्।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नरस्य योग्यता किन्तु लज्जामावसति ध्रुवम्॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "हृदये गुणिता लज्जा रत्नतुल्यो महानिधिः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "उत्सेको गतलज्जस्य चक्षुषोः कष्टकारकः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मानभङ्गं परस्यापि वीक्ष्य स्वस्येव ये जनाः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "त्रपन्ते ते महात्मानः शीलसंकोचमूर्तयः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "निन्दितैः साधनैर्नापि राज्यं गृहृन्ति साधवः।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "उपेक्षां तेऽत्र तन्वन्ति कीर्तिकान्तानुरागिणः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "लज्जात्राणाय मुश्चन्ति निजाङ्गं भद्रवृत्तयः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "न त्यजन्ति हियं वा ते प्राप्तेऽपि प्राणसंकटे॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "परो हि त्रपते यस्मात् ततो यो नैव लज्जते।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "पतितः स नरो नूनं ततो जिहेति भद्रता॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "विस्मृताश्चेत् कुलाचाराः कुलभ्रष्टोऽभिजायते।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "लज्जायां किन्तु नष्टायां सर्वे नश्यन्ति सद्गुणाः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "लज्जावारि मनुष्यस्य चक्षुर्भ्यां किल चेच्च्युतम्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "जीवनं भरणं तस्य काष्ठपुत्तलसन्निभम्॥१०॥"
    }
  ]
}