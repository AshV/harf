{
  "book_id": "kural-kavya",
  "chapter_id": "ch_126",
  "number": 126,
  "title": "परिच्छेदः १८ निर्लोभिता",
  "word_count": 104,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सन्मार्ग यः परित्यज्य परवित्ताभिलाषुकः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "खलत्वं वर्द्धते तस्य परिवारश्च नश्यति॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "जुगुप्सा यस्य पापेभ्यो लोभं नैव करोति सः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "प्रवृत्तिस्तस्य भद्रस्य कुकर्मणि न जायते॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "स्थिरसौख्याय यस्यास्ति स्पृहा तस्य सुमेधसः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "लोभो नास्त्यल्पभोगानां पापकर्माविधायिनः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "इन्द्रियाणि वशे यस्य चित्ते चातिविशालता।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "स्वोपयोगीति बुद्धया स नान्यवस्तु जिघृक्षति॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "किं तया क्रियते मत्या लोभे या क्रमते सदा।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "बोधेनैवञ्च कि तेन यद्यघाय समुद्यतः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "सत्पथं ये सदा यान्ति सुकीर्तेश्चानुरागिणः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तेऽपि नष्टा भविष्यन्ति यदि लोभात् कुचक्रिणः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "तृष्णया सश्चितं वित्तं मा गृध्य हितवाञ्छया।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "एवंभूतं धनं भोगे दुःखैस्तीक्ष्णतरं भवेत्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "लक्ष्मीर्भवेन्न में न्यूना यद्येवं काङ्क्षसे ध्रुवम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "मा भूस्त्वं ग्रस्तुमुद्युक्तो वैभवं प्रतिवेशिनः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सुनीति वेत्ति यः प्राज्ञः परस्त्राद् विमुखो भवन्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तद्गृहं ज्ञातमाहात्म्या लक्ष्मीरन्विष्य गच्छति॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अदूरदर्शिनस्तृष्णा केवला नाशकारिणी।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "निष्कामस्य महत्वन्तु सर्वेषां विजयि ध्रुवम्॥१०॥"
    }
  ]
}