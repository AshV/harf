{
  "book_id": "kural-kavya",
  "chapter_id": "ch_155",
  "number": 155,
  "title": "परिच्छेदः ४४ दोषनिवृत्तिः",
  "word_count": 127,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "४३ बुद्धिः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ४५ योग्यपुरुषाणां मैत्री   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ४४"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "दोषनिवृत्तिः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "क्रोधदार्पौ हतौ यस्य विषये चास्तकामनाः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अपूर्वभेव तस्यास्ति सौभाग्यद्योति गौरवम्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "प्रभुत्वजनितो दर्पो गृध्नुता विषयान्धता।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "भूपे दोषा भवन्त्येते प्रायेणैव विशेषतः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "शुभ्रज्योत्स्नासमा कीर्तिः सुप्रिया यस्य विद्यते।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "स्वदोषं सर्पपाकारं तालतुल्यं स मन्यते॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "दोषाणां त्वं विनाशाय नित्यं भव समुद्यतः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अन्यथा सर्वनाशं ते विधास्यन्तीति निश्चयः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "भाविदुःखफल भोक्तूं यः पूर्व नैव सज्जितः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "स तथा निधनं याति यथाग्नौ तृणसंहतिः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "परशुद्धिविधेः पूर्वं यः स्वदोषान् विशुध्यति।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "के तं दोषाः स्पृशन्तीह भूपाल योगिसन्निभम्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "हा धिक् तं कृपणं मर्त्यं व्ययो यस्य न राजते।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "व्ययस्थानेऽपि तस्यान्ते विनाशो ननु निश्चितः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "निन्द्यत्वेन समाः सर्वे दुर्गुणाः खलु भूतले।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "परं तत्रापि कार्पण्यं विभिन्नं परिगण्यते॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "सहसैव प्रसादोऽपि नृणां दोषाय कल्पते।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "लाभेन वर्जितं कार्य हातव्यं तच्च दूरतः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "स्वाभिलाषास्तथा गोप्या यथा वेद्या निजारिभिः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "न भवेयुः कथंचित् ता निष्फलाः स्युस्ततो द्विषः॥१०॥"
    }
  ]
}