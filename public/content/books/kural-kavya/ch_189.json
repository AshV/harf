{
  "book_id": "kural-kavya",
  "chapter_id": "ch_189",
  "number": 189,
  "title": "परिच्छेदः ७५ दुर्गः",
  "word_count": 94,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "उपकर्ता यथा दुर्गों निर्बलानां स्वरक्षिणाम्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "सबलानां तथैवैष नास्ति न्यूनः सहायकृत्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "वनदुर्गों गिरेर्दुगों मरुदुर्गोऽथ वारिणः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "दुर्गः प्राकारदुर्गश्च सन्ति दुर्गा अनेकथा॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "दार्ढ्यमुत्सेधविष्कम्भावजय्यत्वञ्च सर्वतः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "दुर्गाणां हि विनिर्माणे नूनमावश्यका गुणाः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "यो दार्ढ्यें किञ्चिदूनोऽपि शत्रूणां मदभञ्जकः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "पर्याप्तों यत्र विस्तारो स दुर्गः प्रवरो मतः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "दुर्गसैनिकरक्षायाः प्रबन्धो वस्तुसंग्रहः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अजय्यत्वञ्च दुर्गस्य सन्ति ह्यावश्यका गुणाः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "आवश्यकपदार्थानां यत्र पर्याप्तसंग्रहः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "रक्षितो यो हि वीरैश्च स दुर्गों दुर्ग उच्यते॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "चिरानुबन्धावस्कन्दसुरङ्गाभिश्च यं रिपुः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "विजेतुं नैव शक्नोति स दुर्गों दुर्ग उच्यते॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "विजयाय कृतोद्योगान् परिवारकसैनिकान्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अपि जेतुं क्षमो यश्च सैव दुर्गोऽस्त्यसंशयम्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सैव दुर्गोऽस्ति यच्छतेस्तवस्था रक्षका भटाः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "दूरादेव बहिः सोम्नो घातयन्ति स्वैरिणः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "पूर्णसाधनसम्पन्नः सुदुर्गोऽपि निरर्थकः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "यदि प्रमादिनः सन्ति रक्षकाः स्फूर्तिविच्युताः॥१०॥"
    }
  ]
}