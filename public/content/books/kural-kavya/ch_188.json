{
  "book_id": "kural-kavya",
  "chapter_id": "ch_188",
  "number": 188,
  "title": "परिच्छेदः ७४ देशः",
  "word_count": 126,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "७३ सभायां प्रौढता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ७५ दुर्गः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ७४"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "देशः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "देशेषु स महान् देशो यत्र सन्ति महर्षयः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "धार्मिका धनिकाश्चापि कृषिर्नित्यं समृद्विभाक्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "स एवास्ति महान् देशो यो द्रव्यैंर्लोककर्षकः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "प्रचुरा च कृषिर्यत्र स्वास्थ्यं पूर्णनिरामयम्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "समृद्धं पश्य तं देशं सहते यो बहूनपि।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "उत्साहेन रिपोर्वारान् काले च करदायकः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "यस्मिन् देशे न दुर्भिक्षं न वा मारी च दृश्यते।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "समन्ताद् रक्षितो यश्च स याति महनीयताम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "महान् स एव देशो यो न त्रिभक्तो विपक्षिषु।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "देशविद्रोहिणः कृत्या न च स्युर्यत्रमण्डले॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "न जातः शत्रुयानेन लुप्तश्रीयों हि जातुचित्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "जातोऽप्यथायपूर्णों यः स देशो रत्नसन्निभः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "भूमिवारि नदीवारि नभोवारि महीधरः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सुदृढो दुर्गवर्गश्च देशस्यावश्यका इमे॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "समृद्धिरुर्वराभूमिरारोग्यं सुखशालिता।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "रिपुभ्यश्च परित्राणं देशभूषणपश्चकम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "सहजा जीविकोपाया यस्मिन् सन्ति स वस्तुतः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "देशोऽस्ति तत्पुरोऽन्ये तु समकक्षा भवन्ति नो॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "तावन्न राजते देशो युक्तोऽपि बहुभिर्गुणैः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "यावत् तत्र न सौराज्यं प्रजानां परिपालकम्॥१०॥"
    }
  ]
}