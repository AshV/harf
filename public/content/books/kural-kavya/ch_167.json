{
  "book_id": "kural-kavya",
  "chapter_id": "ch_167",
  "number": 167,
  "title": "परिच्छेदः ५५ न्यायशासनम्",
  "word_count": 107,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सम्यविचार्य निष्पक्षो भूत्वा चापि महीपते।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "नीतिज्ञसम्मतः शुद्धः कर्तव्यो न्यायविस्तरः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "जीवनस्य प्रदानाय लोको मेघं यथेक्षते।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "न्यायप्राप्त्यै तथा चायं राजदण्डं समीक्षते॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "राजदण्डो यथेहास्ति मुख्यो धर्मस्य रक्षकः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "राजदण्डस्तथैवास्ति विद्यानां परिपालकः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "स्निग्धदृष्टचैव यो राजा स्वराज्यं शास्ति सर्वदा।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तं भूपति कदापीह राजश्रीर्नैव मुश्चति॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "न्यायदण्डं समादत्तें भूपतियों यथाविधि।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "तद्रराज्ये विपुला सस्यवृद्धिः स्याञ्च सुवर्षणम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "महीपतेः खरः कुन्तो विजये नास्ति कारणम्।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "विशुद्धो न्याय एवास्ति विजये किन्तु कारणम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "भुवं रक्षति भूपालो गुणयुद्धेन तेजसा।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "विशुद्धो राजदण्डश्च तं नृपं पाति सर्वदा॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "प्रजाभ्यो योऽस्ति दुर्दर्शों न्याये नापि विचारकः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अरिणा स च हीनोऽपि स्तपदाद् भ्रश्यते नृपः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अन्तरस्थास्तथा बाह्यान् दण्ड्यान् दण्डेन दण्डयन्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "भूपः करोति कर्तव्यमतस्तस्मिन्न दूषणम्॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "परित्राणाय साधूनां श्रेयान् दुष्टयधस्तथा।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तृण्योच्छेदो   &#91; १ &#93;    यथा क्षेत्र शालीनां हि समृद्धये॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    तृणसमूहहोल्पाठनम्।"
    }
  ]
}