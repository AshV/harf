{
  "book_id": "kural-kavya",
  "chapter_id": "ch_173",
  "number": 173,
  "title": "परिच्छेदः ६० उत्साहः",
  "word_count": 97,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "उत्साहभूषिता एवं सत्य सम्पत्तिशालिनः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तद्विरुद्वाः पुनर्नैव स्वामिनः स्वश्रियामपि॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "उत्साह एव लोकेऽस्मिन् सत्यं परमवैभवम्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "अन्यद्धि सर्वमैश्वर्यं क्षयं यात्येव कर्हिचित्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "उत्साहसाधनं येषां करे नित्यं विराजते।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "ते धन्याः सर्वनाशेन न सीदन्ति कदाचन॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "स धन्यो य: श्रमान्नैर दूरादेव पलायते।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सौभाग्यश्रीस्तदाबासमन्विष्यायात्यनेहसि॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "क्षुपेभ्यो वारिदानेन पुष्पश्रीः मुच्यते यथा।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "तथोत्साहेन भाग्यश्रीर्ज्ञायते देहधारिणः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "निजलक्ष्यं सदोदात्तं कार्य कुशलबुद्धिभिः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "वैफल्येऽपि यतो जाते कलङ्कः कोऽपि नो भवेत्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "पराजितोऽप्यनुत्साह भजते नैव साहसी।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "शराघातं रणे प्राप्य दृढपादो गजो यतः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तं पश्य क्षीयते लोके यस्योत्साहः शनैः शनैः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अपारवैभवानन्दस्तस्य भाग्ये न वर्तते॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "पीनोन्नतेन देहेन खरदन्तैश्च दन्तिनः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "को गुणो यदि वीक्ष्यैव मृगेन्द्र म्रियते मनः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अस्ति नूनं महोत्साहो महाशक्तिर्महीतले"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "ये सन्ति तेन हीनास्ते पशवो देहभेदतः॥१०॥"
    }
  ]
}