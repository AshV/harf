{
  "book_id": "kural-kavya",
  "chapter_id": "ch_119",
  "number": 119,
  "title": "परिच्छेदः ११ कृतज्ञता",
  "word_count": 103,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१० मधुरभाषणम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १२ न्यायशीलता   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ११"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कृतज्ञता"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "या दया क्रियते भव्यैराभारस्थापनं विना।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "स्वर्ग्यमर्त्यावुभौ तस्याः प्रतिदानाय न क्षमौ॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "शिष्टैरवसरं वीक्ष्य यानुकम्पा विधीयते।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "स्वल्पापि दर्शने किन्तु विश्वस्मात् सा गरीयसी॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "आपन्नार्तिविनाशाय यानपेक्ष्वार्यवृत्तिना।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "क्रियते करुणा तस्या अब्धेरप्यधिकं बलम्॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "लाभ: सर्षपतुल्योऽपि परस्माज्जायते यदि।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कृतज्ञस्य पुरस्तात्तु तालतुल्यो भवत्यसौ॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सीमा कृतज्ञतायास्तु नोपकारावलम्बिता।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तन्मूल्यमुपकार्यस्य पात्रत्वे किन्तु निर्भरम्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "उपेक्षा नैव कर्तव्या प्रसादस्य महात्मनाम्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "प्रणयोऽपि न हातव्यस्तेषां ये दुःखबान्धवाः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "संकटे भीतिमापन्नान् य उद्धरति सर्वदा।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "कृतज्ञत्वेन तन्नाम कीर्त्यते हि भवान्तरे॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "नीचत्वं ननु नीचत्वमुपकारस्य विस्मृतिः।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "भद्रत्वं खलु भद्रत्वमपकारस्य विस्मृतिः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "अपकर्तुरपि प्राज्ञैरुपकारः पुराकृतः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "स्मृतः करोति दुःखानां विस्मृतिं मर्मघातिनाम्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "अन्यदोषेण निन्द्यानासुद्धारः संभवत्यहो।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "परं भाग्यविहीनस्य कृतघ्नस्य न चास्ति सः॥१०॥"
    }
  ]
}