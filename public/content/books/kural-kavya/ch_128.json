{
  "book_id": "kural-kavya",
  "chapter_id": "ch_128",
  "number": 128,
  "title": "परिच्छेदः २ मेघमहिमा",
  "word_count": 102,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१ ईश्वरस्तुतिः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ३ मुनिमाहात्म्यम्   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः २"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "मेघमहिमा"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "यथासमयसंजाता वृष्टिर्यस्योपकारिणी।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "वारिवाहः सुधारूपस्तेनेदं वर्तते जगत्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सर्वस्वादिष्टखाद्यानां मूलं जलद उच्यते।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "नेदमेव स्वयं वारि भोजनाङ्गं प्रतिष्ठितम्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "मेघवृष्टिं बिना लोके दुर्भिक्षं संग्रजायते।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "समन्तात् सागरैर्युक्ता भूरपि स्यात् प्रपीडिता॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जीवनाधारभूतानि स्वर्गस्रोतांसि वारिदाः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "विलीनाश्चेत् कृषि नृनमहास्यन् हलजीविनः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अतिवृष्टिबलाञ्जाताः क्षीणा ये किल मानवाः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "समृद्धास्ते हि भूयोऽपि जायन्ते वारिवर्षणात्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "खात् पतन्ती पयोवृष्टिर्विरता चेत् कदाचन।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "तृणजन्मविलुप्तिः स्यादन्येषां दूरगा कथा॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "बीभत्सदारुणावस्था जायेताहो सरित्पतेः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तज्जलस्य ग्रहोत्सगौं न कुर्याच्चेत् पयोधरः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "देवानां परितोषाय सपर्या पंक्तिभोजनम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "सर्वाण्येतानि लुप्यन्ते विलुप्ते व्योम्नि वारिदे॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "दानिनां दानकर्माणि शूराणां चैव शूरता।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "जपहोमक्रियाः सर्वा नष्टा नष्टे वलाहके॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "संभवन्ति समस्तानि कार्याणि जलदागमे।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "सदाचारोऽपि तेनैव विदुषामेष निश्चयः॥१०॥"
    }
  ]
}