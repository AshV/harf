{
  "book_id": "kural-kavya",
  "chapter_id": "ch_170",
  "number": 170,
  "title": "परिच्छेदः ५८ चारुशीलम्",
  "word_count": 130,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "५७ भयप्रदकृत्यत्यागः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ५९ गुप्तचरः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ५८"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "चारुशीलम्:"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "चारुशीलात्परं नास्ति सुरम्यं मोददायकम्।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "कार्य सुचारुरूपेण सृष्टेस्तेनैव वर्तते॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "जीवनस्यापि माधुर्य शीले सत्येव विद्यते।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "भारभूता विपर्यासे जायन्ते मानवा भुवि॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अहो गीतेन कि तेन यन्न केनापि गीयते।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नेत्रेणापि च किं तेन यत्र स्नेहो न दृश्यते॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कोऽर्थों नेत्रेण मात्रायां यन्नादरपरं परे   &#91; १ &#93;   ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "केवलं मुखमुद्रायां नूनमस्यास्ति दर्शनम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "नेत्रयोर्भूषणं शीलं यत्र तत्रैव विद्यते।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अहो ते लोचने नूनं वर्तेते शिरसि क्षते॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "जायते नैव यस्याक्षि सविचारं परं प्रति।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सनेत्रोऽपि स किंनेत्रो निर्विशेषश्च भूरुहात्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "सत्यमेवाक्षिहीनास्ते येषु नास्ति परादरः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सनेत्राः सन्ति ते ये च परदोषे दयालवः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "यः कर्तव्ये न वैलक्ष्यं कृत्वा सत्कुरुते परान्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तस्य रिक्थे महीराज्यं वर्तते गुणशालिनः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "दुःखदेभ्यः क्षमादानं दत्वा नूनं विमोचनम्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "सहैव स्नेहदानं चेत् ख्याता चित्तसमुन्नतिः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "यदीच्छसि निजं लोके शीलनेत्रसमन्वितम्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "तद्विषं तर्हि पानीयं यत् ते साक्षाद् विमिश्रितम्॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    परस्मिन्।"
    }
  ]
}