{
  "book_id": "kural-kavya",
  "chapter_id": "ch_131",
  "number": 131,
  "title": "परिच्छेदः २२ परोपकारः",
  "word_count": 99,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "नोपकारपराः सन्तः प्रतिदानजिघृक्षया।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "समृद्धः किमसौ लोको मेघाय प्रतियच्छति॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "महान्तो बहुभिर्यत्नैरर्जयन्ति स्वपौरुषात्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "यद्द्रव्यं खलु तत्सर्वं परेषामेव कार्यकृत्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "यः कश्चिदुपकारो हि हार्दिकः क्रियते बुधैः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "न किश्चिद्वस्तु तत्तुल्यं भूतले वा सुरालये॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "योग्यायोग्यविचारो हि नून यस्य स जीवति।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तयोर्विवेकहीनश्च जीवन्नपि मृतायते॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "पश्य तं सलिलापूर्णं कासार   [ १ ]    हृधदर्शनम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "एवं तस्यापि गेहे श्रीर्यस्यान्तः प्रेमसंस्थितिः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "उदाराणामिदं सर्वं वैभवं समुपार्जितम्।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "ग्राममध्ये समुत्पन्नतरुवैभवसन्निभम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "तेन वृक्षेण संकाशा   [ २ ]    उत्तमस्य विभूतयः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सर्वाङ्गं यस्य भैषज्यं सदा च फलशालिनः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "दुःखं दैवाद् यदि प्राप्तो योग्यायोग्यपरीक्षकः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "न मुश्चति तथाप्येष उपकारं दयाकरः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सुकृती रिक्तमात्मानं तदानीं मन्यते ध्रुवम्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आशाभंगान्निवर्तन्ते यदा वै याचका जनाः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "उपकारो विनाशेन सहितोऽपि प्रशस्यते।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "विक्रीयापि निजात्मानं भव्योत्तम विधेहि तम्॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    सरोवरम्।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    तुल्या.।"
    }
  ]
}