{
  "book_id": "kural-kavya",
  "chapter_id": "ch_129",
  "number": 129,
  "title": "परिच्छेदः २० व्यर्थभाषणम्",
  "word_count": 105,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अर्थशून्यं वचो यस्य श्रुत्वोद्वेगः प्रजायते।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तत्सम्पर्काज्जुगुप्सन्ते लोके सर्वेऽपि मानवाः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "क्लेशदानं स्वमित्रेभ्यो वरमस्तु कथञ्चन।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "गोष्ठ्यां किन्तु वृथालापो न श्लाघ्यो निम्नताकरः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "निस्सारं दम्भपूर्णश्च व्याख्यानं यः प्रभाषते।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "नन्वाख्याति स्वयं लोके स मन्दः   [ १ ]    स्वामयोग्यताम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "बुधवृन्दे प्रलापेन कोऽपि लाभो न जायते।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "विद्यमानो वरांशोऽपि तत्सम्बन्धाद् विलीयते॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "योग्योऽप्ययोग्यवद् भाति व्यर्थालापपरायणः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सम्मानं गौरवश्चास्य द्वयमेव विनश्यति॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "रुचिरेवास्ति यस्याहो मोघार्थवचसां व्यये।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तं मानवं न जानीहि ह्यपेक्ष्यं चापि कच्चरम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "उचितं बुध चेद् भाति कुर्याः कर्कशभाषणम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "परं नैव वृथालापं यतोऽस्माद्वै तदुत्तमम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "येषां हि निरतं चित्तं तत्त्वज्ञानगवेषणे।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "विकथां ते न कुर्वन्ति क्षणमात्रं महर्षयः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "येषां तु महती दृष्टिर्यें चैवं दीर्घदर्शिनः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विस्मृत्यापि न कुर्वन्ति वृथोक्तीस्ते महाधियः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "वाचस्ता एव वक्तव्या याः श्लाघ्याः सभ्यमानवैः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "वर्जनीयास्ततो भिन्ना अवाच्या या वृथोक्तयः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    मूर्खा.।"
    }
  ]
}