{
  "book_id": "kural-kavya",
  "chapter_id": "ch_141",
  "number": 141,
  "title": "परिच्छेदः ३१ क्रोधत्यागः",
  "word_count": 133,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "३० सत्यभाषणम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ३२ उपद्रवत्यागः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ३१"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "क्रोधत्यागः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सत्यां निग्रहशक्तौ हि क्रोधत्यागः सुशोभते।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "यतः शक्तिविहीनस्य क्षान्त्याऽक्षान्त्या च किं भवेत्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अथ चेन निग्रहेऽशक्तिस्तदा कोपो निरर्थकः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अथ चेन् निग्रहे शक्तिस्तदा कोपो घृणास्पदः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "हानिकर्ता भवेत् कोऽपि कोपो हेयस्तथापि सः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "अनर्था येन जायन्ते शतशो दुःखदायिनः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "मोदं विहन्ति कोपोऽयमानन्दथ्वनसकारकः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अन्यो नास्ति ततः कोऽपि शत्रुर्हानिविधायकः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "भद्रमिच्छसि   &#91; १ &#93;    चेद् भद्र कोपं मुञ्च सुदूरतः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अन्यथाऽऽक्रम्य शीघ्रं ते स विनाशं विधास्यति॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अग्निर्दहति तद्वस्तु तत्पार्श्वे यस्य संस्थितिः।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "भस्मीकरोति कोपस्तु क्रुध्यन्तं सकुटुम्बकम्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "निधाय हृदि रोषं यो निधानमिव रक्षति।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "भूमिं संताड्य हस्तेन पीडितः स प्रमत्तवत्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सम्प्राप्य महतीं हानिं क्रोधाग्नौ संज्वलत्यपि।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "इदं भद्रतरं नूनं यत् कोपाद्भव दूरगः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "त्वरितं तस्य सिध्यन्ति सर्व एव मनोरथाः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "येन दूरीकृतो नित्यं क्रोधोऽयं शान्तचेतसा॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "स्वयशे नैव यश्चण्डः   &#91; २ &#93;    स नूनं मृतसन्निमः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "यश्च कोपपरित्यागी योगितुल्यो विभाति सः॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    वल्याणम्।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "↑    अत्यन्तकोपी।"
    }
  ]
}