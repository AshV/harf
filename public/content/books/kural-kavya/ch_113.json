{
  "book_id": "kural-kavya",
  "chapter_id": "ch_113",
  "number": 113,
  "title": "परिच्छेदः १०३ कुलोन्नतिः",
  "word_count": 105,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अहर्निशं श्रमिष्मियामि विना श्रान्तिं करद्वयात्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "नरस्यायं हि संकल्पः कुलोत्कर्षेककारणम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "योगक्षेमपरा बुद्धिः श्रमश्च पौरुषान्वितः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "इमे स्तो बंशवृद्धयर्थं समर्थे द्वे हि कारणे॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कुलोन्नतिं यदा कर्तुं नरो भवति सञ्जितः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "कटिवद्धाः सुरा यान्ति तदग्रे स्वयमव्यथाः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "येन मुक्तं न चेत्किश्चित् कुलोत्कर्षचिकीर्षया।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "स्वल्पमप्यस्तु तत्कार्य सिद्धये किन्तु निश्चितम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अनघैश्चरितैर्नित्यं यः करोति कुलोन्नतिम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "स उदात्तः सदा मान्यस्तन्मित्रं क्षितिमण्डलम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "स वंशो गुरुतां नीतः श्रियि ज्ञाने बले च वा।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "यत्र जन्म मनुष्यस्य पौरुषं तस्य पौरुषम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "वीरमेव यथा युद्धे प्रहरन्त्यरयो भृशम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "शक्त स्कन्धौ तथा लोके कुलभारोऽभिगच्छति॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "कुलोन्नतिं चिकीर्षास्तु सर्वे काला हितावहाः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "प्रत्यनीके प्रमादेन कुलपातो विनिश्चितः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कुटुम्परक्षिणां कार्य वीक्ष्यैवं धीः प्रजायते।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "श्रमार्थमथ दुःखार्थ किमसौ विधिना कृतः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "यस्य नास्ति कुटुम्बस्य पालकः सत्प्रवन्धकः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तन्मूले विपदां घातात् पतनं तस्य जायते॥१०॥"
    }
  ]
}