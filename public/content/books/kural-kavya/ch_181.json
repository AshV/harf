{
  "book_id": "kural-kavya",
  "chapter_id": "ch_181",
  "number": 181,
  "title": "परिच्छेदः ६८ कार्यसञ्चालनम्",
  "word_count": 99,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "क्रियते हि परामर्शो निश्चयार्थ विचक्षणै:।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "निश्चये च पुनर्जाते निस्सारं कालयापनम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अविलम्बसह कार्यमाशु कुर्वीत धीधनः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "चिरभावि च यत्कार्य तत् कुर्याच्छान्तिमास्थितः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "लक्ष्येणैव हि गन्तव्यं स्थितिश्चेदनुकूलिनी।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "वामाथ तर्हि गन्तव्यं स्वल्पबाधामये पथि॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "कार्य सामिकृतं शत्रुर्नास्ति यश्च पराजितः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "समये वृद्धिमापन्नौ शेषाग्निरिव दुःखदौ॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "क्षेत्रं साधनसम्पत्तिं द्रव्यं भावश्च कालवत्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "पूर्व विचार्य पश्चाच्च कार्य कुर्वीत कोविदः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "अत्र कार्य कियाँल्लामः श्रमश्चापि कियानथ।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "वाधाश्चापि कियत्यः स्युरिति पूर्व विचिन्तयेत्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कार्यसिद्धेरसौ मार्गों विद्वद्भिः परिनिश्चितः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "यद् रहस्पत्रिदं प्राप्य तद्रहस्यं समर्जयेत्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "वने हि वशितां याति गजेनैव गजो यथा।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "कार्यक्षेत्रे तथा धीमान् कार्य कार्येण साधयेत्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "मित्रोपहारदानादप्यधिकेयं शुभक्रिया।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "पद् द्रुतं हि विधातच्या रिपूणां सांत्वनक्रिया॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "दुर्बलाय हिता नैव संकटेषु चिरस्थितिः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अतो बलवता साकं काले सन्धि समर्जयेत्॥१०॥"
    }
  ]
}