{
  "book_id": "kural-kavya",
  "chapter_id": "ch_149",
  "number": 149,
  "title": "परिच्छेदः ३९ राजा",
  "word_count": 118,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सेना मंत्री सुहृत् कोषो दुर्गैः साकं जनाश्रयः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "षडेते सन्ति यत्पाश्र्वे राजसिहः स भूतले॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "साहसं बुद्धिरौदार्यं कार्यशक्तेश्च पूर्णता।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "आवश्यका इमे सर्वे गुणाः शासनकारिणः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "शासनाय समुत्पन्नान् न त्यजन्ति गुणास्त्रयः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "विद्या निर्णयसामर्थ्य नित्यञ्चापि परीक्षणम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नूनं स एव राजास्ति यो न धर्मात् प्रमाद्यति।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अधर्मध्नः सदाचारी वीरः सम्मानरक्षकः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "राज्यसाधनविस्फूर्तिवृद्धिश्चापि कथं भवेत्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "कथं कोषस्य पूर्णत्वं कथमायव्ययौ च मे॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "धनस्य परिरक्षा च कथं मे वर्ततेऽधुना।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "एतत्सर्व हि विज्ञेयं राज्ञा स्वहितकांक्षिणा॥५॥ (युग्मम्)"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "प्रजानां स्वलु सर्वासां सुलभं यस्य दर्शनम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "नाप्युद्वेगकरं वाक्यं तस्य राज्यं समुन्नतम्॥६॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "औचित्येन समं दानं प्रेमयुक्तञ्च शासनम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "एतद्द्वयं हि यस्यास्ति स भूपो लोकविश्रुतः॥७॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "रक्षणे नित्यमुद्युक्तो निष्पक्षो न्यायकर्मणि।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "धन्य एवंविधो भूपः स नूनं भुवि देवता॥८॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "कर्णयोरप्रिया शब्दाञ् श्रोतुं शक्रोति यो नृपः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तस्यच्छत्रतलेऽजस्रं सकलेयं वसुन्धरा॥९॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "उदारो न्यायसम्पन्नः प्रजासेवी दयारतः।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "य एवं वर्तते भूपो ज्योतिष्मान् स हि राजसु॥१०॥"
    }
  ]
}