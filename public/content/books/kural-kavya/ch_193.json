{
  "book_id": "kural-kavya",
  "chapter_id": "ch_193",
  "number": 193,
  "title": "परिच्छेदः ७९ मित्रता",
  "word_count": 92,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "किमस्ति कठिनं लोके शिष्टैः श्लाघ्या सुमित्रता।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तत्समो दृढसन्नाहो यतो नास्ति महीतले॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "सतां भवति मैत्री तु ज्योत्स्नाचन्द्रकलासमा।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "असताञ्च पुनः सैव तमिस्नेन्दुकलानिमा॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "मैत्री भवति गुण्यानां श्रुतिस्वाध्यायसनिभा।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "उत्तरोत्तरवृद्धा हि द्योतन्ते यत्र सद्गुणाः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नैवामोदविनोदार्थ मित्रताद्रियते बुधैः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अपि भर्त्सनया मित्रं मार्गस्थं क्रियते तया॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सदैव सहगामित्वं भूयोभूयश्च दर्शनम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सख्यस्य वर्धने नैव कारणं किन्तु मानसम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "विनोदकारिणी गोष्टी नैवास्ते मित्रतागृहम्।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "मैत्री प्रेमामृतोद्धूता हृदयाह्लादकारिणी॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कापथावहिराकृष्य नियुड्क्ते न्यायकर्मणि।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "उपतिष्ठते च दुःखेषु यत् तन्मित्रं प्रगण्यते॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "गृह्णीतोऽरं यथा पाणी वायुविच्युतमंशुकम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "विपन्नमित्रकार्याणि सुसखः कुरुते तथा॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "आस्थानं कुत्र सख्यस्य यत्रास्ते हृदयकता।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "उभे च यत्र चेष्टेते मिलित्वा श्रेयसे मिथः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "उपकारप्रसंख्यानं यत्रास्ति प्रीतिधारिणाम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "दारिद्रयं तत्र गर्वोक्त्या गाढस्नेहस्य घोषणा॥१०॥"
    }
  ]
}