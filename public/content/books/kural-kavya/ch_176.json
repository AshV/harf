{
  "book_id": "kural-kavya",
  "chapter_id": "ch_176",
  "number": 176,
  "title": "परिच्छेदः ६३ विपदि धैर्यम्",
  "word_count": 114,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "हसन् भव पुरोभागी विपत्तीनां समागमे।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "विपदां हि जये हासः सहायः प्रबलो मतः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अव्यवस्थितचित्तोऽपि भवन्नेकाग्रमानसः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "विपदां चेत् पुरःस्थायी तत्क्षुब्धाब्धिः प्रशाम्यति॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "विपदो मन्यते नैव विपदो यो हि मानवः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "ध्रुवं तस्य निवर्तन्ते विपन्नाः स्वयमापदः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "प्राणेषु त्यक्तमोहः सन् यतते यो लुलायवत्   [ १ ]   ।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "जेतुं सर्वाषदस्तस्य हताशाः प्रतियान्ति ताः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "स्वविपक्षे विपत्तीनां सज्जितां महतीं चमूम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "दृष्ट्वापि यस्य नाधैर्यं ततो विम्पति ताः स्वयम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नासीत् सौभाग्यकालेऽपि प्रमोदो यस्य सद्मनि।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "स कथं कथयेत् सर्व 'हा संप्रति विपद्धतः'॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "इति वेत्ति स्वयं प्राज्ञो यद्देहो विपदां पदम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अतएव विपन्नोऽपि नानुशोचति पण्डितः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "यो विलासप्रियो नास्ति मन्यते चापदस्तथा।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "सहजा जन्मना साकं स दुःखातों न जायते॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "यस्य नास्ति महाहर्षः सम्पत्तीनामुपागमे।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विषादोऽपि कथं तस्य भवेत् तासामपागमे॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "मन्यते सुखमायासे वर्षावेगद्वये च यः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तं स्तुवन्ति महाधीर विरुद्धा अपि वैरिणः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    महिष इब।"
    }
  ]
}