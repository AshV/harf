{
  "book_id": "kural-kavya",
  "chapter_id": "ch_150",
  "number": 150,
  "title": "परिच्छेदः ४ धर्ममाहात्म्यम्",
  "word_count": 112,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "३ मुनिमाहात्म्यम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ५ गृहस्थाश्रमः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ४"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "धर्ममाहात्म्यम्"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "धर्मात् साधुतरः कोऽन्यो यतो विन्दन्ति मानवाः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पुण्यं स्वर्गप्रदं नित्यं निर्वाणञ्च सुदुर्लभम्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "धर्मान्नास्त्यपरा काचित् सुकृतिर्देहधारिणीम्।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "तत्त्यागान्न परा काचिद् दुष्कृतिर्देहभाजिनाम्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सत्कृत्यं सर्वदा कार्य यदुदर्के सुखावहम्।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "पूर्णशक्तिं समाधाय महोत्साहेन धीमता॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सर्वेषामेव धर्माणामेष सारो विनिश्चितः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मनःशुद्धिं विहायान्यो वृथैवाडम्बरो महान्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "दुर्वचोलोभकोपेर्ष्या हातव्या धर्मलिप्सुना।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "इदं हि धर्मसोपानं धर्मज्ञैः परिनिश्चितम्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "करिष्यामीति संकल्पं त्यक्त्वा धर्मी भव द्रुतम्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "धर्म एव परं मित्रं यन्मृत्यौ सह गच्छति॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "को गुणः खलु धर्मेण मा पृच्छैवं कदाचन।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "शिविकावाहकान् दृष्ट्‌वा तस्याञ्चारूढभूपतिम्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "व्यर्थ न याति यस्यैकं धर्माचारं बिना दिनम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "जन्ममृत्युमहाद्वारं मुद्रितं तेन साधुना॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "सुखं धर्मसमुद्‌भूतं सुख प्राहुर्मनीषिणः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "अन्यथा विषयोद्‌भूतं लज्जादुःखानुबन्धि तत्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "कार्य तदेव कर्तव्यं यत् सदा धर्मसंभृतम्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "धर्मेणासंगतं कार्य हातव्यं दूरतो द्रुतम्॥१०॥"
    }
  ]
}