{
  "book_id": "kural-kavya",
  "chapter_id": "ch_115",
  "number": 115,
  "title": "परिच्छेदः १०५ दरिद्रता",
  "word_count": 110,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "दारिद्रयादधिकं लोके वर्तते किन्नु दुःखदम्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "इति पृच्छास्ति चेत्तर्हि शृणु सैवास्ति निःस्वता   &#91; १ &#93;   ॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "हतदैवं हि दारिद्रयमस्त्येवेहाति दुःखदम्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "पारलौकिकभोगानामप्यास्ते किन्तु घातकम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "तृष्णानुबन्धिदारिद्रयं सत्यं गर्हृातिगर्हितम्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "वंशस्य गुरुतां हन्ति वाचो यच्च मनोज्ञताम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "हीनस्थितिर्मनुष्यस्य महती कष्टदायिनी।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "हीना इव प्रभाषन्ते सुवंश्या अपि यद्वशात्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अभिशापोऽस्ति दैवस्य दारिद्रयापरनामकः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "निलीनाः सन्ति यस्याधो विपदो हि सहस्रशः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "रिक्तस्य न हि जागर्ति कीर्तनीयोऽखिलो गुणः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अलमन्यैर्न लोकेभ्यो रोचते तत्सुभाषितम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "आदौ रिक्तः पुनर्धर्माद्धीनो यस्तु पुमानहो।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "पौरुषं तस्य संवीक्ष्य तन्मातैव जुगुप्सते॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "किन्न मुञ्चसि दुःखार्तं मामद्यापि दरिद्रते।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "ह्य एव हि महादुष्टे कृतः सामिमृतस्त्वया   &#91; २ &#93;   ॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "तप्तशूलेषु सुध्वापः कदाचित् सम्भवत्यहो।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आकिञ्चन्ये च मर्त्यस्य सुखनिद्रा न संभवा॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "उत्सृजन्ति निजप्राणान् यदि नो निर्धना नराः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तर्ह्मन्येषां वृथा याति भक्तं पानश्च सैन्धवम्॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    निर्धनता।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    अर्धमृत।"
    }
  ]
}