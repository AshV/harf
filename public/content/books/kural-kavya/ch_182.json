{
  "book_id": "kural-kavya",
  "chapter_id": "ch_182",
  "number": 182,
  "title": "परिच्छेदः ६९ राजदूतः",
  "word_count": 121,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "६८ कार्यसञ्चालनम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        परिच्छेदः ७० नृपाणां समक्षे व्यवहारः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ६९"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "राजदूतः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "लोकपूज्ये कुले जन्म हृदयं करुणामयम्।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नृपाणां मोददातृत्वं राजदूतगुणा इमे॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "निसर्गात् प्रेमवृत्तित्वं वारिग्मत्वं विस्मयावहम्।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "प्रतिभावत्वञ्च दूतानां त्रयो ह्यावश्यका गुणाः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "स्वामिलाभाय येनात्तो   &#91; १ &#93;    भारो भूपतिमण्डले।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "आवश्यकं हि तद्वाण्यां पाण्डित्यं सर्वतोऽधिकम्॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "प्रभावजननी यस्य मुखमुद्रास्ति पश्यताम्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "विद्याविभूषितो यश्च स दूतार्हों महीभुजाम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "संक्षेपभाषणं वाण्यां माधुर्य कट्वभाषणम्।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "सुदूताः साधनैरेतैः कुर्वन्ति स्वामिनो हितम्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "प्रभावोत्पादिका वाणी वैदुष्यं समयज्ञता।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "प्रत्युत्पन्नमतित्वञ्च दुतस्य प्रथमे गुणाः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "स्थानावसरकर्त्तव्यबोधे यस्यातिपाटवम्।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "आलोचितोक्तशब्दो यः स दूतो दूत उच्यते॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "निसर्गहृदयग्राही विशुद्धात्मा सदाशयः।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "हक्षाश्च यस्य संकल्पास्तं दूत्ये   &#91; २ &#93;    खलु योजयेत्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "आवेशादपि न ब्रूते दुर्वाक्यं यो विचक्षणः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "परराष्ट्रे स एवास्ति योग्यः शासनहारका॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "च्यवन्ते नैव कर्तव्यात् प्राणैः कण्ठगतैरपि।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "सुदतः पूर्णयत्नेन साधनोति स्वामिनो हितम्॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    गृहीतो।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "↑    दूतवाणीग्म्याश्चेति यत्।"
    }
  ]
}