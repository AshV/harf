{
  "book_id": "kural-kavya",
  "chapter_id": "ch_118",
  "number": 118,
  "title": "परिच्छेदः १०८ भ्रष्टजीवनम्",
  "word_count": 124,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१०७ भिक्षाभीतिः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १ ईश्वर-स्तुति   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः १०८"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "भ्रष्टजीवनम्"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सन्तीमे पतिता भ्रष्टाः कीदृशो मनुजैः समाः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अहो एवंविधं साभ्यं मया नान्यत्र वीक्षितम्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अनार्या अधिका आर्याज्जायन्ते सुखिनो ध्रुवम्।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यतो न मानसैर्दुःखैरभिभूता भवन्ति ते॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "आभासन्ते किल भ्रष्टाः प्रत्यक्षेश्वरसन्निभाः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "यतः स्वशासिता नित्यं ते भवन्ति महीतले॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अतिदुष्टो यदा स्वस्मान् न्यूनं पश्यति दुर्जनम्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "वर्ण्यते तत्पुरस्तेन गर्वोक्त्या स्वायसंहतिः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "दुष्टा नरा भयेनैत्र कयाचित् तृष्णयाऽथवा।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "श्रेयोमार्गे प्रवर्तन्ते निसर्गातु कुमार्गिणः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "पुरढक्कासमाः सन्ति नीचाः खलु निसर्गतः।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कर्णजाहं   &#91; १ &#93;    गतं भेदं यान्त्युद्घोध्यैव निर्दृतिम्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तेषामेव वशे नीचा मुखे ये मुष्टिघातकाः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अन्यथोच्छिष्टपाणेश्च प्रक्षेपाय निषेधकाः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "एकमेव हि सद्वाक्यमलं योग्याय वर्तते।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "विसृजन्ति तथा क्षुद्रा यथा पुण्ड्रा निपीलिताः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "यदैव सुखिनं दुष्टः पश्यति प्रतिवेशिनम्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तदैव तेन तन्मूर्ध्नि दोषः कोऽप्यवतार्यते॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "क्षुद्रो हि मानवो जातु विपदा परिभूयते।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "शीघ्रमेव स मोक्षार्थ विक्रीणीते स्वजीवनम्॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    कर्णयोर्मूलम्।"
    }
  ]
}