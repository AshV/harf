{
  "book_id": "kural-kavya",
  "chapter_id": "ch_148",
  "number": 148,
  "title": "परिच्छेदः ३८ भवितव्यता",
  "word_count": 101,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "नरो दृढप्रतिज्ञः स्याद् भाग्यलक्ष्मीप्रसादतः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "स एव याति शैथिल्यं हतभागस्य दोषतः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "शक्तेर्हासो मनुष्याणां दुर्भाग्यात्सम्प्रजायते।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "बुद्धेः स्फूर्तिस्तु लोकानां जागृते पुण्यकर्मणि॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कोऽर्थो ज्ञानेन जातेन चातुर्येणापि को गुणः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अन्तरात्मा यतो नित्यं सर्वोपरि प्रभाववान्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "द्वे वस्तुनीह संसारे विभिन्ने सर्वथा पृथक्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "एकं तत्र धनाढ्यत्वं द्वितीयं साधुशीलता॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "शुभोऽप्यशुभतां याति सति भाग्ये पराङ्मुखे।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अनुकूले सति त्वस्मिन्त्रशुभोऽयि शुभायते॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "यत्नेनापि न तद् रक्ष्यं भाग्यं नैव यदिच्छति।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "भाग्येन रक्षितं वस्तु प्रक्षिप्तं नापि नश्यति॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "महाशासकदैवस्य शासनातिक्रमेण वै।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "उपभोक्तुं न शक्तोऽस्ति कोट्यधीशो वराटिकाम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "निर्धना अपि जायन्ते कदाचित् त्यागबुद्धयः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "भाविदुःखकृते दैवं परं तत्रास्ति बाधकम्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सुखे न जायते येषामुद्वेलो हर्षसागरः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "दुःखं प्राप्य कथं लोके शोकमग्ना भवन्ति ते॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "दैवस्य प्रवला शक्तिर्यतस्तद्ग्रस्तमानवः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "यदैव यतते जेतुं तदैवाशु स पात्यते॥१०॥"
    }
  ]
}