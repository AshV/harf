{
  "book_id": "kural-kavya",
  "chapter_id": "ch_143",
  "number": 143,
  "title": "परिच्छेदः ३३ अहिंसा",
  "word_count": 98,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अहिंसा परमो धर्मों धर्मेषु श्रेष्ठसम्मतिः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "हिंसा च सर्वपापानां जननी लोकविश्रुता॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "इदं हि धर्म सर्वस्यं शास्तृणां वचने द्वयम्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "क्षुधार्तेन समं मुक्ति: प्राणिनाञ्चैव रक्षणम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अहिंसा प्रथमो धर्मः सर्वेषामिति सम्मतिः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "ऋषिभिर्बहुधा गीतं सूनृतं तदनन्तरम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अयमेव शुभो मार्गों यस्मिन्नेवं विचारणा।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "जीवः कोऽपि न हन्तव्यः क्षुद्रात्क्षुद्रतरोऽपि सन्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "हिसां दूरात् समुत्सृज्य येनाहिंसा समादृता।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "उदात्तः स हि विज्ञेयः पापत्यागिषु वै ध्रुवम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "अहिसाबतसम्पन्नो धन्योऽस्ति करुणामयः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सर्वग्रासी यमोऽप्यस्य जीवने न क्षमो भवेत्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "विपत्तिकाले सम्प्राप्ते प्राप्ते च प्राणसंकटे।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तथाप्यन्यप्रियप्राणान् मा जहि त्वं दयार्द्रधीः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "श्रूयते बलिदानेन लभ्यन्ते वरसम्पदः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "पवित्रस्य परं दृष्टौ तास्तुच्छाश्च घृणास्पदाः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "येषां जीवननिर्वाहो हिंसायामेव निर्भरः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विबुधानां सुदृष्टौ ते मृतस्वादकसन्निभाः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "पूतिगन्धसमायुक्तं पश्य शीर्ण कलेवरम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "स घातकचरो नूनं बुधैरित्यनुमीयते॥१०॥"
    }
  ]
}