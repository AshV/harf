{
  "book_id": "kural-kavya",
  "chapter_id": "ch_111",
  "number": 111,
  "title": "परिच्छेदः १०१ निरुपयोगिधनम्",
  "word_count": 128,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१०० सभ्यता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १०२ लज्जाशीलता   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः १०१"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "निरुपयोगिधनम्"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "निजगेहे कृतो येन विपुलस्त्वर्थसंग्रहः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "व्यये किन्तु कदर्योऽस्ति ततो मृतवदेव सः॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "धनमेव परं वस्तु वर्तते वसुधातले।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "इत्यर्थाय मृतो गृघ्न् राक्षसोऽमुत्र जायते॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "वित्तार्थन्तु महोत्साहः कीर्त्यै किन्तु निरादरः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "येषां ते सन्ति निस्सारा भुवो भाराय केवलाः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "स्वस्मिन् नैवार्जिता येन सुप्रीतिः प्रतिवेशिनाम्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "आशा कास्ति पुनस्तस्य प्राणान्ते यां समुत्सृजेत्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "न दत्ते नापि भुङ्क्ते यो लोभोपहतमानसः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "जातु चेत् कोट्यधीशोऽपि वस्तुतः सोऽस्ति निर्धनः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "परस्मै ददते नै भुञ्जते नापि ये स्वयम्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "ते सन्ति कुपणा लोके स्वलक्ष्म्या रोगरूपिणः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "देशे काले च पात्रे च यद्वित्तं नैव दीयते।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "मोघं तदपि सुन्दर्या वनस्थायाः सुरूपवत्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सन्तो यया न सुप्रीताः सा लक्ष्मीर्ननु तादृशी"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "ग्राममध्ये यथा जातः फलितो विषपादपः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "धर्माधर्मावनादृत्य बुभुक्षाश्च विषह्य यः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "सञ्चीयते निधिर्नित्यं परेषां स हितावहः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "आपन्नार्तिविनाशेन वदान्यस्य दरिद्रता।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "जाता जातु न नित्या सा मेघस्येव सुवर्षणात्॥१०॥"
    }
  ]
}