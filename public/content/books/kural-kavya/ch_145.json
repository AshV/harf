{
  "book_id": "kural-kavya",
  "chapter_id": "ch_145",
  "number": 145,
  "title": "परिच्छेदः ३५ त्यागः",
  "word_count": 99,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "३४ संसारानित्यता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ३६ सत्यस्यानुभूतिः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ३५"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "त्याग:"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मन्ये ज्ञानी प्रतिज्ञाय यकिञ्चित् परिमुञ्चति।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "तदुत्पन्नमहादुःखान्निजात्मा तेन रक्षितः॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अनेकसुखरत्नानामाकरस्त्यागसागरः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "चिरं सुखाभिलाषा चेद् भव त्यागपरायणः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "निग्रहं कुरु पञ्चानामिन्द्रियाणां विकारिणाम्।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "प्रियेषु त्यज संमोहं त्यागस्यायं शुभक्रमः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सर्वसंगपरित्यागो यमिनां व्रतमिष्यते।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "पुनर्बन्धनप्राप्तिर्हि त्यक्तोपात्तैकवस्तुना॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "भवचक्रनिवृत्तीच्छोरस्ति कायेऽपि हेयता।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "कथमावश्यकास्तस्य भिन्ना बन्धनहेतवः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "'अहं' 'ममेति' संकल्पो गर्वस्वार्थित्वसम्भृतः।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "जेतास्य याति तं लोक स्वर्गादुपरिवर्तिनम्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "अतिवृष्णाभिभूतो यो लोभं नैव जिहासति।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "स दुःखैर्ग्रस्यते नित्यं मुक्तिर्न जातुचित्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "विरक्तो मोक्षमार्गस्थो निर्मोहः सर्ववस्तुनि।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अन्ये संसारिणः सर्वे मोहजालवशीकृताः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "न चाप्नोति पुनर्जन्म लोभमोहजयक्षणात्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "बन्धनं यैस्तु नोच्छिन्नं भ्रमजाले पतन्ति ते॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "शरणं ब्रज तस्यैव येन मोहो विनिर्जितः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "आश्रयी भव तस्यैव छिद्यते येन बन्धनम्॥१०॥"
    }
  ]
}