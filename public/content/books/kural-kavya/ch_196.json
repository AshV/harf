{
  "book_id": "kural-kavya",
  "chapter_id": "ch_196",
  "number": 196,
  "title": "परिच्छेदः ८१ घनिष्टमित्रता",
  "word_count": 121,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "८० सख्यार्थं योग्यतापरीक्षा"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        परिच्छेदः ८२ विघातिका मैत्री   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ८१"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "घनिष्टमित्रता"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "घनिष्टमित्रता सैव तयोरस्त्यनुरूपयोः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "यत्रात्मा प्रीतिपात्राय यथाकामं समर्प्यते॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सत्यरूपात् तयोर्मैत्री वर्तते विज्ञसम्मता।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "स्वाश्रितौ यत्र पक्षौ द्वौ भवतो नापि बाधकौ॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "यदि नास्ति वयस्यस्य स्वातन्त्र्यं मित्रवस्तुनि।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "सौहार्देनापि कि तेन क्रियाविकलरूपिणा॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "प्रगाढमित्रयोरेकः किमप्यनुमति विना।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कुरुते चेद् द्वितीयोऽपि सख्यमाध्याय हृष्यति॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मित्रकृत्येन केनापि यदि ते दूयते मनः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तस्यार्थः सख्युरज्ञानं किं वा वामेकतानता   &#91; १ &#93;   ॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अभिन्नहृदयं मित्रं सुसखो नैव मुञ्चति।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "वरमस्तु विनाशस्य हेतुरेव तदाश्रयः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "येन साकं चिरस्नेहो यश्वासीत् सुप्रियो हृद।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "कुर्वन्नपि व्यलीकानि स प्रियो न घृणास्पदम्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "मित्रं नैव सुमित्रस्य सहते दोषकीर्तनम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "निन्दको दण्ड्यते यस्मिन् तदहस्तस्य तोषदम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "अन्तर्हिमालयाद्यस्य प्रेमगङ्गा परान् प्रति।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "वहत्यखण्डधारायां भूप्रियः सोऽपि जायते॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "यस्य स्नेहो न शैथिल्यं याति मित्र चिरन्तने।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "तस्मै मानवरत्नाय स्निहृन्ति रिपवोऽप्यलम्॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    युवयो।"
    }
  ]
}