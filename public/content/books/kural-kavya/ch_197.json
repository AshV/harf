{
  "book_id": "kural-kavya",
  "chapter_id": "ch_197",
  "number": 197,
  "title": "परिच्छेदः ८२ विघातिका मैत्री",
  "word_count": 108,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "विघातिनी तयोमैंत्री यौ प्रदर्शयतो बहिः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "सख्यं किन्तु ययोः किश्चिद् वर्तते नैव मानसे॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "पतन्ति पदयोः स्वार्थात् स्वार्थाभावाच्च दूरगाः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "ये धूर्तास्ते हि हातव्यास्तत्सख्येनापि को गुणः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अस्मात् सख्युरियाँल्लामः स्यादित्येवं विचारयन्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "नरो भवति चौराणां वेश्यानाञ्च कुपंक्तिषु॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पलायते यथा युद्धात् पातयित्वाश्ववारकम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कुत्स्यसप्तिस्तथा   [ १ ]    मायी का सिद्धिस्तस्य सख्यतः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "विश्वस्तं सुहृदं काले मुञ्चता सह मायिना।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सख्यस्थापनमश्रेयः श्रेयान् ननु विपर्ययः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "प्राज्ञैः सम विरोधोऽपि वर मूढस्य संगतेः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सादृश्याय यतो नूनं वर्द्धन्ते गुणराशयः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "स्वार्थिनां चाटुकर्तृणां सौहार्दाद् वैरिणामहो।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "असह्यापि घृणा साध्वी शतगुण्या मता बुधैः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तव पाणौकृते कार्य योऽस्ति बाधाविधायकः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "किञ्चितं प्रति मा ब्रूहि मैत्री मुश्च शनैः शनैः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अन्यदेव खलु ब्रूते कुरुते चान्यदेव यः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "स्वप्नेऽप्यशुभरूपास्ति तेनामा सख्यकल्पना॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "एकान्ते स्तौति यो नित्यं बहिर्निन्दति दुष्टधीः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "वृत्तिरेवंविधा यस्य स ह्युपेक्ष्यो विमर्शिना॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    दुष्ढाश्व।"
    }
  ]
}