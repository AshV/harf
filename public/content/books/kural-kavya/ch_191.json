{
  "book_id": "kural-kavya",
  "chapter_id": "ch_191",
  "number": 191,
  "title": "परिच्छेदः ७७ सेना",
  "word_count": 103,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "शिक्षितं बलसम्पन्नं संकटे चास्तभीतिकम्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "नृपस्य वस्तुजातेषु श्रेष्ठमस्ति सुसैन्यकम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अपर्याप्ताभिघातेऽपि नैराश्ये च भयङ्करे।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "स्थितिरक्षा हि कुर्वन्ति शूरा युद्धविशारदाः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अहितं नास्ति नः किश्चिद् वरं गर्जन्तु तेऽब्धिवत्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अलमाखुसहस्रेभ्यः फूत्कारः कृष्णभोगिनः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "च्यवते या न कर्तव्यान्नानुभूतपराजया।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "प्रदर्शितस्वशौर्या च सैव सेना वरूथिनी॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यमेन पूर्णक्रुद्धैन समं यस्याः सुसाहसम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "योद्धु विशोभते तस्याः सेनाख्या वीरकाङ्क्षिता॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "प्रतिष्ठावीरते ज्ञानं युद्धानां पूर्ववर्तिनाम्।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "बुद्धिमत्वञ्च सेनाया गुणाः सन्नाहसनिभाः   &#91; १ &#93;   ॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "आक्रम्यापि रिपुर्नूनं जितः स्यादिति निश्चयात्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "गवेषयन्ति निर्भीकाः स्वशत्रु सुभटोसमाः ॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "न चेत् सज्जा नवाशक्तिः प्रचण्डाक्रमणाय च।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "विभवौज प्रतापाच सेनायास्त्रुटिपूरकाः ॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "या न्यूना नास्ति संख्यायां नार्थाभावेन पीडिता।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तस्या अस्ति जयो नूनं सेनाया इति निश्चयः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सेनापतेरसद्भावे न सेना कापि जायते।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सन्तु यद्यपि भूयांसः सैनिका रणकोविदाः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    कवचतुल्यः।"
    }
  ]
}