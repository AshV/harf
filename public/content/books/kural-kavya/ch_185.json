{
  "book_id": "kural-kavya",
  "chapter_id": "ch_185",
  "number": 185,
  "title": "परिच्छेदः ७१ मुखाकृत्याभावपरीक्षणम्",
  "word_count": 118,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "उक्तः पूर्व विजानाति मनोभावं परस्य यः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "स मेधावी सतां वन्धो वर्तते भूविशेषक:   &#91; १ &#93;   ॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "मनोगतं हि यो भावं बुद्धया समधिगच्छति।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "न स साधारणः किन्तु वर्तते भुवि देवता॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "आकृतिं वीक्ष्य यः प्राज्ञः परभावं समूहते।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "प्रीत्या केनापि यत्नेन मन्त्रदः स विधीयताम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "उक्तं वेत्ति नरः कश्चिदनुक्तञ्चाप्यतुच्छधीः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "आकृतौ सति साम्येऽति श्रेण्यां भिन्नस्थितिस्तयोः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सकृदेव नरं दृष्ट्वा भावं मानससंस्थितम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "बोद्धुं यदक्षमं चक्षुर्वृथा ज्ञानेन्द्रियेषु तत्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "भिन्नवर्णसमायोगं व्यनक्ति स्फटिको यथा।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तथैव सर्वलोकानां वक्त्रं वक्ति हि मानसम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "भावपूर्णमुखं त्यक्त्या श्रेष्ठमन्यन्न वस्तुकम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मुखं हि सर्वतः पूर्व हर्षामषौं व्यनक्ति नुः   &#91; २ &#93;   ॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "यदि प्राप्तो भवेत्पुण्याद् विना शब्देन भाववित्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तदक्षिसन्निकर्षोऽपि जायते ननु सिद्धिदः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "आकूतादिपरिज्ञानमुत्तमं यदि वर्तते।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "एकेन तर्हि बुध्येते रागरोषौ हि चक्षुषा॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "धूर्ता भद्रतराश्चापि सन्ति ये वसुधातले।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तदृदृष्टिरेव सर्वत्र तेषां भावस्य सूचिका॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    भूतिलक।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    नरस्य।"
    }
  ]
}