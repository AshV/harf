{
  "book_id": "kural-kavya",
  "chapter_id": "ch_199",
  "number": 199,
  "title": "परिच्छेदः ८४ मूर्खता",
  "word_count": 110,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "मौर्ख्य किमिति जिज्ञासो शृणु तर्हि वदामि तत्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "लाभहेतोः परित्यागो ग्रहणं हानिकारिणाम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अयोग्येऽथ विनिन्धे च प्रवृत्तिर्ननु कर्मणि।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "प्रथमा मूढता ज्ञेया तस्याः सर्वासु कोटिषु॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "मूर्खों विस्मृत्य कर्तव्यमसभ्यं भाषते वचः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "धर्मो न रोचते तस्मै हीदयाभ्यां स बर्ज्यते॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "शिक्षितोऽपि सुदक्षोऽपि गुरुत्वे सुस्थितोऽपि सन्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "लम्पटो योऽक्ष जातानां को मूढस्तादृशो भुवि॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अहो स्वयं समाख्याति पूर्वमेव स्वजीवने।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "श्वभ्रस्य विवरे तुच्छे स्वस्थानं खलु मूढधीः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "उच्चकार्य समादत्ते यो मूढो निजहस्तयोः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "स परं नैव तन्नाशी बन्दी भवति च स्वयम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मूर्खोंपार्जितवित्तेन भवन्ति सुखिनः परे।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "आत्मीयाः किन्तु दुःखार्ताः त्रस्यन्ति क्षुषयातुराः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "बहुमूल्यं यदा वस्तु दैवादन लभ्यते।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "उन्मत्तसदृशो भूत्वा तदा सोऽयं कुचेष्टते॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "मैत्री भवति मूर्खाणां सुप्रिया ननु सर्वदा।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "यतो विघटने तस्याः सन्तापो नैव जायते॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अविदग्धस्तथा नैव शोभते बुधमण्डले।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "दुग्धोज्ज्वले हि पर्यङ्के यथैव मलिनं पदम्॥१०॥"
    }
  ]
}