{
  "book_id": "kural-kavya",
  "chapter_id": "ch_175",
  "number": 175,
  "title": "परिच्छेदः ६२ पुरुषार्थः",
  "word_count": 99,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अशक्यमिति संभाष्य कर्म मा मुञ्च दूरतः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "उद्योगो वर्तते यस्मात् कामसू: सर्वकर्मसु॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "सामिकार्य   [ १ ]    न कुर्वीत लोकरीतिविशारदः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "तद्विधात्रे यतः कोऽपि स्पृहयेन्न सचेतनः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "न जहाति विपत्तौ यः सानिध्यं तस्य गौरवम्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सेवारूपनिधिन्यासाल्लभ्यते तत् सुदुर्लभम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अनुद्योगवतो नूनमौहार्य क्लीबखड्गवत्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "यतस्तयोर्द्वियोर्मध्ये नैकं चास्ति चिरस्थिरम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सुखे रतिर्न यस्यास्ति कामना किन्तु कर्मणः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "आधारः स हि मित्राणां विपत्तावश्रुमार्जिकः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "उद्योगशीलिता लोके वैभवस्य यथा प्रसू।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "दारिद्रथाशक्तियुग्मस्य जनकोऽस्ति तथालसः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "आलस्यं वर्तते नूनं दारिद्रयस्य निवासभूः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "गतालस्यश्रमश्चाथ कमलाकान्तमन्दिरम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "नापि लज्जाकर दैवान् वैभवं यदि नश्यति।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "वैमुख्यं हि श्रमात् किन्तु लजायाः परमं पदम्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "वरमस्तु विपर्यस्त भाग्य जातु कुदैवतः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "पौरुषन्तु तथापीह फलं दत्ते क्रियाजुषे॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "शश्वत्कर्मप्रसक्तो यो भाग्यचक्रे न निर्भरः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "जय एवास्ति तस्याहो अपि भाग्यविपर्यये॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    अर्धंकार्यम्।"
    }
  ]
}