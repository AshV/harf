  "number": 132,
  "title": "परिच्छेदः २३ दानम्",
  "word_count": 121,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "२२ परोपकारः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        कुरल-काव्य/परिच्छेदः २४ कीर्तिः२४ कीर्तिः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः २३"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "दानम्"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "दीनाय दुःखपात्राय यद्दानं तत्प्रशस्यते।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अन्यत् सर्वन्तु विज्ञेयमुद्धारसदृशं पुनः ॥२॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "दानादाने   &#91; १ &#93;    हि न श्रेयः स्वर्गोऽपि प्राप्यते यदि।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "दानश्च परमो धर्मः स्वर्गद्वारेऽपि मुद्रिते॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "प्रशंसार्हाः सतां मान्या ननु सर्वेऽपि दानिनः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "परं तेषु कुलीनः स यः पूर्वं न निषेधति॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तावन्न मोदते दानी यावन्नासौ विलोकते।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "सन्तोषजनितं हर्षमर्थिनो मुखमण्डले॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "विजयेषु समस्तेषु श्रेष्ठः स्वात्मजयो मतः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "ततोऽपि विजयः श्रेष्ठः परेषां क्षुत्प्रशामनम्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "आर्तक्षुधाविनाशाय नियमोऽयं शुभावहः।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कर्तव्यो धनिभिर्नित्यमालये वित्तसंग्रहः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "इतरानपि संभोज्य यो भुङ्क्ते दययान्वितः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "नैव स्पृशति तं जातु क्षुधारोगो भयङ्करः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सञ्चिनीति विनाशाय संकीर्णहृदयो धनम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "ज्ञायते तेन न ज्ञातो दानस्य मधुरो रसः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "एकाकी कृपणो भुड्क्ते यदन्नं प्रीतिसंयुतः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "अनार्यजुष्टमस्वर्ग्यं भिक्षान्नात् तद् घृणास्पदम्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "मृत्युरेव हि तद्वस्तु यत्सर्वाधिकमप्रियम्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "दानशक्तरेसद्भावे चित्रमेषोऽपि रोचते॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    दानग्रहणे।"
    }
  ]
}