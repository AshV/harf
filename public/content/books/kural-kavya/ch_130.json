{
  "book_id": "kural-kavya",
  "chapter_id": "ch_130",
  "number": 130,
  "title": "परिच्छेदः २१ पापभीतिः",
  "word_count": 104,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "यन्मौर्ख्यं निखले लोके पापनाम्ना निगद्यते।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "ततोऽभीताः खलाः किन्तु सन्तस्तस्माच्च दूरगाः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "'द्रोहात्संजायते द्रोह' इति सत्यं सुभाषितम्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "दूरादेव ततस्त्याज्यो द्रोहाग्निर्वैरवर्द्धकः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कथयन्ति बुधा एवं यद्धीः सैवेह शस्यते।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "यया बुद्धिमता नित्यं हानिर्हेया द्विषामपि॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "विस्मृत्यापि नरो धीमान् परनाशं न चिन्तयेत्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "यतस्तस्य विनाशाय न्यायो युक्तिं सदेक्षते॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "'निर्धनोऽस्मीति' बुद्धयापि न कर्तव्यं हि किल्विषम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "दुरिताद् बर्द्धते यस्माद् दारिद्रयमधिकाधिकम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "यदीच्छसि विपत्तिभ्यस्त्राणं सततमात्मनः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "न कर्तव्या त्वया हानिः परेषां दुःखदायिनी॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अन्यारिभ्यस्तु संरक्षा कदाचित् संभवत्यहो।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "परं पापाद् विनिर्मुक्तिर्नाशात्पूर्वा न जातुचित्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "न जहाति नरं छाया यथा सा पृष्ठवर्तिनी।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तथैव पापकर्माणि नाशोदर्काणि देहिनाम्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "न करोति नरः पापं यस्यात्मा वै ध्रुवं प्रियः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "स एव कुरुते पापं यस्यात्मा ध्रुवमप्रियः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "विपदो विहतास्तस्य पूर्णरीत्या च रक्षितः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "विधातुं पापकर्माणि यः सन्मार्ग न मुञ्चति॥१०॥"
    }
  ]
}