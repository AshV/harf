{
  "book_id": "kural-kavya",
  "chapter_id": "ch_154",
  "number": 154,
  "title": "परिच्छेदः ४३ बुद्धिः",
  "word_count": 89,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "आकस्मिके विपच्चक्रे बुद्धिः सन्नाहसन्निभा।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अजय्यः प्रतिभादुर्गः समवेत्यापि शत्रुभिः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "सुबुद्धथा करणग्रामो विषयेभ्यो निवर्तते।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "अशुभाच्च शुभे मार्गे नियुक्ते सा यथाविधि॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अस्ति बुद्धेरियकार्य वत्सत्यासत्यनिर्णयः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "तद्वक्ताऽस्तु पुनः कोऽपि सुप्रियो दुष्प्रियोऽथवा॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "मतिमान् भाषते नित्यं सुबोध्यामेव भारतीम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "परेषां वचसां सारं स्वयञ्चापि स बुध्यति॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सर्वसौहार्दवृत्तित्वात् सर्वादियः सुधीः सदा।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "यस्यैकरूपता सख्ये चित्ते चातिव्यवस्थितिः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "लोकरीत्यनुसारेण व्यवहारोऽपि सर्वदा।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "आख्याति बुद्धिसद्भावमिति लोकज्ञभाषणम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "बुद्धिमान् बुद्धिसामान किमुदर्के भविष्यति।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "इति पूर्व स्वयं वेत्ति न चैवं बुद्धिवर्जितः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "भीतिस्थाने हठादेव प्रवृत्तिर्बुद्धिहीनता।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "भयहेतोविभीतिश्च प्रबुद्धेरेव सूचिका॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सर्वेषामेव कार्याणां कृते यः पूर्वसज्जितः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तस्य कम्पकदुःखानां नाघातो दूरदर्शिनः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अखिलं तस्य कल्याणं यस्यास्ति बुद्धिवैभवम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "यस्य नास्ति स्वयं प्रज्ञा तस्य किञ्चिन्न विद्यते॥१०॥"
    }
  ]
}