{
  "book_id": "kural-kavya",
  "chapter_id": "ch_137",
  "number": 137,
  "title": "परिच्छेदः २८ धूर्तता",
  "word_count": 109,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "प्रतारणमयीं वृत्ति वीक्ष्य तस्यैव मायिनः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "भौतिकाङ्गानि देहान्तस्तूष्णीं   &#91; १ &#93;    भूत्वा हसन्ति तम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "कोऽर्थः प्रभाववत्यापि नरस्य मुखमुद्रया।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "यदि सैब विजानाति स्वचित्तं शाठ्यदूषितम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "तपस्विवेशमाधाय कातर्यं येन सेव्यते।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सिंहचर्मपरिच्छन्नस्तृणभोजी स रासभः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "धर्मेणाच्छादितस्तिष्ठन् स्वैराचारी हि पातकी।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "गुल्मेनान्तर्हितो गृह्णन् विष्किरानिव   &#91; २ &#93;    नाफलः   &#91; ३ &#93;   ॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "शुचिंमन्यः कुधीर्दम्भी मायया धर्मसेवकः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "देहान्ते विलपत्येष हा हा नैव शुभं कृतम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "बहिस्त्यजति मायावी किल्विषं नैव चेतसा।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तथाप्याडम्बरो भूयान् दृश्यते निष्ठुरात्मनः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कृष्णतुण्डी यथा गुञ्जा बहिरेव मनोहरा।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सुन्दरोऽपि तथा धूर्तों दूषणैर्दूषिताशयः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "एवं हि बहवो लोका मनो येषां न पावनम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "परं तीर्थकृतस्नाना भ्रमन्ति ज्ञानिसन्निभाः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "दर्शने सरलो वाणः किञ्चिद्वक्रश्च तुम्बुरुः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "नराकृतिमतो हित्वा पश्य तत्कार्यपद्धतिम्॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "लोकनिन्द्यानि कार्याणि येन त्यक्तानि धीमता।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "किं जटाधारणैस्तस्य मुण्डनैर्वा महात्मनः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    देहमध्ये,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    पक्षिण,"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "↑    व्याध।"
    }
  ]
}