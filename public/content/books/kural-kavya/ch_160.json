{
  "book_id": "kural-kavya",
  "chapter_id": "ch_160",
  "number": 160,
  "title": "परिच्छेदः ४९ अवसरसमीक्षा",
  "word_count": 98,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "जयत्यवसरं प्राप्य दिवोलूकं हि वायसः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "एवञ्चाक्सरो हेतुर्विजये भूपतेरपि॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "समयं वीक्ष्य कार्याणां करणं मन्यते बुधः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "प्रेमरज्वा स्वसौभाग्यश्रियो हि दृढबन्धनम्॥३॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "क्षेत्रं साहाय्यसम्पत्तिं पूर्व वीक्ष्य करोति यः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "कार्य साघनविज्ञातुस्तस्यास्ति किमसम्भवम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "यदि स्ववसरं वेत्सि साधनानि तथैव च।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "शक्रोषि निजवीर्येण विजेतुं जगतीतलम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कार्यकालं प्रतीक्षन्ते जोषं हि जयरागिणः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "न क्षुभ्यन्ति कदाचित्ते नाप्युत्तापविधायिनः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "संघातकरणात् पूर्वं यथा मेषोऽपसर्पति।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तथाऽकर्मण्यता लोके कर्मण्यस्यापि दृश्यते॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अमर्षस्य प्रकाशो हि त्वरितं नैव धीमताम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तं गुप्तं हृदये कृत्वा तत्कालं स प्रतीक्षते॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "विनेतव्यो रिपुस्तावद् यावत्तस्य शुभोदयः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "विनिपातो यदा तस्य सुखोच्छेद्यस्तदा हि सः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अमोघकालं संप्राप्य विचिकित्सां विहाय च।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "क्षिप्रमेव विधातव्यं कार्य चेदपि दुष्करम्॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "पूर्व निश्चेष्टवद्भाति वामे काले विचक्षणः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अनुकूले पुनः काले वकवद् वाधते रिपुम्॥१०॥"
    }
  ]
}