  "title": "परिच्छेदः ८५ अहङ्कारपूर्णा मूढता",
  "word_count": 122,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "८४ मूर्खता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ८६ उद्धतता   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ८५"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अहङ्कारपूर्णा मूढता"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "दारिद्रथेष्वतिदारिद्रयं बुद्धेरेव विहीनता।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "निर्धनित्वं क्षयं याति यतो योग्यप्रयत्नतः॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "स्वेच्छया यदि मूढात्मा दत्ते किश्चिदुपायनम्।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सौभाग्यं तत्र पात्रस्य हेतुरन्यो न कश्चन॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "मूर्खः स्वदोषसंघातैः स्वयं यादृग् विपद्यते।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "तादृम् विपद्दयुतों नैव क्रियते क्रूरवैरिभिः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सहस्रबुद्धिमात्मानं वेत्ति यो गर्विताशयः"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नूनं स एव मूढात्मा बोद्धव्यो विदुषां वरैः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अज्ञातविषयज्ञानं दर्शयित्वा हि मन्दधीः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "विज्ञातविषयज्ञाने संशीतिं जनयत्यहो॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "मूढानां हि निजाङ्गेषु को गुणः पटधारणात्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अस्त्यसंधृतदोषाणां मानसे यदि संस्थितिः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "भेदं कमपि यः क्षुद्रः स्वस्मिन्नेव न सीमितम्।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "कर्तुं शक्रोति तन्मूर्ध्नि वर्तते विषदां चयः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "नो शृणोति न चावैति सुनीर्ति यो दुराग्रही।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "स हि मूढः स्वबन्धूनां दुःखदोऽस्ति निरन्तरम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "प्रबोधनाय मूर्खस्य यतते सोऽपि बालिशः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "शुद्धं नावैति मूढोऽन्यं मार्ग ह्यात्मविनिश्चितात्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "अपि लोकमतं वस्तु यो दम्भी नैव मन्यते।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "स भूतो भूमिसंचारी ज्ञायते सर्वमानवैः॥१०॥"
    }
  ]
}