{
  "book_id": "kural-kavya",
  "chapter_id": "ch_138",
  "number": 138,
  "title": "परिच्छेदः २९ निष्कपटव्यवहारः",
  "word_count": 98,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "घृणितं यदि नो लोके निजात्मानं दिदृक्षसि।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "स्वस्यात्मानं ततो नित्यं कपटाद्रक्ष यत्नतः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "सर्व वित्तं हरिष्यामि मायया प्रतिवेशिनः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "एवं हार्दिकसंकल्पः पापाय परिकल्पते॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कपटप्रभवं द्रव्यं वरं वर्द्धिष्णु भासताम्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अन्ते नाशः परं तस्य नियतोऽस्तीति निश्चयः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अपहारपिपासेयं समृद्धरेप्यनेहसि।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अनन्तसंख्यकं दुःखं प्रत्येव नयति ध्रुवम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "परस्वं गृध्नुदृष्ट्या यो हर्तुं कालं प्रतीक्षते।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "दयास्थान न तच्चित्ते प्रेमवार्ता च दूरगा॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नापैति गृध्नुता यस्य लुण्ठित्वाप्यन्यसम्पदम्।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "वस्तुमूल्यं न तद्‌दृष्टौ सुपथञ्च न याति सः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "संसारासारतां ज्ञात्वा लब्धबोधः पवित्रदृक्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "पार्श्वस्थवञ्चनादोषं कुरुते नैव धन्यधीः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "आर्याणां राजते चित्ते निसर्गादृजुता यथा।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "मायित्वस्य निवासस्तु चौराणां हृदये तथा॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "तस्मिन् कारुण्यमायाति यत्रान्या नास्ति कैतवात्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "वार्ता विमुच्य सन्मार्ग विनाशं स प्रयास्पति॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "निजदेहेऽपि स्वामित्वं वञ्चकानां विनश्यति।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "दायादाः किन्तु निर्बाधाः स्वर्गभूमेरमायिनः॥१०॥"
    }
  ]
}