{
  "book_id": "kural-kavya",
  "chapter_id": "ch_180",
  "number": 180,
  "title": "परिच्छेदः ६७ स्वभावनिर्णयः",
  "word_count": 118,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "६६ शुभाचरणम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ६८ कार्यसञ्चालनम्   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ६७"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "स्वभावनिर्णयः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मनोबलात् किमन्यत्र महत्त्वं यशसा चये।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "इतरेषां यतो नास्ति तत्राल्पापि किलांशता॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "विनिश्चयाय कार्याणां विदुषां निर्णयद्वयम्।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "पूर्णदार्ढ्यं निजोद्देशेऽशक्यस्याथविमोचनम्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "न व्यनक्ति निजोद्देशं सिद्धेः पूर्व सुकर्मठः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "अलंध्या अन्यथा पुंसो जायन्ते विपदां चयाः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कथनं सुलभं लोके यस्य कस्यापि वस्तुनः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "यथापद्धति हस्तेन करणं किन्तु दुर्लभम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "विधानादुञ्चकार्याणां सन्ति ये कीर्तिशालिनः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "सेवन्ते तान् नृपा नत्वा श्लाघन्ते च जनाः सदा॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "पुमाँश्चेत् सत्यसंकल्पः पूर्णशक्त्या च संभृतः।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "तदेव लभ्यते तर्हि यथा यत्तेन काम्यते॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आकृत्यैव नरः कोऽपि नैष्कर्म्यं नाधिगच्छति।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "स एव दृश्यते काले कार्याधारो रथाक्षवत्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सद्बुद्धया यत् त्वया कार्य स्वकर्तव्ये विनिश्चितम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तसिद्धथै पूर्णशक्तथैव यतस्वाचलचेतसा॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "प्रसादकेषु कार्येषु संलग्नो भव चेतसा।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "आक्रान्तोऽपि शतैः कष्टर्यावदन्तं दृढो भवन्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "चरित्रगठने येषां शक्तिमत्ता न विद्यते।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "तेऽन्यदिक्षु महान्तोऽपि न लोके गौरवान्विताः॥१०॥"
    }
  ]
}