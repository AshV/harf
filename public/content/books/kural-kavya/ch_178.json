{
  "book_id": "kural-kavya",
  "chapter_id": "ch_178",
  "number": 178,
  "title": "परिच्छेदः ६५ वाक्पटुता",
  "word_count": 101,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "वाग्मित्वं हि वरीवर्ति बरदानं विलक्षणम्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तन्नांशोऽन्यस्य कस्पापि स्वतःसिद्धं तदीप्सितम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "मृत्युर्वसति जिह्वाग्रे जिह्वाग्रे ननु जीवनम्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "अतः सुधीर्वदेद् वाणी विचार्यैव शुभां सदा॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "वाचस्ता एव सुश्लाघ्या याः सक्ताः   [ १ ]    सख्यवर्धने।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "रिपूणामपि कल्पन्ते हृदयाकर्षणाय च॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पर्यालोच्य नरः पूर्वं पश्चात् भाषेत भारतीम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "धर्मवृद्धिरतो नान्या लाभश्चापि शुभावहः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "वाणी सैव प्रयोक्तच्या यस्यां किञ्चिन्न हेयता।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अनुल्लंघ्या च या सर्वैर्लब्धसार्वगुणोदया॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "आशुविद् यः परार्थानां सुवक्ता चित्कर्षकः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अधिकारी स एवास्ति राजनीतेर्विदांवरः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नैव स्खलति यस्यान्तः सुवक्तुर्वादसंसदि।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "कथं पराजयः शक्यस्तस्य निर्भीकचेतसः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "ओजस्वि वाड्मयं यस्य विश्वास्यं परिमार्जितम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तदिङ्गिते नरीनर्ति समस्तं वसुधातलम्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "शब्दैः परिमितैरेव स्वाभिप्रायप्रकाशनम्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "ये जना नैव जानन्ति तेषु वै वावदूकता॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "निजार्तितं यदि ज्ञानं स्वयं व्याख्यातुमक्षमः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "नरो न शोभते तद्वन् निर्गन्ध कुसुमं यथा॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    तत्परा।"
    }
  ]
}