  "number": 120,
  "title": "परिच्छेदः १२ न्यायशीलता",
  "word_count": 114,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "११ कृतज्ञता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १३ संयमः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः १२"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "न्यायशीलता"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "इदं हि न्यायनिष्ठत्वं यन्निष्पक्षतया सदा।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "न्याय्यो भागो हृदा देयो मित्राय रिपवेऽथवा॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "न क्षीणा जायते जातु सम्पत्तिार्न्यायशालिनः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "वंशक्रमेण सा याति सहैवास्य सुकर्मणः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अन्यायप्रभवं वित्तं मा गृहाण कदाचन।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "वरमस्तु तदादाने लाभ एवास्तदूषणः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अन्यायेन समायुक्तं न्यायारूढञ्च मानवम्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "व्यनक्ति संततिर्नूनं स्वगुणैरात्मसंभवम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "स्तुतिर्निन्दा च सर्वेषां जायेते जीवने ध्रुवम्।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "न्यायनिष्ठा परं किश्चिदपूर्व वस्तु धीमताम्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "नीतिं मनः परित्यज्य कुमार्ग यदि धावते।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सर्वनाशं विजानीहि तदा निकटसंस्थितम्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "अथ निःस्वो भवेन् न्यायी कदाचिद् दैवकोपतः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तथापि तं न पश्यन्ति लोका हेयदृशा ध्रुवम्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अमायिकस्तुलादण्ड: पक्षद्वयसमो यथा।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तेन तुल्यः सदा भूयादासीनो न्यायविष्टरे॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "नैवस्खलति चेतोऽपि सुनीतेर्यस्य धीमतः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तस्यौष्ठनिर्गतं वाक्यं न मृषा न्यायरागिणः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "परकार्यमपि प्रीत्या स्वकार्यमिव यो गृही।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "कुरुते तस्य कार्येषु सिद्धिर्भाग्यवतः सदा॥१०॥"
    }
  ]
}