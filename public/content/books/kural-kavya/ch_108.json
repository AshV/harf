{
  "book_id": "kural-kavya",
  "chapter_id": "ch_108",
  "number": 108,
  "title": "परिच्छेदः १ ईश्वरस्तुतिः",
  "word_count": 128,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "प्रस्तावना"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        २ मेघमहिमा   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "श्री कुन्दकुन्दाचार्य"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "परिच्छेदः १"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "ईश्वरस्तुतिः"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "'अ' वर्णों वर्तते लोके शब्दानां प्रथमो यथा।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तथादि भगवानस्ति पुराणपुरुषोत्तमः॥१॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यदि नो यजसे पादौ सर्वज्ञपरमेष्ठिनः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अखिलं तर्हि वैदुष्यं मुधा ते शास्त्रकीर्तने॥२॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "वर्तेते पावनौ पादौ स्वर्णाम्भोजविहारिणः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "शरण्यौ हृदये यस्य स नूनं चिरमेधते॥३॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "वीतरागस्य देवस्य रक्तः पादारविन्दयोः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "यो धन्यः स पुमॉल्लोके दुःखी न स्यात् कदाचन॥४॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "उत्साहेन समायुक्ता नित्यं गायन्ति ये प्रभोः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "गुणान्, भवन्ति ते नैव कर्मदुःखोपभोगिनः॥५॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "आत्मना जयिना तेन यो धर्माध्वा प्रदर्शितः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तं नित्य येऽनुगच्छन्ति ते नून दीर्घजीविनः॥६॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "दुःखजालसमाकीर्णेऽगाधे संसारसागरे।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "कृच्छ्रान्मुक्तः स एवास्ति यस्यैकः शरणं प्रभुः॥७॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "धर्मसिन्धोर्मुनीशस्य लीना ये पदकंजयोः।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "त एव तरितुं शक्ताः क्षुब्धं तारुण्यवारिधिम्॥८॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "निष्क्रियेन्द्रियसंकाशा   &#91; १ &#93;    मानवास्ते महीतले।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "पादद्वयं नमस्यन्ति   &#91; २ &#93;    ये नाष्टगुणधारिणः॥९॥"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "जन्ममृत्युमहाम्मोघेः पारं गच्छन्ति ते जनाः।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "पावनौ शरणं येषां योगीन्द्रचरणौ ध्रुवम्॥१०॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "↑    तुल्या"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "↑    नमस्कुर्वन्ति"
    }
  ]
}