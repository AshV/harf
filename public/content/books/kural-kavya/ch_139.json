{
  "book_id": "kural-kavya",
  "chapter_id": "ch_139",
  "number": 139,
  "title": "परिच्छेदः ३ मुनिमाहात्म्यम्",
  "word_count": 111,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "परिग्रहं परित्यज्य जाता ये तु तपस्विनः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तेषां गायन्ति शास्त्राणि माहात्म्यं सर्वतोऽधिकम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "ऋषीणां पूर्णसामर्थ्य वेत्तुं को मानवः क्षमः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "दिवंगतान् यथा जीवान् संख्यातुं को जनः क्षमः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "मुक्तेर्भिन्नं भवं ज्ञात्वा त्यक्तो येन महात्मना।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "उद्‌द्योतितं जगत्सर्वं तेनैव निजतेजसा॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "स्वर्गक्षेत्रस्य बीजानि   [ १ ]    संयमेन तपोधनाः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "इन्द्रियाणि वशे येषामङ्कुशेन गजो यथा॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "विजिताक्षमहर्षीणां शक्तिरत्रास्ति कीदृशी।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "ज्ञातुमिच्छसि चेत्तर्हि पश्य भक्तं सुराधिपम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "करोति दुष्करं कार्य सुकरं पुरुषोत्तमः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "करोति सुकरं कार्य दुष्करं पुरुषाधमः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "स्पर्शे रसेऽथवा गन्धे रूपे शब्दे च यन्मनः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "क्रमते नैव तस्यास्ति योगो विष्टपशासने॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "ये सन्ति धार्मिका ग्रन्थाः समस्ते धरिणीतले।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "आलोकं   [ २ ]    तेऽपि कुर्वन्ति मुनीनां सत्यवादिनाम्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "त्यागस्य शिखरारूढो मोहग्रन्थिमपास्य यः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "क्षणं सहेत तत्क्रोधमेवं नास्ति नरो भुवि॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "साधुस्वभावमापन्ना मुनयो ब्राह्मणा मताः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "यतस्तेषां सदा चित्ते जीवानां करुणा स्थिता॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    'सन्ति' अभ्याहार्यम्"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    जयघोषम्।"
    }
  ]
}