{
  "book_id": "kural-kavya",
  "chapter_id": "ch_192",
  "number": 192,
  "title": "परिच्छेदः ७८ वीरयोद्धुरात्मगौरवम्",
  "word_count": 116,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "७७ सेना"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ७९ मित्रता   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ७८"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "वीरयोद्धुरात्मगौरवम्"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "रे रे सपत्नसंघात मा तिष्ठ स्वामिनः पुरः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "स योद्धुं यैः पुराहूतः साम्प्रतं ते चिताश्मसु॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कुन्ताघातो गजे मोधोऽग्यस्ति गौरवदायकः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "शशे किन्तु शराघातो सालोऽपि न मानदः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "नूनं तदेव वीरत्वं येन ह्याक्रम्यते रिपुः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "शरणागतवात्सल्य रूपञ्चास्त्यस्य सुन्दरम्॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "स्वकुन्तं करिदेहान्तः प्रवेश्यान्यं गवेषयन्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "निष्कासयँश्च गावस्थं स्मयते स भटाग्रणीः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "रिपुप्रासप्रहाराच्चेज्जातं नेत्रनिमीलनम्।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तर्हि ख्यातस्य वीरस्य का लज्जा स्यादतः परा॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "न पश्यन्ति यदा शूराः स्वाङ्गमालीढशोभितम्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "तदा दिनानि मन्यन्ते व्यर्थानि क्षीणचेतसः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "प्राणेषु त्यक्तमोहः सन् कीर्ति लोकान्तसंश्रिताम्।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "ईप्सते यस्तदंघ्रिस्थो निगडोऽपि सुशोभते॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "यस्य नास्ति भयं मृत्योर्युद्धे स सुभटोत्तमः।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "आतङ्कादपि सेनान्यो भटनीतिं न मुश्चति॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "अभीष्टकार्यसिद्धयर्य वीरा उद्योगशालिनः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "यदि प्राणैर्वियुक्ताः स्युस्तर्हि के दोषवादिनः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "यं समीक्ष्य भवेत् स्वामी वाष्पपूर्णाकुलेक्षणः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "भिक्षया चाटुकारैश्च तं मृत्युं प्रार्जयेद् भटः॥१०॥"
    }
  ]
}