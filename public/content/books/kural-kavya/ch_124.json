{
  "book_id": "kural-kavya",
  "chapter_id": "ch_124",
  "number": 124,
  "title": "परिच्छेदः १६ क्षमा",
  "word_count": 124,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१५ परस्त्रीत्यागः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १७ ईर्ष्यात्यागः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः १६"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "क्षमा"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "आश्रयं धरणी दत्ते खनितारमपि ध्रुवम्।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "तथा त्वं बाधकान्नित्यं क्षमस्वास्मिन् सुगौरवम्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तस्मै देहि क्षमादानं यस्ते कार्यविघातकः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "विस्मृतिः कार्यहानीनां यद्यहो स्थात् तदुत्तमा॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "स एव निर्धनो नूनमातिथ्याद् यः पराङ्मुखः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "एवं स एव वीरेन्दुर्मौंर्ख्यं येन विषह्यते॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "यदि कामयसे सत्यं हृदयेन सुगौरवम्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कार्यस्तर्हि समं सर्वैर्व्यवहारः क्षमामयः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "प्रतिवैरं विधत्ते यो न स्तुत्यः स विदाम्परैः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अरावपि क्षमाशीलो बहुमूल्यः स हेमवत्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "यावदेकदिनं हर्षों जायते वैरसाधनात्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "क्षमादानवतः किन्तु प्रत्यहं गौरवं महत्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "प्राप्यापि महतीं हानिं स्वल्पोऽप्याकारविभ्रमः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "न लक्ष्यते परं चित्रं नैवेहा वैरशोधने॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "विधत्ते तब कार्याणां हानिं यो गर्विताशयः।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "सद्वर्तनस्य शस्त्रेण तस्यापि विजयी भव॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "गृहं विमुच्य ये जाता ऋषयों लोकपूजिता:।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तेभ्योऽपि प्रवरा नूनं यै: खलोक्तिर्विषह्मते॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "महान्तः सन्ति सर्वेऽपि क्षीणकायास्तपस्विनः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "&#91; १ &#93;   क्षमावन्तमनुख्याताः किन्तु विश्वे हि तापसाः॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    हीना."
    }
  ]
}