{
  "book_id": "kural-kavya",
  "chapter_id": "ch_134",
  "number": 134,
  "title": "परिच्छेदः २५ दया",
  "word_count": 103,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "महतां हि धनं चित्तं करुणारससंभृतम्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अन्यद् द्रव्यं यतो लोके हीनवर्गेऽपि दृश्यते॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "यथाक्रमं समीक्ष्यैव दयां चित्तेन पालयेत्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "सर्वे धर्मा हि भाषन्ते दया मोक्षस्य साधनम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "असूर्या नाम ये लोका अन्धेन तमसावृताः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "ताँस्ते प्रेत्य न गच्छन्ति येषां चित्ते दयालुता॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अंहसां न फलं तेषां भुङ्क्ते सर्वदयारतः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "येषां स्मरणमात्रेण नूनमात्मा प्रकम्पते॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "दयालुः पुरुषो नैव जायते क्लेशभाजनम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "साक्षिणी तत्र वातानां वलयैर्वेष्टिता मही॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "हन्त येन दयाधर्मस्त्यक्तः पापान्धचेतसा।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "विस्मृतं तेन भुक्त्वापि धर्मत्यजनदुष्फलम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "यथा वैभवहीनाय नायं लोकः सुखाकरः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "न तथा परलोकोऽपि कारुण्यक्षीणवृत्तये॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "ऐहिकार्थपरिक्षीणः कदाचिद् धनिको भवेत्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "परं भूतदयारिक्तो नामुत्र सुदिनोदयः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सुलभं नो यथा सत्यं कषायवशवर्तिनः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "न प्रशस्तं तथा कार्य सुकरं निष्ठुरात्मना॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "दुर्बलं बाधितुं क्रूर यदोत्साहेन चेष्टसे।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तत्पदे स्वं तदा मत्वा चिन्तयस्य निजस्थितिम्॥१०॥"
    }
  ]
}