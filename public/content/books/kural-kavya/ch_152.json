{
  "book_id": "kural-kavya",
  "chapter_id": "ch_152",
  "number": 152,
  "title": "परिच्छेदः ४१ शिक्षाया अवहेलना",
  "word_count": 108,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "४० शिक्षा"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ४२ प्रवचनश्रवणम्   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ४१"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "शिक्षाया अवहेलना"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अध्यास्ते संसदः पीठं पूर्णशिक्षामुपेक्ष्य यः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "शारीपटं विना सोऽयमक्षैर्दीव्यति धूर्तधीः॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अनभ्यस्य श्रुतं यो वा काड्क्षते वाग्ग्मिगौरवम्।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "युवसु ख्यातिसाकाङ्क्षानुरोजा' रमणीव सः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सुशिक्षितानां पुरो धैर्यान् मूर्खश्वेन्मौनमास्थितः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "गण्यते शिक्षितो लोकैर्विदुषां सोऽपि योगतः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कियानपि भवेद् धीमान् शिक्षाशून्यो हि मानवः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "आद्रियते परं नैव विद्वद्भिस्तस्य मंत्रणा॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अवहेलितशिक्षो यः पण्डितं मन्यते निजम्।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "सुस्पष्टं सोऽपि लज्जेत यदा भाषेत संसदि॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अशिक्षितजनस्याहो दशोषरमहीनिभा।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "स जीवत्यतो नास्ति वार्ता तद्विषयेऽपरा॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विदुषां वैभवहीनत्वं मनसे नैव रोचते।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "आढ्यता किन्तु मूढानामप्रियास्ति ततोऽधिका॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "भव्यानि सूक्ष्मतत्वानि यद्बुद्धिर्नावगाहते।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तद्देहस्य सुसौन्दर्य मृण्मृर्तेरिख मण्डनम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "उच्चवंशप्रसूतोऽपि लघुतामेस्पशिक्षितः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "विद्यावृद्धः कुवंश्योऽपि लभते किन्तु गौरवम्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "पशुभ्योऽयं नरो यावान् साधुर्भवति भूतले।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "अशिक्षितेभ्यो वरस्तावान् शिक्षितोऽप्यस्ति विभुतः॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "१. उरोजहीना।"
    }
  ]
}