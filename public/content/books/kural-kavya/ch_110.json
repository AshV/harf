{
  "book_id": "kural-kavya",
  "chapter_id": "ch_110",
  "number": 110,
  "title": "परिच्छेदः १०० सभ्यता",
  "word_count": 130,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "९९ योग्यता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १०१ निरुपयोगिधनम्   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः १००"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सभ्यता"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "निर्व्याजचेतसा नित्यं स्वागताय समुद्यताः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अपूर्वेषु प्रियालापा भवन्ति प्रियदर्शनाः॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "ज्ञानमूलाः सुसंस्कारा हृदये च दयालुता।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "चेद् गुणद्वयसम्बन्धाद् हर्षबुद्धिः प्रजायते॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "आकृतौ सति साम्येऽपि न साम्यं मन्यते बुधः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "आचारैश्च विचारैश्च साम्यं वै हर्षदायकम्॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सन्नीत्या धर्मबुद्धया च लोकानुपकरोति यः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "स्तुवन्ति सुजनास्तस्य प्रकृतिं पुण्यरूपिणीम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "उक्तं हास्येऽपि दुर्वाक्यं जनानामस्त्यरुन्तुदम्   &#91; १ &#93;   ।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "दुर्व्यहृतं   &#91; २ &#93;    न कर्तव्यं भद्रैस्तस्माद् रिपावषि॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "सार्वाः सद्गुणसम्पन्ना आर्याः सन्ति महीतले।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "दयादाक्षिण्यसम्पूर्ण तेनेदं वर्तते जगत्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आचाशत्पतितो नैव शिक्षितोऽपि शुभावहः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सुव्रश्चनो   &#91; ३ &#93;    यथा नैव रणे दण्डाद् बृहत्तरः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अनम्रता नरस्यार्यैः सदा सर्वत्र गर्हिता।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अन्यायिनि विपक्षे वा प्रयुक्ताऽपि न शोभते॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "स्मितं न जायते यस्य विस्तृते धरणीतले।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तस्याभाग्यवतो नूनं दिनेऽपि निविडं तमः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "कुपात्रे निहितं क्षीरं यथैवास्ति निरर्थकम्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "वैफल्यं हि तथा याति वित्तं दुर्जनसमनि॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    हृदयव्यथक्रम्।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "↑    दुर्भाषणम्‌।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "↑    लोहघर्षणी।"
    }
  ]
}