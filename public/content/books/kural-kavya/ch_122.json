{
  "book_id": "kural-kavya",
  "chapter_id": "ch_122",
  "number": 122,
  "title": "परिच्छेदः १४ सदाचारः",
  "word_count": 95,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सदाचारेण सर्वत्र प्रतिष्ठाधारको जनः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "प्राणाधिकस्ततो रक्ष्यः सदाचारः सदा बुधैः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "प्रत्यहं प्रत्यवेक्षेत सुधीश्चरितमात्मनः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "दृढमित्रं यतो नास्ति तत्तुल्यं क्कापि विष्टपे   [ १ ]   ॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "आचारेण सुवंश्यत्वं द्योत्यते जगतीतले।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "कदाचारैश्च नीचानां श्रेणावायाति मानवाः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "विस्मृतोऽप्यागमः प्राज्ञैः कण्ठस्थः क्रियते पुनः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "स्वाचारप्रच्युतः किन्तु न पुनर्याति तत्पदम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "परोत्कर्षासहिष्णूनां यथा नैव समृद्वयः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "न गौरवं तथा किञ्चिद् दुराचारवतः कृते॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "न स्खलन्ति सदाचारात् प्रतिज्ञापालका जनाः"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "स्खलनं ते हि जानन्ति दुःखाब्धेर्मूलकारणम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "सन्मार्गवर्तिनः पुसः सन्मानं सभ्यसंसदि।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अप्रतिष्ठापकीर्तिश्च भाग्ये कापथगामिनः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "सुखबीजं सदाचारो वैभवस्यापि साधनम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "कदाचारप्रसक्तिस्तु विपदां जन्मदायिनी॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "विद्याविनयसम्पन्नः शालीनो गुणवान् नरः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "प्रमादादपि दुर्वाक्यं न ब्रूते हि कदाचन॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अन्यत् सर्वं सुशिक्षन्ते मूर्खा योग्योपदेशतः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "हन्त सन्मार्गगामित्वं न शिक्षन्ते कदापि ते॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    जगति"
    }
  ]
}