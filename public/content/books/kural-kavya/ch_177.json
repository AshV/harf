{
  "book_id": "kural-kavya",
  "chapter_id": "ch_177",
  "number": 177,
  "title": "परिच्छेदः ६४ मंत्री",
  "word_count": 99,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "महत्त्वपूर्णकार्याणां सम्पादनकुशाग्रधीः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "समयज्ञश्व तेषां यःस मंत्री स्थान्महीभुजाम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "कौलीन्यं पौरुष श्रेष्ठ स्वाध्यायो दृढनिश्चयः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "प्रजोत्कर्षाय सस्नेहचेष्टा मंत्रिगुणा इमे॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "रिपूणां भेदकर्तृत्वे मित्राणां सख्यवर्धने।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अरिभिश्च पुनःसन्धौ शक्तिर्यस्य स मंत्रदः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "साधूद्योगेषु सुप्रीतिः साधनानां विनिश्चयः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सम्मतिः स्पष्टरूपा च मत्रदातुरिमे गुणाः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "स्थानावसरसंवेदी नियमज्ञो बहुश्रुतः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सम्पग्विचार्य वक्ता यो मंत्री योग्यः स भूतले॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "स्वाध्यायाद् यस्य संजाता प्रतिमा सर्वतोमुखी।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "दुर्जेयं तस्य किं वस्तु विद्यते ननु विष्टपे॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "भवानुभवसम्पन्नो विद्यावित्तों   &#91; १ &#93;    भवन्नपि।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "पूर्व विमृश्य मेधावी व्यवहारं सदाऽऽवहेत्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "निर्विचारोऽस्तु भूपालो यदि वा कार्यबाधक:।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तथापि मंत्रिया वाच्यं हितमेव नरेश्वरे॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अनुशास्ति विनाशाय यो मंत्री मंत्रणागृहे।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "सप्तकोटिरिषुभ्योऽपि स शत्रुरधिको मतः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "नूनं विमर्शशून्या धीः संप्राप्यापि सुपद्धतिम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "व्यवहारे स्खलत्येव सिद्धिश्चापि न गच्छति॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    विधाया प्रसिद्ध.।"
    }
  ]
}