  "number": 147,
  "title": "परिच्छेदः ३७ कामनाया दमनम",
  "word_count": 116,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "३६ सत्यस्यानुभूतिः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ३८ भवितव्यता   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ३७"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कामनाया दमनम्"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "एकस्यापि पदार्थस्य कामना बीजसंततिः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "प्रतिजन्तु यतो जन्मनिष्पत्तिः फलशालिता॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कामनां कर्तुमिच्छा चेत् तर्हि मुक्तौ विधीयताम्।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सोऽधिकारी परं तत्र येनेयं कामना जिता॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "निर्दोषं हि महद्वस्तु निष्कामित्वं महीतले।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "स्वर्गेऽपि नास्ति तत्तुल्यो द्वितीयः कोषसंग्रहः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कामनायाः परित्यागान्नान्या काचित् पवित्रता।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "तत्‌त्त्यागस्तु परब्रह्मपदप्राप्त्यभिलाषया॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मुक्तास्त एव सन्तीह निर्जिता यैस्तु कामना।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अन्ये च बन्धनैर्बद्धाः स्वतन्त्रा इव भान्ति ते॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "हातव्या कामना दूरात् स्वकल्याणं यदीच्छसि।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "तृष्णाजालस्वरूपेयमन्ते नैराश्यकारिणी॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विषयाशाः परित्यक्ताः सर्वथा येन धीमता।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "मुक्तिरायाति तत्पार्श्वे निर्दिष्टेनैव वर्त्मना॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "यो न कामयते किञ्चिद् दुःखान्यपि न तत्कृते।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "बम्भ्रमीति य आशावान् दुःखानां तस्य राशयः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "स्थिरं सुखं मनुष्येण प्राप्तुमत्रापि शक्यते।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "दुःखानुबन्धिनी तृष्णा विध्वस्ता चेत् स्वशक्तितः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "इच्छाभिस्तु नरः कोऽपि संतृप्तो नैव भूतले।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "पूर्णतृप्तः स एवास्ति येनाशात्याग आदृतः॥१०॥"
    }
  ]
}