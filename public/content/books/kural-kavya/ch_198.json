{
  "book_id": "kural-kavya",
  "chapter_id": "ch_198",
  "number": 198,
  "title": "परिच्छेदः ८३ कपटमैत्री",
  "word_count": 111,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "मैत्रीप्रदर्शनं शत्रोः केवलं स्थाणुयोजना   [ १ ]   ।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "समये त्वापि   [ २ ]    यत्रासौ ताडयेद्धातुसन्निभम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "हृदये यस्य दुर्भावो बाह्ये यश्च सखीयते।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "कामिन्या इव तञ्चित्तं क्षणेनैति विरागताम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "वरमस्तु महाज्ञानं विशुद्धिर्वापि मानवे।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "शत्रोश्चित्ते तथापीह घृणात्यागोऽस्त्यसंभवः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "बहिर्हृष्यति यो मायी वेष्टि चान्तर्दुराशयः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "भीतो भव ततो धूर्ताद् यदि प्राणानपेक्षसे॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "त्वयामा हृदयं येषां विद्यते नैव सर्वथा।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "विश्वासस्तेषु नो कार्यों वदत्स्वपि प्रियं वचः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "अहो नूनं क्षणेनैव परिपन्थी प्रकाशते।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सखेव मधुरालापं कुर्वन्नपि मुहुर्मुहुः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "प्रोह्वोऽपि च रिपुनैंव विश्वास्यो दीर्घदर्शिना।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "धनुषो हि विनम्रत्वमनिष्टस्यैव सूचकम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "कृताञ्जली रुदँश्चापि प्रत्येतव्यो न वैरकृत्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "शस्त्रं संभाव्यते तस्य निगूढं करमध्यके॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "बाहृे नौति विविक्ते च घृणार्थ हसति ध्रुवम्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "बहिः संस्तुत्य तं काले मर्ढन्मित्रतां गतम्॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "संघित्सुः   [ ३ ]    खल्वरातिश्चेदशक्तश्च स्वयं बले।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सन्धिस्तेन समं कार्यः कृत्वा च भव दूरगः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    स्वर्णकारलोहकीलकम्।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    त्वामपि।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "↑    संधि कर्तुमिच्छुकः।"
    }
  ]
}