{
  "book_id": "kural-kavya",
  "chapter_id": "ch_164",
  "number": 164,
  "title": "परिच्छेदः ५२ पुरुषपरीक्षा",
  "word_count": 107,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सदसच्चोभयं वेत्ति परमाश्रयते शुभम्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "एवं यस्य मनोवृत्तिर्नियोक्तव्यः स कर्मसु॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "शासनाङ्गेषु विस्फूर्तिर्यस्यास्ति प्रतिभावलात्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "यो हर्ता च विपत्तीनां स कार्यः कार्यवाहकः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "दयावान् बुद्धिसम्पन्नः कार्येषु द्रुतनिश्चयः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "यो लोभेन विनिर्मुक्तः स कार्यों राज्यसेवकः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "ईदृशोऽपि जनाः सन्ति येषां सर्वत्र पौरुषम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "परं तेऽपि विलोक्यन्ते काले कर्तव्यविच्युताः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कार्येषु पूर्णदाक्षिण्यं शक्ति शान्तिविधायिनीम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "इति वीक्ष्यैव दातव्यं कार्य न प्रीतिमात्रतः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "मानवं योग्यतां वीक्ष्य योग्यकर्मणि योजयेत्।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "योग्यकाले च सम्प्राप्ते कार्यारम्भञ्च कारयेत्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "शक्ति कार्यञ्च वीक्षेत पूर्व भृत्यस्य भूमिपः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "पश्चात्कार्य तदायत्त   &#91; १ &#93;    विदध्याद् गतसंशयः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तत्पदायोपयुक्तोऽय यद्येवं निश्चितं त्वया।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तस्यानुरूपशोभापि तर्हि स्वच्यवशिष्यते॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "भक्त दक्षे च यो भृत्ये रुष्टो भरति भूपतिः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "नूनं तस्य भवेदेव भाग्यश्रीः परिवर्तिता॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "प्रत्यहं प्रत्यवेक्षेत भृत्यकार्याणि भूप्रभुः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "भृत्या यत्र विशुद्धा हि तद् रज्यं न विपद्यते॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    तदधीसम्"
    }
  ]
}