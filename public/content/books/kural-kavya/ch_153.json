  "number": 153,
  "title": "परिच्छेदः ४२ प्रवचनश्रवणम्",
  "word_count": 124,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "४१ शिक्षाया अवहेलना"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ४३ बुद्धिः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ४२"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "प्रवचनश्रवणम्"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "कोषेषु मूल्यवान् कोषः कर्णकोषोऽस्ति सर्वथा।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सम्पदासु च सर्वासु स श्रेष्ठो नात्र संशयः॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कर्णयोर्भधुरं पेयं प्राप्तं नैव यदा भवेत्।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कुक्षेरपि तदा तृप्त्यै दानीयं स्यात् सुभोजनम्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सूक्तयो बहवो नित्यं यः श्रुताः श्रुतशालिनाम्।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "महीतले हि ते सन्ति देवतारूपधारिणः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "नैवाधीतं श्रुतं येन शृणुयात् सोऽपि सद्वचः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "विपदां सन्निधाने हि शान्तिस्तेनैय जायते॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "धार्मिकाणां शुभा वाणी दृढयष्टिरिवाहिता।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "विपत्तिकाले सम्प्राप्ते पतनाद् या सुरक्षति॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अपि स्वल्पं महद्वाक्यं श्रोतव्यं युक्तचेतसा।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "एकाकिना यतस्तेन क्रियते भुवि मान्यता॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "समभ्यस्य श्रुतं येन स्वयञ्च मननं कृतम्।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "विस्मृत्यापि बुधः सोऽयमवाच्यं नैव भाषते॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "बधिरावेव तौ कर्णौ श्रवणक्षमतायुतौ।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अनभ्यासो ययोरस्ति श्रोतु विज्ञसुभाषितम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "न श्रुतं विदुषां येन कलापूर्ण सुभाषितम्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तस्य भाषणनैपुण्यं स्वयमेवातिदुर्लभम्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "जिह्वारसन्तु यो वेत्ति कर्णयोः किन्तु नो रसम्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "को गुणो जन्मना तस्य हानिर्वा मरणेन का॥१०॥"
    }
  ]
}