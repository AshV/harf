{
  "book_id": "kural-kavya",
  "chapter_id": "ch_186",
  "number": 186,
  "title": "परिच्छेदः ७२ श्रोतॄणां निर्णयः",
  "word_count": 96,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "चित्ते सुरुचिसम्पन्नो वाक्कलायां विशारदः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "श्रोतृभावं विदित्वादावनुरूपं वदेद् वचः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "भो भोः शब्दार्थवेत्तारः शास्तारः पुण्यमानसाः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "श्रोतॄणां हृदयं वीक्ष्य तदर्हा ब्रूत भारतीम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "श्रोतृणां प्रकृति वेत्तु' यस्य नैवास्ति पाटवम्"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "वक्तृकलानभिज्ञः स निष्कर्मा चान्यकर्मसु॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "ज्ञानचर्चा तु कर्तव्या विदुषामेव संसदि।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "मौर्ख्ये च दृष्टिमाधाय वक्तव्यं मूर्खमण्डले॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "स्यज्यते येन नेतृत्वकामना मान्यसंसदि।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "स गुणेष्पस्ति विख्यातो धन्यो वचनसंयमः।५।।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "यस्यास्ति नैव सामर्थ्य साफल्यञ्चापि भाषणे।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "न विभाति बुधाग्रे स धर्मभ्रष्टो नरो यथा॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "लोकातिशायिपाण्डित्यं विदुषां पूर्णवैभवैः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "उद्योतते सभामध्ये विदुषामेव रागिणाम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "धीमतां ननु सान्निध्ये विदुषो ज्ञानकीर्तनम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "जीविते तरुसंघाते भाति नीरनिषेकवत्॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "ध्याख्यानेन यशोलिप्सो श्रुत्वेद स्वचधार्यताम्"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विस्मृत्याग्रे न वक्तव्यं व्याख्यानं हतचेतसाम्।।९।।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "विरुद्धानां पुरस्तात्तु भाषणं विद्यते तथ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "मालिन्यदूषिते देशे यथा पीयूषपातनम्॥१०॥"
    }
  ]
}