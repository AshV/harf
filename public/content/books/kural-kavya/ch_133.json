{
  "book_id": "kural-kavya",
  "chapter_id": "ch_133",
  "number": 133,
  "title": "परिच्छेदः २४ कीर्तिः२४ कीर्तिः",
  "word_count": 106,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "दानं विश्राण्य दीनेभ्यः प्रार्जयेत् कीर्तिमुज्ज्वलाम्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कीर्तितुल्यो यतो लाभो नरस्यान्यो न विद्यते॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "प्रशंसकमुखे तेषां वर्तते नामकीर्तनम्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "यैः सदा दीयते दानं दीनेभ्यो दययान्वितैः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सर्वे भावा   [ १ ]    विनश्यन्ति भुवनत्रयवर्तिनः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अतुला केवला कीर्तिर्नरस्याहो न नश्यति॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "दिगन्तव्यापिनी येन स्थायिनी कीर्तिरर्जिता।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सम्मानयन्ति तं देवा ऋषेरपि महत्तरम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "विनाशः कीर्तिविस्कायी मृत्युश्च कीर्तिवर्द्धनः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "मध्येमार्गं समायाति महतामेव तद्द्द्वयम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नरत्वं खलु चेल्लब्धं भवितव्यं यशस्विना।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "नियोगेन त्वया मर्त्य मा भवेस्त्वं नरोऽथवा॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "न च क्रुध्यत्यहो स्वस्मै स्वयं दोषहतो नरः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "परं वैरायते साकं निन्दकैः स जडाशयः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "प्रतिष्ठाधारका नैव नूनं सन्ति नरास्तु ते।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "येषां नैव स्मृतिर्लोंके कीर्तिरूपेण विश्रुता॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अपकीर्तिमतां भारैराक्रान्तं पश्य मण्डलम्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "समृद्धमपि तत्पूर्व क्षयं याति शनैः शनैः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "निष्कलङ्कं सदा यस्य जीवनं तस्य जीवनम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "कलड्कैर्नष्टकीर्तिश्च नूनं मृतक एव सः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    पदार्था।"
    }
  ]
}