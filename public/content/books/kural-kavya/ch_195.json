{
  "book_id": "kural-kavya",
  "chapter_id": "ch_195",
  "number": 195,
  "title": "परिच्छेदः ८० सख्यार्थं योग्यतापरीक्षा",
  "word_count": 116,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अपरीक्ष्यैव मैत्री चेत् कः प्रमादो ह्यतः परः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "भद्राः प्रीति विधायादौ न तां मुश्चन्नि कर्हिचित्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अज्ञातकुलशीलानां मैत्री संकटसंहतिः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "सति प्राणक्षये यस्याः शान्तिर्भवति पूर्णतः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कथं शीलं कुलं किं कः सम्बन्धः का च योग्यता।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "इति सर्व विचार्यैव कर्तव्यो मित्रसंग्रहः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "प्रसूतिर्यस्य सद्वंशे कुकीर्तेश्च बिभेति यः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "मूल्यं दत्त्यापि तेनामा   &#91; १ &#93;    कर्तव्या खलु मित्रता॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अन्विव्यापि समं तेन मैत्री कार्या विपश्चिता।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सुमार्गाच्चलितं मित्रं यो भर्त्ययति नीतिवित्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "विपत्स्वपि महानेकः सुगुणः सर्वसम्मतः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "यदापन्मानदण्डेन ज्ञायते मित्रसंस्थितिः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अस्मिन्नेवास्ति कल्याणं नराणां सौख्यवर्द्धनम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "यन्मूर्खस्य सदा हेया मैत्री दुर्गतिकारिणी॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "औदासीन्यनिरुत्साहमृता हेया विचारकाः   &#91; २ &#93;   ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "बन्धुता सापि हातव्या विपत्तौ या पराड्मुखी॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सम्पत्तौ सह संवृद्धा विपत्तौ ये च मायिनः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "मैत्रीस्मृतिर्हि तेषानु मृत्युकालेऽपि दाहृदा॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "विशुद्धहृदयैरायः सह मैत्री विधेहि वै।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "उपयाचितदानेन   &#91; ३ &#93;    मुञ्चस्वानार्यमित्रताम्॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    सह।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    कुत्सितविचारा।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "↑    देवोपहारदानेन।"
    }
  ]
}