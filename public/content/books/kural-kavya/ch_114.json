{
  "book_id": "kural-kavya",
  "chapter_id": "ch_114",
  "number": 114,
  "title": "परिच्छेदः १०४ कृषिः",
  "word_count": 104,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "नरो गच्छतु कुत्रापि सर्वत्रान्नमपेक्षते।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तसिद्भिश्च कृषेस्तस्मात् सुभिक्षेऽपि हिताय सा॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "कृषीवला धुरा तुल्या देशरूपस्य चक्रिणः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "अकृपाणा यतः सन्ति नूनं तदुपजीविनः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "ये जीवन्ति कृषि कृत्वा ते नराः सत्यजीविनः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "परपिण्डादिनः किन्तु सर्वेऽन्ये सन्ति मानवाः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "स्निग्धच्छायासु सस्यानां क्षेत्राणि यस्य शेरते।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तद्देशीयनृपच्छत्रादधः स्युश्छत्रिणः परे॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अभिक्षुकाः परं नैव दानिनोऽप्यनिषेधकाः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "ते सन्ति ये कृषि नित्यं कुर्वते साधुमानवाः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "कृषीवलाः कृषः कार्याद् विरताश्चेत् कथश्चन।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सन्यासिनोऽपि ये जातास्तेऽपि स्युर्ववपीडिताः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "जलार्द्रा खलु चेन्मृत्स्ना शोषयेत् ता रवेः करैः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तुर्याशस्यावशेषे सा निखाद्यापि बहूर्वरा॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "कर्षणात् खाद्यदानेषु निन्द्यदानादनन्तरम्   [ १ ]   ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अम्बुसेकाच रक्षायां भवन्ति बहवो गुणाः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "यः पश्यति कृषि नैव गृहे नित्यमवस्थितः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "सुभार्येव कृषिस्तस्मै कुप्यति क्षीणदेहिका॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "भक्षणाय न मे किञ्चिदस्तीति वचनं भृशम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "वदन्तं क्रन्दमानञ्च हसत्युर्वीरमालसम्   [ २ ]   ॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    निन्द्यतृणखण्डनात्।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    पृथ्वीलक्ष्मीरलसम्।"
    }
  ]
}