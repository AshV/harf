{
  "book_id": "kural-kavya",
  "chapter_id": "ch_117",
  "number": 117,
  "title": "परिच्छेदः १०७ भिक्षाभीतिः",
  "word_count": 123,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१०६ याचना"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १०८ भ्रष्टजीवनम्   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः १०७"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "भिक्षाभीतिः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अभिक्षुको वरीवर्ति भिक्षोः कोटिगुणोदयः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "याचनास्तु वदान्ये वा निजादधिगुणे च वै॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "भिक्षया जीवनं कुर्यान् नरो यस्यैष निश्चयः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सृष्टोः स च विधातापि बम्भ्रमीतु भवै भवै॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "निर्लज्जेष्वपि निर्लज्जः सोऽस्ति कापुरुषः परः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "यो ब्रूते भिक्षया नूनं नाशयिष्ये स्वनिःस्वताम्॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "न याचते परात् किश्चिद् यो नरो निर्धनोऽपि सन्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मही तस्य कृते स्वल्पा धन्यं तस्यात्मगौरवम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "यड्भोजनं स्वपाणिभ्यामर्ज्यते श्रमपूर्वकम्।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "जलाच्चेद् द्रवीभूतं स्वादीयः किन्तु भक्षणे॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "एकोऽपि याचना शब्दो जिह्वाया निकृतिः परा।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "वरमस्तु स शब्दोऽपि पानीयार्थहि गोः कृते॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "एकं हि याचकान् याचे मा याचध्वं कदाशयान्।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अद्यश्वो ये तु कुर्वन्ति साधयन्ति न चेप्सितम्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "याचनाश दपोतस्यादातुर्वै कालयापनम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "शिलासंघातसंकाशं जायते भंगकारणम॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "भाग्यं याचनवृत्तीनां समीक्ष्यात्मा विकम्पते।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "वीक्ष्यावज्ञा पुनस्तेषां म्रियते ध्रुवमेव सः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "निलीनाः कुत्र तिष्ठन्ति प्राणास्तस्ये निषेधिनः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "धिक्कारं किन्तु श्रुत्सैव ते निर्यान्त्यर्थिनस्तनोः॥१०॥"
    }
  ]
}