{
  "book_id": "kural-kavya",
  "chapter_id": "ch_172",
  "number": 172,
  "title": "परिच्छेदः ६ गृहिणी",
  "word_count": 111,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "यस्यामस्ति सुपत्नीत्वं सैवास्ति गृहिणी सती।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "गृहस्यायमनालोच्य व्ययते न पतिव्रता॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "यदि नास्ति गृहे दैवात् पत्नी स्वगुणभूषिता।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "अन्यवैभवयोगेऽपि कष्टं गार्हस्थ्यजीवनम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "यत्र पत्नी गुणैराढ्या तत्र श्रीः सर्ववस्तुनः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "यदि पत्नी गुणैहींना त्रुटिः कस्य न वस्तुनः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पातिव्रत्यबलेनैव यदि स्त्री शक्तिशालिनी।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "ततोऽधिकः प्रभावः कः प्रतिष्ठावर्धको भुवि॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सर्वदेवान् परित्यज्य पतिदेवं नमस्यति।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "प्रातरुस्थाय या नारी तद्वश्या वारिदाः स्वयम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "आदृता पतिसेवायां रक्षणे कीर्तिधर्मयोः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अद्वितीया सतां मान्या पत्नी सा पतिदेवता॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "गुप्तस्थाननिवासेन स्त्रीणां नैव सुरक्षणम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अक्षाणां   &#91; १ &#93;    निग्रहस्तायां केवलो धर्मरक्षकः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "प्रसूते या शुभं पुत्रं लोकमान्यं विदाम्बरम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "स्तुवन्ति देवता नित्यं स्वर्गस्था अपि तां मुदा॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "यस्य गेहाद् यशोवल्ल्याः प्रसारो नैव जायते।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "उद्‌ग्रीवः सन् कथं शत्रोरग्रे सिंह इवैति   &#91; २ &#93;    सः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "विशुद्धमादृतं गेहमुत्तमो वर उच्यते।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सुसंततिस्तु माहात्म्यपराकाष्ठाप्रकाशिनी॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    इन्द्रियाणाम्,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    एति-गच्छति।"
    }
  ]
}