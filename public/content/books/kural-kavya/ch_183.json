{
  "book_id": "kural-kavya",
  "chapter_id": "ch_183",
  "number": 183,
  "title": "परिच्छेदः ७ संततिः",
  "word_count": 106,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "६ गृहिणी"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ८ प्रेम   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ७"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "संततिः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "यदि पुण्यात् कुले जन्म बुद्धिमत्याः सुसंततेः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "ततोऽधिकं परं श्रेयो न मन्येऽहं महीतले॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "निष्कलङ्का सदाचारभूषिता यस्य संततिः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सप्तजन्मसमाप्त्यन्तं नासौ पापस्य भाजनम्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "आनन्ददायिनी पुसः संततिः सत्यसम्पदा।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "निधानं प्राप्यते पुण्यैरीदृशं सुखदायकम्॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "शिशुभिर्लघुहस्ताभ्यां मथ्यते यत् सुभोजनम्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "तद्रसास्वादनं नूनं पीयूषस्वादसन्निभम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अङ्गस्पर्शो हि बालानां देहे पूर्णसुखोदयः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "निसर्गललितालापस्तेषां कर्णरसायनम्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "वेणुध्वनौ सुमाधुर्यं वीणा स्वादीयसी बहुः।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "एवं वदन्ति यैनैंव श्रुता संततिकाकिली॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "प्रजां प्रति पितुः कार्यमिदमेवावशिष्यते।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "मध्येसभं यथा स्यात् सा बुधपंक्तौ गुणादृता॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सर्वेषां जायते मोदो दृष्ट्‌वा हर्षविकासिनीम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "बुद्धिवैभवमाहात्म्यैरात्मनोऽप्यधिकां प्रजाम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "प्रकाशते सुतोत्पत्त्या मातुर्मोदस्य वारिधिः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तत्कीर्तिश्रवणात्तस्या उद्वेलः स च जायते॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "यदुदात्तां कृतिं वीक्ष्य पृच्छेयुर्जनकं जनाः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "यदीदृक् तपसा केन सुतो लब्धः स नन्दनः॥१०॥"
    }
  ]
}