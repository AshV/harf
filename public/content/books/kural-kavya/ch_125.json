{
  "book_id": "kural-kavya",
  "chapter_id": "ch_125",
  "number": 125,
  "title": "परिच्छेदः १७ ईर्ष्यात्यागः",
  "word_count": 98,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "ईर्ष्यापूर्णविचारास्तु सततं दुःखदायिनः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "मनसा ताञ्जहीहि त्वं तदभावे हि धर्मिता॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अखिलेर्ष्याविनिर्मुक्तस्वभावसदृशं पुनः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "नास्ति भद्रमहो पुंसां विस्तृते जगतीतले॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "यस्य नास्ति धने प्रीतिर्धमें चात्महितङ्करे।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "स ईर्ष्यति सदा वीक्ष्य समृद्धं प्रतिवेशिनम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "ईर्ष्याया कुरुते नैव परहानिं विचक्षणः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "ईर्ष्याजन्यविकाराणां ह्युदर्कं वेत्ति तत्त्ववित्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "ईर्ष्यैवालं विनाशाय तदाश्रयप्रदायिनः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "मुश्चेद्वा तं रिपुर्जातु नत्वीर्ष्या सर्वनाशिनी॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "परस्मै यच्छते पुसे य ईर्ष्यति नराधमः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "भृशं दुःखायते तस्य कुटुम्बं कशिपोः   [ १ ]    कृते॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "विजहाति स्वयं लक्ष्मीरीर्ष्यादूषितचेतसम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अर्पयते च तं स्वस्याः पूर्वजायै   [ २ ]   दुराशयम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अतिदुःखकरी नूनं दानवीव दरिद्रता।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "इयमीर्ष्या च तहूती नरकद्वारदर्शिनी॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "ईर्ष्यावतां समृद्धत्वं दानिनाश्च दरिद्रता।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विवेकिनां मनस्येते समाने विस्मयावहे॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "ईर्ष्यया क्वापि नो कश्चित् पुष्पितः फलितोऽथवा।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तथैवोदारचेतास्तु ताभ्यां क्वापि न वञ्चितः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    अन्नवस्त्रयों.,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    दरिद्रतायै।"
    }
  ]
}