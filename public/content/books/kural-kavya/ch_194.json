{
  "book_id": "kural-kavya",
  "chapter_id": "ch_194",
  "number": 194,
  "title": "परिच्छेदः ८ प्रेम",
  "word_count": 118,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "७ संततिः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ९ अतिथिसत्कारः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ८"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "प्रेम"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अर्गला कापि नो नूनं प्रेमद्वारनिरोधिनी।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सूच्यतेऽश्रुनिपातेन मानसे तस्य संस्थितिः॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "यो नरः प्रेमशून्यो हि स जीवत्यात्मनः कृते।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "परं प्रेमानुरक्तस्य    &#91; १ &#93;   कीकसश्च परार्थकृत्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "प्रेमामृतरसास्वादलालसोऽयं हि चेतनः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "सम्मतोऽभूत्पुनर्वद्धुं पिञ्जरेऽस्थिविनिर्मिते॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "प्रेम्णः संजायते स्नेहः स्नेहात् साधुस्वभावता।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अमूल्यं मित्रतारत्नं सूते सा स्नेहशीलता॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "यदिहास्ति परत्रापि सौभाग्यं भाग्यशालिनः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तत् स्नेहस्य पुरस्कारो विश्रुतेयं जनश्रुतिः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "साधुभिः सह कर्तव्यः प्रणयो नेतरै: समम्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "नेयं सूक्तिर्यतः स्नेहः खलस्यापि जये क्षमः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "अस्थिहीनं यथा कीटं सूर्यों दहति तेजसा।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तथा दहति धर्मश्च प्रेमशून्यं नृकीटकम्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "मरुभूमौ यदा स्थाणुर्भवेत् पल्लवसज्जितः।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तदा प्रेमविहीनोऽपि भवेद् ऋद्धिसमन्वितः॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "आत्मनो भूषणं प्रेम यस्य चित्ते न विद्यते।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "बाह्यं हि तस्य सौन्दर्य व्यर्थं रूपधनादिजम्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "जीवनं जीवनं नैव स्नेहो जीवनमुच्यते।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "प्रेमहीनो नरो नूनं मांसलिप्तास्थिसंचयः॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    अस्थि"
    }
  ]
}