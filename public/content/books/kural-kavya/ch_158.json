{
  "book_id": "kural-kavya",
  "chapter_id": "ch_158",
  "number": 158,
  "title": "परिच्छेदः ४७ समीक्ष्यकारिता",
  "word_count": 103,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "व्ययः कियान् कियॉल्लाभो हानि का भविष्यति।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "इतिपूर्व विचार्यैव कार्य कुर्वीत धीधनः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "मंत्रमंत्रिभिः सार्धं मंत्रयि वैव यो नृपः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "विदधाति स्वकार्याणि तस्यास्ति किमसम्भवम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सन्त्येवं हि बहूद्योगा ये पूर्व लाभदर्शकाः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "समूलघातका अन्ते तेषु हस्तो न धीमताम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नैवेच्छति निजात्मानं यो यातुं परिहास्यताम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "नासमीक्ष्य क्वचित् किञ्चिद् विधत्तेऽसौ विचारवान्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अयनेषु च सर्वेषु व्यूहादिस्थितिसूचिकाम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "युद्धसज्जां विना युद्धं राज्ये वैर्यभिषेचनम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "अकर्मणः समाचारान् नूनं नश्यति मानवः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कर्मणश्च परित्यागात् सत्यं नश्यति मानवः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नाविचार्य क्वचित् किंञ्चिद् विधातव्यं मनीषिणा।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "पूर्व प्रारभ्य पश्चाच्च शोचन्ति हतबुद्धयः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "सन्मार्ग यः समुत्सृज्य स्वकार्याणि चिकीर्षति।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तस्य यत्ना ध्रुवं मोघाः साहाययं प्राप्य भूर्यपि॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "उपकारोऽपि कर्तव्यः स्वभावं वीक्ष्य देहिनः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "अन्यथा स्यात् प्रमादेन यातनैव विधायिनः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "कुरु तान्येव कार्याणि यान्यनिन्द्दनि सर्वथा।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "निन्द्दकार्याद् यतः प्राणी प्रतिष्ठाभंगमाभुयात्॥१०॥"
    }
  ]
}