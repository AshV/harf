{
  "book_id": "kural-kavya",
  "chapter_id": "ch_190",
  "number": 190,
  "title": "परिच्छेदः ७६ धनोपार्जनम्",
  "word_count": 99,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "तुच्छोऽपि गुरुतां याति विश्रुतिश्चाप्यविश्रुतः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "धनेन मनुजो ह्येवं शक्तिः क्कान्यत्र दृश्यते॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "निर्धनानां हि सर्वत्र न्यक्कारः खलु जायते।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "धनिकानाञ्च सर्वत्र प्रतिपत्तिर्विवद्धते॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अविश्रान्तमहज्ज्योतिरहो वित्तं हि भूतले।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "स्थानं तमोवृतं येन ज्योत्स्नापूर्ण विधीयते॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "निर्दोषैः पापशून्यैर्यत् साधनैः प्राप्यते वसु।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "ततो वहन्ति स्रोतांसि सुखस्य सुकृतस्य च॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यद्धनं दयया रिक्तं प्रेमशून्यश्च विद्यते।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "तज्जिघृक्षा न कर्तव्या स्पर्शो वा तस्य नो वरः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "दण्डद्रव्यं मृतद्रव्यं करस्वं शुल्कजं धनम्।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "युद्धद्रव्यञ्च भूपस्य कोषसंवृद्धिहेतवः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अनुकम्पा हि भूतानां विद्यते प्रेमसंततिः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तत्पालनाय धात्र्येषा सम्पत्तिः करुणाभृता॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "गिरिशृङ्गाद् यथा निर्भाः प्रेक्षते करिणो रणम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तथा कार्य समारभ्य शङ्का नाप्नोति वित्तवान्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "यदीच्छसि रिपुं जेतुं कर्तव्यस्तर्हि संग्रहः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "द्रविणस्य यतोऽमोघं शस्त्रमेतज्जयैषिणाम्॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "येन स्वपौरुषात् पुंसा सञ्चितं हि महाधनम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "करमध्ये स्थितौ तस्य धर्मकामावुभावपि॥१०॥"
    }
  ]
}