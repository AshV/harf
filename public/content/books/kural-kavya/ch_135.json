{
  "book_id": "kural-kavya",
  "chapter_id": "ch_135",
  "number": 135,
  "title": "परिच्छेदः २६ निरामिषजीवनम्",
  "word_count": 104,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अद्यते येन मांसं हि निजमांसविवृद्धये।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "नैव संभाव्यते नूनं करुणा तस्य मानसे॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "यथा धनं न तत्पार्श्वे व्यर्थं यो व्ययते नरः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "मांसाशिनस्तथा चित्ते दयास्तित्यं न दृश्यते॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "मांसमास्वाद्यते येन निर्दयेन दुरात्मना।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "न श्रेयसि मनस्तस्य लुण्ठाकस्येव शस्त्रिण:॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "असंशयं महत् क्रौर्यं जीवानां खलु हिंसनम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "परं पापस्य घोरत्वं यन्मांसं भुज्यते जनै:॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "नियमेन मनुष्यस्य मांसत्यागे सुजीवनम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अन्यथा नरकद्वारं न निर्गन्तुमनावृतम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "यदि नैव भवेल्लोके मांसास्वादस्य कामना।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तर्हि नैव भवेल्लोके मांसस्य खलु विक्रयः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "परस्यापि विजानीयात् स्वस्येव निधने व्यथाम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सकृदेव नरो भूयो न कुर्याज्जीवहिंसनम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "मिथ्यात्वत्यजनाद् यस्य हृदयं न्यायसंगतम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "नासौ शवबुभुक्षुः स्यात् प्राणैः कण्ठगतैरपि॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "हिंसायाः पिशिताच्चैव घृणा यस्यास्ति मानसे।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "कोटियज्ञफलं नित्यं लभ्यते तेन साधुना॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "आमिषाज्जीवघाताच्च विरतिर्यस्य धीमतः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "पाणी संयोज्य सम्मानं कुरुते तस्य विष्टपम्॥१०॥"
    }
  ]
}