{
  "book_id": "kural-kavya",
  "chapter_id": "ch_184",
  "number": 184,
  "title": "परिच्छेदः ७० नृपाणां समक्षे व्यवहारः",
  "word_count": 104,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "नातिदूरसमीपस्थो नृपं सेवेत पण्डितः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "शीतबाधानिवृत्यर्थ यथाग्नि सेवते जनः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "नृपस्याभीष्टवस्तूनां लालसा स्यज दूरतः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "ततो बैभवसंप्राप्तेरेषमंत्रोऽस्त्यबाधितः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "विरागं भूपतेः प्राप्तुं यदि त्वं नैव वाञ्छसि।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मुश्च तर्हि महादोषान् यतः शङ्कास्ति दुम्त्यजा॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "राज्ञः पुरो न केनामा कर्तव्यं कर्णभाषणम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "स्मितेङ्गिते च नो कार्ये आत्मनोभूतिमिच्छता॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "निलीय शृणुयान्नैव वार्ता काञ्चिन् महीपतेः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "यत्नश्चापि न कर्तव्यस्तद्गुह्यस्याबोधने॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "कालोऽस्ति सांप्रतं कीद्दक् प्रकृतिश्चास्य कीदृशी।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "इति पूर्व समालोच्य वाचा तदनुमोदयेत्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मोदो भवति याः श्रुत्वा बाचस्ता व्याहरेन् नृपम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "यामिश्च कोऽपि लाभो न पृच्छयभानो न ता वदेत्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "बन्धुमल्पवयस्कं वा मत्वा भूप न हेडताम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "महती देवता ह्येषा नररूपेण तिष्ठति॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "निर्द्वन्द शुद्धदृष्टिर्यों लब्धभूपप्रसादकः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "न तत्कार्य स कुर्वीत रुष्टः स्याद् भूपतिर्यतः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "घनिष्ठो दृढमित्रञ्च वर्तते मम भूपतिः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "इति मत्वापकृत्ये यो रतो नूनं स नश्यति॥१०॥"
    }
  ]
}