{
  "book_id": "kural-kavya",
  "chapter_id": "ch_136",
  "number": 136,
  "title": "परिच्छेदः २७ तपः",
  "word_count": 109,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "२६ निरामिषजीवनम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        २८ धूर्तता   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः २७"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "तपः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सर्वेषामेव जीवानां हिंसाया विरतिस्तथा।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "शान्त्या हि सर्वदुखानां सहनं तप इष्यते॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तपो नूनं महत्तेजस्तेजस्विन्येव शोभते।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "निस्तेजसि तपः किन्तु निष्फलं जायते सदा॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "ऋषीणां परिचर्यार्थ केचिदावश्यका जनाः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "इतीव न तपस्यन्ति किमन्ये धर्मवत्सलाः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "रिपूणां निग्रहं कर्तुं सुहृदाञ्चाप्यनुग्रहम्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "यदीच्छा तर्हि तप्यस्व तपस्तद् द्वायसाधनम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सर्वेषामेव कामानां सुसिद्धौ साधनं तपः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अतएव तपस्यार्थं यतन्ते सर्वमानवाः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "ये कुर्वन्ति तपो भक्तथा श्रेयः कुर्वन्ति तेऽञ्जसा।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अन्ये तु लालसावद्धा आत्मनो हानिकारकाः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "यथा भवति तीक्ष्णाग्निस्तथैबोज्जवलकाश्चनम्।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तपस्येवं यथाकष्टं मनःशुद्धिस्तथैव हि॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "प्रभुत्वं वर्तते यस्य स्वस्यात्मन्येव वस्तुनि।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "सम्पूजन्ति तं सर्वे निष्कामं पुरुषोत्तमम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "शक्तिसिद्धीउभेयस्य संप्राप्ते तपसोबलात्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "मृत्योरपि जये तस्य साफल्यं दृश्यते स्फुटम्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "अतृप्ताः सन्त्यसंख्याता अभिलाषावशंवदाः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "अधिका हि तपोहीना विरलाश्च तपस्विनः॥१०॥"
    }
  ]
}