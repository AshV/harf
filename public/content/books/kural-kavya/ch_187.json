{
  "book_id": "kural-kavya",
  "chapter_id": "ch_187",
  "number": 187,
  "title": "परिच्छेदः ७३ सभायां प्रौढता",
  "word_count": 106,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "वाक्कला शिक्षिता येन सुरुच्या च समन्विता।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "स वाग्मी विदुषामग्रे सुब्रवीति च्युति बिना॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "सिद्धान्तदृढता यस्य राजते विज्ञसंसदि।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "स प्राज्ञो विदुषां मध्ये समाम्नातो विदाम्बरैः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सन्ति शूरा महेष्वासा बहवो रणकोविदाः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "विरलाः किन्तु वक्तारः सभायां लब्धकीर्तयः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "यदुपातं स्वयं ज्ञानं तद्विद्वत्सु प्रकाश्यताम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अनुपातमथज्ञानं विज्ञेभ्यः साधु शिक्ष्यताम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अधीष्वसाधुरीत्या त्वं तर्कशास्त्रमसंशयम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "न विभेति हि तर्कज्ञो भापितुं लोकसंसदि॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "कोऽर्थस्तस्य कृपाणेन शक्तिर्यस्य न विद्यते।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कि वा शास्त्रेण भीतस्य तिष्ठतो विदुषां पुरः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "श्रोतृणां पुरतो ज्ञान विभ्यतो न हि राजते।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "रणक्षेत्रे यथा खङ्गो क्लीबहस्ते न शोभते॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "विद्वद्गोष्ठयां निजज्ञानं यो हि व्याख्यातुमक्षमः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तस्य निस्सारतां याति पाण्डित्यं सर्वतोमुखम्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सन्ति ये ज्ञानिनः किन्तु स्थातु शास्त्रनिदां पुरः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "न शक्रुवन्ति ते नूनमज्ञेभ्योऽपि घृणावहाः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सभ्यानां पुरो यातुं ये भवन्ति भयान्विताः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सिद्धान्तवर्णनाशक्तास्ते श्वसन्तो मताधिकाः॥१०॥"
    }
  ]
}