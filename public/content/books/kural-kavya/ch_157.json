  "number": 157,
  "title": "परिच्छेदः ४६ कुसङ्गपरित्यागः",
  "word_count": 116,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "४५ योग्यपुरुषाणां मैत्री"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        परिच्छेदः ४७ समीक्ष्यकारिता   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ४६"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कुसङ्गपरित्यागः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "भद्रो बिभेति दुःमंगात् परः संगच्छते तथा।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अभद्रेण समं नित्यं यथा स्यात् तत्कुटुम्घभाक्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "यथाभूमौ वहत्यम्भस्तत्तथा परिवर्तते।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यादृशी संगतिस्तस्य पुरुषोऽपि तथाविधः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "बुद्धर्यद्यपि सम्बन्धो मस्तकादेव वर्तते।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "यशसः किन्तु सम्बन्धो गोष्ठया उपरि निर्भरः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "ज्ञायते हृदये वासः स्वभावस्य सदा जनैः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "परं तस्य निवासस्तु तद्गोष्ठयां यत्र स स्वयम्॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मनसः कर्मणश्चापि शुद्धेर्मूलं सुसंगतिः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तद्विशुद्धौ यतः सत्यां संशुद्धिर्जायते तयोः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "पवित्रं हृदयं यस्य संततिस्तस्य पुण्यमाक्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "यावज्जीवमसौ भद्रः समृद्धः सन् सुखायते॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "मनःशुद्धिर्मनुष्यस्य निधानं वसुधातले।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सत्संगश्च ददातीह गौरवं गुणवत्तरम्॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "आकग गुणरत्नानां स्वयं सन्ति मनीषिणः।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "सत्संगति तथाप्यते मन्यन्ते शक्तिमन्दिरम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "धर्मो गमयति स्वर्ग पुण्यात्मानं विकिल्विषम्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "धर्मप्राप्त्यै च सद्वृत्ते नियुङ्क्ते सा सुसंगतिः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "सत्संगादपरो नास्ति जनस्य परमः सखा।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "दुःसंगाच परो नास्ति हानिकर्ता महीतले॥१०॥"
    }
  ]
}