{
  "book_id": "kural-kavya",
  "chapter_id": "ch_161",
  "number": 161,
  "title": "परिच्छेदः ५ गृहस्थाश्रमः",
  "word_count": 97,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "आश्रमाः खलु चत्वारस्तेषु धन्या गृहस्थिताः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "मुख्याश्रया हि ते सन्ति भिन्नाश्रमनिवासिनाम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अनाथानां हि नाथोऽयं निर्धनानां सहायकृत्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "निराश्रितमृतानाञ्च गृहस्थः परमः सखा॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "गृहिणः पञ्च कर्माणि स्वोन्नतिर्देवपूजनम्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "बन्धुसाहाय्यमातिथ्यं पूर्वेषां कीर्तिरक्षणम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "परनिन्दाभयं यस्य बिना दानं न भोजनम्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कृतिनस्तस्य निर्बीजो वंशो नैव कदाचन॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यत्र धर्मस्य साम्राज्यं प्रेमाधिक्यञ्च दृश्यते।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "तद्‌गृहे तोषपीयूषं सफलाश्च मनोरथाः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "गृही स्वस्यैव कर्माणि पालयेद् यत्नतो यदि।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तस्य नावश्यका धर्मा भिन्नाश्रमनिवासिनाम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "धर्मेण संगतं यस्य कार्य संजायते सदा।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मुमुक्षुजनमध्ये तु स श्रेष्ठ इति कीर्तितः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "यो गृही नित्यमुद्युक्तः परेषां कार्यसाधने।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "स्वयञ्चारसम्पन्नः पूतात्मा स ऋषेरपि॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "धर्माचारौ विशेषेण नित्यं सम्बन्धमाजिनौ।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "जीवनेन गृहस्थस्य सुकीर्तिस्तस्य भूषणम्॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "विदधाति तथा कार्यं यथा यद्विहितं विधौ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "विबुधः स गृही सत्यं मान्यैरायैंः प्रकीर्तितः॥१०॥"
    }
  ]
}