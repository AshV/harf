{
  "book_id": "kural-kavya",
  "chapter_id": "ch_142",
  "number": 142,
  "title": "परिच्छेदः ३२ उपद्रवत्यागः",
  "word_count": 104,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "लोभादिदोषनिर्मुक्तो विशुद्धहृदयो नरः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "दत्ते त्रासं न कस्मैचिद् अपि कौवेरसम्पदे॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वेषबुद्धथा महत्कष्टं विधत्ते यदि दुष्टधीः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "न कुर्वते तथाप्यार्या वैरशुद्धिं विकल्मषाः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अहेतौ यो व्यथां दत्ते में तस्मै च तथैव ताम्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "दास्येऽहमिति संकल्पे दुश्चिकित्स्या विपत्तयः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अहितस्य हितं कुर्याद् हिया येन मृतो भवेत्।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "विनयार्थं हि दुष्टानामेषैव श्लाध्यपद्धतिः॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यो न वेत्ति परस्यापि स्वस्येव व्यसने व्यथाम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "कोऽर्थस्तस्य नरस्याहो तीक्ष्णयापि महाधिया॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "दुःखानि यानि भुक्तानि स्वयमेव मनीषिणा।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "परस्मै तानि नो जातु देयानीति विचिन्तयेत्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "ज्ञातभावेन कस्मैचित् स्वल्पा अपि मनोव्यथाः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "न दत्ते यस्ततः कोऽन्यः श्लाघ्यो भवति भूतले॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "यानि दुःखानि भुक्तानि स्वयमेव मुहुर्मुहुः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "न जातु तानि देयानि परस्मै सारसंग्रहः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "मध्याह्ने यद्यहो कश्चिद् वाधते प्रतिवेशिनम्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तद्दिने प्रहरादूर्ध्वं स्वयं सैव विपद्यते॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "दुष्कर्मकारिणां शीर्षमाक्रमन्त्यापदः सदा।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अपकृत्यान्यतो भद्रास्त्यजन्तीह निरन्तरम्॥१०॥"
    }
  ]
}