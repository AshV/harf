{
  "book_id": "kural-kavya",
  "chapter_id": "ch_162",
  "number": 162,
  "title": "परिच्छेदः ५० स्थानविचारः",
  "word_count": 113,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "असमीक्ष्य बुधः न कार्य नापि विग्रहम्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "विदधाति तथा नैव क्षुद्रकं मन्यते रिपुम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "आस्तां नरो महाशूरो रणकर्मणि कोविदः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "दुर्गाश्रयस्तु तस्यापि नूनमावश्यको मतः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "योग्यस्थानं विनिश्चित्य यो युध्यति सुयुक्तितः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "दुर्वलोऽपि बलिष्ठारिं जयति ध्रुवमेव सः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "दृढभूमिं समाश्रित्य ये युध्यन्ति सुशस्विणः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "व्यर्था भवन्ति संकल्पाः सर्वेषामेव तद्विषाम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "मकरो हि पयोराशौ पञ्चास्य   &#91; १ &#93;    इव भीतिदः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "जलाद्वहिः स एवास्ति क्रीडावस्तु स्ववैरिणाम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "रथोहि दृढचक्रोपि समुद्रे नाभिगच्छति।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "समुद्रयायी पोतश्च स्थलगामी न जायते॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कार्य पूर्व विनिर्धार्य सुक्षेत्रे यस्य विक्रमः।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तस्यारिविजये नास्ति परापेक्षा महीपतेः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "दृद्धसैन्यविहीनोऽपि सुस्थान प्रामुयाद् यदि।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "विफलास्तर्हि बोद्धव्या उपायास्तस्य चैरिणाम् ८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "असत्यपि सुरक्षायाः साधनेऽन्नादिवस्तुन।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "स्वदेशे हि जनाः सर्वे दुर्जय्याः खलु चैरिणाम्।।९।।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "निर्निमेषं रणे येन प्रहाराः कुन्तधारिणाम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सोढाः स एव सानाह्यः   &#91; २ &#93;    पंके क्रोष्ट्रा विजीयते॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    सिंह।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    रणगज।"
    }
  ]
}