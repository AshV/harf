{
  "book_id": "kural-kavya",
  "chapter_id": "ch_179",
  "number": 179,
  "title": "परिच्छेदः ६६ शुभाचरणम्",
  "word_count": 96,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "मित्रत्वेन समायाति साफल्यं सर्ववस्तुषु।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "शुभाचरणवृत्तिस्तु नूनं सर्वत्र कामसू:॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "यतो न जायते कीर्तिर्लाभिश्चापि शुभोदयः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "वैमुख्यमेव सुश्रेयस्ततोऽस्ति हितकारकम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अभ्युदयं सदाराध्यं यदि लोके समीहसे।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "ततकार्य तर्हि हातव्यं येन कीर्तिर्विहन्यते॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "विपत्कालेऽपि येषान्तु वस्तुयाथार्थ्यनिर्णयः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कुर्वन्ति नैव ते कर्म छुद्रं कीर्तिविराधकम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "किं कृतन्नु मयाधेति पश्चात्तापविधायकम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "कार्यं नैव सुधीः कुर्यात् कृतं नाम्रेडित पुनः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "विगर्हितानि सन्तीह यानि कार्याणि साधुभिः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जनन्या अपि रक्षार्थ तानि कुर्यान्न जातुचित्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "शुभाचारवतः पुसो दारिद्रथयमपि राजते।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "नत्वाचारविहीनस्य वैभवं धर्मवर्जितम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "निषिद्धान्यपि कार्याणि यो नरो नैव मुश्चति।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "सफलस्यापि तस्याहो निर्बृतिर्नैव मानसे॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "विलापैरर्जिता लक्ष्मीः क्रन्दनैः सह नश्यति।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "धर्मेण सञ्चिता सम्पन् मध्ये क्षीणापि वृद्धये॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "आमकुम्भे भृतं नीरं यथैवास्ति निरर्थकम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "तथैव सश्चितं वित्तं मायया परवञ्चनात्॥१०॥"
    }
  ]
}