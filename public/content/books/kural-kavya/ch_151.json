{
  "book_id": "kural-kavya",
  "chapter_id": "ch_151",
  "number": 151,
  "title": "परिच्छेदः ४० शिक्षा",
  "word_count": 93,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अधिगम्यं हि यज्ज्ञानं सामस्त्येन तदर्जयेत्।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "आचरेच्च तथा नित्यं विद्याप्राप्तेरनन्तरम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वे चक्षुषी मनुष्याणां जातेर्जीवितजागृते।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "एकं वर्णसमाम्नायो द्वितीयञ्चाङ्कसंग्रहः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "यः शिक्षितः स एवास्ति चक्षुष्मानिह भूतले।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अन्येषान्तु मुखे नूनमस्ति गर्तद्वयाकृतिः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सहैव नयते मोई विद्वान् यत्रापि गच्छति।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "प्रमोदोऽपि ततो याति यतश्चायं निवर्तते॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "न्यक्कृतोऽपि भवञ्शिष्टैधनिकैरिव भिक्षुकः।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "प्रयत्नेन पठेद् विद्यां ह्यधमा ज्ञानदूरगाः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "तावदेव जलं भूरि यावत् स्रोतो निखन्यते।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "एवञ्च तावती विद्या यावती सा हि पठ्यते॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "सर्वत्र विदुषां गेहं स्वदेशश्च महीतलम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "यावज्जीवं पुनर्मात्र्याः कथं न ज्ञानरागिणः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "एकजन्मनि यज्ज्ञानं गृहीतं देहधारिणा।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "उन्नतं तत् करोतीह जीवमागामिजन्मसु॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "इयं विद्या यथा मेऽस्ति पुष्कलानन्ददायिनी।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तथैवेयं परस्यापि सुप्रियातो बुधस्य सा॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "मनुष्याणां कृते ज्ञानमविनाशी महानिधिः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "दोषत्रुटिविहीनञ्च यस्मादन्यन्न वैभवम्॥१०॥"
    }
  ]
}