{
  "book_id": "kural-kavya",
  "chapter_id": "ch_140",
  "number": 140,
  "title": "परिच्छेदः ३० सत्यभाषणम्",
  "word_count": 100,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "यस्मान्न जायते पीड़ा कस्यापि प्राणधारिणः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तदेव वचनं सत्यं भाषितं मुनिपुङ्गवै:॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "संकटाकीर्णजीवानामुद्धारकरणेच्छया।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "कथिता साधुभिर्जातु मृषोक्तिरमृषैव सा॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "मृषात्वं यस्य विज्ञातं मनसा यदि धीमता।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "तद्वचो न प्रयोक्तव्यमनुतापोऽन्यथा भवेत्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सत्यव्रतेन यस्यास्ति पवित्रं मानसं सदा।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "प्रभुत्वं वर्तते तस्य सर्वेषामेव मानसे॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सत्ये शाश्वतकल्याणे निमग्नं यस्य मानसम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "ऋषिभ्यः स महान् नूनं दानिभ्यश्च वरो मतः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "अतः परा च का कीर्तिर्यन्मृषासौ न भाषते।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "एवं विधो नरो नूनं विना क्लेशेन सिद्धिभाक्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "न वक्तव्यं न वक्तव्यं मृषावाक्यं कदाचन।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सत्यमेव परो धर्मः किं परैर्धर्मसाधनैः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "विमलैः सलिलैर्यद्वद् गात्रं शुद्धयति देहिनाम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "एवमेव मनुष्याणां मानसं सत्यभाषणैः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अन्यान् सर्वविधान्नैव प्रकाशान् मन्यते सुधीः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "सत्यमेव परं ज्योतिर्विजानाति विशुद्धधीः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "बहुवस्तूनि दृष्टानि तत्रैकं सारवत्तरम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "इदमेव मया ज्ञातं यत्सत्यं परमोत्तमम्॥१०॥"
    }
  ]
}