{
  "book_id": "kural-kavya",
  "chapter_id": "ch_171",
  "number": 171,
  "title": "परिच्छेदः ५९ गुप्तचरः",
  "word_count": 110,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "५८ चारुशीलम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ६० उत्साहः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ५९"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "गुप्तचर:"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "नेत्रद्वयेन भूपालो वीक्षते राज्यसंस्थितिम्।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "राजनीतिस्तु तत्रैकं द्वितीयं चरसंज्ञकम्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "भूपतेरितिकर्तव्ये कर्तव्योऽयं विनिश्चितः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "केषाश्चिञ्चरितं पश्येत् प्रत्यहं चरचक्षुषा॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "न वेत्ति घटनाचक्रं चारैर्दूतैश्च यो निजैः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "स शक्तोऽपि दिशो जेतुं न शक्नोति महीपतिः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "रिपूणां राजभृत्यानां बान्धवानाञ्च भूपतिः।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "गति मतिश्च विज्ञातुं नियुञ्जीत 'चरं' सदा॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "आकृतिर्यस्य नुर्नास्ति   &#91; १ &#93;    क्वापि सन्देहकारिणी।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "वाग्मी निगूढभावश्च स चरो गुणवत्तरः॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "वर्णितापसवेशेषु स्त्रान्तर्भावं निगृहयन्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "येन केनापि यत्नेन स्वकार्यं साधयेश्वरः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "परमर्मसमादाने निपुणो यो निसर्गतः।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "यस्य कार्यमसंदिग्धं शुद्धञ्चासौ चरो मतः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अपरस्यावसर्पस्य तारशीमेब सूचनाम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "प्राप्य पूर्वचरस्थोक्तौ कुर्यात् प्रामाण्यनिर्णयम्॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "परस्परमजानन्तः स्पशाः कुर्युः समीहितम्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "त्रयाणामेकवाक्ये तु सत्यं बुध्येत भूपतिः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "न हि स्वराज्यचाराणां पुरस्कार प्रकाशयेत्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "अन्यथाकरणे राज्ञा राज्यमेव प्रकाश्यते॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "↑    नरस्य।"
    }
  ]
}