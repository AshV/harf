{
  "book_id": "kural-kavya",
  "chapter_id": "ch_146",
  "number": 146,
  "title": "परिच्छेदः ३६ सत्यस्यानुभूतिः",
  "word_count": 108,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "३५ त्यागः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ३७ कामनाया दमनम   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ३६"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सत्यस्यानुभूतिः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अनित्ये खलु संसारे किञ्चित् सत्यं न विद्यते।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सत्यं पश्यन्ति ये तत्र तेषां दुःखितजीवनम्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "मिथ्याभावविनिर्मुक्त आत्मदृष्टिश्च यो नरः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "दुःखमोहौ समुच्छिद्य स शान्तिमधिगच्छति॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "असत्यं यः परित्यज्य लभते सत्यदीपकम्।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "तत्कृतेऽतिसमीपस्थ: स्वर्गो भूवलयादपि॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "यद्यात्मन् शाश्वतं सत्यमनुभूतं न जातुचित्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नरयोनौ तदा जन्मग्रहणेनापि को गुणः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "इयानेवात्र सत्यांशः शेषस्तत्प्रत्यनीकभाक्।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "इदमेव परिज्ञानं मेधाया वरलक्षणम्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "येन सत्यमभिज्ञातं स्वाध्यायतपसोर्बलात्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "स धन्यो याति तद्धाम यद्‌गत्वा न निवर्तते॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "ध्यानप्रभृतियोगाङ्गैर्येन सत्यं समर्जितम्।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "भाविजन्मसमादाने का चिन्ता तस्य योगिनः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अविद्या भवरोगस्य जननी सर्वदेहिनाम्।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तन्मुक्तया सह चित्प्राप्तिरेषैव प्राज्ञता परा॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "मोक्षमार्गस्य यो ज्ञाता मोहारेश्च जयोद्यतः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तस्य भावीनि दुःखानि यान्ति शान्तिमयत्नतः॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "कामः क्रोधस्तथा मोहो यथा स्युः क्षीणशक्तिकाः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "तथानुगामिदुःखानि क्षीयन्तेऽधिकमात्रया॥१०॥"
    }
  ]
}