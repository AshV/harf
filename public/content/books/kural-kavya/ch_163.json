{
  "book_id": "kural-kavya",
  "chapter_id": "ch_163",
  "number": 163,
  "title": "परिच्छेदः ५१ उपयुक्तपरीक्षा",
  "word_count": 104,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अर्थों धर्मश्च कामश्च प्राणानां भयमेव च।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "उपयुक्तपरीक्षार्थ   [ १ ]    चतस्रो   [ २ ]    निकषा मताः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अप्रतिष्ठाभयं यस्य निर्दोषः कुलजस्तथा।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "स एव पुरुषो योग्यस्त्वत्सेवार्थ महीपते॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "ज्ञानविज्ञानसम्पन्नो यतिकल्पोऽपि यो नरः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सोऽप्यनवधक्रियो नास्ति विचारे सति तत्वतः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नरस्य सद्गुणान् पश्य दोषानपि तथैव च।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अधिकाः सन्ति ये तेषु प्रकृतिस्तस्य तादृशी॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "वर्तते किमसी क्षुद्रः किनु वायमुदारधी।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "इति वेत्तु नरः पश्येदाचार निकषोपमम्॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "असमीक्ष्य न कर्तव्यो विश्वासो निष्कुटुम्बिनः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "एकाकिनो यतस्तस्य मोहलाविहीनता॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मूद कार्यविधेः शून्यं यः करोति स्वमंत्रदम्।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "केवलं प्रीतिमात्रेण स नृपो विपदां पदम्॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अपरीक्षितविश्वासं कुरुते यो हि मानवः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "स संततिकृते दुःखबीजानि बपति ध्रुवम्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "परीक्षितस्य विश्वासः कर्तव्यो हष्टचेतसा।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "परीक्षिताय तद्योग्यं कार्य देयं नृपालकैः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अज्ञातकुलशीलस्य विश्वासो भयदायकः।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "एवं विज्ञातशीलस्याप्रत्ययो   [ ३ ]    दुःखकारकः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    राज्यपदाभिलाषिन।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    उपधा।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "↑    अविश्वास.।"
    }
  ]
}