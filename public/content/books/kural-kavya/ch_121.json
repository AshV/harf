{
  "book_id": "kural-kavya",
  "chapter_id": "ch_121",
  "number": 121,
  "title": "परिच्छेदः १३ संयमः",
  "word_count": 99,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "इन्द्रियाणां निरोधेन लभ्यते त्रिदशालयः।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "[ १ ]   घण्टापथस्तु विज्ञेयो रौरवार्थमसंयमः॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "संयमोऽपि सदा रक्ष्यो निजकोषसमो बुधैः।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "ततोऽधिकं यतो नास्ति निधानं जीवने परम्॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सम्यग्बोधन यः प्राज्ञः करोतीच्छानिरोधनम्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मेधादिसर्वकल्याणं प्राप्स्यते स सदाशयः॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "इन्द्रियाणां जयो यस्य कर्तव्येषु च शूरता।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "पर्वतादधिकस्तस्व प्रभावो वर्तते भुवि॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "नम्रता वर्तते नूनं सर्वेषामेव भूषणम्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "पूर्णाशैः शोभते किन्तु धनिके विनयान्विते॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "संयम्य करणग्रामं कूर्मोऽङ्गानीव यो नरः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "वर्तते तेन कोशो हि संचितो भाविजन्मने॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अन्येषां विजयो माऽस्तु संयतां रसनां कुरु।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "असंयता यतो जिह्वा बह्वपायैरधिष्ठिता॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "एकमेव पदं वाण्यामस्ति चेन्मर्मघातकम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "विनष्टास्तर्हि विज्ञेया उपकाराः पुराकृताः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "दग्धमङ्गं पुनः साधु जायते कालपाकतः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "कालपाकमपि प्राप्य न प्ररोहति वाक्क्षतम्॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "पश्य मर्त्यं जितस्त्रान्तं विद्यावन्तं सुमेधसम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "यद्दर्शनाय तद्गेहमेतो   [ २ ]    धर्मित्वसाधुते॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    राजमार्ग,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "↑    आगच्छत."
    }
  ]
}