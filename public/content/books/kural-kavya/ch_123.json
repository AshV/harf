  "number": 123,
  "title": "परिच्छेदः १५ परस्त्रीत्यागः",
  "word_count": 120,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१४ सदाचारः"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        १६ क्षमा   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः १५"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "परस्त्रीत्यागः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "रूपलावण्यसंव्याप्तदेहयष्टिजुषामपि।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नासौ रागी परस्त्रीणां धने धर्मे च यस्य धीः॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "नास्ति तस्मात् परो मूखों यो द्वारं प्रतिवेशिनः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "वीक्षते पापबुद्धया स स्वधर्मात् पतितो जनः॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "असंशयं मुखे मृत्योस्ते तिष्ठन्ति नराधमाः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "असन्देहवतः सख्युर्गृहं यैरभिगम्यते॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कोऽर्थस्तस्य महत्त्वेन रमते यः परस्त्रियाम्।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "व्यभिचारात् समुत्पन्ना लज्जा येन च हेलिता॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "आश्लिष्यति गले यश्च सुलभां प्रतिवेशिनीम्।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अङ्कमारोप्य तेनैव दूषितं निजनामकम्॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "चत्वारो नैव मुञ्चन्ति व्यभिचारिजनं सदा।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "घृणा पापानि भ्रान्तिश्च कलङ्केन समन्विताः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विरक्तः प्रतिवेशिन्या रूपलावण्यसम्पदि।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "स एव सद्गृही सत्यं कुलजाचारपालकः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "नैवेक्षते परस्त्रीं यः पुंस्त्वं तस्य जयत्यहो।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "न परं तत्र धर्मित्वं महात्मा स हि भूतले॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "बाहुपाशे न यो धत्ते कण्ठाश्लिष्टां पराङ्गनाम्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "भोक्ता स एव सर्वेषां श्रेयसां भूमिवर्तिनाम्॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "वरमन्यत्कृतं पापमपराधोऽपि वा वरम्।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "परं न साध्वी त्वत्पक्षे कांक्षिता प्रतिवेशिनी॥१०॥"
    }
  ]
}