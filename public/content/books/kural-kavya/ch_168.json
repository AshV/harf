{
  "book_id": "kural-kavya",
  "chapter_id": "ch_168",
  "number": 168,
  "title": "परिच्छेदः ५६ अत्याचारः",
  "word_count": 122,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "५५ न्यायशासनम्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ५७ भयप्रदकृत्यत्यागः   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ५६"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अत्याचारः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "यः प्रजा बाधते नित्यमत्याचारपरायणः।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "शासकोऽसौ न राजास्ति सोऽधमः किन्तु धातकात्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "शासनं यस्य हस्तेऽरित विनम्रमपि तद्वचः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "देहि सर्वं न किञ्चित्ते लुण्टाकस्य वचोनिभम्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "राज्ये शासनचक्रं यो नृपो नित्यं न वीक्षते।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "न मार्ष्टिं च त्रुटीः सर्वाः प्रभुत्वं तस्य क्षीयते॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अहो तस्मिन् महाशोको निर्विचारे नरेश्वरे।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "न्यायादपैति यस्तस्य राज्यं वित्तश्च नश्यति॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "असंशयं नृपान्यायत्रस्तानामश्रुविन्दवः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "वाहयन्ति तदीयां हि समृद्धिं सकलामपि॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "यशसा भूष्यते भूपो यदि न्यायेन शासनम्।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अकीर्त्या दृष्यते सैव यद्यन्यायेन शासनम्॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "या दशा जायते क्षोण्या वर्षाशून्ये नमस्तले।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सा दशा सर्वभूतानां राज्ये निर्दयभूपतेः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अन्यायिनो महीपस्य राज्ये सर्वेऽपि दुःखिनः।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "परा हि दुर्दशा तेषु धनिनां सर्वतोऽधिका॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "उच्चरते यदा दोषाद्धर्म न्यायञ्च भूपतिः।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "योग्यकालेऽपि तद्रराज्ये जायतेऽवग्रहस्तदा॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "न्याय्यं हि शासनं जह्याद् यदि राजा स्त्रदोषतः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "धेनुस्तन्यविलोपः स्याद् द्विजविद्या च विस्मृता॥१०॥"
    }
  ]
}