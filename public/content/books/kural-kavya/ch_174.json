{
  "book_id": "kural-kavya",
  "chapter_id": "ch_174",
  "number": 174,
  "title": "परिच्छेदः ६१ आलस्यत्यागः",
  "word_count": 97,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "आलस्यं कुत्सितो वायुः पिण्डाघातेन यस्य हा।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "लुप्यते राजवंशस्याखण्डज्योतिर्धरातलात्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अयमालस्यवानित्थं भाषन्तां मानवा वरम्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "किन्त्वालस्यं स्वयं बुद्ध्वा हेयं वंशोनिनीषुणा॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "घातकं रोचते यस्मा आलस्यं पश्य तं जडम्।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सह्यभागी स्वयं पश्येजीवन्नेव कुलक्षयम्॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "आलस्यादुच्चकार्येषु येषां हस्तो न वर्तते।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तद्गृहं क्षीणता प्राप्य सङ्कटेषु पतिष्यति॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कालस्य यापनं निद्रा शैथिल्यं विस्मृतिस्तथा।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "उत्सवस्य महानावः सन्त्येता हतमागिनः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "आलस्यर्निरतो लोकः कृपां लब्ध्वापि भूपतेः।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कर्तुं समुन्नति नैव शक्नोति जगतीतले॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "येषामुदात्तकार्येषु व्यापारो नास्ति हस्तयो।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "न्यकारं वा घृणां नित्यं सहन्ते ते प्रमादिनः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "आलस्यमन्दिरं लोके जायते यत्कुटुम्बकम्।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "विपद्यते सपत्नानां क्षिप्रमेव करेषु तत्॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "विपदुन्मुखोऽपि लोकोऽयं चेत् स्याद् विगतालसः।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "स्तभ्नन्ति तर्हि तत्रैवायान्तोऽपि क्रूरसंकटाः॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "यो न वेत्ति महीपाल आलस्य नित्यकर्मयुक्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "त्रैक्रमैर्मितां पादैः स शास्ति सकलामिलाम्॥१०॥"
    }
  ]
}