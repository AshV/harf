{
  "book_id": "kural-kavya",
  "chapter_id": "ch_109",
  "number": 109,
  "title": "परिच्छेदः १० मधुरभाषणम्",
  "word_count": 100,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सुस्निग्धा मधुरा नूनं सतां भवति भारती।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अकृत्रिमा दयायुक्ता पूर्णसद्भावसंभृता॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "प्रियवाण्यां सुवात्सल्ये स्निग्धदृष्टौं च यद्विधम्।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "माधुर्य दृश्यते तद्वद् बृहद्दानेऽपि नेक्ष्यते॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "स्नेहपूर्णा दयादृष्टिर्हार्दिकी या च वाक्सूधा।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "एतयोरेव मध्ये तु धर्मों वसति सर्वदा॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "वचनानि रसाढ्यानि यस्याह्लादकराणि सः।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कदाचिल्लभते भैव दारिद्रयं दुःखबर्द्धनम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "भूषणे द्वे मनुष्यस्य नम्रताप्रियभाषणे।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अन्यद्धि भूषणं शिष्टैनदृितं सभ्यसंसदि॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "यदि ते मानसं शुद्धं वाणी चान्यहितड्करी।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "धर्मवृद्धया समं तर्हि विज्ञेयः पापसंक्षयः॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "सेवाभावसमायुक्तं विनम्रवचनं सदा।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "विश्वं करोति मित्रं हि सन्त्यन्येऽपि महागुणाः॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "शब्दाः सहृदयै: श्लाध्याः क्षुद्रतारहिताश्च ये।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "कुर्वन्ति ते हि कल्याणमिहामुत्र च भाषिणः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "श्रुतिप्रियोक्तिमाधुर्यमवगम्यापि ना   [ १ ]    कथम्।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "न मुश्चति दुरालाप किमाश्चर्यमतः परम्॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "विहाय मधुरालापं कटूक्तिं योऽथ भाषते।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अपक्कं हि फलं भुङ्क्ते परिपक्कं विमुच्य सः॥१०॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "↑    नर.।"
    }
  ]
}