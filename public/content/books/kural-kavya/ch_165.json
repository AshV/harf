{
  "book_id": "kural-kavya",
  "chapter_id": "ch_165",
  "number": 165,
  "title": "परिच्छेदः ५३ बन्धुता",
  "word_count": 105,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "एकैव बन्धुता यत्र स्नेहस्थैर्य विलोक्यते।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अन्यथा विपदां चक्रे क्व च तस्यास्ति दर्शनम्॥१॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "गुणाढ्ये यत्र बन्धूनां स्नेहो नैवापचीयते।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "तस्य भाग्यवतो वृद्धे: कोऽपि नास्ति निरोधकः॥२॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "भूत्वा सहृदयो येन बन्धुस्नेहो न लभ्यते।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "तथैव विद्यते सोऽयं निराधारं सरो यथा॥३॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "वैभवस्य किमुद्देशः किं फलं वाथ विद्यते।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सम्बन्धिनां समाह्वानं प्रतिपत्त्या च मोहनम्॥४॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "वाण्यां यस्यातिमाधुर्यमौदार्यश्च करे तथा।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "तस्य गेहं समायान्ति बन्धवो बद्धपंक्तयः॥५॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "सार्वं यस्यामितं दानं क्रोधशून्यञ्च जीवनम्।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "लोकबन्धुः स एवास्ति पश्यान्विष्य महीतलम्॥६॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "काको भक्ष्यं यथा स्वार्थाद् बन्धुभ्यो न निगूहते।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "एवं हि प्रकृतिर्यस्य वैभव तस्य सद्मनि॥७॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "राजा यथागुणं बन्धून् सत्कुर्याद् गुणरागतः।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "अन्यथा बहवः सन्ति स्वस्वत्वामर्षिणो जनाः॥८॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "विरागहेतोः संत्यागादपरागोऽपि हीयते।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "एवं चित्तविशुद्धया तु गताप्यायाति बन्धुता॥९॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "त्यक्तस्नेहोऽपि बन्धुश्चेद् भूयोऽप्ययाति बन्धुताम्।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सहर्षो मिलतेनामा धृत्वा किन्तु सतर्कताम्॥१०॥"
    }
  ]
}