  "number": 159,
  "title": "परिच्छेदः ४८ शक्तेर्विमर्शः",
  "word_count": 117,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "४७ समीक्ष्यकारिता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कुरल-काव्य"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     तिरुवल्लुवर    , अनुवादक     पं० गोविन्दराय जैन        ४९ अवसरसमीक्षा   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "परिच्छेदः ४८"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "शक्तेर्विमर्शः"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "पूर्व संचिन्त्य विध्नौघान् शक्ति स्वस्य परस्य च।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सध्रीचस्तब्दलञ्चापि दृष्ट्वा कुर्वीत वाञ्छितम्॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "यथायोग्यकृताभ्यासः स्वशक्ते: पूर्णवेदकः।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अनुगामी च यो बुद्धस्तस्य यानं जयोन्मुखम्॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "स्वं शक्तावधिकम्मन्या बभूवुर्बहवो नृपाः।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "स्वशक्तरधिकं कार्य ते प्रारभ्य क्षयं गताः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अहङ्कारविमूढात्मा ज्ञानशून्यो बलाबले।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "शान्तिजीवी च यो नास्ति त्रय एते विनाशिनः॥४॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "बहूनामप्यसाराणां समवायो हि दुर्जयः।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "केकिपत्रैर्यतः प्राज्य रथभंगो विधीयते॥५॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "शक्तिं समीक्ष्य भावावां क्रियां कुर्वीत पण्डितः।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अधियानं हि नाशाय तरोः शिखरवर्तिनः॥६॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विभवं स्वस्य संवीक्ष्य कर्तव्यमतिसर्जनम्।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अनुरूपं बुधैरेष योगक्षेमविधिः शुभः॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "संकीर्णापि न चिन्त्यास्ति लोके पूरकनालिका।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "व्ययनाली न विस्तीर्णा यद्यस्ति गृहिणो गृहे॥८॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "यस्यायव्यययोनास्ति लेखो नापि विचारणा।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "कार्यात्पूर्व स्वशक्तेश्च तन्नामापि न शिष्यते॥९॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "यः स्ववित्तमनालोच्य व्ययते मुक्तहस्तकः।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "अविलम्बं क्षयं याति विपुलं तस्य वैभवम्॥१०॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "१. सापकाम्। २. प्रधुरैः।"
    }
  ]
}