{
  "book_id": "mansarovar-2",
  "chapter_id": "ch_16",
  "number": 16,
  "title": "२४ जादू",
  "word_count": 618,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "नीला-तुमने उसे क्यों पत्र लिखा ?"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "मीना-किसको ?"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "'उसीको ?"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "'मैं नहीं समझी।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "'खूब समझती हो। जिस आदमी ने मेरा अपमान किया, गली-गली मेरा नाम बेचता फिरा, उसे तुम मुँह लगाती हो, क्या यह उचित है ?'"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "'तुम गलत कहती हो।'"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "'तुमने उसे खत नहीं लिखा?'"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "'कभी नहीं।'"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "'तो मेरी गलती, क्षमा करो। तुम मेरी बहन न होती, तो मैं तुमसे यह सवाल भी न पूछती।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "'मैंने किसीको खत नहीं लिखा ।'"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "'मुझे यह सुनकर खुशी हुई।'"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "'तुम मुसकिराती क्यों हो?"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "'मैं।'"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "'जी हाँ, आप।'"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "'मैं तो ज़रा भी नहीं मुसकिराई।'"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "'क्या मैं अन्धी हूँ?"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "'यह तो तुम अपने मुँह से ही कहती हो।'"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "'तुम क्यों मुसकिराई?'"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "'मैं सच कहती हूँ, ज़रा भी नहीं मुसकिराई ।'"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "'मैंने अपनी आंखों देखा।'       'अब मैं कैसे तुम्हें विश्वास दिलाऊँ ।'"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "'तुम आंखों में धूल झोंकती हो।'"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "'अच्छा मुसकिराई ! बस, या जान लोगी।'"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "'तुम्हे किसी के ऊपर मुसकिराने का क्या अधिकार है ?'"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "'तेरे पैरो पड़ती हूँ नीला, मेरा गला छोड़ दे। मैं बिलकुल नहीं मुसकिराई।'"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "'मैं ऐसी अनीली नहीं हूँ।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "'यह मैं जानती हूँ।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "'तुमने मुझे हमेशा झूठी समझा है।'"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "'तू आज किसका मुंह देखकर उठी है ?'"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "'तुम्हारा।'"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "'तू मुझे थोड़ा सखिया क्यों नहीं दे देती ?'"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "'हां, मैं तो हत्यारिन हूँ ही।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "'मैं तो नहीं कहती।'"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "'अब और कैसे कहोगी, क्या ढोल बजाकर । मैं हत्यारिन हूँ, मदमाती हूँ, दीदा दिलेर हूँ , तुम सर्वगुणागरी हो, सती हो, सावित्री हो । अब खुश हुई ।'"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "'लो कहती हूँ, मैंने उन्हें पत्र लिखा, फिर तुमसे मतलब ? तुम कौन होती हो मुम्से जवाब तलब करनेवाली ?'"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "'अच्छा किया लिखा, सचमुच मेरी बेवकूफी थी कि मैंने तुमसे पूछा ।'"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "'हमारी खुशी, हम जिसको चाहेगे खत लिखेंगे, जिससे चाहेगे बोलेंगे, तुम कौन होती हो रोकनेवाली ? तुमसे तो मैं नहीं पूछने जाती, हालांकि रोज़ तुम्हे पुलिन्दों पत्र लिखते देखती हूँ।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "'जब तुमने शर्म ही भून खाई, तो जो चाहो करो, अख्तियार है।'"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "'और तुम कबसे बड़ी लज्जावती बन गई ? सोचती होगी अम्मा से कह दूंगी, यहाँ इसकी परवाह नहीं है । मैंने उन्हे पत्र भी लिखा, उनसे पार्क में मिली भी, बात- चीत भी की, जाकर अम्मा से, दादा से और सारे महल्ले से कह दो।'"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "'जो जैसा करेगा, आप भोगेगा, मैं क्यो किसीसे कहने जाऊँ।'"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "'ओ हो, बड़ी धैर्यवाली, यह क्यों नहीं कहती, अंगूर खट्टे हैं।'"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "'जो तुम कहो वही ठीक ।'       'दिल मे जली जाती हो ।'"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "'मेरी बला जले।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "'रो दो जरा।'"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "'तुम खुद रोओ, मेरा अंगूठा रोये।'"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "'मुझे उन्होंने एक रिस्टवाच भेंट दी है, दिखाऊँ ?'"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "'मुबारक हो, मेरी आँखों का सनीचर न दूर होगा।'"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "'मैं कहती हूँ, तुम इतनी जलती क्यो हो ?'"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "'अगर मैं तुझसे जलती है, तो मेरी आँखें पट्टम हो जायें ।'"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "'तुम जितनी ही जलोगी, मैं उतनी ही जलाऊँगी।'"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "'मैं जलूगी ही नहीं ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "'जल रही हो साफ।'"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "'कब सन्देश आयेगा ?'"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "'जल मरो।'"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "'पहले तेरी भाँवरें देख लें।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "'भाँवरों की चाट तुम्हींको रहती है।'"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "'अच्छा । तो क्या बिना भांवरो का ब्याह होगा?'"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "'यह ढकोसले तुम्हे मुबारक रहे, मेरे लिए प्रेम काफी है।'"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "'तो क्या तू सचमुच :......\""
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "'मैं किसीसे नहीं डरती।'"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "'यहाँ तक नौवत पहुँच गई ! और तू कह रही थी, मैंने उसे पत्र नहीं लिखा और कसमें खा रही थी।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "'क्यों अपने दिल का हाल बतलाऊँ?'"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "'मैं तो तुमसे पूछती न थी , मगर तू आप-ही-आप बक चली।'"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "'तुम मुसकिराई क्यों ?"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "'इसलिए कि वह शैतान तुम्हारे साथ भी वही दग्गा करेगा, जो उसने मेरे साथ किया और फिर तुम्हारे विषय में भी वैसी ही बातें कहता फिरेगा। और फिर तुम भी मेरी तरह उसके नाम को रोओगी।'"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "'तुमसे उन्हें प्रेम नहीं था ?'       'मुझसे ! मेरे पैरो पर सिर रखकर रोता था, और कहता था, मैं मर जाऊँगा और जहर खा लूँगा।'"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "'सच कहती हो?"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "'विलकुल सच।'"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "'यही तो वह मुझसे भी कहते हैं।'"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "'सच?'"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "'तुम्हारे सिर की कसम ।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "'और मैं समझ रही थी, अभी वह दाने बिखेर रहा है।'"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "'क्या वह सचमुच...'"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "'पक्का शिकारी है।'"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "'मीना सिर पर हाथ रखकर चिन्ता मे डूब जाती है।'"
    }
  ]
}