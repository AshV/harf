{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_10",
  "number": 10,
  "title": "तलवा",
  "word_count": 1443,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "⁠मूठी"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        पते की बातें   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;  तलवा"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "जब न कॉटे के लिये कॉटा बने।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "पाँव के नीचे पड़े जब सब सहे॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "जब छिदे छिल छिल गये सॅभले नही।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "क्यों न तब छाले भरै तलवे रहे॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288;   काम के कलाम"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "&#8288;  बात की करामात"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "क्या अजब मुँह सी गया उनका अगर।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "टकटकी बाँधे हुए जो थे खड़े॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "जब बरौनी सी तुझे सूई मिली।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "आँख तुझ मे जब रहे डोरे पड़े॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "थिर नहीं होतीं थिरकती है बहुत।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "हैं थिरकने मे गतों को जाँचती॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "काठ का पुतला ललकतों को बना।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आँख तेरी पुतलियाँ है नाचती॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "खोलते ही खोलने वाले रहे।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "भेद उस के पर न खोले से खुले॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तोल करके मान मन कितना गया।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "पर न तोले आँख तेरे तिल तुले॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "है न गहरी दुई बहुत लाली।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "है न उस में मजीठ बूँद चुई॥"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "खीझ से बूझ का लहू करके।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "आँख तू है लहूलुहान हुई॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "हम बतायें तो बतायें किस तरह।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "तू न जाने कौन मद में है सना॥"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "कान कितने झूमते हैं आज भी।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "देख तेरे झूमकों का झूमना॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "तब निकलता न किस लिये सूरज।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "जब ललाई लिये फटी पौ थी॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "कान पाता न क्यों तरौना तब।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "जब ललकती छिदी हुई लौ थी॥"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "होठ औ दॉत मिस समय पा कर।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "मुँह लगे फल भले बुरे पाने॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "है अगर फल कही इनारू का।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "तो कहीं है अनार के दाने॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "बोल बोले अमेल, फूल झड़े।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "चाँदनी को किये हँसी से सर॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "लग गये चार चॉद जिस मुँह को।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "हम उसे चाँद सा कहें क्यों कर॥"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "एक तिल फूल एक दुपहरिया।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "दो कमल और दो गुलाब बड़े॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "भूल है फूल मिल गये इतने।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "फूल मुँह से किसी अगर न झड़े॥"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "बोलने आदि के बड़े आले।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "सब निराले कमाल तुम जैसे॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "मिल किसी काल में उसे न सके।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "मुँह तुम्हें हम कमल कहें कैसे॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "सब दिनों साथ एक सूगे के।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "दो ममोले हिले मिले देखे॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "मुँह तुमारे कमाल के बल से।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "चाँद मे दो कमल खिले देखे॥"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "नाचती मछलियाँ, हरिन भोले।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "हो ममोले कभी बना लेते॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "मुँह कभी निज अजीब आँखों को।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "कर कमल, हो कमाल कर देते॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "है कही बाल भी कही आँसू।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "और मुँह मे कही हँसी का थल॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "है कहो मेघ औ कही बिजली।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "औ कही पर बरस रहा है जल॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "क्यों न मुँह को चॉद जैसा ही कहें।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "पर भरम तो आज भी छूटा नहीं॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "चाँद टूटा ही किया सब दिन, मगर।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "टूट कर भी मुँह कभी टूटा नहीं॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "है बनाते निरोग कायम को।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "काम के रम ढग बीच ढले॥"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "है बहुत ही लुभावने होते।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "दाँत सुथरे धुले भले उजले॥"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "तुम कभी अनमोल मोती बन गये।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "औ कभी हीरे बने दिखला दमक॥"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "दाँत है चालाकियाँ तुम मे न कम।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "चौंकता हूं देख चौके की चमक॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "मिल न रगीनियाँ सकी उसको।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "पास उस के हँसी नही होती॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "देख करके बहार दॉतों की।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "हार कैसे न मानता मोती॥"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "सॉझ के लाल लाल बादल में।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "है दिखाती कमाल चन्दकला॥"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "या बही लाल पर अमीधारा।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "या हँसी होंठ पर पड़ी दिखला॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "लोग चाहे कौंध बिजली की कहें।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "या अमीधारा कहे रस में सनी॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "पर कहेगे हम बड़े ही चाव से।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "है हॅसी मुखचन्द की ही चाँदनी॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "है सहेली खिले हुए दिल की।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "फूल पर है सनेह-धार लसी॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "है लहर रसभरे उमगों की।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "चाँदनी है हुलास चन्द हॅसी॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "जब हंसी तुझ से दुई ऑखे सुखी।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "देख तुझ को सॉसते वे जब सहें॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "सूझ वाले तब न तुझ को किस तरह।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "चॉदनी औ कौध बिजली की कहें॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "नास कर देती अगर सुध बुध रही।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "किस तरह तो है अभी उस मे बसी॥"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "जब दरस की प्यास बुझतां ही नही।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "तब भला रस-सोत कैसे है हँसी॥"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "आग बल उठने कलेजे में लगे।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "आँख से चिनगारियाँ कढ़ती रहें॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "देख उस को जी अगर जलता रहे।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "तो हँसी को चाँदनी कैसे कहे॥"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "हैं थली होनहार लीकों को।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "लाभ की या सहेलियाँ हैं ए॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "कौल की लाल लाल पंखड़ियाँ।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "या किसी को हथेलियाँ हैं ए॥"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "&#8288;  अनूठे विचार"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "जब न उस मे मिला रसीलापन।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "जीभ उस की बनी सगी तब क्या॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "फूल मुँह से अगर न झड़ पाया।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "बात की झड़ भला लगी तब क्या॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "खोट घुट्टी में किसी की जो पड़ी।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "वह बँटाने से कभी बॅटती नही॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "नाक कटवा ली गई कह कर जिसे।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "काटने से बात वह कटती नही॥"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "चाहते हो बनी रहे लाली।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "पर पड़ा चाल ढाल का ठाला॥"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "छूट पाता नहीं बिलल्लापन।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "किस तरह बोल रह सके बाला॥"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "जब हमी निज भरम गॅवा देंगे।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "लोग तब क्यों भरम न खोलेंगे॥"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "बोल जब हम सके सँभाल नही।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "बोलियाँ लोग क्यों न बोलें॥"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "कब कहाँ पर किसे न भीतर से।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "ढोल की ही तरह मिले पाले॥"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "जब रहे बोलते रहे बढ़ बढ़।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "कर सके कुछ कभी न बढ़बोले॥"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "और के दुख दर्द की भी सुध रखें।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "कस नही लेवें सितम पर ही कमर॥"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "नित उसे हम नोचते ही क्यों रहें।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "नोचने से नुच गई दाढ़ी अगर॥"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "जब कलेजा और का है फाड़ते।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "और कहते बात है ताड़ी हुई॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "आँख तब क्यों फाड़ कर है देखते।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "दूसरों की दाढ़ियाँ फाड़ी हुई॥"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "क्या अजब जो मचल बुढ़ापे में।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "लड़ कई की कसर गई काढ़ी॥"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "जो न पाये बिचार ही पक तो।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "क्या करेगी पको दुई दाढ़ी॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "क्यों किसी की बात हम जड़ते रहे।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "जो जड़े तो नग अनूठे ही जड़ें॥"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "क्यों पड़े हम और लोगों के गले।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "जो पड़े वन फूल की माला पड़ें॥"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "तब सुधरते तो सुधरते किस तरह।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "जब कि सकते सीख हम ले ही नहीं॥"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "किस तरह तब वह भला जी मे धँसे।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "बात उतरी जब गले से ही नही॥"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "क्या हुआ पजे कड़े जो मिल गये।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "आदमीयत किस लिये हो छोड़ते॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "तोड़ना हो सिर बुरों का तोड़ दो।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "क्यों किसी की उँगलियाँ हो तोड़ते॥"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "पाँव भी रक्खें अहितपथ मे न तो।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "हित अगर कर दें न उठते बैठते॥"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "कुछ किसी से अठ क्यों फूले फिरें।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "अठ पजों को रहें क्यों अठते॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "तो हुआ नाम क्या सधा मतलब।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "जो चला काम सिर किये गजा॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "जो रही आनबान कान मले।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "जो मिला मान मोड़ कर पजा॥"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "चुभ सका कम या बहुत ही चुभ सका।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "कम दिया या दुख दिया उस ने बड़ा॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "जान पर तो मेमने के आ बनी।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "क्या मोलायम और क्या पजा कड़ा॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "दीन दुखियों पर पसीजें क्यों न हम।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "देख उन की आँख से आँसू छना॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "क्यों किसी की वे गरम मूठी करें।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "है न उन के पास मूठी भर चना॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "सब जगह वे ही सदी माने गये।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "मान का जो मान रख करके जिये॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "हम लथेड़ें तो लथेड़ें क्यों उसे।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "खा थपेड़े लें न पड़े के लिये॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "खोल दिल दान दें, खिला खायें।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "धन दुआ कब धरम किये से कम॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "धन अगर है बटोरना हम को।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "तो बटोरे न हाथ अपना हम॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "हैं बुरा काम कर बुरा करते।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "यह बुरा काम ही बताता है॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "दिल दुखा दिल दुखा नही किस का।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "पाप कर हाथ कॉप जाता है॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "ध्यार के सारे निराले ढंग जब।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "छल कपट के रग मे ढाले गये॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "हित-नियम आले न जब पाले पले।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "तब गले में हाथ क्या डाले गये॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "धर्म ही है साथ जाता जीव के।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "तन चिता तक ही पहुँच पाया मरे॥"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "रह गई धरती यही की ही यही।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "कौन छाती पर गया धन को धरे॥"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "क्यों न पाये थल भली रुचि ऑख मे।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "क्यों बुरी रुचि हाथ से जाये पिसी॥"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "जाय जम जो प्यार जड़ जी मे न तो।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "जाय गड़ छाती न छाती में किसी॥"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "है सताना भला नही होता।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "क्यों किसी को गया सताया है॥"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "पक गये तो गये बला से पक।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "क्यों कलेजा गया पकाया है॥"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "दाम हो, या छदाम पास न हो।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "पर बने मन न सूम-मन जैसा॥"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "जान जाये न दमड़ियाँ देते।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "जी न निकले निकालते पैसा॥"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "चाह वालों को न दे चाहत बढ़ा।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "लाभ का मद दे न लोभी को पिला॥"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "लालसाओं का न दे लासा लगा।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "जी न ललचाये बुरी लालच दिला॥"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "ठीक कोई कर कभी सकता नही।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "भाग, बिगड़े भाग, का फूटा हुआ॥"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "टूट पड़ कर किस लिये है तोड़ते।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "जुड़ सका जोड़े न जी टूटा हुआ॥"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "जाँय रंग प्यार-रगतों मे हम।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "सब जगह रग जो जमाना है॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "लाभ करके लुभावनी बातें।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "जी लुभा लें अगर लुभाना है॥"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "वह किये लाड़ लाड़ करता है।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "है उखड़ता उखाड़ने से जा॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "मत बिगाड़े बिगाड़ने वाले।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "कब न बिगड़ा बिगाड़ने से जी॥"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "बद बनाती कब नहीं बद आदतें।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "छूट पाती है बुरी लत छन नही॥"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "मन-सहक कैसे नहीं जाता सहक।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "क्यों बहॅकता मन-बहँक का मन नहीं॥"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "हम धनी जी के रहे सब दिन बने।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "हाथ मे चाहे हमारे हो न धन॥"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "तन भले ही हाथ मे हो और के।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "पर पराये हाथ मे होवे न मन॥"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "बात हित की क्यों बताये हम उसे।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "बूझ होते बन गया जो बैल हो॥"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "रख बुरे मैला न कैसे मन मिले।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "मेल क्यों हो जब कि मन मे मैल हो॥"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "poem>"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "कर बुरा अपना भला चाहे न हम।"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "हित हमारे हों न अनहित मे सने॥"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "जाय तन तन-परवरी परतुल नही।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "मतलबों का मन न मतवाला बने॥</poem>"
    }
  ]
}