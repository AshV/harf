{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_07",
  "number": 7,
  "title": "गागर में सागर",
  "word_count": 1393,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "देवदेव"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चौपदे"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "जो किसी के भी नहीं बाँधे बँधे ।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "प्रेमबंधन से गये वे ही कसे॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "तीन लोकों में नही जो बस सके।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "प्यारवाली आँख में वे ही बसे ॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पत्तियों तक को भला कैसे न तब।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कर बहुत ही प्यार चाहत चूमती ॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "साँवली सूरत तुम्हारी साँवले।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "जब हमारी आँख में है घूमती॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "हरि भला आँख में रमे कैसे।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जब कि उस में बसा रहा सोना ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "क्या खुली आँख श्री लगी लौ क्या ।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "लग गया जबकि आँख का टोना ॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "मंदिरों मसजिदों कि गिरजने में ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "खोनने हम कहाँ कहाँ जावें ॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "आप फेले हुए जहाँ में है।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "हम कहाँ तक निगाह फैलावें ॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "जान तेरा सके न चौड़ापन ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "क्या करेंगे विचार हो चौड़े।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "है जहाँ पर न दोड़ मन की भी।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "वाँ बिचारी निमाह क्या दौड़े ॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "भौं सिकोड़ी बके झके; बहके।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "बन बिगड़ लड़ पड़े अड़े अकड़े ॥"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "लोक के माथ सामने तेरे।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "कान हम ने कभी नहीं पकड़े ॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "हो कहाँ पर नही झलक जाते।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "पर हमे तो दरस: हुआ सपना ॥"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "कब हुआ सामना नही, पर हम।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "कर सके सामने मे, मुंह अपना ॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "जो अँधेस है भरी जी में उसे ।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "हम अँधेरे में पड़े खोते नही ॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "उस जगत की जोत की भी जोत के।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "नोतवाले नख अगर होते नहीं ॥"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "लोक को निज नई कला दिखला ।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "पा निराली दमक दमकता है ॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "दूज का चन्द्रमा नहीं है यह ।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "पद चमकदार नख चमकता है ॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "कर अजब आसमान की रगत ।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "ए सितारे न रंग लाते है ॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "अनगिनत हाथ-पाँव वाले के ।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "नख, जगा जोत जममगाते है ॥"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "हैं चमकदार गोलियां तारे।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "और खिली चाँदनी बिछौना है॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "उस बहुत ही बड़े खेलाड़ी के।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "हाथ का चन्दमा खेलौना है॥"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "भेद वह जो कि भेद खो देवे।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "जान पाया न तान कर सूते ॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "नाथ वह जो सनाथ करता है।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "हाथ आया न हाथ के बूते ॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "सब दिनों पेट पाल पाल पले।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "मोहता मोह का रहा मेवा ॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "है पके बाल पाप के पीछे।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "आप के पाँव की न की सेवा ॥"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "जो निराले बड़े रसीले है।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "पा सके फूल फूल फल वे हम ॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "चाह है यह ललक ललक देखें।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "लाल, के लाल लाल तलवे हम ॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "हो भले, हो सब तरह के सुख हमें।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "एक भी साँसत न दुख में पड़ सहें ॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "चाह है, लाली बनी मुँह की रहे।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "लाल तलकों से लगी आँखे रहें ॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "मा की ममता"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "भूल कर देह गेह की सब सुध।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "मा रही नेह मे सदा माती ॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "जान को वार कर जिलाती है।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "पालती है पिला पिला छाती ॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "देख कर लाल को किलक हँसने।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "लख ललक बार बार ललचाई ॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "कौन मा भर गई न प्यारों से।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "कौन छाती भला न भर आई ॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "मा कलेजे में बही जैसी कि वह।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "प्यार की धारा कहाँ वैसी बही ॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "कौन हित-माती हमें ऐसी मिली।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "दूध से किस की भरी छाती रही ॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "नौ महीने पेट में, सह साँसतें।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "रख जतन से कौन तन-थाती सकी ॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "माह मे माती हुई मा के सिवा।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "कौन मुंह में दे कभी छाती सकी ॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "प्यार मा के समान है किस का।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "हैं कढ़ी धार किस हृदय-तल से ॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "छातियों मिस हमे दिये किस ने।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "दूध के दो भरे हुए कूलसे ॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "दृध छाती में भरा, भर बह चला।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "आँख बालक ओर मा की जब फिरी ॥"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "गंगधारा शभु के शिर से बही।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "दूध की धारा किसी गिरि से गिरी ॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "एक मा मे कमाल ऐसा है।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "कुंभ को कर दिया कमल जिस ने ॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "रस भरे फल हमें कहाँ न मिले ।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "फल दिये दूध से भरे किस न ॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "किस तरह मा के कमालों को कहें।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "छू उसे हित-पेड़ रहता है हरा ॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "है पनपता प्यार तन की छांह में।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "दूध से है छेद 'छाती का भरा ॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "देख कर अपने लड़ैते लाल को।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "कब नही मुखड़ा रहा मा का खिला ॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "प्यार से छाती उछलती ही रही।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "दूध छाती में छलकता ही मिला ॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "कौन बेले पर नहीं बनता हितू।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "भाव अलबेले कहाँ ऐसे मिले ॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "एक मा के दिल सिवा है कौन दिल।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "जाय जो छिल, पूत का तलवा छिले ॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "कवि"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "कबि अनूठे कलाम के बल से।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "हैं बड़ा ही कमाल कर देते ॥"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "बेधने के लिये कलेजों को।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "है कलेजा निकाल धर देते ॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "हैं निराली निपट अछूती जो।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "हैं वही सूझ काम में लाते ॥"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "कम नहीं है कमाल कबियों में।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "है कलेजा निकाल दिखलाते ॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "क्यों न दिल खीच ले उपज पाला।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "जो कि उपजी कमाल भी कुछ ले ॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "जिन पदों में छलक रहा है रस।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "क्यो कलेजा न सुन उसे उछले ॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "भाव में डूब पा अनूठे पद ।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "जिस समय है कबिन्द जी लड़ता ॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "हैं उमगें छलॉग सी भरती।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "है कलेजा उछल उछल पड़ता ॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "तज उसे कौन है मला ऐसा ।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "दिल कमल सा खिला मिला जिसका ॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "फूल मुंह से झड़े किसी कबि के।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "है कलेजा न फूलता किस का ॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "भेद उस ने कौन से खोले नही।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "कौन सी बाते नही उस ने कहीं ॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "दिल नहीं उस ने टटोले कौन से।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "घुस गया कबि किस कलेजे में नही ॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "है जहां कोई पहुंच पाता नही ।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "वह वहाँ आसन जमा है बैठता ॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "सूझ-मठ में पैठ बस रस-पैंठ मे।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "किस कलेजे मे नही कवि पैठता ॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "जो रही किस का नहीं मन मोहती।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "हाथ में किस वह अजब माला लसी ॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "छोड़ कबि बस कर दिखाने की कला।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "है भला किस के कलेजे में बसी ॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "रस-रसिक पागल सलाने भाव का ।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "कौन कवि सा है लुनाई का सगा ॥"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "लोक-हित-गजरा लगन-फूलों बना।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "है रखा किस ने कलेजे से लगा ॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "बॉध सुन्दर भाव का सिर पर मुकुट।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "वह भलाई के लिये है अवतरा ॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "कौन कवि सा हित-कमल का है भँवर।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "प्यार से किस का कलेजा है भरा ॥"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "है रहा किस मे बसत सदा बना।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "नित चली किस में मलय सी पौन है ॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "धार किस में सब रसों की है बही।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "कवि-कलेजे सा कलेजा कौन है ॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "एक कवि छोड़ कौन है ऐसा।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "प्रेम में मस्त मन रहा जिस का ॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "भाव में डूब धन , उमड़ते लौं।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "है कलेजा उमड़ सका किस का ॥"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "फूल जिस से सदा रहा झड़ता।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "मुंह वही श्राम है उगल लेता ॥"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "क्या अजब, कबि जला भुना कोई।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "है कलेजा बला जला देता ॥"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "हाथ ऊंचा सदा रहा किस का।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "हित सकल सुख सहज सहेजे में ॥"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "कबि करामात कर दिखाता है।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "ढाल जल जल रहे कलेजे में ॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "है किसी के न पास रस इतने।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "है रसायन बना बचन किस का ॥"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "कवि सिवा कौन लग लगा उस के।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "है कलेजा सुलग रहा जिस का ॥"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "तो भला क्या कमाल है कबि में।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "जो सका कर कमल न नेजे को ॥"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "गोद में प्यार है पला जिस की।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "गोद देवे न उस कलेजे के ॥"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "चाँद को छोल चाँदनी को, मल।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "रंग दे लाल, लाल रेजे में ॥"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "कबि कहा कर बदल कमल दल को।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "छेद कर दे न छबि कलेजे में ॥"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "पैठ कर के प्यार जैसे पैठ मे।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "दाम खोटी चाट का पाता रहा ॥"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "जो कभी चोटी चमोटी के लगे।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "कवि-कलेजा चोट खा जाता रहा ॥"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "प्यार के पुतले"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "बात मीठी लुभावनी सुन सुन।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "जो नही हो मिठाइयाँ देते ॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "तो खिले फूल से दुलारे का।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "चाह से गाल चूम तो लेते ॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "हाथ उन पर भला उठायें क्यों।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "जो कि हैं ठीक फूल ही जैसे ॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "पा सके तन गला गला जिन को।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "गाल उन का भला मलें कैसे ॥"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "हैं लुभा लेती ललक पहल लिये।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "हैं कमाल भरी अमोल पहेलियां ॥"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "लालसावाले निराले लाल के।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "हाथ की ए लाल लाल हथेलियां ॥"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "तैरते हैं उमंग लहरों में।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "चाव से खाड़ साथ लड़ लड़ के ॥"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "लाभ हैं ले रहे लड़कपन का।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "हाथ औ पाँव फेंकते लड़के ॥"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "प्यार कर प्यार के खेलौने को।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "कौन दिल में पुलक नहीं छाई ॥"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "देख भावों भरी भली सूरत ।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "कौन छाती भला न भर आई ॥"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "चूम लें और ले बलायें लें।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "लाम है लाड़ के अँमेजे में ॥"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "मनचले नौनिहाल हैं जितने।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "हम उन्हें डाल लें कलेजे में ॥"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "ले सके जो, उसे न क्यों लेवे।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "लाड़िला वह तमाम घर का है।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "ठोक पर का अगर रहा पर का।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "दूसरा कौन पीठ पर का है।"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "क्यों ललकती रहे न माँ-आँखें।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "दल उसे लाल फूल का कह कह ॥"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "लाल है, है गुलाल की पुतली।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "लाल की लाल लाल एड़ी यह ॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "प्यार से है प्यार की बाते भरी।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "मा कलेजे के कमल जैसा खिले ॥"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "पाँव पॉव ठुमक ठुमुक घर मे चले।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "लाल को हैं पाँव चन्दन के मिले ॥"
    }
  ]
}