{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_08",
  "number": 8,
  "title": "गाल",
  "word_count": 1722,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "लाल होगे सुख मिले खीजे मले।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "वे पड़े पीले डरे औ दुख सहे॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "रॅग बदलने की उन्हें है लत लगी।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "गाल होते लाल पीले ही रहे॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "हैं उन्हें कुछ समझ रसिक लेते।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "पर सके सब न उलझनों को सह॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "है बड़ा गोलमाल हो जाता।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "गाल मत गोल गोल बातें कह॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "है निराला न आँख के तिल सा।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "और उस मे सका सनेह न मिल॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "पा उसे गाल खिल गया तू क्या।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "दिल दुखा देख देख तेरा तिल॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "आब में क्यों न आइने से हों।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "क्यों न हों कांच से बहुत सुथरे॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "पर अगर है गरूर तो क्या हैं।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "गाल निखरे खरे भरे उभरे॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "पीसने के लिये किसी दिल को।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तू अगर बन गया कभी पत्थर॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तो समझ लाख बार लानत है।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "गाल तेरी मुलायमीयत पर॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "मुँह"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "हो गयी बन्द बोलती अब तो।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "तू बहुत क्या बहँक बहँक बोला।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "तू भली बात के लिये न खुला।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "मुँह तुझे आज मोत ने खोला॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "है बहुत से अडोल ऐसे भी।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "ना कि बिजली गिरे नहीं डाले॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "'जी' गये भी नही खुला जो मुँह।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "मौत कैसे भला उसे खोले॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "बोल सकते हो अगर तो बोल लो।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "तुम बड़ी प्यारी रसीली बोलियाँ॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "दिल किसी का चूर करते मत रहो।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "मुँह चला कर गालियों की गोलियाँ॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "जो कभी कुछ न सीख सकते हों।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "दो चली सीख सब उन्हें सिखला॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "मात कर के न बात को मुँह तुम।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "दो करामात बात की दिखला॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "जो किसी को कभी नहीं भाती।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "है उसी की तुझे लगन न्यारी॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "क्यों लगी आग तो न मुँह तुझ में।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "बात लगती अगर लगी प्यारी॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "प्यास से सूख क्यों न जावे वह।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "पर सकेगा न रस टपक पाने॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "मुँह बिचारा भला करे क्या ले।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "दाँत ऐसे अनार के दाने॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "मुँह पसीने से पसीजा जब किया।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "तब अगर आँसू बहा तो क्या बहा॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "सूखता ही मुँह रहा जब प्यास से।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "आँख से तब रस बरसता क्या रहा॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "जीभ तो बेतरह रहे चलती।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "चटकना गाल को पड़े खाना॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "मुँह अजब चाल यह तुमारी है।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "कूर बच जाय औ पिसे दाना॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "मत सितम आँख मूद कर ढाओ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "तुम बदी से करोड़ बार डरो॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "जो गये वार वार मुँह उन पर।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "भौह तलवार की न वार करो॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "तीर सी आँखें, भवें तलवार सी।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "और रख कर पास फाँसी सी हँसी॥"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "डाल फदे सी लटों के फद मे।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "मुँह बढ़ा दो मत किसो को बेबसी॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "मुँह बड़े ही भयावने तुम हो।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "बन सके हो भले न तो भाले॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "चैन जो था बचा बचाया वह।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "बच न पाया चले बचन गोले॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "जो बुरे आठो पहर घेरे रहे।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "तो भली ऑखें न क्यों पीछे हटें॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "मुँह बुरा है जो भले तुम को लगे।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "बाल बेसुलझे हुए, उलझी लटें॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "पड़ गई है बान जटने की जिन्हें।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "वे भला कैसे न भोले को जटें॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "मुँह किसी ने सौप क्यों तुम को दिया।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "साँप जैसे बाल साँपिनि सी लटें॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "मुँह तुम्हें जो रुचा चटोरापन।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "जीव कैसे न तब भला कटते॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "तुम रहे जब हराम का खाते।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "तब रहे राम राम क्या रटते॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "मुँह कहाँ तब रहा ढँगीलापन।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "जब कि बेढंग तुम रहे खुलते॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "जब गया आब गालियाँ बक बक।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "तब रहे क्या गुलाब से धुलते॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "बात कड़वी निकल पड़ेहीगी।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "क्यों न उस में सदा अमी बोलूं॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "राल टपके बिना नही रहती।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "क्यों न मुँह को गुलाब से धो लू॥"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "मुँह! चढ़ा नाक भौंह साथी से।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "पूच से नेह गॉठ सूठा तू॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "जो बनी झूठ को रही रुचि तो।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "जूठ से झूठमूठ रूठा तू॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "और पर क्या बिपत्ति ढाओगे।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "मुँह तुमारी विपत्ति तो हट ले॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "वह हँसे या डॅसे न औरों को।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "उँस तुम्हीं को न नागिनी लट ले॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "दाँत जैसे कड़े, नरम लब से।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "हैं सदा साथ साथ रह पाते॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "मुँह तुम्हारे निबाहने ही से।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "हैं भले औ बुरे निबह जाते॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "बात जिस की बड़ी अनूठी सुन।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "दिल भला कौन से रहे न खिले॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "है बड़ी चूक जो उसी मुँह को।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "चुगलिया गालियां चबाव मिले॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "मत उठा आसमान सिर पर ले।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "मत भवें तान तान कर सर तू॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "ढा सितम रह सके न दस मुँह से।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "मुँह उतारू न हो सितम पर तू॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "क्या बड़ाई काकुलों की हम करें।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "जब रही आँखें सदा उन मे फँसी॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "क्यों न उस मुँह को सराहे पा जिसे॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "जीभ है बत्तीस दांतों मे बसी॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "छेद डाला न जब छिछोरों को।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "जब बुरे जी न बेध बेध दिये॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "भौह औ आँख के बहाने तब।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "मुँह रहे या कमान बान लिये॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "दाँत"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "हो बली, रख डीलडौल पहाड़ सा।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "बस बड़े घर मे, समझ होते बड़ी॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "हाथियों को दॉत काढ़े देख कर।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "दाबनी दॉतों सले उँगली पड़ी॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "जब कि करतूत के लगे घस्से।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "तब भला किस तरह न वे घिसते॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "पीसते और को सदा जब थे।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "दाँत कैसे भला न तब पिसते॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "है निराली चमक दमक तुम मे।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "सब रसों बीच हो तुम्ही सनते॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "दाँत यह कुन्दपन तुम्हारा है।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "जो रहे कुन्द को कली बनते॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "रस किसी को भला चखाते क्या।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "हो बहाते लहू बिना जाने॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "दॉत आनर तुम्हे न क्यों मिलता।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "हो अनूठे अनार के दाने॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "क्या लिया बार बार मोती बन।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "लोभ करते मगर नही थकते॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "लाल हो लाख बार लोहू से।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "दाँत तुम लाल बन नही सकते॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "आस जिस से हो वही जो बद बने।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "दूसरों से हो सके तो आस क्या॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "दाँत जब तुम जीभ औ लब मे चुभे।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "पासवालों का किया तब पास क्या॥"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "लाल या काले बनोगे क्यों न तब।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "जब कि मिस्सी लाल या काली मली॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "दॉत क्या रगीन बनते तुम रहे।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "सादगी रगोनियों से है भली॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "वह बनी क्यों रहे न सोने की।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "तुम उसे फेंक दो न ढील करो॥"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "लीक है वह लगा रही तुम को।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "दॉत कुछ कील को सबील करो॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "है नही चुभने, कुचलने, कूचने।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "छेदने औ बेधने ही के गिले॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "दाँत सारे औगुनों मे हो भरे।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "तुम बिगड़ते औ उखड़ते भी मिले॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "जीभ"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "कट गई, दब गई, गई कुचली।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "कौन साँसत हुई नही तेरी।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "जीभ तू सोच क्या मिला तुझ को।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "दाँत के आस पास दे फेरी॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "जब बुरे ढग में गई ढल तू।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "फल बुरा तब न किस तरह पाती॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "बोलती ऐंठ ऐंठ कर जब थी।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "जीभ तब ऐंठ क्यों न दी जाती॥"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "जब लगी काट छॉट में यह थी।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "तब न क्यों काट छाँट की जाती॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "जब कतरब्योंत रुच गई उस को"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "जीभ तब क्यों कतर न दी जाती॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "बिख रहे जो कि घोलती रस मे।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "क्यों उसे रस चखा चखा पालें॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "बात जिस से सदा रही कटती।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "क्यों न उस जीभ को करा डालें॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "बात कड़वी, कड़ी, कुढगी कह।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "जब रही बीज बैर का बोती॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "तब लगी क्यों रही भले मुँह मे।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "था भला जीभ गिर गई होती॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "सच, भली रुचि, सनेह, नरमी का।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "नाम ही जब कि वह नहीं लेती॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "तब सिवा बद-लगाम बनने के।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "चाम की जीभ काम क्या देती॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "क्या गरम दूध और दाँत करें।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "सब दिनों किस तरह बची रहती॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "जीभ कैसे जले कटे न भला।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "जब कि थी वह जली कटी कहती॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "क्यों न तब तू निकाल ली जाती।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "जब बनी आबरू रही खोती॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "क्यों नही आग तब लगी तुझ में॥"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "जीभ जब आग तू रही बोती॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "क्या रही जानती मरम रस का।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "जब कि रस ठीक ठीक रख न सकी॥"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "तब किया क्या तमाम रस चख कर।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "रामरस जीभ जब कि चख न सकी॥"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "जीभ औरों की मिठाई के लिये॥"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "राल भूले भी न बहनी चाहिये।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "जब कि कड़वापन तुझे भाता नहीं।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "तब न कड़वी बात कहनी चाहिये॥"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "जब कि प्यारी बात का बरसा न रस।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "तू बता तब क्या हुआ तेरे हिले॥"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "तरबतर जब जीभ तू करती नही।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "सो तरावट धूल में तेरी मिले॥"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "पान को कोस लें मगर वह तो।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "है बुरी बात के पड़ी पाले॥"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "जब कही बात थी जलनवाली।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "क्यों पड़े जीभ मे न तब छाले॥"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "बात तू ही बेठिकाने की करे।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "किस तरह हम तब ठिकाने से रहे॥"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "जीभ तू ने बात जब बेजड़ कही।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "बात की जड़ तब तुझे कैसे कहे॥"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "दाँत से बार बार छिद बिध कर।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "जीभ है फल बुरे बुरे चखती॥"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "है मगर वह उसे दमक देती।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "चाटती, पोंछती, बिमल रखती॥"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "क्या भला तीखे रसों को तब चखा।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "जब न उस की काहिली को खो सकी॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "जाति को तीखी बनाने के लिये।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "जीभ जब तीखी नही तू हो सकी॥"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "क्या रहा सामने घड़ा रस का।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "जब नहीं एक बूंद पाती तू॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "पत गँवा लोप कर रसीलापन।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "है अबस जीभ लपलपाती तू॥"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "थी जहाॅ सूख तू वही जाती।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "पड़ बिपद मे भली न उकताई॥"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "प्यास के बढ़ गये बिकल हो कर।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "किस लिये जीभ तू निकल आई॥"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "किस लिये तब तू न सौ टुकड़े हुई।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "तब बिपद कैसे नही तुझ पर ढही॥"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "काट देने को कलेजा और का।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "जीभ जब तलवार बनती तू रही॥"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "जीभ तू थी लाल होती पान से।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "पर न जाना तू किसी का काल थी॥"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "धूल में तेरा ललाना तब मिले।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "तू लहू से जब किसी के लाल थी॥"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "रुच भले ही जाय खारापन तुझे।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "पर खरी बातें भला किस ने सही॥"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "जीभ तुझ को चाहिये था सोचना।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "एक खारापन खरापन है नही॥"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "सब रसों में जब कि मीठा रस जँचा।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "और तू सब दिन अधिक उस मे सनी॥"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "जीभ तो है चूक तेरी कम नही।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "जो न मीठा बोल कर मीठी बनी॥"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "होंठ"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "पान ने लाल और मिस्सी ने।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "होंठ तुम को बना दिया काला॥"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "क्या रहा, जब ढले उसी रॅग मे।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "रग मे जिस तुमे गया ढाला॥"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "जब कि उन मे न रह गई लस्सी।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "वे भला किस तरह सटेंगे तब॥"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "नेह का नाम भी न जब लेगे।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "होंठ कैसे नहीं फटेंगे तब॥"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "वह भली होवे मगर पपड़ी पड़े।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "दूध बड़ का ही हुआ 'हित' कर जसी॥"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "होंठ पपड़ाया हुआ ले क्या करे।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "चाँदनी जैसी अमी डूबी हँसी॥"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "चाहिये था चाॅदनी जैसी छिटक।"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "वह बना देतो किसी की आँख तर॥"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "कर उसे बेकार बिजली कौध लौ।"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "क्या दिखाई मुसकुराहट होंठ पर॥"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "जब रहे अनमोल लाली से लसे।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "पीक मे वे पान की तब क्यों सने॥"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "जब ललाये वे ललाई के लिये।"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "तब भला लब लाल मूॅगे क्या बने॥"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "लालची बन और लालच कर बहुत।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "मान की डाली किसी को कब मिली॥"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "तब रहे क्यों लाल बनले पान से।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "लब तुम्हें लाली निराली जबामली॥"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "दो बना और को न बेचारा।"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "तुम बुरी बात से बचो हिचको॥"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "खो किसी की बची बचाई पत।"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "होंठ तुम बार बार मत बिचको॥"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "जब मिठाई की बदौलत ही तुम्हें।"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "बोल कड़वे भी रहे लगते भले॥"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "मुसकुराहट के बहाने होंठ तुम।"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "तब अमी-धारा बहाने क्या चले॥"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "हँसी"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "जब कि बसना ही तुझे भाता नही।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "तब किसी की आँख में तू क्यों बसी॥"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "क्या मिला बेबस बना कर और को।"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "क्यों हँसी भाई तुम्हें है बेबसी॥"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "जो कि अपने आप ही फँसते रहे।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "क्यों उन्हीं के फाँसने में वह फँसी॥"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "जो बला लाई दबों पर ही सदा।"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "तो लबों पर किस लिये आयी हॅसी।"
    }
  ]
}