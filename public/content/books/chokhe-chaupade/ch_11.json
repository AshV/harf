{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_11",
  "number": 11,
  "title": "तिलक",
  "word_count": 1244,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अन्योक्ति"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        गाल   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "की गई सॉसत धरम के नाम पर।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "जी कड़ा कर कब तलक कोई सहे॥"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "किस लिये माथे किसी के पड़ गये।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "जब तिलक तुम नित बिगड़ते ही रहे॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "हो धरम का रंग बहुत तुम पर चढ़ा।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "हो भले ही तुम भलाई मे सने॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "पर तिलक जब है दुरगी ही बुरी।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "तब भला क्या सोच बहुरंगी बने॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "नेक के सिर पर पड़ी कठिनाइयाँ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नेकियों की ही लहर में है बही॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तुम तिलक धुलते व पुँछते ही रहे।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "पर तुमारी पूछ होती ही रही॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "लोग उतना ही बढ़ाते हैं तुम्हे।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "रंग जितने ही बुरे हो चढ़ गये॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "पर तिलक इस बात को सोचो तुम्ही।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "इस तरह तुम घट गये या बढ़ गये॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "किस लिये यो बॅधी लकीरों पर।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "हो बिना ही हिले डुले अड़ते॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "है सिधाई नही तिलक तुम मे।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "जब कि हो काट छाँट मे पड़ते॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "हो तिलक तुम रूप रॅग रखते बहुत।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "है तुमारा भेद पा सकते न हम॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "रॅग किसी बहुरूपिये के रग मे।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "हो किसी बहुरूपिये से तुम न कम॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "&#8288;  &#8288;  आँख"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "सूर को क्या अगर उगे सूरज।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "क्या उसे जाय चाँदनी जो खिल॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "हम अँधेरा तिलोक में पाते।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "आँख होते अगर न तेरे तिल॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "क्या हुआ चौकड़ी अगर भूले।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "लख उछल कूद और छल करना॥"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "है छकाता छलॉग वालों को।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "ऑख तेरा छलौंग का भरना॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "काम करती रही करोड़ों मे।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "जब फबी आनबान साथ फबी॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "और की कोर ही रही दबती।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "आँख तेरी कभी न कोर दबी॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "काजलों या कालिखों की छूत मे।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "कम अछूतापन नही तेरा सना॥"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "धूल लेकर के अछूते पॉव की।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "ऐ अछूती ऑख तू सुरमा बना॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "वह लुभाता है भला किस को नही।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "थी भलाई भी उसी मे भर सकी॥"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "भूल भोलापन गई अपना अगर।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "भूल भोली आँख ने तो कम न की॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "क्या करेगी दिखा नुकीलापन।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "क्या हुआ जो रही रसों बोरी॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "सब भली करनियों करीनों से।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "आँख की कोर जो रही कोरी॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "क्या कहें और के सभी दुखड़े।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "खेल होते है और के लेखे॥"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "फूट जो है उसे बहुत भाती।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "आँख तो आप फूट कर देखे॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "देख सीधे, सामने हो, फिर न जा।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "मान जा, बेढंग चालें तू न चल॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "सोचले सब दिन किसी की कब चली।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "एक तिल पर आँख मत इतना मचल॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "हम कहें कैसे कि उन में सूझ है।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "जब न पर-दुख-आँसुओं में वे बहे॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "क्या उजाले से भरे हो कर किया।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "आँख के तिल जब अँधेरे मे रहे॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "हो गईं सब बरौनियाँ उजली।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "जोत का तार बेतरह टूटा॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "देख ऊबी न तू छटा बाँकी।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "आँख तेरा न बॉकपन छूटा॥"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "एक दिन था कि हौसलों में डूब।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "गूँधती प्यार-मोतियों का हार॥"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "अब लगातार रो रही है आँख।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "टूटता है न आँसुओं का तार॥"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "बेबसी में पड़ बहुत दुख सह चुकी।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "कर चुकी सुख को जला कर राख तू॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "अब उतार रही सही पत को न दे।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "आँसुओं मे डूब उतरा आँख तू॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "मत मटक झूठमूठ रूठ न तू।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "मत नमक घाव पर छिड़क हो नम॥"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "अब गया ऊब ऊधमों से जी।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "ऊधमी आँख मत मचा ऊधम॥"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "जा चुका हे वार सरबस प्यार पर।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "तू उसे तेवर बदल कर कर न सर॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "दे दिया जिस ने कि चित अपना तुझे।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "आँख चितवन से उसे तू चित न कर॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "प्यार करने में कसर की जाय क्यों।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "है न अच्छा जो रहे जी में कसर॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "कर सके जो लाड़ तो कर लाड़ तू।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "ऐ लड़ाकी आँख लड़ लड़ कर न मर॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "कौन पानी है गॅवाना चाहता।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "मछलियाँ पानी बिना जीतीं नहीं॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "प्यास पानी के बचाने को बढ़े।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "आँख आँसू क्यों भला पीती नही॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "तू उसे भूल कर गुनी मत गुन।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "जिस किसी को गुमान हो गुन का॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "जो कि हैं ताकते नही सीधे।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "आँख! मुँह ताक मत कभी उन का॥"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "&#8288;  आँसू"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "तुम पड़ो टूट लूट लेतों पर।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "क्यों सगों पर निढाल होते हो॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "दो पला, आग के बगूलों को।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "ऑसुओ गाल क्यों भिंगोते हो॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "आँसुओ और को दिखा नीचा।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "लोग पूजे कभी न जाते थे॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "क्यों गॅवाते न तुम भरम उन का।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "जो तुम्हें आँख से गिराते थे॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "हो बहुत सुथरे बिमल जलबूँद से।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "मत बदल कर रंग काजल में सनो॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "पा निराले मोतियों की सी दमक।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "आँसुओ काले-कलूटे मत बनो॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "था भला आँसुओ वही सहते।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "जो भली राह में पड़े सहना॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "चाहिये था कि ऑख से बहते।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "है बुरी बात नाक से बहना॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "&#8288;  नाक"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "हो उसे मल से भरा रखते न कम।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "यह तुमारी है बड़ी ही नटखटी॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "तो न बेड़ा पार होगा और से।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "नाक पूरे से न जो पूरी पटी॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "जो भरे को ही रहे भरते सदा।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "वे बहुत भरमे छके बेढँग ढहे॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "नाक तुम को क्यों किसी ने मल दिया।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "जब कि मालामाल मल से तुम रहे॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "तू सुधर परवाह कुछ मल की न कर।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "पाप के तुझ को नहीं कूरे मिले॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "लोग उबरे एक पूरे के मिले।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "हैं तुझे तो नाक दो पुरे मिले॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "वह कतर दी गई सितम करके।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "पर न सहमी न तो हिली डोली॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "नाक तो बोलती बहुत ही थी।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "बेबसी देख कुछ नहीं बोली॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "दुख बड़े जिस के लिये सहने पड़ें।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "दें किसी को भी न वे गहने दई॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "तब अगर बेसर मिली तो क्या मिली।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "नाक जब तू बेतरह बेधी गई॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "और के हित है कतर देते तुझे।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "और वह फल को कुतुर करके खिली॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "ठोर सूगे की तुझे कैसे कहें।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "नाक जब न कठोर उतनी तू मिली॥"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "जो न उसके ढकोसले होते।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "तो कभी तू न छिद गई होती॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "मान ले बात, कर न मनमानी।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "मत पहन नाक मान हित मोती॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "सूंघने का कमाल होते भी।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "काम अपने न कर सके पूरे॥"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "बस कुसँग में सुबास से न बसे।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "नाक के मल भरे हुए पूरे॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "ताल में क्यों भरा न हो कीचड़।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "पर वहीं है कमल-कली खिलती॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "नाक कब त रही न मलवाली।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "है तुम्हीं से मगर महँक मिलती॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "&#8288;  कान"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "दासपन के चिन्ह से जो सज सका।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "क्यों नहीं तन बिन गया वह नीच तन॥"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "कान! तेरी भूल को हम क्या कहें।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "बोलबाला कब रहा बाला पहन॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "धूल में सारी सजावट वह मिले।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "दूसरा जिस से सदा दुख ही सहे॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "और पर बिजली गिराने के लिये।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "कान तुम बिजली पहनते क्या रहे॥"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "बात सच है कि खोट से न बचा।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "पर किसी से उसे कसर कब थी॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "सब भला क्यों न वह मुकुत पाता।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "कान की लौ सदा लगी जब थी॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "जब मसलता दूसरों का जी रहा।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "आँख में तुझ से न जब आई तरी॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "दे सकेंगी बरतरी तुझ को न तब।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "कान तेरी बालियाँ मोती भरी॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "भीतरी मैल जब निकल न सका।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "तब तुम्हें क्यों भला जहान गुने॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "बान छूटी न जब बनावट की।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "तब हुआ कान क्या पुरान सुने॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "किस लिये तब न तू लटक जाता।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "जब भली लग गई तुझे लोरकी॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "छोड़ तरकीब से बने गहने।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "गिर गया कान तू पहन तरकी॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "तग उतना ही करेगी वह हमें।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "चाह जितनी ही बनायेंगे बड़ी॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "कान क्यों हैं फूल खोंसे जा रहे।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "क्या नहीं कनफूल से पूरी पड़ी॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "जब किसी भांत बन सकी न रतन।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "तेल की बूँद तब पड़ी चू क्या॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "जब न उपजा सपूत मोती सा।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "कान तब सीप सा बना तू क्या॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "राग से, तान से, अलापों से।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "बह न सकता अजीब रस-सोता॥"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "रीझता कौन सुन, रसीले सुर।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "कान तुझ सा रसिक न जो होता।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "तो मिला वह अजीब रस न तुझे।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "पी जिसे जीव को हुई सेरी॥"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "लौ-लगों का कलाम सुनने मे।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "कान जो लौ लगी नहीं तेरी॥"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "&#8288;  गाल"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "वह लुनाई धूल में तेरी मिले।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "दूसरों पर जो बिपद ढाती रहे॥"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "गाल तेरी वह गोराई जाय जल।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "जो बलायें और पर लाती रहे॥"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "तो गई धूल मैं लुनाई मिल।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "औ दुआ सब सुडौलपन सपना॥"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "पीक से बार बार भर भर कर।"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "गाल जब तू उगालदान बना॥"
    }
  ]
}