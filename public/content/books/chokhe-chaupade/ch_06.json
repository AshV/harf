{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_06",
  "number": 6,
  "title": "कोर कसर",
  "word_count": 948,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "हाथ और दान"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        जाति के कलंक   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;   कोर कसर"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  जी की कचट"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "ब्योंत करते ही बरस बीते बहुत।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "कर थके लाखों जतन जप जोग तप॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सब दिनों काया बनी जिस से रहे।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "हाथ आया वह नहीं काया कलप॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "किस तरह हम मरम कहें अपना।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "कक न काँटे करम रहा बोता॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तब रहे क्यों भरम धरम क्यों हो।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "हाथ ही जब गरम नहीं होता॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "आज तक हम बने कहाँ वैसे।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "बन गये लोग बन गये जैसे॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "जब न सरगरमियाँ मिलींं हम को।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कर सकेंं हाथ तब गरम कैसे॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "रह गया जो धन नहीं तो मत रहो।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "है हमारी नेकियों को हर रही॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "क्या कहें हम तँगदिल तो थे नहीं।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तंग तगी हाथ की है कर रही॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "पा सका एक भी नही मोती।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "पड़ गया सिंधु आग के छल में॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "तो जले भाग को न क्यों कोसें।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "जाय जल हाथ जो गये जल में॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "मान मन सब मनचलापन मरतबे।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "मन मरे कैसे भला खोता नहीं॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "क्यों न वह फँसता दुखों के दाम में।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "दाम जिस के हाथ में होता नहीं॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "बढ़ गई बेबसी बुढ़ापा की।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "चल बसा चैन, सुख हुआ सपना॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "दूसरे हाथ में रहें कैसे।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "हाथ मे हाथ है नहीं अपना॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "आँख पुर नेह से रही जिस की।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "अब नहीं नेह है उसी तिल में॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "खोलता गाँठ जो रहा दिल की।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "पड़ गई गॉठ अब उसी दिल में॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "फूल हम होवें मगर कुछ भल से।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "दूसरों की ऑख में काँटे जँचे॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "क्यों बचाये बच सकेगी आबरू।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "जी बचायें जो बचाने से बचे॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "ठीक था ठीक ठीक जल जाता।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "जो सका देख और का न भला॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "रंज है देख दसर्स का हित।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "जी हमारा जला मगर न जला॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "कर सकें हम बराबरी कैसे।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "है हमे रंगतें मिली फीकी॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "हम कसर हैं निकालते जी से।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "वे कसर हैं निकालते जी की॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "उलझनों में रहे न वह उलझा।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "कुछ न कुछ दुख सदा लगा न रहे॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "नित न टाँगे रहे उसे चिन्ता।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "जी बिना ही टॅगे टॅमा न रहे॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "बात अपने भाग की हम क्या कहें।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "हम कहाँ तक जी करें अपना कड़ा॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "फट गया जी फाट में हम को मिला।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "बॅट गया जी बाँट में मेरे पड़ा॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "देखये चेहरा उतिर मेरा गया।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "हैं कलेजे में उतरते दुख नये॥"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "फेर में हम है उतरने के पड़े।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "आँख से उतरे उतर जी से गये॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "है बखेड़े सैकड़ों पीछे पड़े।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "है बुरा काँटा जिगर में गड़ गया॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "फँस गये हैं उलझनों के जाल में।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "है बड़े जंजाल में जी पड़ गया॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "सूझ बाले उसे रहे रँगते।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "रग उतस न सूझ का चोखा॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "पड़ बृथा धूम धाम धोखे में।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "पेट को कब दिया नहीं धोखा॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "रोग की आँच जब लगी लगने।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "तब भला वह नही खले कैसे॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "जल रहा पेट जब किसी का है।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "आग उस में न तब बले कैसे॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "हैं लगाती न ठेस किस दिल को।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "टेकियों की ठसक भरी टेकें॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "है कपट काट छाँट कब अच्छी।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "पेट को काट कर कहाँ फेंकें॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "&#8288;  थपेड़े"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "पेटुओं को कभी टटोलो मत।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "कब गई बाँझ गाय दुह देखी॥"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "जो कि मुँह देख जी रहे हैं, वे।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "बान कैसे कहें न मुँहदेखी॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "आज सीटी पटाक बन्द हुई।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "वे सटकते रहे बहुत वैसे॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "बात ही जब कि रह नही पाई।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "बात मुँह से निकल सके कैसे॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "कब भला लोहा उन्हो ने है लिया।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "मारतों के सामने वे अड़ चुके॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "दाब लेंगे दूब दाँतों के तले।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "काम है मुँहदूबरों से पड़ चुके॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "किस तरह छूटते न तब छक्के।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "जब कि तू छूट में रहा माता॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "जब कि मुँहतोड़ पा जवाब गये।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "तब भला क्यों न टूट मुँह जाता॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "दूसरों से बैठती जिस की नही।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "किस लिये वह प्यार जतलाता नही॥"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "मुँह खुला जिसका न औरों के लिये।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "दाँत उस का बैठ क्यों जाता नहीं॥"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "हम समझते थे कि हैं कुछ आप भी।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "किस लिये बेकार गट्टे हो गये॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "देख कर मुझ को खटाई में पड़ा"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "आप के क्यों दाँत खट्टे हो गये"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "कौड़ियों को हो पकड़ते दाँत से।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "चाहिये ऐसा न जाना बन तुम्हें॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "छोड़ देगा कौड़ियों का ही बना।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "यह तुमारा कौड़ियालापन तुम्हें॥"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "दैव का दान जो न देख सके।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "आँख तो क्यों न मूंद लेते हो॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "और के दूध पूत दौलत पर।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "दांत क्यों बार बार देते हो॥"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "हैं किसे चार हाथ पाँव यहां।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "क्यों कमाई ना कर दिखाते हो॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "दूसरों की अटूट संपत पर।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "दत क्यों बेतरह लगाते हो॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "रोटियों के अगर पड़े लाले।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "हैं अगर आस पास दुख घिरते॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "क्यों नहीं तो निकाल जी देते।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "दाँत क्या है निकालते फिरते॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "छोन धन, मान मूस कर जिस ने।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "देह का माँस नोच कर खाया॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "चूस लो उस चुड़ैल का लोहू।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "होंठ को चूस चूस क्या पाया॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "सुध भला किस तरह हमें होवे।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "है लड़कपन अभी नही छूटा॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "कुछ कहें तो भला कहें कैसे।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "कठ भी आज तक नहीं फूटा॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "पोंछने के लिये बहे आँसू।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "जो बहुत दुख भरे गये पाये॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "पूँछ हैं तो उठी उठी मूछें।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "जो उठावे न हाथ उठ पाये॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "जो कभी मुँह मोड़ पाता ही नहीं।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "क्यों उसी से आप हैं मुँह मोड़ते॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "सब दिनों जो जोड़ता है हाथ ही।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "आप उस का हाथ क्यों हैं तोड़ते॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "बेकलेजे के बने तब क्यों न हम।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "बाल बिखरे देख कर जो जी टॅगे॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "या किसी की लट लटकती देख कर।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "लोटने जो साँप छाती पर लगे॥"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "बाँह बल ही व बाल है जिन को।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "जो भले ढंग में नहीं ढलते॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "जो बने काल काल के भी हैं।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "क्यों न छाती निकाल वे चलते॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "जो रही पूत-प्रेम में भाती।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "क्यों वही काम की बने थाती॥"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "क्या खुलीं जो रही खुली आँखें।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "देख कर अधखुली खुली छाती॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "जाति का दिल हो अगर काला हुआ।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "रग काला किस तरह तो छूटता॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "फूट जाये आँख जो है फूटती।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "टूट जाये दिल अगर है टूटता॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "रोटियां छीन छीन औरों की।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "क्यों बड़े चाव साथ है चखता॥"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "मिल सका पेट क्या तुझी को है।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "दूसरा पेट क्या नही रखता॥"
    }
  ]
}