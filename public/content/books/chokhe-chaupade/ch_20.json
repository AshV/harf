{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_20",
  "number": 20,
  "title": "सुनहली सीख",
  "word_count": 1360,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "केसर की क्यारी"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        अछूते फूल   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;  सुनहली सीख"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सैकड़ों ही कपूत-काया से ।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "है भली एक सपूत की छाया ॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "हो पड़ी चूर खोपड़ी ने हो ।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अनगिनत बाल पाल क्या पाया ॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "जो भला है और चलता है सँभल ।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "है भला उस को किसी से कौन डर ॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "दैव की टेढ़ी अगर भौहें न हो ।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "क्या करेंगे लोग टेढ़ी भौह कर ॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नेकियों मानते नही बी ।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "क्यों उन्ही के लिये न बिख चख लें ॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "वे न तब भी पलक उठायेंगे ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "हम पलक पर अगर ललक रख लें ॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "बढ़ सके तो सदा रहें बढ़ते ।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "पर बुरी राह में कभी न बढ़े ॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "चढ़ सकें तो चढ़े किसी चित पर ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "हम किसी की निगाह पर न चढ़े ॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "है बहू बेटियाँ जहाँ रहती ।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "है दिखाती कलक लीक वही ॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "क्यों न हो झोक ही जवानी की ।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "है कभी ताक झाँक ठीक नहीं ॥"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "क्यों टका सा जवाब उस को दें।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "जिस किसी से सदा टके ऐंठे ॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "जो रहें ताकते हमारा मुँह ।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "हम उन्ही की न ताक में बैठे ॥"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "बात ताने की, किसी के भैब की ।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "कह न ढे मुंह पर, बचे या चुप रहें ॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "बात सच है, जल मरेगा वह मगर ।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "लोग काना को अगर काना कहे ॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "काम मत आप कीजिये ऐसे ।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "जो कभी आप को बुरे फल दें ॥"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "हाथ में लग न जाय मल उस का ।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "नाक को बार बार मत मल दें ॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "जो सके बोल बोलियाँ प्यारी ।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "तो उसे बोल डालना अच्छा ॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "कान में तेल डाल लेने से ।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "कान का खाल ‘डालना अच्छा ॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "छोड़ दो छेड़ छाड़ की आदत ।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "मत जगा दो अदावते सोई ॥"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "है बहुत खोदना बुरा होता ।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "देख ले कान खोद कर कोई ॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "तब तमाचा न किस तरह लगता ।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "आग जब बेलगामपन बोता ॥"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "हो रहे जब कि लाल पीले थे ।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "तब भला क्यों न लाल मुँह होता ॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "है अगर चाहते कुफल चखना ।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "तो बुरी चाहते जगा देखे ॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "मुंह लगाना अगर भला है तो ।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "क्यों लहू को न मुँह लगा देखें ॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "काम मे ला खुला निघरघटपन ।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "नाम मरदानगी मिटाना है ॥"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "बेबसों को लपेट चित पट कर ।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "पालना पेट मुँह • पिटाना है ॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "सुन जिसे कोई नही पा कल सके ।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "बात ऐसी क्यों निकल मुंह से पड़े ॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "रगतें हित की न जब उन मे रही ।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "फूल मुँह से तब झड़े तो क्या झड़े ॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "खुल सकेगा तो नही ताला कभी ।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "जो भली रुचि की मिली ताली नही ॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "पान को लाली न लाली रखेगी ।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "रह सको मुंह की अगर लाली नही ॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "बेतरह वे न बेतुके बनते ।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "श्री न संजीदगी तुम्ही खोते ॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "यों सुलगती न लाग-आग कभी ।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "मुँह-लगे जो न मुंह लगे होते ॥"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "निज भरोसे सधा न क्या स्वाधे ।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "और का बल-भरोस है सपना ॥"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "देखना छोड़ दूसरों का मुँह ।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "देखते क्यों रहे न मुंह अपना ॥"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "काम ले बार बार धीरज से ।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "कब न जी को कचट गई खाई ॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "क्यों दुखो की चपेट में आवे ।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "क्यों पड़े मुँह लपेट कर कोई ॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "रूप औ रग के लिये ही क्यों ।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "जो किसी का ललच ललच डाले ॥"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "रख भलाई, सँभाल भोलापन ।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "भूल पाये न मह भले-भाले ॥"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "चाह जो हो कि दुख नचा न सके ।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "पास से सुब नही हिले डोले ॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "पाँव तो देख भाल कर डाले ।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "सह सँभाले, संभाल कर बोले ॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "तष रहे किस लिये भले बनते ।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "जब भली बात ही नही सीखी ॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "भूल कर चाहिये नही कहना ।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "बात कड़वी, कड़ी, बुरी, तीखी ॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "बात कह कर कसर-मरी ऐंठी ।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "हो गई बार बार बरबादी ॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "बेसधा काम साध देती है ।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "बात सीधी, सधी हुई, सादी ॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "रस न उन का अमर रहे उन मे ।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "तो बनें बोलियां सभी सीठी ॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "है लुभाती भला नही किस को ।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "बात प्यारी, लुभावनी, मीठी ॥"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "है बड़ा ही कमाल कर देती ।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "है सुरुचि-भाल के लिये रोली ॥"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "नीव सारी भलाइयों की है ।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "बात सच्ची, जँची, भली, भाली ॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "गोद में उस की बड़े ही लाड़ से ।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "है बहुत सी रेंग बिरंगी रुचि पली ॥"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "ढाल देती है निराले, ढंग में।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "बात भड़कीली, ढंगीली, रसढली ॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "धन रतन धुन उन्हें नहीं रहती ।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "है नहो मोहने उन्हे मेवे ॥"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "मानियों का यही मनाना है ।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "मान कर बात, मान रख लेवे ॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "हो न भारी सके कभी हलके ।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "है न छिपती खुली हुई बातें ॥"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "तोलने के लिये भला किस को ।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "तुल गये कह तुली हुई बातें ॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "है बड़ी बेहूदगी जो काम की।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "बात सुनने के लिये बहरे बने ॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "नो किसी गँव की न गहराई रही ।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "जो न गहरी बात कह गहरे बने ॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "छेद जिस मे अनेक हैं उस में।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "सोच लो पौन का ठिकाना क्या॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "कढ़ गई कढ गई चली न चली।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "साँस का है भला ठिकाना क्या॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "याद प्रभु को करें जियें जब तक।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "लोक-हित की न बुझ सके प्यासें॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "हम गॅवा में इन्हें नहीं यों ही।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "हैं बड़ी हो अमोल ए सॉसें॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "जी सका सब दिनों हवा पी जो।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "उस बिचारे के पास ही क्या है॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "किस तरह से सुचित्त हो कोई।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "साँस की आस पास ही क्या है॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "जो भले भाव भूल में डालें।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "तो उन्हें प्यार साथ पोसा क्या॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "जो भला कर सको तुरत कर लो।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "साँस का है भला भरोसा क्या॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "है वही फूला सुखी जो कर सका।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "वह न फूला दुख दिया जिस ने सहा॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "फूल जैसा फूल जो पाता नहीं।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "दम किसी का फूलता तो क्या रहा॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "मान की चाह है हमे तो हम।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "और का मान कर न कम देवें॥"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "काम साधें कमीनपन न करें।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "दाम लेवे मगर न दम देवें॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "धाँधली मे हवा हवस की पड़।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "क्यों मचाता अनेक ऊधम है॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "जो रहा राम मे न रमता तो।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "दाम दम का छदाम से कम है॥"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "जो मरम जानते दया का हम।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "तो उजड़ता न एक भी खोंता॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "क्यों न होता दुलार दुनिये में।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "प्यार का पाठ कठ जो होता॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "मोतियों से पिरो न क्यों देवें।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "कब समझदार हो सके संठे॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "लठ के लठ ही रहेंगे वे।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "लंठ लें कठ मे, पहन कठे॥"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "जब किसी का पॉव हे हम चूमते।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "हाथ बाँधे सामने जब है खड़े॥"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "लाख या दो लाख या दस लाख के।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "क्या रहे तब कठ मे कठे पड़े॥"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "क्या हुआ प्यार-पालने में पल।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "जो नही है कमाल भेजे में॥"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "वे रखे जॉय कालिजों में भी।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "जो गये है रखे कलेजे मे॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "मन मरे दूर हो अमन जिस से।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "सुख पिसे, चूर चूर होने की॥"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "है बनाती कड़ा नहीं किस को।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "वह कड़ाई कड़े कलेजे की॥"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "तब भला किस तरह भलाई हो।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "भर गई भूल जब कि भेजे में॥"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "तब सके गाँठ हम कहाँ मतलब।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "पड़ गई गॉठ, जब कलेजे मे॥"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "बन पराया मिले परायापन।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "कब तपाया हमे नहीं तप ने॥"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "और के हाथ मे न दिल दे दे।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "दिल सदा हाथ में रखें अपने॥"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "यात उलझी बहॅक बहॅक न कहे।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "बात सुलझी सँभल सँभल बोलें॥"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "पड़ न पावे गिरह किसी दिल।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "लें गिरह बाँध दिल गिरह खोलें॥"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "बेबसी है बरस रही जिस पर।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "तीर उस पर न तान कर निकले॥"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "यह कसर है बहुत बड़ी दिल की।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "ससहुए पर, न दिल कसर निकले॥"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "बीज बो कर बुरे बुरे फल के।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "कब भले फल फले फलाने से॥"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "दुख मिले क्यों न और को दुख दे।"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "दिल जले क्यों न दिल जलाने से॥"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "छोड़ दे छल, कपट, छिछोरापन।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "देख कर छबि न जाय बन छैला॥"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "और माल पर न हो मायल।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "दिल किसी मैल से न हो मेला॥"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "वह भरा है भयावनेपन से।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "है हलाहल भरा हुआ प्याला॥"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "साँप काला पला उसी में है।"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "काल मे है कराल दिल काला॥"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "मान औरों की न मनमानो करे।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "क्यों रहे अभिमान कर हठ ठानता॥"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "है इसी में मान रहता मान का।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "ले मना, जो मन नहीं है मानता॥"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "और का बार बार दिल दहला।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "भूल कर मन न जाय बहलाया॥"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "तो उमंगें न आस को कुचलें।"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "मन अगर है उमग पर आया॥"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "बीज मीठे जाँय क्यों बोये नहीं।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "है अगर यह चाह मीठे फल चखें॥"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "फ्त रखें, जो पत रखाना हो हमें।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "चक है मन रख न जो हम मन रखे॥"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "सूझ कर सूझता नहीं जिन को।"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "वे उन्हें दूर को सुझाते हैं॥"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "काम है सूझ बूझ का करते।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "पेट को आग जो बुझाते हैं॥"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "है बड़ा वह जो पराया हित करे।"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "हित हितू का कोन करता है नहीं॥"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "है भला वह, पेट जो पर का भरे।"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "कौन अपना पेट भरता है नहीं॥"
    }
  ]
}