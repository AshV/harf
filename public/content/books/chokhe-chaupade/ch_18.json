{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_18",
  "number": 18,
  "title": "हाथ और दान",
  "word_count": 846,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "कुछ कलेजे"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        कोर कसर   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;  हाथ और दान"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "दान जब तक फूल फल करता रहा।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "पेड़ तब तक फूल फल पाता रहा॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "दान-रुचि जी में नहीं जिस के रही।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "धन उसी के हाथ से जाता रहा॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "हित नमूना जो दिखाना है हमें।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "जो चहें यह, सुख न सूना घर करें॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "तो बना दिल सब दिनों दूना रहे।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "दान दोनों हाथ दसगूना करें॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "किस तरह तो छूटते धब्बे बुरे।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "जो मिली होती भली सोती नही॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "तो न पाता हाथ का धुल पाप-मल।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "दान-जल-धारा अगर धोती नहीं॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "पड़ गये पाप की तरंगों में।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "नेक करतूत नाव को खोते॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "जो न पतवार दान के पाते।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "लापता हाथ हो गये होते॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "&#8288;  हाथ और कमल"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "है न वह रंग औ न है वह बू।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "और वेसा नहीं बिमलपन है॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "वे भले ही रहें कमल बनते।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "पर कहाँ हाथ में कमलपन है॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "कब सका लिख, सका बसन कब सी।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "कब सका वह कभी कमा पैसा॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "हाथ तुझ में कमाल है जैसा।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "क्या कमल में कमाल है वैसा?"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "दाम की कैसी कमी तेरे लिये।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "हाथ तू तो है कमल जाता कहा॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "मानते है माननेवाले यही।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "कब कमल आसन न कमला का रहा॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "हैं हमें भेद कम नही मिलते।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "गो उन्हें हैं समान कह लेते॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "फूल करके कमल महँक देंगे।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "फूल कर हाथ है कुफल देते॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "हैं खिले मुँह सभी उन्ही जैसे।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "है उन्हीं के समान नयन नवल॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "हाथ ऐसे सुहावने न लगे।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "कम लगे है लुभावने न कमल॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "जब सदा जोड़ते रहे नाता।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "तब उसे तोड़ते रहे कैसे॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "क्या कमल के लिये ललाये तब।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "हाथ जब आप हैं कमल जैसे॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "&#8288;  हाथ और फूल"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "देखते उस की फबन जो आँख पा।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "तो कभी हित से नही मुँह मोड़ते॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "धूल मे तुम हाथ क्यों मिलते नही।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "भूल है जो फूल को हो तोड़ते॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "जो खले, दुख किसी तरह का दे।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "कब किसे ढंग वह सुहाता है॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "क्यों न ले तोड़ फूल फूले वह।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "हाथ को फूलना सताता है॥"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "क्यों लग पूछने-किसी बद ने।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "नेक को बेतरह लताड़ा क्या॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "हाथ है फूल पर सितम ढाता।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "फूल ने हाथ का बिगाड़ा क्या॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "कब रहा नोचता न कोमल दल।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "कब न कर फलबिहीन कल पाया॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "हाथ-खल इन अबोल फूलों पर।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "मल मसल कब नही बला लाया॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "फूल सा सुन्दर फबीला औ फलद।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "क्यों बँधे छिद बिध गये पामाल हो॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "आग-माला के बनाने मे लगे।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "हाथ-माली क्यों न मालामाल हो॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "वह तुझे भी निहाल करता है।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "और तू क्या व तेरी नीयत क्या॥"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "फूल में ही मुलायमीयत है।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "हाथ तेरी मुलायमीयत क्या॥"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "फूल रस रूप गंध पर रीझे।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "किस तरह से सितम सकेगा थम॥"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "क्यों समझ तू सका न कोमलपन।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "हाथ क्या यह कमीनपन है कम॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "आँख है रूप रग पर रीझी।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "कम महँक पा हुई न नाक मगन॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "हाथ तुझ मे कभी नहीं है कम।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "मोह ले जो न फूल कोमलपन॥"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "हाथ तुम बचते कि वे मैले न हों।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "तोड़ते तो पीर हो जाती कही॥"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "जो लगी होती न लत की छूत तो।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "तुम अछूते फूल छूते ही नहीं।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "लाल लाल हथेलियाँ हैं पास ही।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "जो कमल-दल से नहीं हैं कम भली॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "हाथ तुम फैलो न फूलों के लिये।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "उँगलियों क्या है न चम्पे की कली॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "हाथ मत लोढ़ो मलो नोवो उन्हें।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "है बुरा जो फूल की रंगत खली॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "इस जगत का ही निराला रग है।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "है तुमारी ही नही रंगत भली॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "&#8288;  हाथ और फल"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "डालियों से अलग न होने दो।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "डोलने के लिये उन्हें छोड़ो॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "है भले लग रहे हरे दल में।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "हाथ फल तोड़ कर न जी तोड़ो॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "है समय सुख दुख बना सब के लिये।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "औगुनों पर है भले अड़ते नही॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "पाप होगा हाथ मत तोड़ो उन्हें।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "क्या पके फल आप चू पड़ते नहीं॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "सोच लो है कौन हितकारी, भला।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "कौन है पापी, बुरा, बेपीर, खल॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "तुम रहे ढेले फलों पर फेंकते।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "पर बनाते फल रहे तुम को सफल॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "तोड़ कर फल को कतरता क्यों रहा।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "खा नही सकता उसे जब आप तू॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "मत पराये के लिये बेपीर बन।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "हाथ पापी लौं करे क्यों पाप तू॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "हाथ उन पर किस लिये तुम उठ गये।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "और उन को पीटने तुम क्यों चले॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "फूल सब है फूलते हित के लिये।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "है भले ही के लिये सब फल फले॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "&#8288;  हाथ और तलवार"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "खेलने पर के भरोसे क्या लगे।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "किस लिये हो भेद अपना खोलते॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "तोल तुम ने क्यों न अपने को लिया।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "हाथ तुम तलवार क्या हो तोलते॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "हाथ में तो तमकनत कम है नहीं।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "पर गई बेकारियाँ बेकार कर॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "ताब तो है वार करने की नहीं।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "वार जाते हैं मगर तलवार पर॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "जो रसातल जाति को है भेजते।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "क्यों न उन की आँख को पट्टी खुले॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "जो कि सहलाते सदा तलवा रहे।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "हाथ क्यों तलवार ले उन पर तुले॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "जब समय पर जाय बन बेजान तन।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "ताब हाथों में न जब हो वार की॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "तल बिचल हो जाँय जब तिल आँख के।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "क्या करेगी धार तब तलवार की॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "वह कहाँ पर क्या सकेगी कर नहीं।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "साहसी या सूरमा के साथ से॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "है हिला देती कलेजे बेहिले।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "चल गये तलवार हलके हाथ से॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "सब बड़े से बड़े लड़ाकों को।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "हैं दिये बेध बैध बरछी ले॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "फेर तलवार फेर में डाला।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "कर सके क्या न हाथ फुरतीले॥"
    }
  ]
}