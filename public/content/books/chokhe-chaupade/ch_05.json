{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_05",
  "number": 5,
  "title": "कुछ कलेजे",
  "word_count": 1156,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "निराले नगीने"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        हाथ और दान   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "भेद है बाप-मा-कलेजे मे।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "तर बतर एक दूसरा तर है॥"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "एक में कुछ कसर असर भी है।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "दूसरा बेकसर सरासर है॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "काम का बाप का कलेजा है।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "मा कलेजा मयाधरोहर है॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "एक है प्यार का बड़ा झरना।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "दूसरा प्यार का सरोवर है॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "प्यारवाला है कलेजा बाप का।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मा कलेजा प्यार से भरपूर है॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "जो रसीला आम मानें एक को।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "दूसरा तो रसभरा अगूर है॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "मा कलेजा दूध से है तरबतर।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "है कलेजा बाप का हित से हरा॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "है निछावर एक होता प्यार पर।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "दूसरा है प्यार से पूरा भरा॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "एक से मा बाप के है उर नहा।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "एक सी उन मे न है हित की तहे॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "है अगर वह फल तो यह फेन है।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "मोम उस को औ इसे माखन कहे॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "जनमने का एक ही रज-बीज से।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "कौन से सिर पर गया सेहरा धरा॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "एक भाई का कलेजा छोड़ कर।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "है कलेजा कौन सा भायप भरा॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "प्यार की जिस मे न प्यारी गध है।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "वह कमल जैसा खिला तो क्या खिला॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "चाहना उस से भलाई भूल है।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "जिस कलेजे में न भाईपन मिला॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "प्यार का दिल क्यों न तो हिल जायगा।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "भाइयों से जो न भाई हो हिले॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "तो मिलाने से मिलें क्यों दूसरे।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "जो न टुकड़े हों कलेजे के मिले॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "वह कलेजा नही सगे का है।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "चूकता जो रहा भलाई में॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "भूल से भूल है बड़ी कोई।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "हों भले भाव जो न भाई मे॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "है किसी काम की न वह भायप।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "है गया भूल जो कमाई में॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "क्यों भरा भेद तो कलेजे मे।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "हो अगर भेद-भाव भाई मे॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "चुहचुहाते हुए सहज हित का।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "है लबालब भरा हुआ प्याला॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "है कलेजा किसी बहिन का क्या।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "है खिली प्यार-बेलि का थाला॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "मा कलेजे से निकल हित-रंग में।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "जो निराले ढंग से ढलती रही॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "वह बड़ी नायाब धारा नेह की।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "है बहिन के ही कलेजे में बही॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "लग गये जिस के लगी ही लौ रहे।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "वह लगन सच्ची, वहो दिखला सका॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "एक जिस से दो कलेजे हो सके।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "प्यार वह, प्याई-कलेजा पा सका॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "डूब करके चाहतों के रग मे।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "प्रोति-धारा में परायापन बहा॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "हित उसी मे घर हमे करते मिला।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "प्यार-घर घरनी कलेजा ही रहा॥"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "हित-महॅक जिस की बहुत है मोहती।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "जो रहा जनचित-भँवर को चावथल॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "पासका जिस से बड़ी छबि प्यार-सर।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "है कलेजा बेटियों का वह कमल॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "जा रहा हे जगमगा हित-जोत से।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "चोप कगूरा सका जिस से बिलस॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "प्यार का जिस पर मिला पानिप चढ़ा।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "है कलेजा बेटियों का वह कलस॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "लाभ-पुट से लुभावनापन ले।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "रग है लाल प्यार लोहू का॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "लालसा से लसे हितों का थल।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "है कलेजा किसी पतोहू का॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "है उसी मे पूतपन को रगतें।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "हित रसों का है वही सुन्दर घड़ा॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "प्यार उस का ही दुलारा है बहुत।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "है कलेजा पूत का प्यारा बड़ा॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "बाप-मा-मान का हुआ अनमल।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "हित हुआ चूर, सुख गया दलमल॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "पा सका प्यार पल न कल जिस से।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "है कलेजा कपूत का वह कल॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "अब लोहा हुआ हुनर सोना।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "छू जिसे रिस हुआ अछूता रस॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "पाक है लोक-प्यार से पुर है।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "है कलेजा सपूत का पारस॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "&#8288;  कलेजा कमाल"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "है, लबालब भरा भलाई जल।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "सोहती है सहज सनेह लहर॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "है खिला लोक-हित-कमल जिस में।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "है कलेजा सुहावनी वह सर॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "है सुरुचि के जहाँ बहे सोते।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "है दिखाती जहाँ दया-धारा॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "पा सके प्यार सा जहाँ पारस।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "है कलेजा-पहाड़ वह प्यारा॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "सब रसों की कहाँ बही धारा।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "है कहाँ बेलि रीझ की ऐसी॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "है कहाँ भाव से भले पौधे।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "कौन सी कुंज है कलेजे सी॥"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "हैं जहाँ चोप से अनूठे पेड़।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "गा रहा है जहाँ उमग खग राग॥"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "है जहाँ लहलही ललक सी बेलि।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "है कलेजा लुभावना  वह बाग॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "मनचलापन मकान आला है।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "चोचला चौक चाववाला है॥"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "है चुहल से चहल पहल पूरी।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "नर-कलेजा नगर निराला है॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "है भले भाव देवते जैसे।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "है कही देवते नही वैसे॥"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "है कहीं भक्ति सी नही देवी।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "हैं न मंदिर कहीं कलेजे से॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "चेरियॉ है चुनी हुई चाहें।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "चाव सा है बड़ा चतुर चेरा॥"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "मन महाराज मति महारानी।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "है कलेजा महल सरा मेरा॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "है समझ को जहाँ समझ मिलती।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "है जहाँ ज्ञानमान मन जैसा॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "पढ़ जहाँ पढ़ गये अपढ़ कितने।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "है न कालिज कही कलेजे सा॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "हैं भरे दुख भयावने जिस में।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "है जहाँ आप पाप जैसा थम॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "है जलन आग जिस जगह जलती।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "है नरक से न नर-कलेजा कम॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "ठोसपन से ठसक गठन से हठ।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "ऐंठ भी है उठान से बढ़ चढ़॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "हैं गढ़ी बात की चढ़ी तोपें।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "नर-कलेजा गुमान का है गढ़॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "बुद्धि को कामधेनु करतब को--"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "जो कहें कल्पतरु, न बेजा है॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "है मगन मन उमंग नन्दनबन।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "स्वर्ग जैसा मनुज कलेजा है॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "&#8288;  कसौटी"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "पास खुटचाल पेचपाच कसर।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "कुढ़ कपट काटछॉट कीना है॥"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "क्यों करेगा नही कमीनापन।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "कम कलेजा नही कमीना है॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "हो भरा सब कठोरपन जिस में।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "संग कहना उसे न बेजा है॥"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "है ठसक, गाँठ, काठपन जिस में।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "वह बड़ा ही कठिन कलेजा है॥"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "कर खुटाई बढ़ा बढ़ा खटपट।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "प्यार को बेतरह पटकता है॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "है खटक खोट नटखटी जिस में।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "वह कलेजा बहुत खटकता है॥"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "काहिली, कलकान, कायरपन, कलह।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "क्यों न बेबस कर बढ़ा दें बेबसी॥"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "क्यों बचाई जा सकेगी पत बची।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "जब कचाई है कलेजे में कसी॥"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "मोह लेते मिला वही मन को।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "जो गया है न मोह मद से भर॥"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "काम के काम कर सका कुछ वह।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "जो कलेजा सका मकर कम कर॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "दूर अनबन वही सकेगा कर।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "जो बना रज का न प्याला है॥"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "क्यों पड़ेगा न मेल का लाला।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "जब कलेजा मलालवाला है॥"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "लोभ है तो झली ललक भी है।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "मान के साथ मन मगन भी है॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "है कसर ही नही कलेजे में।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "है अगर लाग तो लगन भी है॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "मोम है, है समान माखन के।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "जोंक है, और नोक नेजा है॥"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "फूल से भी कही मुलायम है।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "काठ से भी कठिन कलेजा है॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "दुख बड़े से बड़े उसी में हैं।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "है बड़ा दुख जिन्हें अँगेजे में॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "एक से एक हैं कड़े पचड़े।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "हैं बखेड़े  बड़े  कलेजे में॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "वही चलता उसी की चल सकी।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "जो बना चौचंद, चोखा, चरपरा॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "चालवाले को कलेजा चाहिये।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "चापलुसी, चाल, चालाकी भरा॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "क्यों रहे चैन उस कलेजे में।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "क्यों लटे वह न देख गत वाँ की॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "भूत-भय का जहाँ बसेरा है।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "है जहाँ पर चुडैल चिन्ता की॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "है भरा चेटकों चपेटों से।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "यह कलेजा उचाटवाला है॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "चुस्त है चिड़चिड़ा चटोरा है।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "चटपटी चाव चाटवाला है॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "क्या नहीं है भला कलेजे में।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "ढील है ढीठपन ढला रस है॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "है ढचर, हैं ढकोसले उस में।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "ढोंग है ढन ढूँढ ढाढ़स है॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "है बही जिस ठौर बेतरनी नदी।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "गंग की धारा वहाँ कैसे बहें॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "क्या बुरा है जो कलेजे में बुरे।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "बैर बदकारी बुराई बू रहे॥"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "है भरा बेहिसाब भोलापन।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "है भटक, भेद-भाव दावा है॥"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "और क्या है लचर कलेजे में।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "भूल है भय भरम भुलावा है॥"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "जो कलेजे कहे गये छोटे।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "क्यों न उन मे रहे छोटाई छल॥"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "बीर के ही बड़े कलेजे में।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "है बिनय बीरता बड़ाई बल॥"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "सुख सदा पास रह सका जिस के॥"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "है उसी एक को मिला सरबस।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "है कलेजा वही बसे जिस में॥"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "सुरता सादगी सुरुचि साहस।"
    }
  ]
}