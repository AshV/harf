{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "केसर की क्यारी",
  "word_count": 1216,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "गागर में सागर"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        ⁠सुनहली सीख   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "केसर की क्यारी"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अनूठी बातें"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "जो बहुत बनते हैं उन के पास से।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "चाह होती है कि कब कैसे टलें ॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "ओ मिले जी खोल कर, उन के यहाँ ।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "चाहता है जो कि सिर के बल चले ॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "भूल जावे कभी न अपनापन।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "जान दे पर न मान को दे, खो ॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "लोग जिस आँख से तुम्हें देखे।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "तुम उसी आँख से उन्हें देखो ॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "और को खोट देखती बेला।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "टकटकी लोग बाँध देते है ॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "पर कसर देखते समय अपनी।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "बेतरह आँख मूंद लेते है ॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "फिर कभी खुलने न पाई माँद वे।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "इस तरह मन के मसोसों से दुई ॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "मूँदते ही मूंदते मुख और का।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "मदभरी आँखे बहुत लो मुंद गई ॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "छोड़ संजीदगी सजे कूँचे।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "बन गये जब लोहार की कूँची ॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "तो बचा रह सका न ऊँचापन ।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "आँख भी रह सकी नही ऊँची ॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "कौन बातें बना सका अपनी ।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "बात बेढंग बढ़ा बढ़ा कर के ॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "आँख पर चढ़ गया न कौन भला ।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "आँख अपनी चढ़ा चढ़ा कर के ॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "बात सुन कर सिखावनों डूबी ।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "जो कि है ठीक राह बतलाती ॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "जब नही सूझ बूझ रग चढ़ा ।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "तब भला आँख क्यों न चढ़ जाती ॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "तुम भली चाल सीख लो चलना ।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "औ भलाई करो भले जो हो ॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "धूल मे मत बटा करो रस्सी ।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "आँख में धूल डालते क्यों हो ॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "ठीक वैसा न मान ले उस को ।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "जो कि जैसे लिवास मे दीखे ॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "जी अगर है टटोल लेना तो ।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "देखना आँख खोल कर सीखे ॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "चाह जो यह है कि हाथों से पले ।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "पेड़ पौधों से अनूठे फल चखें ॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "तो जिले है प्रॉख मे रखते सदा ।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "चाहिये हम आँख भी उस पर रखे ॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "जो न चित का नित बना चाकर रहा ।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "बात चितवन के नहीं जिस पर चले ॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "है जिसे पैसा नचा पाता नहीं ।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "आ सका ऐसा न आँखों के तले ॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "किस तरह से सॅमल सकेंगे वे ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "अपने को जो नही सँभालेंगे ॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "क्यों न खो देंगे आँख का तिल वे ।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "आँख का तेल जो निकालेगे ॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "सघ सकेगा काम तब कैसे भला ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "हम करेंगे साधने मे जब कसर ॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "काम आयेंगी नही चालाकियाँ ।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "जब करेंगे काम आँखें बद कर ॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "जब कि चालाको न चालाकी रही ।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "ओख उस पर तब न क्यों दी जायगी ॥"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "लोग उँगली क्यों उठायेंगे न तब ।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "जब कि उँगली आँख में की जायगी ॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "है खटकती किसे नही दुनिया ।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "लग सके कब खुटाइयों के पते ॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "तब परखते अगर परख वाली ।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "आँख के सामने उसे रखते ॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "क्यों कहें क्गालपन को भी कभी ।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "हैं खुली आँखें हमारी जाँचती ॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "सामने जो वे न नाचे ऑख के ।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "भूख से है आँख जिन की नाचती ॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "खिल उठे देख चापलूसों को।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "देख बेलौस को कुढ़े कांखें ॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "क्यों भला हम बिगड़ न जायेंगे।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "जब हमारी बिगड़ गई आँखें ॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "है जिसे सूझ ही नहीं उस को ।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "क्या करेंगे उधार कर आँखें ॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "है प्रसरता जहां अंधेरा वां।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "क्या करेंगे पसार कर आँखे ॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "कब जाओ न\" उलझनों मे पड़ ।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "जगलों को खंगाल कर देखो ॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "डाल दो हाथ पॉव मत अपना ।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "आँख मे श्रॉख डाल कर देखो ॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "ताक मे रात रात भर न रहे।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "सूइयां डालने से मुंह मोड़ें ॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "और को ऑख फोड़ देने को ।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "आँख अपनी कभी न हम फोड़े ॥"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "तब टले तो हम कही से क्या टले ।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "डाँट बतला कर अगर टाला गया ॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "तो लगेगी हाथ मलने आबरू ।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "हाथ गरदन पर अगर डाला गया ॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "है सदा काम ढग से निकला ।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "काम बेढंगपन न देगा कर ॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "चाह रख कर किसी भलाई की ।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "क्यों भला हो सवार गरदन पर ॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "बेहयाई, बहॅक, बनावट ने ।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "कस किसे नहि दिया शिकजे में ॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "हित-ललक से भरी लगावट ने ।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "कर लिया है किसे न पजे मे ॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "फल बहुत ही दूर, छाया कुछ नहीं ।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "क्यों भला हम इस तरह के ताड़ हो ॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "आदमी हो और हो हित से भरे ।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "क्यों न मूठी भर हमारे हाड़ हो ॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "काम आये, लोक के हित मे लगे ।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "ठीक पानी की तरह दुख में बहे ॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "धन रहा पर-हाथ में तो क्या रहा ।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "रह सके तो हाथ में अपने रहे ॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "बीनना, सीना, परोना, कातना ।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "गूंधना, लिखना न आता है कहे ॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "काम की यह बात है, हर काम मे ।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "बैठता है हाथै बैठाते रहे।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "जाय जिल से कुल कसर जी की निकल ।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "बोलनेवाले बचन वे बोल दे ॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "खोलनेवाले अगर खोले खुले ।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "तो किवाड़े छातियों के खोल दे ॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "दूसरा कोई अधम वेसा नही।।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "पाप जिस से हैं कराती पूरियाँ।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "वे पतित है पेट पापी के लिये।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "छातियों में भोंक दे जो छूरियाँ।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "रह सका काम का सुखी सुन्दर ।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "कौन सा अग दुख अंगेजे पर ॥"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "भूल है जल गरम अगर छिड़कें ।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "फूल जैसे नरम कलेजे पर ॥"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "इस जगत का जीव वह है ही नहीं ।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "लुट गये धन जी लटा जिस का नही ॥"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "हाथ की पूंजी गँवा, पड़ टूट में ।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "है कलेजा टूटता किस का नहीं ॥"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "बेतरह बेध बेध क्यों देवे ।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "भेद है जीभ और नेजे मे ॥"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "बात से छेद छेद कर के क्यों ।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "छेद कर दे किसी कलेजे में ॥"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "पढ़ गये हाथ आ गया पारस ।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "कढ़ गये गुन गया अँगेजा है ॥"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "चढ़ गये चाव चित गया चढ़ बढ़ ।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "बढ़ गये बढ़ गया कलेजा है ॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "मिल न पाया मान मनमानी हुई ।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "मोतियों के चूर का चूना हुआ ॥"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "दिलचलों के सामने बन दिलचले ।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "दून की ले दिल अगर दूना हुआ ॥"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "रंग उस का बहुत निराला है ।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "हम न उस रग को बदल देखें ॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "फूल से वह कही मुलायम है ।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "चाहिये दिल न मल मसल देवें ॥"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "हम उसे ठीक ठीक ही रक्खे ।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "औ उसे ठीक राह बतलावें ॥"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "चाहिये दिल उड़ा उड़ा न फिरे ।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "दिल पकड़ लें अगर पकड़ पावें ॥"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "प्रभु महक से है उसी के रीझते ।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "पी उसी का रस रसिक भौंरे जिये ॥"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "चार फल केवल उसी से मिल सके ।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "तोड़ते दिल-फूल को है किस लिये ॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "है निराली प्रभु-कला जिस में बसी ।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "वह निराला आइना है फूटता ॥"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "टूटती है प्यार की अनमोल कल ।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "तोड़ने से दिल श्रगर है टूटता ॥"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "जीभ को कस में रखें, काया कसें ।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "क्यों लहू कर के किसी का सुख लहे ॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "मारना जी का बहुत ही है बुरा ।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "जी न मारे मारत जी को रहे ॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "काम करते है मफर कर किस लिये ।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "इस मकर से प्यार प्यारा है कहो ॥"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "क्यों हमारा जी गिना जी जायगा ।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "हम अगर जी को समझते जी नही ॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "बात बनती नही बचन से ही ।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "काम सध कब सका सदा धन से ॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "मानते क्यों न मानने वाले ।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "वे मनाये गये नही मन से ॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "क्या बचन मीठे नहीं हम बोलते ।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "क्या हमारे पास सुन्दर तन नहीं ॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "पर भला कैसे रिझायें हम उसे ।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "रीम जिस का रीझ पाता मन नही ॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "बिष-बटी होवे न क्यों हीरे जड़ी ।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "जान उस को खा, गई खोई नहीं ॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "हाथ जो आ जाय सोने की छुरी ।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "पेट तो है मारता कोई नहीं ॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "है कुदिन मे किसे मिले मेवे ।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "जो मिले, आँख मूंद कर खा ले ॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "भूख मे साग पात क्यों देखे ।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "जो सके डाल पेट मे डाले ॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "चाहिये सारे बखेड़े दूर कर ।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "बात आपस की बिठाने को उठे ॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "आँख उठती दीन दुखियों पर रहे ।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "पॉव गिरतों के उठाने को उठे ॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "भक्ति अधी भली नही होती ।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "भाव होते भले नहीं लूंजे ॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "है अगर पॉव पूजना ही तो ।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "पूजने जोग पाँव ही पूजे ॥"
    }
  ]
}