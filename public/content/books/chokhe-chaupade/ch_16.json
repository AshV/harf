{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_16",
  "number": 16,
  "title": "बहारदार बातें",
  "word_count": 1574,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "जाति के कलंक"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;   बहारदार बातें"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  बसंत बहार"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "आ बसत बना रहा है और मन।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "बौर आमों को अनूठा मिल गया।।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "फूल उठते है सुने कोयल-कुहू।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "फूल खिलते देख कर दिल खिल गया॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "आम बौरे, कूकने कोयल लगी।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "ले महॅक सुन्दर पवन प्यारी चली॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "फूल कितनी बेलियों मे खिल उठे।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "खिल उठा मन, खिल उठी दिल की कली॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "भर उमगों मे भँवर हैं गूँजते।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "कोयलों का चाव दोगुना हुआ॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "चाँदनी की चद की चोखी चमक।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "देख चित किस का न चौगूना हुआ।।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आम बौरे बही बयार बसी।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सज लताये हरी भरी डोली॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "बोल बाला बसत का होते।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "खिल उठी बेलि, कोयले बोली॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "भॉवरें बार बार भर भौरे।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "फूल को देख कर फबन भूले॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "कोपलें देख कोयले कूकी।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "दिल-कमल खिल गया कमल फूले॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "हैं निराली रंगतें दिखला रहीं।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "सेत कलियाँ, लाल नीली कोपलें॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "फूल नाना रग के, पत्ते हरे।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "भौंर काले और काली कोयलें॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "हैं लुभाती दिल भला किस का नही।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "लहलहाती बेलि फूलों की महँक॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "गूँज भौंरों को, तितलियों की अदा।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "कोयलों की कूज, चिड़ियों की चहक॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "हैं फबे आज बेल बुटे भी।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "झाड़ियों पर लसी लुनाई है॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "दूब पर है अजब छटा छाई।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "फूल ला घास रंग लाई है।।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "आज है और रग कॉटों का।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "फूल है अंग बन गये जिन के॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "कुछ अजब ढग का हरापन पा।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "हो गये है हरे भरे तिनके ॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "चाँद मे है भर गई चोखी चमक।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "चाँदनी में है भरी चाही तरी॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "है फलों में भर गई प्यारी फबन।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "फूल मे हैं रगतें न्यारी भरी॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "&#8288;  बसंत के पौधे"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "कोंपलों से नये नये दल से।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "है फबन से निहाल कर देते॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "हो गये हैं लुभावने पौधे।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "फूल है दिल लुभा लुभा लेते॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "है सभी पेड़ कोंपलों से पुर।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "है नया रस गया सबों मे भर।।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "आम सिरमौर बन गया सब का।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "मौर का मौर बॉध कर सिर पर॥"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "लस रही है पलास पर लाली।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "या घिरी लालरी बबूलों से॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "है लुभाते किसे नही सेमल।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "लाल हो लाल लाल फूलों से।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "लह बड़ी ही लुभावनी रगत।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "फूल कचनार औ अनार उठे॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "फूल पाकर बहार मे प्यारे।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "हो बहुत ही बहारदार उठे।।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "पा गये पर बहार सा मौसिम।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "क्यों न अपनी बहार दिखला ले॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "लहलही बेलि, चहचहे खग के।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "डहडहे पेड़, डहडही डालें॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "लस रही हैं कोंपलों से डालियॉ।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "फूल उन को फूल कर हैं भर रहे।।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "हर रहा है मन हरापन पेड़ का।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "जी हरा पत्ते हरे है कर रहे।।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "रस नया है समा गया जड़ में।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "रंगते है बदल रही छालें।।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "पेड़ है थालियॉ बने फल की।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "फूल की डालियाँ बनी डालें।।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "है उसे दे रहे निराला सुख।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "कर रहे हैं तरह तरह से तर॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "ऑख मे भर रहे नयापन है।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "पेड़, पत्ते नये नये पाकर॥"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "रगतें न्यारी बड़ी प्यारी छटा।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "कर रहे है लाभ मिट्टी धूल से॥"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "पा रहे है पेड़ फल फल दान का।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "कोपलों, कलियों, फलों से, फूल से॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "पेड़ प्यारे पलास सेमल के।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "फूल पा लाल, लाल लाल हुए।।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "है बहुत ही लुभावने लगते।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "लाल दल से लसे हुए महुए॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "पाकरों औ बरगदों के लाल दल।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "कम लुनाई से न मालामाल है॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "है हरे दल में बहुत लगते भले।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "डालियों की गोदियों के लाल है॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "छा गई है बड़ी छटा उन पर।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "बन गये है बहार के छत्ते॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "है लुनाई विजय फरहरे से।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "छरहरे पेड़ के हरे पत्ते॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "हो गये है कुछ हरे, कुछ लाल हैं।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "कुछ गुलाबी रंग से हैं लस रहे॥"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "श्राम के दल रंगतें अपनी बदल।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "बाँध कर दल हैं दिलों में बस रहे॥"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "रस बहे बौर देख कर उन में।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "उर रहे जो बने तवे पत्ते।।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "कर रहे हैं निहाल आमों के।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "लाल नीले हरे भरे पत्ते।।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "है रही दिल लुभा नही किस का।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "कोंपलों को लुभावनी लाली॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "रस भरे फूल, छबि भरी छालें।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "दल भरे पेड़, फल भरी डाली।।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "सोहते है नये नये पत्ते।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "मोहती है नवीन हरियाली॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "हैं नये पेड़ भार से फल के।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "है नई फूल-भार से डाली।।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "फूल को फेली महँक के भार से।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "चाल धीमी है पवन की हो गई।।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "हैं फलों के भार से पौधे नये।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "है नये दल-भार से डाली नई॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "जो न होतो हरी हरी पत्ती।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "कौन तो ताप धूप का खोती॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "क्यां भली छॉह तन तपे पाते।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "क्यों तपी आँख तरबतर होती।।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "धूप तीखी पतन तपी रूखी।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "तो बहुत हो उसे सता पाती॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "तर न करते अगर हरे पत्ते।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "किस तरह आँख में तरी आती।।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "&#8288;  बसंत की बेलि"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "खिल दिलों को है बहुत बेलमा रही।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "है फलों फूलों दलों से भर रही।।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "खेल कितने खेल प्यारी पौन से।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "बेलियाँ अठखेलियाँ है कर रही।।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "बेलियों मे हुई छगूनी छवि।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "बहु छटाया गया लता का तन॥"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "फूल फल दल बहुत लगे फबने।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "पा निराली फबन फबोले बन॥"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "है लुनाई बड़ी लताओं पर।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "है चटकदार रँग चढ़ा गहरा॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "लह बड़े ही लुभावने पत्ते।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "लहलही बेलि है रही लहरा॥"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "फूल के हार पैन्ह सज धज कर।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "बन गई है बंसत की दुलही॥"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "हो लहालोट, हैं रही लहरा।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "लहलही बेलियाँ लता उलही॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "पा छबीला बसत के ऐसा।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "क्यों न छबि पा लता छबीली हो॥"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "बेलियों क्यों बने न अलबेली।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "फूल फल फेल फब फबीली हो।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "&#8288;  बसंत के फूल"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "रस टपक है रहा फले फल से।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "है फबन साथ फब रही फलियाँ॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "फूल सब फूल फूल उठते हैं।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "खिलखिला है रही खिली कलियाँ।।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "पेड़ सब है कोपलो से लस रहे।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "है लुनाई बेल, बाँस, बबूल पर॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "है लता पर, बेलि पर छाई छटा।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "है फबन फैली फलों पर, फूल पर॥"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "तन, नयन, मन सुखी बनाते है।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "पेड़ के दल हरे हरे हिल कर॥"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "बास से बस बसत की ब्हैर।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "फूल की धूल धूल से मिल कर।।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "रस भरा एक एक पत्ता है।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "आज किस का न रस बना सरबस॥"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "फूल से ही न रस बरसता है।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "फल पर भी बरस रहा है रस॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "कर दिलों का लहू लहू डूबे।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "छुरे पूच पालिसी के हैं।।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "या खिले लाल फूल टेसू के।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "या कलेजे छिले किसी के है।।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "आज काँटे बखेर कर जी में।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "फूल भी हो गया कटीला है॥"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "चिटकती देख कर गुलाब-कली।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "चोट खा चित हुआ चुटीला है॥"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "&#8288;  बसंत बयार"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "फूल है घूम घूम चूम रही।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "है कली को खिला खिला देती॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "है महँक से दिसा महँकती सी।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "है मलय-पौन मोह दिल लेती॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "है सराबोर सी अमीरस में।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "चाँदनी है छिड़क रही तन पर॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "घूम मह मह महक रही है वह।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "बह रही है बसंत की बैहर॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "मंद चल फूल की महँक से भर।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "सूझती चाल जो न भूल भरी॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "आँख में धूल झोंक धूल उड़ा।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "तो न बहती बयार धूल भरी॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "फूल को चूम, छू हरे पत्ते।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "बास से बस जगह जगह अड़ती॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "जो न पड़ती लपट पवन ठंढी।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "तो लपट धूप की न पट पड़ती॥"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "&#8288;  कोयल"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "कूक करके निज रसीले कंठ से।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "है निराला रस रगों में भर रही।।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "कोयले से रंग में रंगत दिखा।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "है दिलों में कोयलें घर कर रही।।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "रंग बिरंगे फूल है फूले हुए।"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "है दिसायें रँग बिरगी गूँजती॥"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "चहचहा चिड़ियाँ रही हैं चाव से।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "भौंर गूँजे, कोयलें हैं कूजती॥"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "मन मराया दिल हुआ कुछ और हो।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "कोपलों में हे छटा वेसी कहाँ।।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "सुन जिसे जी की कली खिलती रही।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "कोयलों में कूक है ऐसी कहाँ।।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "देख करके दुखी जनों का दुख।"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "दुद है वह मचा रही पल पल।।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "या किसी का कराहना सुन कर।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "बेतरह है कराहती कोयल॥"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "जो हुआ है लालसाओं का लहू।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "लाल फल दल है उसी में ही रँगा॥"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "हे उसी का दर्द कोयल कूक में।"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "कोपलों मे है वही लोहू लगा।।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "&#8288;  बसंत के भौरे"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "गूँज कर, झुक कर, झिझक कर, झूम कर।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "भौंर करके झौंर रस ले रहे॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "फूल का खिलना, बिहॅसना, बिलसना।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "दिल लुभाना देख है दिल दे रहे॥"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "गूँजते गूँजते उमग में आ।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "है बहुत्त चौक चौक कर अड़ते॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "चाव से चूम चम कलियों को।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "मनचले भौर है मचल पड़ते।।"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "हैं रहे घूम घूम रस लेते।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "घूम से झूम झूम आते है॥"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "देह-सुध भूल भूल कर भौंरे।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "फूल को चूम चूम जाते हैं।।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "गूँजते हैं, ललक लपटते है।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "है दिखाते बने हुए बौरे।"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "कर रहे है नही रसिकता कम।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "रसभरे फूल के रसिक भौरे॥"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "चौगुने चाव साथ रस पी पी।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "झोर वह ठौर ठौर करती है।।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "आँख भर देख दख फूल फबन।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "भाँवरें भौर भीर भरती है।।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "&#8288;  हम और तुम"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "हम तुमारे लिये रहें फिरते।"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "आँख तुम ने न आज तक फेरी॥"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "हम तुमें चाहते रहेंगे ही।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "चाह चाहे तुमें न हो मेरी॥"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "पेड़ हम हैं, मलय-पवन तुम हो।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "तुमें अगर मेघ, मोर तो हम है।।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "हम भँवर हैं, खिले कमल तुम हो।"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "चन्द जो तुम, चकोर तो हम है॥"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "कौन है जानकार तुम जैसा।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "है हमारा अजान का बाना॥"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "तुम हमें जानते जनाते हो।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "नाथ हम ने तुमें नहीं जाना॥"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "तुम बताये गये अगर सूरज।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "तो किरिन क्यों न हम कहे जाते॥"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "तो लहर एक हम तुमारी हैं।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "तुम अगर हो समुद्र लहराते॥"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "तब जगत में बसे रहे तुम क्या।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "जब सके आँख में न मेरी बस॥"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "लग न रस का सका हमे चसका।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "है तुमारा बना बनाया रस॥"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "हम फँसे ही रहे भुलावों में।"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "तुम भुलाये गये नही भूले।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "नित रहा फूलता हमारा जी।"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "तुम रहे फूल की तरह फूले॥"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "है यही चाह तुम हमे चाहो।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "देस-हित में ललक लगे हम हों॥"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "रंग हम पर चढ़ा तुमारा हो।"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "लोक-हित-रंग में रँगे हम हों।।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "तुम उलझते रहो नही हम से।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "उलझनों में उलझ न हम उलझें॥"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "तुम रहो बार बार सुलझाते।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "हम सदा ही सुलझ सुलझ सुलझें।।"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "भेद तुम को न चाहिये रखना।"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "क्यों हमें भेद हो न बतलाते॥"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "हो कहाँ पर नही दिखाते तुम।"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "क्यों तूूमें देख हम नहीं पाते।।"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "बहारदार बातें"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "जो कि तुम हो वही बनेंगे हम।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "दूर सारे अगर मगर होंगे।।"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "हम मरेंगे, नहीं मरोगे तुम।"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "पा तुम्हें हम मरे अमर होंगे।।"
    }
  ]
}