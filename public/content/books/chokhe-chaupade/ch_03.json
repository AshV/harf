{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_03",
  "number": 3,
  "title": "अनमोल हीरे",
  "word_count": 1568,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "नोक झोंक"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        अन्योक्ति   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "देख कर रंग जाति का बदला।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "जाति का रंग है बदल जाता॥"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "देख आँखें हुईं लहू जैसी।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "आँख में है लह उतर आता॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "देख दुख से अधीर सगी को।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "है जनमसंगिनी लटी पड़ती॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "दाढ़ है दॉत के दुखे दुखती।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "सिर दुखे आँख है फटी पड़ती॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तब भलाई भूल जाती क्यों नहीं।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "जब सचाई ही नही भाती रही॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "जोत तब कैसे चली जाती नही।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "जब किसी को आँख ही जाती रही॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "कौन आला नाम रख आला बना।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "है जहाँ गुन, है निरालापन वहीं॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "साँझ फूली या कली फूली फबी।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "आँख को फूली फबी फूली नहीं॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "एक से जो दिखा पड़े, उन का।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "एक ही ढंग है न दिखलाता॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "है कमल फूलना भला लगता।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "आँख का फूलना नहीं भाता॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "काम क्या अंजाम देगा दूसरा।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "जब नही सकते हमीं अंजाम दे॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "दे सकेगा काम सूरज भी तभी।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "जब कि अपनी आँख का तिल काम दे॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "पड़ बुरों मे संगतें पाकर बुरी।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "सूझ वाला कब बुराई मे फँसा॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "देख लो काली पुतलियों मे बसे।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "आँख के तिल में न कालापन बसा॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "तब भला मैली कुवैली औरते।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "क्यों न पायेंगी निराले पूत जन॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "आँख की काली कलूटी पुतलियां।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "जब जनें तिल सा बड़ा न्यारा रतन॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "फूट पड़ता है उँजाला भी वहाँ।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "घोर अंधियाली जहाँ छाई रही॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "जगमगा काली पुतलियों में हमें।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "जोत वाले तिल जताते हैं यही॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "सूझ वाले एक दो ही मिल सके।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "और सब अधे मिले हम को यहां॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "देखने को देह मे तिल है न कम।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "ऑख के तिल से मगर तिल है कहां॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "वह कभी खीच तान मे न पड़ा।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "है जिसे आन बान की न पड़ी॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "मोतियों से बनी लड़ी से कब।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "आँसुओं की लड़ी लड़ी झगड़ी॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "बीरपन से तन गयों के सामने।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "कब जुलाहे तन सके ताना तने॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "सूर कहला ले, मगर क्यों सूरमा।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "सूरमापन के बिना अंधा बने॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "भेख सच्चा दिखा पड़ा न हमे।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "देख पाये जहाँ तहाँ भेखी॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "फूल कब पा सके किसी से हम।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "नाक फूली हुई बहुत देखी॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "वे सभी क्यारियां निराली है।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "बेलियां है जहा अजीब खिली॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "कब सकी बोल बोलियाँ न्यारी।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "बोलती नाक कम हमे न मिली॥"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "जिस जगह पर लगें भले लगने।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "चाहिये हम वहीं उमग अटकें॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "है कहीं पर अगर लटक जाना।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "तो लटें गाल पर न क्यों लटके॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "लोग कैसे उलझ सकेंगे तब।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "जब हमारी निगाह हो सुलझी॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "बात होते हुए उझलने की।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "लट कभी गाल से नहीं उलझी॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "है लुनाई फिसल रही जिस पर।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "है उसे काम क्या कि कुछ पहने॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "गोल सुथरे सुडौल गालों के।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "बन गये रूप रग ही गहने॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "कुछ बड़ों से हो न, पर कितनी जगह।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "काम करता है बड़ों का मेल ही॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "पत बचाती है उसी की चिक नई।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "माल का तिल क्यों न हो बेतेल ही॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "सब जगह बात रह नहीं सकती।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "बात का बॉध दें भले हो पुल॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "हम रहे क्यों न गुलगुले खाते।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "रह सका गाल कब सदा गुलगुल॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "जो कि सुख के बने रहे कीड़े।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "वे पड़े देख दुख उठाते भी॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "जो उठें तो उठें सँभल करके।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "हैं उठे गाल बैठ जाते भी॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "खोजने ले भले नही मिलते।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "पर बुरों के सुने कहां न गिले॥"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "मिल गये बार, बार बू वाले।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "मुँह मँहकते हमें कहीं न मिले॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "लत बुरी छूटती नहीं छोड़े।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "क्यों न दुख के पड़े रहे पाले"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "पान का चाबना कहाँ छूटा।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "मुँह छिले और पड़ गये छाले॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "जो उन्हें गुन का सहारा मिल सके।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "बात तो कब गढ़ नहीं लेते गुनी॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "दख तो पाई नहीं पर बारहा।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "बान 'बूढ़े' मुँह मुंहासे' की सुनी॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "दुख मिले चाहे किसी को सुख मिले।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "है सभी पाता सदा अपना किया॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "आप ही तो वह अँधेरे मे पड़ा।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "जो किसी मुँह ने बुझा दीया दिया॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "जो भरोसे न भाग के सोये।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "दैव उन से फिरा नही फिर कर॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "जो रखें जान गिर उठें वे ही।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "कब भला दाँत उठ सका गिर कर॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "हैं दुखी दीन को सताते सब।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "हो न पाई कभी निगहबानी॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "लग सका और दाँत में न कभी।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "हिल गये दाँत मे लगा पानी॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "नटखटों से बचे रहे कब तक।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "जब उन्हे छोड़ नटखटी न हटी॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "क्या हुआ बार बार बच बच कर।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "कब भला दाँत से न जीभ कटी॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "क्यों किसी बेगुनाह को दुख दें।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "छूट क्यों जाँय कर गुनाह सगे॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "और के हाथ में लगे तब क्यों।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "जब बुरी जीभ में न दॉत लगे॥"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "जो बड़प्पन है न तो कैसे बड़ा।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "बन सके कोई बड़ाई पा बड़ी॥"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "देख लो कबि के बनाने से कहाँ।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "दाँत की पाँती बनी मोती-लड़ी॥"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "सैकड़ों नेकियाँ किये पर भी।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "नीच है ढा बिपत्ति कल लेता॥"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "जीभ है दाँत की टहल करती।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "दाँत है जीभ को कुचल देता॥"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "कर सकेगे हित बने उतना न हित।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "कर सकेगा हित सदा जितना सगा॥"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "दे सकेंगे सुख न असली दाँत सा।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "देख लो तुम दाँत चॉदी के लगा॥"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "है बुरी लत का लगाना ही बुरा।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "बन हठीली क्यों न वह हठ ठानती॥"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "हम अमी भर भर कटोरी नित पियें।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "पर चटोरी जीभ कब है मानती॥"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "नित बुराई बुरे रहें करते।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "पर भली कब भला रही न भली॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "दाँत चाहे चुभें, गड़ें, कुचलें।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "पर गले दाँत जीभ कब न गली॥"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "सग दुखों से सगा दुखी होगा।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "जल ढलेगा जगह मिले ढालू॥"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "प्यास से जब कि सूखता है मुँह।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "जायमा सूख तब न क्यों तालू॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "हित करेंगे जिन्हे कि हित भाया।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "लोग चाहे बने रहे रूखे॥"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "जीभ क्यों चाट चाट तर न करे।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "लब तनिक भी अगर कभी सूखे॥"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "जो भले हैं भला करेंगे ही।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "कुछ किसी से कभी बने न बने॥"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "तर किया कब न जीभ ने लब को।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "क्या किया जीभ के लिये लब ने॥"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "बस नहीं जिस बात मे ही चल सका।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "हो गई उस बात में ही बेबसी॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "क्यों न भूखा भूख के पाले पड़े।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "क्यों न सूखा मुँह हाँसे सूखी हँसी॥"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "कर सकेंगी संगते कैसे असर।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "सब तरह की रंगतें जब हों सधी॥"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "लाल कब लब की ललाई से हुई।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "कब हॅसी उस की मिठाई से बँधी॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "बाढ़ परवाह ही नही करती।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "क्यों न उस पर बिपत्ति हो ढहती॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "हम मुड़ा लाख बार दें लेकिन।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "मूॅछ निकले बिना नहीं रहती॥"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "है सभी खीज खीज जाते तब।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "रज जब जान बूझ है देते॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "बीसियों बार मनचले लड़के।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "मूॅछ तो नोच नोच हैं लेते॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "हो सके काम जो समय पर हो।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "हो सका वह न ठान ठाने से॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "पाँव लेवें जमा भले ही हम।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "मूॅछ जमती नही जमाने से॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "पट सके, या पट न औरों से सके।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "पर कहीं \"नटखट\" भला है बन गया॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "पड़ सके या पड़ सके पूरी नहीं।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "मूॅछ भूरी का न भूरापन गया॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "कब भलाई से भलाई ही हुई।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "सादगी से बात सारी कब सधी॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "साध रह जाती सिधाई की नही।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "देख सीधी दाढ़ियों को भी बँधी॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "बाहरी रूप रग भावों ने।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "भीतरी बात है बहुत काढ़ी॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "खुल भला क्यों न जाय सीधापन।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "देख सीधी खुली हुई दाढ़ी॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "गुन तभी पा सके निरालापन।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "जब गुनी जन बुरे नहीं होते॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "सुर तभी है कमाल दिखलाते।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "जब गले बेसुरे नहीं होते॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "है किसी मे अगर नही जौहर।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "बीर तो वह बना न कर हीले॥"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "सूरमापन कभी नही पाता।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "काट सूरत गला भले ही ले॥"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "जो बना जैसा बना वैसा रहा।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "बन सका कोई बनाने से नहीं॥"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "चितवने तिरछी सदा तिरछी मिली।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "गरदनें ऐंठी सदा ऐंठी रही॥"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "सब पढ़ पा सके न पूरा ज्ञान।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "हे बहुत से पढ़े लिखे भी लठ॥"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "सुर सबों में दिखा सका न कमाल।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "कम न देखे गये सुरीले कठ॥"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "सब दयावान ही नहीं होते।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "औ सभी हो सके कभी न भले॥"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "सैकड़ों ही कठोर हाथों से।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "फूल से कठ पर कुठार चले॥"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "बात मुॅह से तब निकल कैसे सके।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "जब सती का हाथ लोहू मे सने॥"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "फूट पाये कठ तब कैसे भला।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "कठ-माला कठमाला जब बने॥"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "क्यों हुनर दिखला न मन को मोह लें।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "दूसरों के रूप गुन पर क्यों जलें॥"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "कोयले से रग पर ही मस्त रह।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "हैं निराला राग गातीं कोयलें॥"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "पा सहारा जाति के ही पाँव का।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "जाति का है पाँव जम कर बैठता॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "जाति ही है जाति की जड़ खोदती।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "हाथ ही है हाथ को तो ऐंठता॥"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "ढग से बचते बचाते ही रहें।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "बे-बचाये कौन बच पाया कही॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "जो बचावों को नहीं है जानता।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "ब्यांचने से हाथ वह बचता नहीं॥"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "कौन बैरी हितू किसो का है।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "है समय काम सब करा लेता॥"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "तरबतर तेल से किया जिस ने।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "है वही हाथ सर कतर देता॥"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "कर सकी न बुरा बुरी संगति उसे।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "दैव दे देता जिसे है बरतरी॥"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "बाँह बदबूदार होती ही नहीं।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "क्यों न होवे काँख बदबू से भरी॥"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "नेक तो नेकियाँ करेंगे ही।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "क्यों बिपद पर बिपद न हो आती॥"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "क्या नहीं पाक दूध देती है।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "पीप से भर गई पकी छाती?॥"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "है बुरी रुचि ही बना देती बुरा।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "क्यों सहें लुचपन भली रुचि-थातियाॅ॥"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "लाड़ दिखला दूध पीने के समय।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "क्या नहीं लड़के पकड़ते छातियाॅ॥"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "भेद कुछ छोटे बड़े मे है नही।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "बान पर-हित की अगर होवे पड़ी॥"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "थातियाॅ हित की बनी सब दिन रही।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "हों भले ही छातियाँ छोटी बड़ी॥"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "दैव की करतूत ही करतूत है।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "कब मिटाये अंक माथे के मिटे॥"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "आज तक तो एक भी छाती नहीं।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "हो सको चौड़ी हथौड़ी के पिटे॥"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "दुख न सब को सका समान सता।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "मिस गये फूल लौं सभी न मिसे॥"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "वह दिया जाय पीस कितना ही।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "पाँव बनता नहीं पिसान पिसे॥"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "पोसते लोग हैं निबल को ही।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "गो सबल बार बार खलते हे॥"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "जब गये फूल हो गये मसले।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "सग को पाँव कब मसलते हैं॥"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "नीच से नीच क्यों न हो कोई।"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "है न ऊँचे टहल-समय टलते॥"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "पॉव जब दुख रहे हमारे हो।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "हाथ तब क्या उन्हे नही मलते॥"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "ऐठ मे डूब जो बहुत बँहका।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "क्यों न उस पर भला बिपद पड़ती॥"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "जब गई फूल औ चली इतरा।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "किस लिये तब न पखड़ी झड़ती॥"
    }
  ]
}