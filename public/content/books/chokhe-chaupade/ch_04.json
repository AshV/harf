{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_04",
  "number": 4,
  "title": "अन्योक्ति",
  "word_count": 1051,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "&#8288;  बाल"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "बीर ऐसे दिखा पड़े न कही।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "सब बड़े आनबान साथ कटे॥"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "जब रहे तो डटे रहे बढ़ कर।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "बाल भर भी कभी न बाल हटे॥"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "तुच गये, खिच उठे, गिरे, टूटे।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "और भख मार अन्त में सुलझे॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "कंघियों ने उन्हें बहुत झाड़ा।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "क्या भला बाल को मिला उलझे॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "मैल अपना सके नहीं कर दूर।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "और रूखे बने रहे सब काल॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "मुड़ गये जब कि वे सिधाई छोड़।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "तो हुआ ठीक मुड़ गये जो बाल॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "है दुखाते बहुत, गले पड़ कर।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "सब उन्हें हैं सियाहदिल पाते॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "है कमी भो नहीं कड़ाई मे।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "किस लिये बाल फिर न झड़ जाते॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "वे कभी तो पड़े रहे सूखे।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "औ कभी तेल से रहे तर भी॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "की किसी की नही परवा।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "बाल ने बाल के बराबर भी॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "या बरसता रहा सुखों का मेह।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "या अचानक पड़ा सुखों का काल।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "धार से पा बहुत सुधार सुधार।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "बन गये या गये बनाये बाल॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "निज जगह पर जमे रहे तो क्या।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "क्या हुआ बार बार धुल निखरे॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "चल गये पर हवा बहुत थोड़ी।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "जब कि ए बाल बेतरह बिखरे॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "धूल में मिल गया बड़प्पन सब।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "था भला, थे जहां, वही झड़ते।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "क्या यही चाहिये सिरों पर चढ़।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "बाल हो पाँव पर गिरे पड़ते॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "किस तरह हम तुम्हें कहें सीधे।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "जब कि हो ऑख में समा गड़ते।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "हो न सुथरे न चीकने सुधरे।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "जब कि हो बाल तुम उखड़ पड़ते॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "&#8288;  &#8288;  चोटी"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "जा समय के साथ चल पाते नही।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "टल सकी टाले न उन की दुख-घड़ी॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "छीजती छॅटती उखड़ती क्यों नही।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "जब कि चोटी तू रही पीछे पड़ी॥"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "निज बड़ों के सॅग बुरा बरताव कर।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "है नहीं किस की हुई साँसत बड़ी॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "क्यों नही फटकार सहती बेतरह।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "जब कि चोटी मूँड के पीछे पड़ी॥"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "&#8288;  सिर और पगड़ी"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "सिर! उछाली पगड़ियाँ तुम ने बहुत।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "कान कितनों का करार यों ही दिया॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "लोग भारो कह भले ही लें तुम्हें।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "पर तुमारा देख भारीपन लिया॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "सूझ के हाथ पॉव जो न चले।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "जो बनी ही रही समझ लॅगड़ी॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "तो तुमारी न पत रहेगी सिर।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "पॉव पर डालते फिरे पगड़ी॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "जब तुम्ही ने सब तरह से खो दिया।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "तो बता दो काम क्या देती सई॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "सोच है पगड़ी उतरने का नहीं।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "सिर! तुमारी तो उतर पत भी गई॥"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "देखता हू आजकल की लत बुरी।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "सिर तुमारी खोपड़ी पर भी डटी॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "लाज पगड़ी की गॅवा, मरजाद तज।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "जो तुमारी टोपियों से ही पटी॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "दो जने कोई बदल करके जिन्हे।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "कर सके भायप रँगों मे रँग बसर॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "है तुमारे सारपन की ही सनद।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "सिर तुमारी उन पगड़ियों का असर॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "&#8288;  सिर और सेहरा"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "सोच लो, जी मे समझ लो, सब दिनों।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "यों लटकती है नही मोती-लड़ी॥"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "जव कि तुम पर सिरसजा सेहरा बॅधा।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "मुॅह छिपाने की तुम्हे तब क्या पड़ी॥"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "ला न दे सुख मे कहीं दुख की घड़ी।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "ढा न दें कोई सितम आँखें गड़ी॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "मौर बँधते ही इसी से सिर तुम्हें।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "देखता हूॅ मुॅह छिपाने की पड़ी॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "अनसुहातो रगतें मुॅह की छिपा।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "सिर! रहें रखतो तुम्हारी बरतरी॥"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "इस लिये ही हैं लटक उस पर पड़ी।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "मौर की लड़ियां खिले फलों भरी॥"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "पाजियों के जब बने साथी रहे।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "जब बुरों के काम भी तुम से सधे॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "क्या हुआ सिरमौर तो सब के बने।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "क्या हुआ सिर! मौर सोने का बँधे॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "&#8288;  &#8288;  सिर और पाँव"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "जो बड़े हैं भार जिन पर है बहुत।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "वे नही है मान के भूखे निरे॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "है न तन के बीच अगों की कमी।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "पर गिरे जब पॉव पर तब सिर गिरे॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "लोग पर के सामने नवते मिले।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "पर न ये कब निज सगों से, जी फिरे॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "दूसरों के पॉव पर गिरते रहे।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "पर भला निज पाँव पर कब सिर गिरे॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "तोड़ सोने को न लोहा बढ़ सका।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "मोल सोने का गया टूटे न गिर॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "पाँव ने सिर को अगर दी ठोकरे।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "तो हुआ ऊँचा न वह, नीचा न सिर॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "&#8288;  &#8288;  सिर"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "क्या हुआ पा मये जगह ऊॅची।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "जो समझ औ विचार कर न चले॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "सिर! अगर तुम पड़े कुचालों मे।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "तो हुआ ठीक जो गये कुचले॥"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "जो कि ताबे बने रहे सब दिन।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "वे सँभल लग गये दिखाने बल॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "हाथ क्या, उॅगलियां दखाती हैं।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "सिर मिला यह तुम्हें दबे का फल॥"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "सोच कर उस की दसा जी हिल गया।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "जो कि मुॅह के बल गिरा ऊॅचे गये॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "जब बुरे कॅचे तुम्हें रुचते रहे।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "सिर! तभी तुम बतरह कूॅचे गये॥"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "पा जिन्हें धरती उधरती ही रही।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "लोग जिन के अवतरे उबरे तरे॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "सिर! गिरे तुम जो न उन के पॉव पर।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "तो बने नर-देह के क्या सिरधरे॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "है जिसे प्रभु की कला सब थल मिली।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "पत्तियों में, पेड़ में, फल फूल में॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "ली नहीं जो धूल उन के पाँव की।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "सिर! पड़े तो तुम बड़ी ही भूल मे॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "बात वह भूले न रुचनी चाहिये।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "जो कि तुम को बेतरह नीचा करे॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "सिर! तुम्हीं सिरमौर के सिरमौर हो।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "औ तुम्ही हो सिरधरों के सिरधरे॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "दे जनम निज गोद मे पाला जिन्हें।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "क्या पले थे वे कटाने के लिये॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "खेद है सुख चाह बेदी पर खुले।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "सिर ! बहुत से बाल तू ने बलि दिये॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "बाल मे सारे फुलेलों के मले।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "सब सराहे फूल चोटी मे लसे॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "सिर! सुबासित हो सकोगे किस तरह।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "जब बुरी रुचि-बास से तुम हो बसे॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "कब नही उसकी चली, कुल ब्योंत ही।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "सब दिनों जिस की बनी बाँदी रही॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "माँग पूरी की गई है कब नही।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "सिर! तुमारी कर्ब नहीं चॉदी रही॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "सिर! छिपाये छिप न असलीयत सकी।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "बज सके न सदा बनावट के डगे॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "सब दिनों काले बने कब रह सके।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "बाल उजले बार कितने ही रँगे॥"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "छोड़ रगीनी सुधर सादे बनो।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "यह सुझा कर बीज हित का बो चले॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "चोचले करते रहोगे कब तलक।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "सिर! तुमारे बाल उजले हो चले॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "&#8288;  &#8288;  माथा"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "छूट पाये दॉव-पेचों से नही।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "औ पकड़ भी है नही जाती सही॥"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "हम तुम्हे माथा पटकते ही रहे।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "पर हमारी पीठ ही लगती रही॥"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "चाहिये था पसीजना जिन पर।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "लोग उन पर पसीज क्यों पाते॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "जब कि माथा पसीज कर के तुम।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "हो पसीने पसीने हो जाते॥"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "&#8288;  तिलक"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "हो भले देते बुरे का साथ हो।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "भूल कर भी तुम तिलक खुलते नही॥"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "किस लिये लोभी न टुम से काम लें।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "तुम लहर से लोभ की धुलते नही॥"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "हो भलाई के लिये ही जब बने।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "तब तिलक तुम क्यों बुराई पर तुले॥"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "भेद छलियों के खुले तुम से न जब।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "भाल पर तब तुम खुले तो क्या खुले॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "क्यों नहीं तुम बिगड़ गये उन से।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "जो तुम्हें नित बिगाड़ पाते है॥"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "किस लिये हाथ से बने उन के।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "जो तिलक नित तुम्हें बनाते हैं॥"
    }
  ]
}