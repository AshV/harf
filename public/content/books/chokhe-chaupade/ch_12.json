{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_12",
  "number": 12,
  "title": "दम",
  "word_count": 1150,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "क्यों लिया यह न सोच पहले ही।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "आप तुम बारहा बने यम हो॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "है खटकते तुम्हें किये अपने।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "क्या अटकते इसी लिये दम हो॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  छींक"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "पड़ किसी की राह मे रोड़े गये।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "औ गये कॉटे बिखर कितने कही॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "जो फला फूला हुआ कुम्हला गया।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यह भला था छीक आती ही नही॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "क्यों निकल आई लजाई क्यों नहीं।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "क्यों सगे पर यो बिपद ढाती रही॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तब भला था, थी जहाँ, रहती वही।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "छीक जब तू नाक कटवाती रही॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "राह खोटी कर किसी की चाह को।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "मत अनाड़ी हाथ की दे गेद कर॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "छरछराहट को बढ़ाती आन तू।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "छीक! छाती में किसी मत छेद कर॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "&#8288;  मूँछ"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तो न वह करतूत करतूत ही।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "जो अँधेरे में न उॅजियाली रखे॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तो निराली बात उस में क्या रही।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "जो न काली मूॅछ मुॅह लाली रखे॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "&#8288;  दाढ़ी"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "बेबसी तो है इसी का नाम ही।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "पड़ पराये हाथ में है छँट रही॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "फ्रेंच कट क्या सैकड़ों कट में पड़ी।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "आज कितनी दाढ़ियाँ है कट रही॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "जब रहा पास कुछ न बल-बूता।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "जब न थी रोक थाम कर पाती॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "जब उखड़ती रही उखाड़े से।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "क्यों न दाढ़ी उखाड़ ली जाती॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "बाढ़ जो डाल गाढ़ मे देवे।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "तो भला किस लिये बढ़ी दाढ़ी॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "जो चढ़ी आँख पर किसी की तो।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "क्यों चढ़ाई गई चढ़ी दाढ़ी॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "&#8288;  गला"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "तब खिले फूल से सजा क्या था।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "तब भला क्या रहा सुगध भरा॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "तब दिलों को रहा लुभाता क्या।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "जब किसी के गले पड़ा गजरा॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "वह तुमारा बड़ा रसीलापन।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "सच कहो हो गया कहाॅ पर गुम॥"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "जो कभी काम के न फल लाये।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "तो गला फूलते रहे क्या तुम॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "बोल जब बन्द ही रहा बिल्कुल।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "तब लगे जोड़बन्द क्यों बोले॥"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "जब कि वह खुल सका न पहले ही।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "तब भला क्यों गला खुले खोले॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "तब भला किस तरह न फट जाता।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "जब कि रस से न रह गया नाता॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "आज जब वह बहुत रहा चलता।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "तब भला क्यों गला न पड़ जाता॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "बारहा बन्द हो बिगड़ जावे।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "बैठ जावे, घुटे, फँसे, सूखे॥"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "पर गले की अजब मिठाई के।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "कब न मीठे पसद थे भूखे॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "तब कहाॅ रह सका सुरीलापन।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "जब कि सुर के लिये रहा भूखा॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "सोत रस का रहा बहाता क्या।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "जब कि रस को गॅवा गला सूखा॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "तो पिलाये तो पिलाये क्या भला।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "जो उसे जल का पिलाना ही खला॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "तो खिलाये तो खिलाये क्या उसे।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "जो खिलाये दाख दुखता है गला॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "हो सके किस तरह उपज अच्छी।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "जब कि उपजा सकी नही क्यारी॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "तब उभारी न जा सकी बोली।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "जब कभी हो गया गला भारी॥"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "जब कि वह पुर पीक से होता रहा।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "जब रहे उस मे बुरे सुर भी अड़े॥"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "मोतियों की क्या पड़ी माला रही।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "तब गले मे क्या रहे गजरे पड़े।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "&#8288;  कंठ"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "जब भले सुर मिले नही उस में।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "जब कि रस में रहा न वह पगता॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "तब पहन कर भले भले गहने।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "कठ कैसे मला भला लगता॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "जो निराला रग बू रखते रहे।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "फूल ऐसे बाग मे कितने खिले॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "जो कि रस बरसा बहुत आला सके।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "वे रसीले कंठ है कितने मिले॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "है भला ढंग ही भला होता।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "क्यों बुरे ढंग यों सिखाते हो॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "क्या बुरी लीक है पसद तुम्हे।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "कंठ तुम पीक क्यों दिखाते हो॥"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "पूजते लोग, रंग नीला जो।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "पान की पीक लौ दिखा पाते॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "कंठ क्या बन गये कबूतर तुम।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "था भला नीलकठ बन जाते॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "क्यों रहे गुमराह करते कौर को।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "क्या नहीं गुमराह करना है मना॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "जब सुराहीपन नहीं तुझ में रहा।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "कठ तब क्या तू सुराही सा बना॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "तब भला क्या उमड़ घुमड़ कर के।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "मेघ तू है बरस बरस जाता॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "एक प्यासे हुए पपीहे का।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "कंठ ही सीच जब नही पाता॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "&#8288;  गाना गला कंठ"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "हो सके हम सुखी नही अब भी।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "आप का मेघराज आना सुन॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "ऑख से आज ढल पड़ा आँसू।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "मल गया दिल मलार गाना सुन॥"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "बेसुरी तब बनी न क्यों बसी।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "बीन का तार तब न क्यों टूटा॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "तब रही क्या सरगियाॅ बजती।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "आज सस्ते अगर गला छूटा॥"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "बोल का मोल जान कर के भी।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "कठ के साथ क्यों नही तुलती॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "जब नही ठीक ठीक बोल सकी।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "ढोल की पोल क्यों न तब खुलती॥"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "कठ की खींच तान में पड़ कर।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "हो गया बन्द बोल का भी दम॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "तग होता रहा बहुत तबला।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "दग होता रहा मृदग न कम॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "&#8288;  &#8288;  हथेली"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "क्या कहे हम और, हम ने आज ही।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "आँख से मेहदी लगाई देख ली॥"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "जब ललाई और लाली के लिये।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "तब हथेलो की ललाई देख ली॥"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "कर रही है लालसायें प्यार की।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "क्या लुनाई के लिये अठखेलियाँ॥"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "या किसी दिल के लहू से लाल बन।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "हो गई हैं लाल लाल हथेलियाॅ॥"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "&#8288;  उँगली"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "काम जैसे पसद है जिस को।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "फल मिलेंगे उसे न क्यों वैसे॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "हैं अगर काट कूट मे रहती।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "तो कटेंगी न उँगलियाँ कैसे॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "हाथ का तो प्यार सब के साथ है।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "काम उस को है सबों से हर घड़ी॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "है छोटाई या बड़ाई को न सुध।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "हो भले ही उँगलियों छोटी बड़ी॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "जी करे तो लाल होने के लिये।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "लोभ में पड़ पड़ लहू मे वे सनें॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "क्यों कहे फलियाँ उन्हे छबि-बलि की।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "उँगलियां कलियाँ न चंपे की बनें॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "दुख हुआ तो हुआ, यही सुख है।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "हाथ से जो बिपत्ति के छूटी॥"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "तब भला टूट में पड़ी क्या वे।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "टूट कर जो न उँगलियाँ टूटी॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "फेर मे क्यों लाल रंगों के पड़े।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "क्यों अँगूठी पैन्ह ले हीरे जड़ी॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "है बड़ाई के लिये यह कम नहीं।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "उँगलियों मे है बड़ी, उँगली बड़ी॥"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "कब न करतूत कर सकी छोटी।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "वह दिखाते कला कभी न थकी॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "हो बड़ी और क्यों न हो मोटी।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "कौन उँगली उठा पहाड़ सकी॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "क्यों न हो लाल बारहा उँगली।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "लाल होगी कभी नही गोंटी॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "मिल सके किस तरह बड़ाई तब।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "जब छुटाई मिले हुई छोटी॥"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "बन सकी वह नही बड़ी उँगली।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "भाग का नीक भी नहीं चमका॥"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "मूठियां क्यों न वार दें हीरे।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "क्यों न देवे अँगूठियाँ दमका॥"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "पेन्ह ले तो पैन्ह ले छिगुनी उन्हे।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "क्या करे उँगली बड़ी छल्ले पहन॥"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "तन बड़ाई के लिये छोटे सजे।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "है बड़ा होना बड़ों का बड़प्पन॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "नाम पाता कौन है बेकाम रह।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "क्यों बड़ी उँगली न बिगड़े इस तरह॥"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "पास जब बेनाम वाली के रही।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "तब बनेगी नामवाली किस तरह॥"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "क्यों न हो छिगुनी बहुत छोटी मगर।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "मान कितने काम कर वह ले सकी॥"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "ऐ बड़ी उँगली बता तू ही हमे।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "काम क्या तेरी बड़ाई दे सकी॥"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "जब बने देती रहें सुख और को।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "दूसरों के वास्ते दुख भी सहे॥"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "जब कभी छिड़के, न छिड़के गर्म जल।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "उँगलियां चन्दन छिड़कती ही रहें॥"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "चौकते मरजादवाले है नही।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "देख उज्जबक कठ में कठा पड़ा॥"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "क्यों न छल्ले पैन्ह ले कानी कई।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "कौन उँगली कान करती है खड़ा॥"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "जो किसी को खली, भली न लगी।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "चाहिये चाल वह न जाय चली॥"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "जो गई तो गई किसो मुँह मे।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "किस लिये आँख में गई उँगली॥"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "सोच उँगली तू ढले तो क्यों ढले।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "जो बुरी रुचि में ढला वह जाय ढल॥"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "हैं दमकते तो दमकने दे उन्हें।"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "मोतियों से दाँत में मिस्सी न मल॥"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "डाल कर सुरमा भलाई की गई।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "कब नहीं यह आँख दुखवाली रही॥"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "सोच उँगली तू न कर लाली गॅवा।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "क्या हुआ कुछ काल जो काली रही॥"
    }
  ]
}