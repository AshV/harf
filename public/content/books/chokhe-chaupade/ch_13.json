{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_13",
  "number": 13,
  "title": "निराले नगीने",
  "word_count": 2974,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "पते की बातें"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चोखे चौपदे    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        कुछ कलेजे   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;   निराले नगीने"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  मन"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "है मनाना या मना करना कठिन।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "मन सबों को छोड़ पाता छन नहीं॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तब भला कैसे न मनमानी करे।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "है किसी के मान का जब मन नही॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "काम के सब भले पथों को तज।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "फँस गया बार बार भूलों मे॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "छोड़ फूले फले भले पौधे।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मन भटकता फिरा बबूलों में॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "दें नहीं पेट पीस औरों को।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "जल रहें, बन न जाँय ओले हम॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "बात जितनी कहे मोलायम हो।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "हो न मन की मुलायमीयत कम॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "खोलने पर नयन न खुल पाया।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सूझ पाया हमे न पावन थल॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "लोकहित जल मिला न मिल कर भी।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "धुल न पाया मलीन मन का मल॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "है नही परवाह सुख दुख की उसे।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "जो कि सचमुच जाय बे-परवाह बन॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "तब बलंदी और पस्ती क्या रही।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "जब करे मस्ती किसी का मस्त मन॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "तो उसे प्रेमरंग मे रँग दो।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "वह सदा रग है अगर लाता॥"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "लोकहित के लिये न क्यों मचले।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "मन अगर है मचल मचल जाता॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "प्यास पैसों की उन्हें है जब लगी।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "क्यों न तो पानी भरेंगे पनभरे॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "जग-विभव जब आँख में है भर रहा।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "किस तरह तो मन भरे का मनभरे॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "दौड़ने मे ठोकरें जिस को लगीं।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "वह भला कैसे न मुँह के बल गिरे॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "फेर की है बात इस में कौन सी।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "जो किये मन फेर कोई मन फिरे॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "बैल में बैलपन मिलेगा ही।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "क्यों करेगा न लैलपन छैला॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "क्यों न तन में हमें मिलेगा मल।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "क्यों न होगा मलीन मन मैला॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "फूल किस को गूलरों से मिल सके।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "फल सरों से है न कोई पा सका॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "मोतियों से मिल सका पानी किसे।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "कौन मन के मोदकों को खा सका॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "है सराबोर सब रसो में वह।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "सन सभी भाव में वही सनकी॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "खेल नित रग रग के दिखला।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "रग लानी तरग है मन की॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "क्यों सकेगा न सुख-बसन जन बुन।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "कान हित-सूत तन अगर न थके॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "तन सके क्यों न तो अमन ताना।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "मन अगर बन अमन-पसद सके॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "बात हित की कब बताती है नहीं।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "कब न समझाती बुझाती वह रही॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "मान कर बैठे मनाने से खिझे।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "मति करे क्या, जो न मन, माने कही॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "पत्तियों तक को बहुत सुन्दर बना।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "हैं उसी ने ही सजाये बाग बन॥"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "फल उसो से हैं फबीले हो रहे।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "फुल फबता है मिले मन की फबन॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "हैं उसी मे भाव के फूले कमल।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "जो सदा सिर पर सुजन सुर के चढ़े॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "हैं उपज लहरें उसी में सोहती।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "सोत रस के मन सरोवर से कढ़े॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "हैं उसी के खेल जग के खेल सब।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "लोक-कौतुक गोद में उस की पला॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "हैं उसी की कल सकल तन को कलें।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "सब कलायें एक मन की है कला॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "मोल वाली मे बड़ा अनमोल है।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "सामने उस के सकल धन धूल है॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "माल है वह सब तरह के माल का।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "सब जगत के मूल का मन मूल है॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "क्या कही भूत का बसेरा है?"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "भूल है भय अगर कैंपाये तन॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "तो चढ़ेगा न भूत सिर पर क्यों।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "भूत बन जाय जो किसी का मन॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "तो बनायेगा बड़ा हो औगुनी।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "औगुनों से वह अगर होगा भरा॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "कौन इतनी है बुराई कर सका।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "है बुरे मन सा न बैरी दूसरा॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "जायगा कैसे न वह दानव कहा।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "जो कि दानवभाब लेकर अवतरा॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "देवता कैसे न देवेगा बना।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "देवभावों से अगर है मन भरा॥"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "तो यहां ही हम नरक मे हे पड़े।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "पाप का जी मे जमा है जो परा॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "स्वर्ग का सुख तो बेलसते है यही।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "है भला मन जो भले भावों भरा॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "चाह बैकुंठ की नही रखते।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "हैं नही स्वर्ग की रुची गहें।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "है यही चाह चाह हरि की हो।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "हों चुभी चित्त में भली चाहे॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "छोड़ खलपन अगर नही पाता।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "पर-विभव क्यों न तो उसे खलता॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "डाह जब है जला रही उस को।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "मन बिना आग क्यों न तो जलता॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "क्यों न बनतें सुहावना सोना।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "लाग कर लौहपन अगर खोते॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "पर नही कर सके रसायन हम।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "पास पारस समान मन होते॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "किस तरह जी में जगह देते उसे।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "जी बहुत जिस से सदा ऊबा रहा॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "मान वालों से मिले तो मान क्यों।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "मन अगर अभिमान मे डूबा रहा॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "बार घर बार को न तो समझे।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "जो न जी मे बिकार हो थमता॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "तो न बैठें रमा रमा धूनी।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "मन रहे जो न राम में रमता॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "तो तजा घर बना बनाया क्यों।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "घर बनाया गया अगर बन में॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "आप को सत मान क्यों बैठे।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "मान अपमान है अगर मन मे॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "तब लगाया भभूत क्या तन पर।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "जो सके मोह-भूत को न भगा॥"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "तो किया क्या वसन रँगा कर के।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "मन अगर राम-रग मे न रँगा॥"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "घर बसे और क्या बसे बन मे।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "बासना जो बनी रहे बस मे॥"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "बेकसे और क्या कसे काया।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "मन किसी का अगर रहे कस मे॥"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "ढोग है लोकसाधनायें सब।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "जी हमारा अगर न हो सुलझा॥"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "उलझनें छोड़ और क्या हैं वे।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "मन कही और हो अगर उलझा॥"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "एक को पूछता नही कोई।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "एक आधार प्रेमधन का है॥"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "एक मन है न एक मन का भी।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "एक मन एक लाख मन का है॥"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "फेन से भी है बहुत हलका वही।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "मेरु से भारी वही है बन सका॥"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "मान किस मे है कि मन को तौल ले।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "जब सका तब तौल मन को मन सका॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "मन न हो तो जहान है ही क्या।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "मन रहे है जहान का नाता॥"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "मन सधे क्या सधा नहीं साधे।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "मन बँधे है जहान बँध जाता॥"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "डूब कर के रगतों में प्यार को।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "साथ ही दो फूल अलबेले खिले॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "मेल कर अनमोल दो तन बन गये।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "मोल मन का बढ़ गया दो मन मिले॥"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "मन उबारे से उबरते हैं सभी।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "कौन तारे से नही मन के तरा॥"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "मन सुधारे ही सुधरता है जगत।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "मन उधारे ही उधरती है धरा॥"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "बार घर के बार जो हैं हो रहे।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "तो न सूबे के लिये ऊबे रहें॥"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "क्यों पड़े तो मनसबों के मोह में।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "पास मन के जो न मनसूबे रहें॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "जान है जानकार लोगों की।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "और सिरमौर माहिरों का है॥"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "जौहरों का सदा रहा जौहर।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "जौहरी मन जवाहिरों का है॥"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "एक मन है भरा हुआ मल से।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "एक मन है बहुत धुला उजला॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "एक मन को कमाल है सिड़ में।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "एक मन है कमाल का पुतला॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "लोथ पर लोथ तो नही गिरती।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "लोभ होता उसे न जो धन का॥"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "लाखहा लोग तो न मर मिटते।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "मन अगर जानता मरम मन का॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "एक मन है नरमियों से भी नरम।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "एक मन की फूल जैसी है फबन॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "एक मन की रगतें है मातमी।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "संग को है मात करता एक मन॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "मान ईमान तो करे कैसे।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "जो समझ बूझ बेइमान बने॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "तो सके जान दुख दुखी कैसे।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "मन अगर जान सब अजान बने॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "भेद है तो भेद क्यों होता नही।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "भेद रख कर भेद पहचाने गये॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "जन न सनमाने गये सब एक से।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "औ न सब मन एक से माने गये॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "बात लगती बोलियां औ विदअतें।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "कब कहा किस ने सुखी बन कर सहीं॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "क्यों सताये एक मन को एक मन।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "एक मन क्या दूसरे मन सा नही॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "निज दुखों सा गिने पराये दुख।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "पीर को ठीक ठीक पहचाने॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "तो न मनमानियां कभी होगी।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "जो मनों को समान मन माने॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "तो सितम पर सितम न हो पाते।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "तो न होती बदी बड़े बद से॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "तो न दिल चूर चूर हो जाते।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "चूर होता न मन अगर मद से॥"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "सुख मिले सुख किसे नहीं होता।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "हैं सभी दुख मिले दुखी होते॥"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "मन सके मान या न मान सके।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "हैं सफल मन समान ही होते॥"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "नाम सनमान सुन नहीं पाता।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "देख मेहमान को सदा ऊबाना॥"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "मान का मान कर नही सकता।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "मन गुमानी गुमान में डूबा॥"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "है उसी एक को कला सब में।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "किस लिये नीच बार बार नुचा॥"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "काम लेवे न जो कमालों से।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "तो कहा मन कमाल को पहचा॥"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "है जगत जगमगा रहा जिस से।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "जो मिला वह रतन न नर-तन मे॥"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "कर बसर जो सके न सरबस पा।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "तो भरी है बड़ी कसर मन में॥"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "जो न रॅग जाय प्यार रंगत में।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "तो उमग क्यों उमग में आवे॥"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "किस लिये धन समान तो उमड़े।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "मन दया-चारि जो न बरसावे॥"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "अनगिनत जग बिसात मोहरों का।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "कौन मन के समान माहिर है॥"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "घह समझ बूझ सोत का सर है।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "शान की जोत का जवाहिर है॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "चैन चौपाल चोज चौबारा।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "चाव चौरा चबाव आँगन है॥"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "चाल का चौतरा चतुरता कल।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "चाह थल चेतना महल मन है॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "है पुलकता लहू सगों का पी।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "बाप को पीस मूस मा का धन॥"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "कब उठा कांप पाप करने से।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "पाप को पाप मान पापी मन॥"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "है कतरब्योंत पेच पाच पगा।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "छल उसे छोड़ता नही छन है॥"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "मौत का मुँह मुसीबतों का तन।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "सांप का फन कपट भरा मन है॥"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "क्यों कड़े ऑख से न चिनगारी।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "क्यों न उठने लगे लवर तन मे॥"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "क्यों बचन तब बने न अगारे।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "कोप को भाग जब जली मन में॥"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "यम नही हैं भयावने वैसे।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "है न रौरव नरक बुरा वैसा॥"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "है अधमता सभी भरी उस में।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "है अधम कौन मन अधम जैसा॥"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "टूट पड़ती रहे मुसीबत सब।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "खेलना सॉप से पड़े काले॥"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "काल डाले सकल बलाओं में।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "पर पड़े मन न कोप के पाले॥"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "कुछ करेगे रंग बिरगे तन नहीं।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "जायगी बहुरगियों में बात बन॥"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "रग में उस के सभी रॅग जायगा।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "प्रेम रंगत मे अगर रँग जाय मन॥"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "छानते तो बड़े बड़े जगल।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "और जो यह समुद्र बन जाता॥"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "डालते पीस पर्वतों को हम।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "मन डिगाये अगर न डिग पाता॥"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "डालते किस लोक में डेरा नहीं।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "डर गये कोई नही कुछ बोलता॥"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "धाक से तो डोल जाता सब जगत।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "जो न डावाडोल हो मन डोलता॥"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "आँख में तो नये नये रस का।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "बह न सकता सुहावना सोता॥"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "चहचहे तो न कान सुन पाता।"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "जो दिखाता न रग मन होता॥"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "रग जाता बिगड़ लताओं का।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "पेड़ प्यारा हरा बसन खोता॥"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "फूल रंगीनियां न रह पातीं।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "रग लाता अगर न मन होता॥"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "जीभ रस-स्वाद तो नही पाती।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "तो पिरोती न लेखनी माती॥"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "मोहती नाक को महॅक कैसे।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "जो न मन की कुमक मिली होती॥"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "रख सके आन बान जो अपना।"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "हैं हमे मिल सके नही वैसे॥"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "सामने झुक गये हठीले सब।"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "मन हठी ठान ले न हठ कैसे॥"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "चाँद सूरज चमक दमक खो कर।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "जॉयगे बन बनाय बेचारे॥"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "जोत मन की न जो रहे जगती।"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "तो सकेंगे न जगमगा तारे॥"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "तो रुचिरता कहा रही उस मे।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "रुचि हितों में रहे न जो पगती॥"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "तो भले का कहां भला मन है।"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "जो भलाई भली नहीं लगती॥"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "हो सकेगा कुछ नही काया कसे।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "जो पराया बन नही पाया सगा॥"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "योग जप तप रगतों में क्या रँगे।"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "जो न परहित रग मे मन हो रँगा॥"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "मूल उस को कमाल का समझे।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "छोड़ जंजाल जाप का जपना॥"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "सोच अपना बिकास अपना हित।"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "मन जगत को न मान ले सपना॥"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "है अगर घट मे नही गगा बही।"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "कौन तो गंगा नहा कर के तरा॥"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "तो न होवेंगे बिमल जल से धुले।"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "है अगर मन मे हमारे मल भरा॥"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "है बड़े, सुन्दर सुरों की संगिनी।"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "बज रही है भाव मे भर हर घड़ी॥"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "रस बरस कर है सुरत को माहती।"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "बांसुरी मन की सुरीली है बड़ी॥"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "बादलों मे हे अनूठी रगते।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "इन्द्रधनु मे है निराली धारियां॥"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "है नगीना कौन सा तारा नही।"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "है कहा मन की न मीनाकारियां॥"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "चाह बिजली चमक अनूठी है।"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "श्याम रँग मे रॅगा हुआ तन है॥"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "है बरसता सुहावना रस वह।"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "मन बड़ा ही लुभावना घन है॥"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "है वही सुन्दर सराहे मन जिसे।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "हैं जगत में सब तरह की सूरतें॥"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "मन अगर ले मान मन दे मान तो।"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "देवता है मन्दिरों की मूरतें॥"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "है अगर मानता नहीं मन तो।"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "कौन नाना व कौन मामा है॥"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "मन कहे और मान मन ले तो।"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "बाप है बाप और मा, मा, है॥"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "है जहाँ चाहता वही जाता।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "कौन है दौड़ धूप मे ऐसा॥"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "बेग वाला बहुत बड़ा है वह।"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "है पवन बेग में न मन जैसा॥"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "है कपट काटछाट का पुतला।"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "छूट और छेड़छाड़ का घर है॥"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "छैलपन है छलक रहा उस मे।"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "मन छिछोरा छली छछू दर है॥"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "बात करता कभी हवा से है।"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "वह कभी मद मद चलता है॥"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "खूब भरता कभी छलांगे है।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "मन कभी कूदता उछलता है॥"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "मंद ऑखे क्या अँधेरे में पड़े।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "जो लगाये है समाधि न लग रही॥"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "खोल आंखें मन सजग कर देख लो।"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "हे जगतपति जोत जग मे जग रही॥"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "अनमने क्यों बने हुए मन हो।"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "नेक सन्देह है न सत्ता मे॥"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "कह रहे है हरे भरे पौधे।"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "हरि रमा है हरेक पत्ता मे॥"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "मतलबी पालिसी-पसन्द बड़ा।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "बेकहा बेदहल जले तन है॥"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "है उसे मद मुसाहिबी प्यारी।"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "साहिबी से भरा मनुज-मन है॥"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "पाक पर-दुख-दुखी परम कोमल।"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "हित धुरा, प्यार-जोत-तारा है॥"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "है दया-भाव का दुलारा वह।"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "सत मन संतपन सहारा है॥"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "है सुधा में सना हलाहल है।"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "फूल का हार साँप काला है॥"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "है निरा प्यार है निरा अनबन।"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "नारि का मन बड़ा निराला है॥"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "है खिला फूल, लाल अगारा।"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "बाग सुन्दर बड़ा भयानक बन॥"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "काठ उकठा हरा भरा पौधा।"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "है गरम है बड़ा नरम नर-मन॥"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "है बड़ा ही सुभाषना सुन्दर।"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "है उसी का कमाल भोलापन॥"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "लोक के लाड़-प्यार-वालों का।"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "है बड़ा लाड़-प्यार-वाला मन॥"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "क्यों न उस पर वार में लाखों टके।"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "है जगत में दूसरा ऐसा न धन॥"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "है निराला लाल आला माल है।"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "गोदियों के लाल का अनमोल मन॥"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "है उसी से भलाइयाँ उपजी।"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "लोक का लाभ है उसी का धन॥"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "कब न जन-हित रहा सजन उस का।"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "है सुजनता भरा सुजन का मन॥"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "है बदी बीज बैर का पुतला।"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "पाप का बाप सॉप का है तन॥"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "हे छुरा धार है धुरा छल का।"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "है बहुत ही बुरा कुजन का मन॥"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "देख कर के और को फूला फला।"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "रह सका उस का नही मुखड़ा हरा॥"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "कीच तो उस ने उछाला ही किया।"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "नीच का मन नीचपन से है भरा॥"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "वह अनूठा बसत जैसा है।"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "है बड़ा ही सुहावना उपबन॥"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "चाँद जैसा चमक दमक मे है।"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "है खिले फूल सा सुखी का मन॥"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "भोर का चाँद सॉझ का सूरज।"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "है लगातार दग्ध होता बन॥"
    },
    {
      "id": "b_364",
      "type": "p",
      "text": "है कमलदल तुषार का मारा।"
    },
    {
      "id": "b_365",
      "type": "p",
      "text": "बहु दुखों से भरा दुखी का मन॥"
    },
    {
      "id": "b_366",
      "type": "p",
      "text": "पा समय मोम सा पिघलता है।"
    },
    {
      "id": "b_367",
      "type": "p",
      "text": "फूल है प्यार रग मे ढाला॥"
    },
    {
      "id": "b_368",
      "type": "p",
      "text": "है मुलायम समान माखन के।"
    },
    {
      "id": "b_369",
      "type": "p",
      "text": "है दयावान मन दयावाला॥"
    },
    {
      "id": "b_370",
      "type": "p",
      "text": "है सुफल भार से झुका पौधा।"
    },
    {
      "id": "b_371",
      "type": "p",
      "text": "है बिमल बारि से बिलसता घन॥"
    },
    {
      "id": "b_372",
      "type": "p",
      "text": "दीनहित के लिये दयानिधि का।"
    },
    {
      "id": "b_373",
      "type": "p",
      "text": "है बड़ा दान दानियों का मन॥"
    },
    {
      "id": "b_374",
      "type": "p",
      "text": "दिल उसे दे दें मगर उस से कभी।"
    },
    {
      "id": "b_375",
      "type": "p",
      "text": "एक मुठी मिल नहीं सकता चना॥"
    },
    {
      "id": "b_376",
      "type": "p",
      "text": "जान देगा पर न देगा दान वह।"
    },
    {
      "id": "b_377",
      "type": "p",
      "text": "सूमपन मे सूम का मन है सना॥"
    },
    {
      "id": "b_378",
      "type": "p",
      "text": "वह कभी काल से नही डरता।"
    },
    {
      "id": "b_379",
      "type": "p",
      "text": "वास यमराज का उसे कैसा॥"
    },
    {
      "id": "b_380",
      "type": "p",
      "text": "है बना सूर, सूर, मन से ही।"
    },
    {
      "id": "b_381",
      "type": "p",
      "text": "कौन है सूर सूर-मन जैसा॥"
    },
    {
      "id": "b_382",
      "type": "p",
      "text": "कर सकेगा और का कैसे भला।"
    },
    {
      "id": "b_383",
      "type": "p",
      "text": "जो भलाई में लगाया तन न हो॥"
    },
    {
      "id": "b_384",
      "type": "p",
      "text": "हो सकेगा तो न पूरा हित कभी।"
    },
    {
      "id": "b_385",
      "type": "p",
      "text": "जो भरा हित से पुरोहित मन न हो॥"
    },
    {
      "id": "b_386",
      "type": "p",
      "text": "है बल के लिये बड़ा बल वह।"
    },
    {
      "id": "b_387",
      "type": "p",
      "text": "धाक गढ़ आनबान देरा है॥"
    },
    {
      "id": "b_388",
      "type": "p",
      "text": "धीरता धाम धवरहर धुन का।"
    },
    {
      "id": "b_389",
      "type": "p",
      "text": "बीर-मन बीरता बसेरा है॥"
    },
    {
      "id": "b_390",
      "type": "p",
      "text": "है गगन तल मे हवा उस की बॅधी।"
    },
    {
      "id": "b_391",
      "type": "p",
      "text": "धाक उस की है धरातल में धँसी॥"
    },
    {
      "id": "b_392",
      "type": "p",
      "text": "कौन साहस कर सका इतना कभी।"
    },
    {
      "id": "b_393",
      "type": "p",
      "text": "साहसी मन ही बड़ा है साहसी॥"
    },
    {
      "id": "b_394",
      "type": "p",
      "text": "आँख मे सुरमा लगाया है गया।"
    },
    {
      "id": "b_395",
      "type": "p",
      "text": "है धड़ी की होंठ पर न्यारी फबन॥"
    },
    {
      "id": "b_396",
      "type": "p",
      "text": "भूलती हैं चितवने भोली नहीं।"
    },
    {
      "id": "b_397",
      "type": "p",
      "text": "तन हुआ बूढ़ा हुआ बूढ़ा न मन॥"
    },
    {
      "id": "b_398",
      "type": "p",
      "text": "तो भले भाव के लिये वह क्यों।"
    },
    {
      "id": "b_399",
      "type": "p",
      "text": "बारहा जाय जी लगा जाँचा॥"
    },
    {
      "id": "b_400",
      "type": "p",
      "text": "हो मगन देख लोक-हित-धन तन।"
    },
    {
      "id": "b_401",
      "type": "p",
      "text": "मन अगर मोर लौं नही नाचा॥"
    },
    {
      "id": "b_402",
      "type": "p",
      "text": "है बड़ी भूल भाव में डूबा।"
    },
    {
      "id": "b_403",
      "type": "p",
      "text": "पी कहा नाद जो नही भाया॥"
    },
    {
      "id": "b_404",
      "type": "p",
      "text": "जाति-उपकार-स्वाति के जल का।"
    },
    {
      "id": "b_405",
      "type": "p",
      "text": "मन पपीहा अगर न बन पाया॥"
    },
    {
      "id": "b_406",
      "type": "p",
      "text": "है बड़ा भाग जो बड़े हों हम।"
    },
    {
      "id": "b_407",
      "type": "p",
      "text": "सब भले रंग में रँगा हो तन॥"
    },
    {
      "id": "b_408",
      "type": "p",
      "text": "दुख दिखाये न दुखभरी सूरत।"
    },
    {
      "id": "b_409",
      "type": "p",
      "text": "सुख कमल मुख भँवर बना हो मन॥"
    },
    {
      "id": "b_410",
      "type": "p",
      "text": "तब भलाई भली लगे कैसे।"
    },
    {
      "id": "b_411",
      "type": "p",
      "text": "भूलता जब कि तोर मर नही॥"
    },
    {
      "id": "b_412",
      "type": "p",
      "text": "लोकहित चाव चन्द्रमा का जब।"
    },
    {
      "id": "b_413",
      "type": "p",
      "text": "मन चतुर बन सका चकोर नहीं॥"
    },
    {
      "id": "b_414",
      "type": "p",
      "text": "जो गया भूल देख भोलापन।"
    },
    {
      "id": "b_415",
      "type": "p",
      "text": "चोगुना चाव क्यो न तो करती॥"
    },
    {
      "id": "b_416",
      "type": "p",
      "text": "मुखकमल भावरस भरा पाकर।"
    },
    {
      "id": "b_417",
      "type": "p",
      "text": "मन-भँवर क्यों न भॉवरें भरता॥"
    },
    {
      "id": "b_418",
      "type": "p",
      "text": "हो गया है हवा, हवस मे फॅस।"
    },
    {
      "id": "b_419",
      "type": "p",
      "text": "वह गया बदहवास बन बौड़ा॥"
    },
    {
      "id": "b_420",
      "type": "p",
      "text": "हो सका दूर दुख नही उस का।"
    },
    {
      "id": "b_421",
      "type": "p",
      "text": "मन बहुत दूर दूर तक दौड़ा॥"
    },
    {
      "id": "b_422",
      "type": "p",
      "text": "आम वैसा कहाँ रसीला है।"
    },
    {
      "id": "b_423",
      "type": "p",
      "text": "चाँद कब रस बरस सका ऐसा॥"
    },
    {
      "id": "b_424",
      "type": "p",
      "text": "कर रसायन मिली जवानी कब।"
    },
    {
      "id": "b_425",
      "type": "p",
      "text": "रस कहाँ है जवान-मन जैसा॥"
    },
    {
      "id": "b_426",
      "type": "p",
      "text": "मानता हो न जब कही मेरी।"
    },
    {
      "id": "b_427",
      "type": "p",
      "text": "और करता सदा किनारा हो॥"
    },
    {
      "id": "b_428",
      "type": "p",
      "text": "अनमने तब न हम रहें कैसे।"
    },
    {
      "id": "b_429",
      "type": "p",
      "text": "मन हमारा न जब हमारा हो॥"
    },
    {
      "id": "b_430",
      "type": "p",
      "text": "कौन सा पद मिला नही उस से।"
    },
    {
      "id": "b_431",
      "type": "p",
      "text": "कौन सा मुख गया नहीं भोगा॥"
    },
    {
      "id": "b_432",
      "type": "p",
      "text": "फिर करे मोल जोल क्यों कोई।"
    },
    {
      "id": "b_433",
      "type": "p",
      "text": "मोल क्या मन अमोल का होगा॥"
    },
    {
      "id": "b_434",
      "type": "p",
      "text": "प्यार का प्यार जब न हो उस को।"
    },
    {
      "id": "b_435",
      "type": "p",
      "text": "जब न हित का उसे सहारा हो॥"
    },
    {
      "id": "b_436",
      "type": "p",
      "text": "तब हमे मान मिल सके कैसे।"
    },
    {
      "id": "b_437",
      "type": "p",
      "text": "मन न जब मानता हमारा हो॥"
    },
    {
      "id": "b_438",
      "type": "p",
      "text": "कब निछावर हुआ न वह उस पर।"
    },
    {
      "id": "b_439",
      "type": "p",
      "text": "धन बराबर कभी न तन के है॥"
    },
    {
      "id": "b_440",
      "type": "p",
      "text": "है रतन कौन इस रतन जैसा।"
    },
    {
      "id": "b_441",
      "type": "p",
      "text": "कौन सा मणि, समान मन के है॥"
    },
    {
      "id": "b_442",
      "type": "p",
      "text": "तब न कैसे और भी कस जायगा।"
    },
    {
      "id": "b_443",
      "type": "p",
      "text": "जब कि सन की गाँठ मे पानी पड़ा॥"
    },
    {
      "id": "b_444",
      "type": "p",
      "text": "तब कठिन से भी कठिन होगा न क्यों।"
    },
    {
      "id": "b_445",
      "type": "p",
      "text": "मन कठिन कठिनाइयों मे जब पड़ा॥"
    },
    {
      "id": "b_446",
      "type": "p",
      "text": "भर गई हैं खुटाइयॉ जिस में।"
    },
    {
      "id": "b_447",
      "type": "p",
      "text": "भाव उस मे भले भरोगे क्या॥"
    },
    {
      "id": "b_448",
      "type": "p",
      "text": "है बुरे कब बुराइयाँ तजते।"
    },
    {
      "id": "b_449",
      "type": "p",
      "text": "मन बुरा मान कर करोगे क्या॥"
    },
    {
      "id": "b_450",
      "type": "p",
      "text": "हे कराती काम वे बातें नही।"
    },
    {
      "id": "b_451",
      "type": "p",
      "text": "जो जमाये से नही जो मे जमे॥"
    },
    {
      "id": "b_452",
      "type": "p",
      "text": "मान करके जो न मन को ही चलें।"
    },
    {
      "id": "b_453",
      "type": "p",
      "text": "मिल सके ऐसे न मन वाले हमे॥"
    },
    {
      "id": "b_454",
      "type": "p",
      "text": "कम न अपमान हो चुका जिन का।"
    },
    {
      "id": "b_455",
      "type": "p",
      "text": "हित उन्हे मान क्यों नही लेते॥"
    },
    {
      "id": "b_456",
      "type": "p",
      "text": "बात यह मान की तुमारे है।"
    },
    {
      "id": "b_457",
      "type": "p",
      "text": "मन उन्हे मान क्यों नही देते॥"
    },
    {
      "id": "b_458",
      "type": "p",
      "text": "जो बनाये जॉय बिगड़े काम सब।"
    },
    {
      "id": "b_459",
      "type": "p",
      "text": "बात बिगड़ी जायगी कैसे न बन॥"
    },
    {
      "id": "b_460",
      "type": "p",
      "text": "माल मनमाना उसे मिल जाय तो।"
    },
    {
      "id": "b_461",
      "type": "p",
      "text": "क्यों न मालामाल हो पामाल मन॥"
    },
    {
      "id": "b_462",
      "type": "p",
      "text": "चाहते तंग है बहुत होती।"
    },
    {
      "id": "b_463",
      "type": "p",
      "text": "हैं बुढ़ापा तरंग ही तन मे॥"
    },
    {
      "id": "b_464",
      "type": "p",
      "text": "रग ही है न ढग हो है वह।"
    },
    {
      "id": "b_465",
      "type": "p",
      "text": "अब न है वह उमग ही मन मे॥"
    },
    {
      "id": "b_466",
      "type": "p",
      "text": "&#8288;  कुछ कलेजे"
    },
    {
      "id": "b_467",
      "type": "p",
      "text": "मोम-माखन सा मुलायम है वही।"
    },
    {
      "id": "b_468",
      "type": "p",
      "text": "प्यार में पाया उसी को सरगरम॥"
    },
    {
      "id": "b_469",
      "type": "p",
      "text": "है उसी मे सब तरह की नरमियॉ।"
    },
    {
      "id": "b_470",
      "type": "p",
      "text": "फल से भी मा-कलेजा है नरम॥"
    },
    {
      "id": "b_471",
      "type": "p",
      "text": "प्यार को आँच पा पिघलने में।"
    },
    {
      "id": "b_472",
      "type": "p",
      "text": "मा-कलेजा न मोम से कम है॥"
    },
    {
      "id": "b_473",
      "type": "p",
      "text": "वह निराली मुलायमीयत पा।"
    },
    {
      "id": "b_474",
      "type": "p",
      "text": "फेन से, फूल से, मोलायम है॥"
    },
    {
      "id": "b_475",
      "type": "p",
      "text": "एक मा को छोड़ ममता मोह में।"
    },
    {
      "id": "b_476",
      "type": "p",
      "text": "है किसी का मन न उस के माप का॥"
    },
    {
      "id": "b_477",
      "type": "p",
      "text": "सब हितों से उर उसी का है भरा।"
    },
    {
      "id": "b_478",
      "type": "p",
      "text": "प्यार से पुर है कलेजा बाप का॥"
    }
  ]
}