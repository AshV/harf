{
  "book_id": "chokhe-chaupade",
  "chapter_id": "ch_02",
  "number": 2,
  "title": "अछूते फूल",
  "word_count": 695,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "फूल में कीट, चॉद में धब्बे।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "भाग में धूम,दीप में काजल॥"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "मैल जल मे, मलीनता मन में।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "देख किस का गया नही दिल मल॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "है बुरा, घास-फूस-वाला घर।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मल भरा तन, गरल भरा प्याला॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "रिस भरी ऑख, सर भरा सौदा।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "मन भरा मैल, दिल कसर वाला॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "है कहाँ गोद तो भरी पूरी।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "जो सकी गोद मे न लाल सुला॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "क्या मिला पूत जो सपूत नहीं।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "क्या खुली कोख जो न भाग खुला॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "क्या रहा ताल तब भरा जल से।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "जब कि उस में रहा कमल न खिला॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "क्या फली डाल जो सुफल न फली।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "क्या खुली कोख जो न लाल मिला॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "पुल सकेगा न बँध सितारों पर।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "कुल धरा धूल ढुल नहीं सकती॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "धुल सकेंगे न चाँद के धब्बे।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "बाँझ की कोख खुल नहीं सकती॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "जब नही उस ने बुझाई भूख तो।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "मोतियों से क्या भरी थाली रही॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "जो न उस के फल किसी को मिल सके।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "नो फलों से क्या लदी डाली रही॥"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "जोत कैसे मलीन होवेगी।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "क्या हुआ भूमि पर अगर फैली॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "धूल से भर कभी न धूप सकी।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "हो सकी चाँदनी नही मेली॥"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "आम में आ सका न कड़वापन।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "है मिठाई न नीम मे आती॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "छोड़ ऊंचा सका न ऊंचापन।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "नीच की नीचता नही जाती॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "रस के छीटें"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "भाग में मिलना लिखा था ही नहीं।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "तुम न आये साँसतें इतनी हुईं॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "जी हमारा था बहुत दिन से टँगा।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "आज आँखे भी हमारी टँग गईं॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "सूखती चाह-बेलि हरिआई।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "दूध की मक्खियां बनीं माखे॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "रस बहा चाँदनी निकल आई।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "खिल गये कौल, हँस पड़ी आँखें॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "सादगी चित से उतर पाई नहीं।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "है नहीं भूली भलाई आप की॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "काढ़ने से है नहीं कढ़ती कभी।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "आँख में सूरत समाई आप की॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "लोग कैसे न बेबसों सा बन।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "रो उठे, खिल पड़े, खिझें, माखें॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "हो न किस पर गया खुला जादू।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "देख जाढ़ भरी हुई आँखें॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "बेबसी बेतरह सताती है।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "वह हुआ जो न चाहिये होना॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "थाम कर रह गये कलेजा हम।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "कर गया काम आँख का टोना॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "मानता मन नही मनाने से।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "तलमलाते है आँख के तारे॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "जागते रात बीत जाती है।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "माख के या कि आँख के मारे॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "वह बहुत ही लुभावनी सूरत।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "हम भला भूल किस तरह जाते॥"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "है तुम्हें देख आँख भर आती।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "आँख भर देख भी नही पाते॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "आँसुओं साथ तरबतर हो हो।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "हैं जलन के अगर पड़ी पाले॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "सूरतों पर बिसरती आँखें।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "सेंक लें आँख सेंकने वाले॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "तब कहें कैसे किसी की चाहते।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "रगतों में यार की है ढालती॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "जब कि मुखड़े की लुनाई आप की।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "आँख में है लोन राई डालती॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "लूट ले प्यार को लपेटों से।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "दे निबौरी दिखा दिखा दाखें॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "पट, पटा कर, न पट सकी जिस से।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "क्यों गई पटपटा न वे ऑखे॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "है पहेली अजीब पेचीला।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "हैं खिली बेलि हैं पकी दाखे॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "अधकढ़ी बात अधगिरी पलकें।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "अधखुले होंठ अधखुली आँखें॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "प्यार उन से भला न क्यों बढ़ता।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "हो सके पास से न जो न्यारे॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "वे उतारे न चित्त से उतरे।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "हिल सके जिन से आँख के तारे॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "देखते ही पसीज जावेंगे।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "रीझ जाते कभी न वे ऊबे॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "टल सकेंगे न प्यार से तिल भर।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "आँख के तिल सनेह में डूबे॥"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "जी टले पास से धड़कता है।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "जोहते मुख कभी नहीं थकते॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "आँख से दूर तब करे कैसे।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "जब पलक ओट सह नही सकते॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "देह सुकुमारपन बखाने पर।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "और सुकुमारपन बतोले है॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "छू गये नेक फूल के गजरे।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "पड़ गये हाथ में फफोले हैं॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "धुल रहा हाथ जब निराला था।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "तब भला और बात क्या होती॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "हाथ के जल गिरे ढले हीरे।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "हाथ झाड़े बिखर पड़े मोती॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "बात लगतो लुभावनी कह सुन।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "बन दुखी, हो निहाल, दुख सुख से॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "दिल हिले, आँख से गिरे मोती।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "दिल खिले, फूल झड़ पड़े मुख से॥"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "चाह कर के हैं बढ़ाते चाह वें।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "खिल रहे है औ खिला है वे रहे॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "मिल रहे है औ रहे हैं वे मिला।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "दे रहे दिल और दिल हैं ले रहे॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "क्यों पियेगा ललक चकोर नहीं।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "जायगी चद की कला जो मिल॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "फूल खिल क्यों लुभा न दिल लेगा।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "चोर दिल का न क्यों चुरा ले दिल॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "लोचनों को ललक हुई दूनी।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "वह बिना मोल का बना चेरा॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "देख कर लोच लोच वाले का।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "रह गया दिल ललच ललच मेरा।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "बाप मा के अडाल कानों को।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "बूॅद मिलती न तो अमी घोली॥"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "बोल अनमोल रस लपेटे जो।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "बोलती बेटियाँ न मुॅहबोली॥"
    }
  ]
}