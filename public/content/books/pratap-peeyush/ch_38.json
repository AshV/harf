{
  "book_id": "pratap-peeyush",
  "chapter_id": "ch_38",
  "number": 38,
  "title": "समस्या पूर्ति ।",
  "word_count": 374,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "मुख खोलति बोलै न नाहि न हाँ।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तुमही मनुहारि कै हारि परे"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "सखियान की कौन चलाई कहाँ।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "बरखा है प्रताप जू धीर धरो"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "अब लों मन को समुझायो जहाँ ।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "वह ब्यारि तबै बदलैगी कछू"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पपिहा जब पूंछिहै पीव कहाँ ॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "(बीर बली धुरवा घमकावैं)"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "बूड़ि मरैं न समुद्र में हाय"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "ये नाहक हाथ निछीछे डुबावैं ।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "का तजि लाजि गराज किये"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "मुख कारो लिये इत ही उतधावैं।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नारि दुखारिन पै बज मारे"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "वृथा बुंदियान के बान चलावैं ।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "बीर हैं तौ बल बीरहि जाय कै"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "बीर बली धुरवा घमकावैं ॥२॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "(बजनी घुघुरू रजनी उजियारी)"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आसव छाकि खुली छति पै खुलि खेलति जोवन की मतवारी।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "गात ही गात अदा ही अदा"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "कढै़ बात ही बात सुधा सुखकारी।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "रंग रचै रस राग अलापि"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "नचै परताप गरे भुज डारी ।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "ताछिन छावै अजीब मजा"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "बजनी घुघुरू रजनी उजियारी ॥३॥"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "(देह धरे को यहै फल भाई)"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "नैनन में बसै सांवरो रूप"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "रहै मुख नाम सदा सुखदाई ।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "त्यों श्रुति में ब्रज केलिकथा"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "परिपूरण प्रेम प्रताप बड़ाई ।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "कोऊ कछू कहै होय कहूँ कछु"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "पै जिय में परवाहि न लाई ।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "नेह निभै नंदनन्दन सों नर-"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "देह धरे को यहै फल भाई ॥४॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "(धुरवान की धावन सावन में)"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "सिर चोटी गंधावती फूलन सों"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "मेहंदी रचि हाथन पावन में।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "परताप त्यों चूनरी सूही सजी"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "मन मोहती हावन भावन में।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "निस द्यौस बितावती पीतम के संग भूलन में औ भूलावन में।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "उनहीं को सुहावनो लागत है"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "धुरवान की धावन सावन में ॥५॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "------------"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "तृप्यन्ताम् ।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "'तृप्यन्ताम्' शीर्षक कविता के थोड़े से अंश यहां दिये"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "जाते हैं। इस कविता में भारत की आर्थिक तथा सामाजिक"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "दुर्दशा का हृदय-ग्राही चित्र खींचा गया है। देवताओं से प्रार्थना"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "की गई है कि ऐसी संकटपूर्ण स्थिति में जब अपना पेट पालना"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "मुश्किल हो रहा है तो उन्हें सन्तुष्ट करना मुश्किल है।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "(आदर के लिए एकवचन के स्थान पर भी बहुवचन का प्रयोग होता है । अतः छंद बदलना निष्प्रयोजनीय समझा है।)"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "केहि विधि वैदिक कर्म होत कब कहाँ बखानत रिक यजु साम ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "हम सपने हू में नहिं जानैं रहैं पेट के बने गुलाम ।।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "तुमहिं लजावत जगत जनम धरि दुहु लोकन में निपट निकाम ।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "कहैं कौन मुख लाय हाय फिर ब्रह्मा बाबा तृप्यन्ताम ।।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "तुमहिं रमापति वेद बतावत हम कहं दारिद गनै गुलाम ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "तुम बैकुंठ विहारी हौ प्रभु हम सब करें नरक के काम ॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "तुम कहं प्यारी लगै भक्ति, हम कहं स्वारथ प्रिय आठौ याम ।"
    }
  ]
}