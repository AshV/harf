{
  "book_id": "pratap-peeyush",
  "chapter_id": "ch_29",
  "number": 29,
  "title": "बुढ़ापा-वर्णन ।",
  "word_count": 383,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "कानपुर-महिमा ।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "प्रताप पीयूष    (१९३३)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     प्रतापनारायण मिश्र        सभा-वर्णन ।   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "(२०२)"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  &#8288;   बुढ़ापा-वर्णन।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "हाय बुढ़ापा तोरे मारे"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "&#8288; अब तो हम नकन्याय गयन।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "करत धरत कछु बनतै नाहीं"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288; कहाँ जान औ कैस करन।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "छिन भरि चटक छिनै मां मद्धिम"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "&#8288; जस बुझात खन होय दिया।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तैसै निखवख देखि परत हैं"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "&#8288; हमरी अक्किल के लच्छन॥१॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अस कछु उतरि जाति है जीते"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "&#8288; बाजी बेरियां बाजी बात।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "कैस्यो सुधि ही नाही आवति"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "&#8288; मूंडुइ काहे न दै मारन।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "कहा चहौ कुछु निकरत कुछ है"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "&#8288; जीभ रांड़ का है यह हालु।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "कोऊ याकौ बात न समुझै"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "&#8288; चाहे बीसन दांय कहन॥२॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "दाढ़ी नाक याक मां मिलिगै"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "&#8288; बिन दांतन मुंह अस पोपलान।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "दढ़िही पर बहि बहि आवति है"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "&#8288; कबौं तमाखू जो फांकन।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "( २०३)"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "बार पाकि गे रीरौ झुकि गै"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "&#8288; मूंडौ सासुर हालन लाग।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "हाथ पांव कुछु रहे न आपनि"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "&#8288; केहिके आगे दुखु र्वावन॥३॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "यही लकुठिया के बूते अब"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "&#8288; जस तस डोलित डालित है।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "जेहिका लै कै सब कामेन मा"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "&#8288; सदा खखारत फिरत रहन।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "जियत रहैं महराज सदा जो"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "&#8288; -हम ऐस्यन का पालति हैं।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "नाहीं तो अब को धौ पूंछै"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "&#8288; केहिके कौने काम के हन॥४॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; ---------"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "&#8288;  &#8288;   सभा-वर्णन।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "दिन के दिन सब कोउ जुरि आये, देखवैया औ कारगुजार॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "कोऊ आये हैं बिरिया पर, कोउ कोउ पहरन समै बिताय॥"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "लगी कचेहरी नुनि लाला की, भरमाभूत लगे दरबार॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "रंग बिरंगे कपड़ा झलकैं, शोभा तिलक त्रिपुंडन क्यार॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "गरे जंजीरैं हैं सोने की, मानौ बंधुवा कलियुग क्यार॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "बाँह अनन्ता कोउ कोउ पहिरे, टड़ियाँ मनौ मेहरियन क्यार॥"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "यह कार्य   भारत में  सार्वजनिक डोमेन   है क्योंकि यह  भारत  में निर्मित हुआ है और इसकी कॉपीराइट की अवधि समाप्त हो चुकी है।  भारत के कॉपीराइट अधिनियम, 1957  के अनुसार लेखक की मृत्यु के पश्चात् के वर्ष (अर्थात् वर्ष 2026 के अनुसार, 1 जनवरी 1966 से पूर्व के) से गणना करके साठ वर्ष पूर्ण होने पर सभी दस्तावेज सार्वजनिक प्रभावक्षेत्र में आ जाते हैं।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "यह कार्य   संयुक्त राज्य अमेरिका  में भी सार्वजनिक डोमेन में है क्योंकि यह भारत में 1996 में सार्वजनिक प्रभावक्षेत्र में आया था और संयुक्त राज्य अमेरिका में इसका कोई कॉपीराइट पंजीकरण नहीं है (यह भारत के वर्ष 1928 में  बर्न समझौते  में शामिल होने और  17 यूएससी 104ए  की महत्त्वपूर्ण तिथि जनवरी 1, 1996 का संयुक्त प्रभाव है।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "Public domain  Public domain  false  false"
    }
  ]
}