{
  "book_id": "pratap-peeyush",
  "chapter_id": "ch_29",
  "number": 29,
  "title": "बुढ़ापा-वर्णन ।",
  "word_count": 234,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "&#8288; अब तो हम नकन्याय गयन।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "करत धरत कछु बनतै नाहीं"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "&#8288; कहाँ जान औ कैस करन।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "छिन भरि चटक छिनै मां मद्धिम"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288; जस बुझात खन होय दिया।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "तैसै निखवख देखि परत हैं"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "&#8288; हमरी अक्किल के लच्छन॥१॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अस कछु उतरि जाति है जीते"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288; बाजी बेरियां बाजी बात।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "कैस्यो सुधि ही नाही आवति"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "&#8288; मूंडुइ काहे न दै मारन।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कहा चहौ कुछु निकरत कुछ है"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "&#8288; जीभ रांड़ का है यह हालु।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "कोऊ याकौ बात न समुझै"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "&#8288; चाहे बीसन दांय कहन॥२॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "दाढ़ी नाक याक मां मिलिगै"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "&#8288; बिन दांतन मुंह अस पोपलान।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "दढ़िही पर बहि बहि आवति है"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "&#8288; कबौं तमाखू जो फांकन।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "बार पाकि गे रीरौ झुकि गै"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "&#8288; मूंडौ सासुर हालन लाग।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "हाथ पांव कुछु रहे न आपनि"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "&#8288; केहिके आगे दुखु र्वावन॥३॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "यही लकुठिया के बूते अब"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "&#8288; जस तस डोलित डालित है।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "जेहिका लै कै सब कामेन मा"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "&#8288; सदा खखारत फिरत रहन।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "जियत रहैं महराज सदा जो"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "&#8288; -हम ऐस्यन का पालति हैं।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "नाहीं तो अब को धौ पूंछै"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "&#8288; केहिके कौने काम के हन॥४॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; ---------"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "&#8288;  &#8288;   सभा-वर्णन।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "दिन के दिन सब कोउ जुरि आये, देखवैया औ कारगुजार॥"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "कोऊ आये हैं बिरिया पर, कोउ कोउ पहरन समै बिताय॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "लगी कचेहरी नुनि लाला की, भरमाभूत लगे दरबार॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "रंग बिरंगे कपड़ा झलकैं, शोभा तिलक त्रिपुंडन क्यार॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "गरे जंजीरैं हैं सोने की, मानौ बंधुवा कलियुग क्यार॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "बाँह अनन्ता कोउ कोउ पहिरे, टड़ियाँ मनौ मेहरियन क्यार॥"
    }
  ]
}