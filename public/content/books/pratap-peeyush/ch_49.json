{
  "book_id": "pratap-peeyush",
  "chapter_id": "ch_49",
  "number": 49,
  "title": "प्रार्थना १",
  "word_count": 100,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "शरणागत पाल कृपाल प्रभो!"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "हमको इक आस तुम्हारी है।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "तुम्हरे सम दूसर और कोऊ"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "नहिं दीनन को हितकारी है।।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सुधि लेत सदा सब जीवन की"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अति ही करुना बिस्तारी है।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "प्रतिपाल करें बिनही बदले"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अस कौन पिता महतारी है।।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "जब नाथ दया करि देखत हौ"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "छुटि जात बिथा संसारी है ।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "बिसराय तुम्हें सुख चाहत जो"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अस कौन नदान अनारी है ।।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "परवाहि तिन्हें नहिं स्वर्गहु की"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "जिनको तव कोरति प्यारी है।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "धनि है धनि है सुखदायक जो"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तव प्रेम सुधा अधिकारी है।।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "सब भाँति समर्थ सहायक हौ"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तव आश्रित बुद्धि हमारी है।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "\"परताप नरायण\" तौ तुम्हरे"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "पद पंकज पै बलिहारी है।।"
    }
  ]
}