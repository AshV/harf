{
  "book_id": "pratap-peeyush",
  "chapter_id": "ch_49",
  "number": 49,
  "title": "प्रार्थना १",
  "word_count": 257,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "हिन्दी हिन्दू हिन्दुस्तान ।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "प्रताप पीयूष    (१९३३)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     प्रतापनारायण मिश्र        प्रार्थना २   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;  &#8288; ( २२० )"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  &#8288;   प्रार्थना १"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "शरणागत पाल कृपाल प्रभो!"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "&#8288; हमको इक आस तुम्हारी है।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तुम्हरे सम दूसर और कोऊ"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288; नहिं दीनन को हितकारी है।।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सुधि लेत सदा सब जीवन की"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "&#8288; अति ही करुना बिस्तारी है।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "प्रतिपाल करें बिनही बदले"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "&#8288; अस कौन पिता महतारी है।।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "जब नाथ दया करि देखत हौ"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "&#8288; छुटि जात बिथा संसारी है ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "बिसराय तुम्हें सुख चाहत जो"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "&#8288; अस कौन नदान अनारी है ।।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "परवाहि तिन्हें नहिं स्वर्गहु की"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "&#8288; जिनको तव कोरति प्यारी है।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "धनि है धनि है सुखदायक जो"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "&#8288; तव प्रेम सुधा अधिकारी है।।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "सब भाँति समर्थ सहायक हौ"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "&#8288; तव आश्रित बुद्धि हमारी है।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "\"परताप नरायण\" तौ तुम्हरे"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "&#8288; पद पंकज पै बलिहारी है।।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "यह कार्य   भारत में  सार्वजनिक डोमेन   है क्योंकि यह  भारत  में निर्मित हुआ है और इसकी कॉपीराइट की अवधि समाप्त हो चुकी है।  भारत के कॉपीराइट अधिनियम, 1957  के अनुसार लेखक की मृत्यु के पश्चात् के वर्ष (अर्थात् वर्ष 2026 के अनुसार, 1 जनवरी 1966 से पूर्व के) से गणना करके साठ वर्ष पूर्ण होने पर सभी दस्तावेज सार्वजनिक प्रभावक्षेत्र में आ जाते हैं।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "यह कार्य   संयुक्त राज्य अमेरिका  में भी सार्वजनिक डोमेन में है क्योंकि यह भारत में 1996 में सार्वजनिक प्रभावक्षेत्र में आया था और संयुक्त राज्य अमेरिका में इसका कोई कॉपीराइट पंजीकरण नहीं है (यह भारत के वर्ष 1928 में  बर्न समझौते  में शामिल होने और  17 यूएससी 104ए  की महत्त्वपूर्ण तिथि जनवरी 1, 1996 का संयुक्त प्रभाव है।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "Public domain  Public domain  false  false"
    }
  ]
}