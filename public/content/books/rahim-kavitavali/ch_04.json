{
  "book_id": "rahim-kavitavali",
  "chapter_id": "ch_04",
  "number": 4,
  "title": "बरवै नायिका भेद",
  "word_count": 2021,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "दोहा।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कबित कह्यो दोहा कह्यो, तुल्यो न छप्पय छंद।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "बिरच्यो यहै विचारि कै, यह बरवै रस-कंद   [ १ ]   ॥१॥"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "बन्दना—बन्दौं देबि सरदवा   [ २ ]   , पद कर जोरि।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "बरनौं काब्य बरैवा, लगइ न खोरि॥२॥"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "त्रिविध-स्वकीया।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "मुग्धा—"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "लहरत लहर लहरिया, लहर बहार।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "मोतिन जरी किनरिया, बिथुरे बार॥३॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "लागौ आनि नबेलिअहि, मनसिज बान।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "उकसन लागु उरोजवा, दिग   [ ३ ]    तिरछान॥४॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "मध्या—"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "निसुदिन चाहन चाहत, श्री ब्रजराज।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "लाज जोरावरि है, बसि करत अकाज॥५॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "रहत नैन के कोरवा, चितवनि छाय।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "चलत न पगु पैजनिआँ, मगु टहराय॥६॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "प्रौढ़ा—"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "भोरहि बोलि कोइलिआ, बढ़वति ताप।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "घरी एक घरि अलिआ, रहु चुपचाप॥७॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "मुग्धा के भेद।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अज्ञात—"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "कौन रोग दौ   [ ४ ]    छतिआ, उकस्यो   [ ५ ]    आइ।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "दुखि-दुखि उठत करेजवा, लगि जनु लाइ॥८॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "ज्ञात—"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "औचक आइ जोबनवा, मोहिं दुख दीन्ह।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "छुटिगो संग गोइअवाँ   [ ६ ]   , नहिं भल कीन्ह॥९॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "नवोढ़ा—"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "पहिरत चूनि   [ ७ ]    चुनरिआ, भूषन भाव   [ ८ ]   ।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "नैनन्हि देत कजरवा, फूलनि-चाव   [ ९ ]   ॥१०॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "विस्रब्ध-नवोढ़ा—"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "जंघन जोरति गोरिआ, करति कठोर।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "छुअन न पावै पिअवा, कहुँ कुच-कोर॥११॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "द्विविध-परकीया।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "ऊढ़ा—"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "सुनि धुनि कान मुरलिआ, रागन-भेद।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "गै मन छाँड़त गोरिआ, गनत न खेद॥१२॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "निसुदिन सासु ननँदिआ, मोहिं घर घेरु।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "सुनन न देत मुरलिआ, ना धुन टेरु॥१३॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "अनूढ़ा—"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "मोहिं बर जोग कन्हैआ, लागउँ पाँय।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "तुमको पुजउँ देवतवा, होहु सहाय॥१४॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "परकीया (ऊढ़ा) के ६ भेद।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "भूत-गुप्ता—"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "चूनत फूल गुलबवा, डार कटील।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "टुटिगौ बन्द अँगिअवा   [ १० ]   , फटु पट नील॥१५॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "अब नहिं तोहिं पढावों, सुगना सार।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "परिगो दाग अधरवा, चोंच तुचार॥१६॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "भविष्य-गुप्ता—"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "होइ कत कारि बदरिआ, बरखत पाथ।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "जै हौं घन   [ ११ ]    अमरइआ   [ १२ ]   , संग न साथ॥१७॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "जै हौं चुनन कुसुमिआ   [ १३ ]   , खेत बड़ि दूरि।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "चेरिआ केरि छोकरिआ   [ १४ ]   , मोहिं सँग कूरि॥१८॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "वचन-विदग्धा—"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "तोरेसि नाक नथुनिआ, मित   [ १५ ]    हित नीक।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "कहेसि नाक पहिरावहु, चित दै सींक॥१९॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "क्रिया-विदग्धा—"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "बाहर लै कै दिअवा   [ १६ ]   , बारन जाइ।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "सासु-ननँद घर पहुँचत, देत बुताइ   [ १७ ]   ॥२०॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "लक्षिता—"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "आजु नैन के कोरवा, औरै भाँति।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "नागर   [ १८ ]    नेह नवेलिहि, मूँदि न जाति॥२१॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "मुदिता—"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "जै हौं कान्ह नेवतवा   [ १९ ]   , भो दुख दून।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "बहू करै रखवरिआ, है घर सून॥२२॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "नेवते गई ननँदिया, मैके सास।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "दुलहिनि तोरि खबरिआ, औ पिअ पास॥२३॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "कुलटा—"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "जस मदमातल   [ २० ]    हथिआ, हुमकति   [ २१ ]    जाय।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "चितवत छैल तरुनिआ   [ २२ ]   , मुह मुसुकाय॥२४॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "चितवत ऊँचि अटरिआ, दाहिन   [ २३ ]    बाम   [ २४ ]   ।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "लाखन लखत बिदेसिआ   [ २५ ]   , ह्वै बस काम॥२५॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "प्रथम अनुसयना—"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "जमुना-तीर तरुनिअहि, लखि भौ सूल।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "झरिगो कुंज-बेअलिआ   [ २६ ]   , फूलत फूल॥२६॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "ग्रीषम दहत दवरिआ   [ २७ ]   , कुञ्ज-कुटीर।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "तिमि-तिमि तकत तरुनिअहि, बाढ़त पीर॥२७॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "द्वितीय अनुसयना—"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "धीरज धरु किन गोरिआ, करि अनुराग।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "जात जहाँ पिअ देसवा, घन बर बाग॥२८॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "जनि मरु रोइ दुलहिआ   [ २८ ]   , करि मन ऊन   [ २९ ]   ।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "सघन कुंज ससुररिआ, औ घर सून॥२९॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "तृतीय अनुसयना—"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "मितवा करनि पसुरिआ, सुमन सपात।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "फिरि-फिरि ताकि तरुनिआ, मन पछितात॥३०॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "मित उतते फिरि आओ, देखि अराम।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "मैं न गई अमरैआ, रह्यो न काम॥३१॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "गणिका।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "लखि लखि धनिक नयकवा, बनवति भेख।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "रहि गइ हेरि अरसिआ   [ ३० ]   , कजरा रेख॥३२॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "अन्य-सम्भोग दुःखिता—"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "मैं पठई जेहि कजवा, आइस साधि।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "छुटिगो सीस जुरववा, दिढ़ करि बाँधि॥३३॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "सखि इत हरबर आवत, भो पथ खेद।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "रहि-रहि लेत उससवा, औ तन सेद॥३४॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "रूप-गर्विता—"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "छीन, मलिन, विष-भइया, औगुन तीन।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "मोहिं कह चन्द-बदनिआ, पिय मति हीन॥३५॥   [ ३१ ]"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "रातुल   [ ३२ ]    भयसि मुगउआ   [ ३३ ]   , निरस पखान   [ ३४ ]   ।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "यह मधु-भरल   [ ३५ ]    अधरवा   [ ३६ ]   , करसि समान॥३६॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "प्रेम-गर्विता—"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "आपुहि देत कजरवा, गूँदत हार।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "चुनि पहिराव चुनरिआ, प्रान-अधार॥३७॥"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "औरन पाँय जवकवा   [ ३७ ]   , नाइन दीन।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "तुम्हैं अँगोरत गोरिआ, न्हान न कीन॥३८॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "नायिकावों के और दस भेद।\n१—प्रोषितपतिका।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "मुग्धा-प्रोषितपतिका—"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "तै अब जासि बेइलिआ   [ ३८ ]   , जरि-बरि मूल।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "बिनु पिय सूल करेजवा, लखि तुव फूल॥३९॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "मध्या-प्रोषितपतिका—"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "का तुव मंजु लतिअवा, झलरति जाय।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "पिअ बिन मन हुड़कइया   [ ३९ ]   , मोहिं न सुहाय॥४०॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "प्रौढ़ा-प्रोषितपतिका—"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "कासन   [ ४० ]    कहउँ सँदेसवा, पिअ परदेसु।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "लागेउ चइत न फूले, तेहि बन टेसु॥४१॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "२—खण्डिता।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "मुग्धा-खण्डिता—"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "सखि-सिख सीखि नबेलिआ, कीन्हेसि मान।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "पिय लखि कोप भवनवाँ, ठानेसि ठान॥४२॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "सीस नवाइ नबेलिया, निचवा   [ ४१ ]    जोइ।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "छिति   [ ४२ ]    खनि   [ ४३ ]    छोर छिगुनिआ, सुसुकन   [ ४४ ]    रोइ॥४३॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "मध्या-खण्डिता—"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "ठगि गो पीअ पलँगिआ, आलस पाइ।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "पौढ़हु जाइ बरोठवा, सेज बिछाइ॥४४॥"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "पोछेहु अनख   [ ४५ ]    कजरवा, जावक भाल।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "उपटेउ पीतम छतिया, बिन गुन माल॥४५॥"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "प्रौढ़ा-खण्डिता—"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "पिय आवत अगनइआ, उठि कै लीन्ह।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "बिहसत चतुर तिरिअवा, बैठन दीन्ह॥४६॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "परकीया-खण्डिता—"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "जेहि लगि सजन सनेहिया, छुट घर बार।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "अपने होत पिअरवा, साँच परार॥४७॥"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "पौढ़हु पीअ पलँगिआ, मींजउँ पाय।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "रैनि जगे कर निंदिआ, सब मिटि जाय॥४८॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "गणिका-खण्डिता—"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "मितवा ओठ कजरवा, जावक भाल।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "लिहेसि काढ़ि बरिअइआ   [ ४६ ]   , तकि मनिमाल॥४९॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "३—कलहान्तरिता।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "मुग्धा-कलहान्तरिता—"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "आयहु अबहिं गवनवाँ   [ ४७ ]   , तुरतहि मान।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "अब रस लागि गोरिअवा, मन पछितान॥५०॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "मध्या-कलहान्तरिता—"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "मैं मति मन्द तिरिअवा, परलेउँ   [ ४८ ]    भोरि।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "ते नहिं कन्त मनवलेउँ   [ ४९ ]   , तोहिं कछु खोरि॥५१॥"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "प्रौढ़ा-कलहान्तरिता—"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "थकि गौ करि मनुहरिआ   [ ५० ]   , फिरि गौ पीव।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "मैं उठि तुरत न लायउँ, हिमकर हीव॥५२॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "परकीया-कलहान्तरिता—"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "जेहि लगि कीन बिरोगवा, ननद जेठानि।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "लीन न लाइ करेजवा, तेहि हित जानि॥५३॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "गणिका-कलहान्तरिता—"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "जेहि दीन्हे बहु बेरिया, मोहिं मनि-माल।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "तेहते रूठेउँ सखिआ, फिरि गौ लाल॥५४॥"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "४–बिप्रलब्धा।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "मुग्धा-बिप्रलब्धा—"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "मिलेउ न कन्त सहेटवा   [ ५१ ]   , लखेउ डेराइ।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "धनिआ   [ ५२ ]    कमल बदनिआ, गौ कुभिलाइ॥५५॥"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "मध्या-बिप्रलब्धा—"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "लखेसि न केलि-भवनवाँ, नन्द-कुमार।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "लै-लै ऊँचि उससवा, ह्वइ बिकरार   [ ५३ ]   ॥५६॥"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "प्रौढ़ा-बिप्रलब्धा—"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "देखि न कन्त सहेटवा, भो दुख पूरि।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "रोवत नैन कजरवा, ह्वै गौ दूरि॥५७॥"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "परकीया-बिप्रलब्धा—"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "बैरिनि मह अभिसरवा, अति दुखदानि।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "तापर मिल्यो न मितवा, भो पछितानि॥५८॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "गणिका-बिप्रलब्धा—"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "करिकै सोरह सिंगरवा, अतर लगाइ।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "मिलेउ न लाल सहेटवा, फिरि पछिताइ॥५९॥"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "५—उत्कण्ठिता।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "मुग्धा-उत्कण्ठिता—"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "गौ जुग   [ ५४ ]    जाम   [ ५५ ]    जमिनिआ   [ ५६ ]   , पिय नहिं आइ।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "राखेहु कौन सवतिआ, धौं बिलमाइ॥६०॥"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "मध्या-उत्कण्ठिता—"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "जोहत   [ ५७ ]    परी पलँगिआ, पिय कै बाट।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "बेचेउ चतुर तिरिअवा, धौं केहि हाट॥६१॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "प्रौढ़ा-उत्कण्ठिता—"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "पिय-पथ हेरति गोरिआ, भो भिनुसार   [ ५८ ]   ।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "चलहु न करिहि तिरिअवा, तुव इतबार॥६२॥"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "परकीया-उत्कण्ठिता—"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "उठि-उठि जात खिरकिआ, जोहन बाट।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "कत वह आइहि मितवा, सूनी खाट॥६३॥"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "गणिका-उत्कण्ठिता—"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "कढ़ि न नींद भिनुसरवा, आलस पाइ।"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "धन दै मूरुख मितवा, रहल लोभाइ॥६४॥"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "६—बासकसज्जा।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "मुग्धा-बासकसज्जा—"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "हरुए   [ ५९ ]    गवन नबेलिआ, डीठि बचाइ।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "पौढ़ी जाइ पलँगिआ, सेज बिछाइ॥६५॥"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "मध्या-बासकसज्जा—"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "सेज बिछाइ पलँगिआ, अंग सिंगार।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "चितवत चौंकि तरुनिआ, दै दिग-द्वार॥६६॥   [ ६० ]"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "प्रौढ़ा-बासकसज्जा—"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "हँसि-हँसि हेरि अरसिआ, सहज सिंगार।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "उतरत चढ़त नबेलिआ, पियकै बार॥६७॥"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "परकीया-बासकसज्जा—"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "सोवत सब गुरु लोगवा, जानेउ बाल।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "दीन्हेसि खोलि खिरकिआ, उठिकै हाल॥६८॥"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "गणिका-बासकसज्जा—"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "कीन्हेसि सबै सिंगरवा, चातुर बाल।"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "ऐहै प्रान पियरवा, लै मनि-माल॥६९॥"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "७–स्वाधीनपतिका।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "मुग्धा-स्वाधीनपतिका—"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "आपुहिं देत जवकवा, गहि-गहि पाँइ।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "आपु देत मोहि पिअवा, पान खवाइ॥७०॥"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "मध्या-स्वाधीनपतिका—"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "पीतम करत पिअरवा   [ ६१ ]   , कहल न जात।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "रहत गढ़ावत सोनवा, यहै सिरात॥७१॥"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "प्रौढ़ा-स्वाधीनपतिका—"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "मैं अरु मोर पिअरवा, जस जल-मीन।"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "बिछुरत तजत परनवाँ   [ ६२ ]   , रहत अधीन॥७२॥"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "परकीया-स्वाधीनपतिका—"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "भौ जुग नयन चकोरवा, पिअ मुख चन्द।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "जानति है तिअ अपने, मोहि सुख-कन्द॥७३॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "गणिका-स्वाधीनपतिका—"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "लै हीरन कै हरवा, मोतिन माल।"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "मोहि रहत पहिरावत, बसि ह्वै लाल॥७४॥"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "८–अभिसारिका।"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "मुग्धा-अभिसारिका—"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "चलीं लवाइ नबेलिअहि, सखि सब संग।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "जस हुलसत गो गोदवा, मत्त मतंग॥७५॥"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "मध्या-अभिसारिका—"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "पहिरे लाल अछुअवा, तिअ गज-पाय।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "चढ़िकै नेह-हथियवा, हुलसत जाय॥७६॥"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "प्रौढ़ा-अभिसारिका—"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "चली रइनि   [ ६३ ]    अधिअरिआ   [ ६४ ]   , साहस गाढ़ि।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "पाँयन फेरि ककरिआ, डारेसि काढ़ि॥७७॥"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "परकीया-कृष्णाभिसारिका—"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "नील मनिन के हरवा, नील सिंगार।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "किए रइनि अधिअरिआ, धनि अभिसार॥७८॥"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "परकीया-शुक्लाभिसारिका—"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "सेत कुसुम के हरवा, भूषन सेत।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "चली रैनि उजिअरिआ, पिअ के हेत॥७९॥"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "दिवा-अभिसारिका—"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "पहिरि बसन जरितरिआ   [ ६५ ]   , पिअ के हेत।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "चली जेठ दुपहरिया, मिलि रवि जोति॥८०॥"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "गणिका-अभिसारिका—"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "धन   [ ६६ ]   -हित कीन्ह सिंगरवा, चातुर बाल।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "चली संग लै चेरिआ   [ ६७ ]   , जहँवा लाल॥८१॥"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "९—प्रवत्स्यत्प्रेयसी।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "मुग्धा-प्रवत्स्यत्प्रेयसी—"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "परिगौ कानन सखिआ, पिअ को गौन।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "बैठी कनक पलँगिआ, होइकै मौन॥८२॥"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "मध्या-प्रवत्स्यत्प्रेयसी—"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "सुठि सुकुमार तरुनिआ, सुनि पिअ गौन।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "लाजनि पौढ़ि ओबरिआ   [ ६८ ]   , ह्वै कै मौन॥८३॥"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "प्रौढ़ा-प्रवत्स्यत्प्रेयसी—"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "बन घन फूलि टेसुइआ   [ ६९ ]   , बगियन बेलि।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "तब पिअ चलेउ बिदेसवा, फागुन फैलि॥८४॥"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "परकीया-प्रवत्स्यत्प्रेयसी—"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "मितवा चलेउ बिदेसवा, मन अनुरागि।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "पिअ की सुरति गगरिया, रहि मग लागि॥८५॥"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "गणिका-प्रवत्स्यत्प्रेयसी—"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "पीतम एक सुमिरिनिआ   [ ७० ]   , मोंहि दै जाहु।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "जेहिं जपि तोर बिरहवा   [ ७१ ]   , करब निबाहु॥८६॥"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "१०—आगतपतिका।"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "मुग्धा-आगतपतिका—"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "बहुत दिना पर पिअवा, आयउ आजु।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "पुलकित नवल बधुइआ, कर घर-काजु॥८७॥"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "मध्या-आगतपतिका—"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "पिअवा पौरि दुअरवा, उठि किन देखु।"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "दुरलभ पाइ बिदेसिआ, जिअकै लैखु॥८८॥"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "प्रौढ़ा-आगतपतिका—"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "योबन प्रान पिअरवा, हेरेउ आइ।"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "तलफत मीन तिरिअवा, जस जल पाइ॥८९॥"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "परकीया-आगतपतिका—"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "पूछत चली खबरिया, मितवा   [ ७२ ]    तीर।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "नैहर खोज तिरिअवा, पहिरि सुचीर॥९०॥"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "गणिका-आगतपतिका—"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "तौं लगि मिटै न मितवा, तनकी पीर।"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "जौं लगि पहिरि न छतिआ, नख-नग-चीर॥९१॥"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "पुनः त्रिविध नायिका-भेद।"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "उत्तमा—"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "लखि अपराध नयकवा, नहिं रिस कीन्ह।"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "बिहँसत चँदन-चउकिया   [ ७३ ]   , बैठन दीन॥९२॥"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "मध्यमा—"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "बिन गुन पिअ उर हरवा, उपटेउ हेरि।"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "चुप ह्वै चित्र-पुतरिया, रहि चख फेरि॥९३॥"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "अधमा—"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "बार-बार गुरु   [ ७४ ]    मनवा   [ ७५ ]   , जनि करु नारि।"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "मानिक औ गजमोतिआ, जौं लगि बारि॥९४॥"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "सखी के काम"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "मण्डन—"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "सखिअन कीन सिंगरवा, रचि बहु भाँति।"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "हेरति नैन अरसिआ, मुख मुसकाति॥९५॥"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "शिक्षा—"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "थके बैठि गोड़वरिआ   [ ७६ ]   , मींजहु पाँउ।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "पिअ तन पेखि गरमिया, बिजन   [ ७७ ]    डोलाउ॥९६॥"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "उपालंभ—"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "चुप ह्यौ रह्यो सँदेसवा, सुनि मुसुकाय।"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "पिअ निज हाथ बिरवना   [ ७८ ]   , दीन पठाय॥९७॥"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "परिहास—"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "बिहँसत भौंह चढ़ाए, धनुष मनोज।"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "लावत उर अबलनियाँ   [ ७९ ]   , ऐंठि उरोज॥९८॥"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "दर्शन।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "साक्षात्‌-दर्शन—"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "बिरहिनि और बिदेसिआ, भौ एक ठौर।"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "पिअ मुख तकत तिरिअवा, चन्द चकोर॥९९॥"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "चित्र-दर्शन—"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "पिअ मूरति चित-सरिया   [ ८० ]   , देखत बाल।"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "बितवत अवधि बसरवा   [ ८१ ]   , जपि-जपि माल॥१००॥"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "श्रवण-दर्शन—"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "आयउ मीत बिदेसिआ, सुनु सखि तोर।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "उठि किन करसि सिगँरवा, सुनि सिख मोर॥१०१॥"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "स्वप्न-दर्शन—"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "पीतम मिलेउ सपनवाँ, भौ सुख-खानि।"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "आनि जगायसि चेरिआ, भइ दुख-दानि॥१०२॥"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "नायक।"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "लक्षण—"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "सुन्दर चतुर धनिकवा   [ ८२ ]   , कुल को ऊँच।"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "केलि-कला परबिनवा   [ ८३ ]   , सील समूच॥१०३॥"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "पति उपपति बैसिकवा, त्रिबिध बखानि।"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "विधि सों ब्याह्यो गुरुजन, पति सो जानि॥१०४॥"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "पति—"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "लैकै सुघर पुरुषवा, पिअ के साथ।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "छपरो एक छतरिआ, बरखत पाथ॥१०५॥"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "उपपति—"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "झाँकि झरोखे गोरिआ, आँखिन जोर।"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "फिरि चितवति चित मितवा, करत निहोर॥१०६॥"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "बैसिक—"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "जनु अति नील अलकिया   [ ८४ ]   , बनसी   [ ८५ ]    लाय।"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "मो मन बार वधुअवा, मीन बझाय   [ ८६ ]   ॥१०७॥"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "चतुर्विध-पति।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "अनुकूल—"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "करत नही अपरधवा, सपनेहुँ पीव।"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "मान करै को सधवा, रहिगौ जीव॥१०८॥   [ ८७ ]"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "दक्षिण—"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "सब मिलि करैं निहोरवा, हम कहँ देइ।"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "गुहि-गुहि चम्पक टँड़िआ, उचइ सो लेइ॥१०९॥"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "धृष्ट—"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "जहवाँ जगे रइनिआँ, तहवाँ जाउ।"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "जोरि नयन निरलजवा, कत मुसकाउ॥११०॥"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "शठ—"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "छूट्यो लाज गरिअवा, औ कुल-कानि।"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "करत रोज अपरधवा, परि गइ बानि॥१११॥"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "पुनः चतुर्विध नायक।"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "क्रिया-चतुर नायक—"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "खेलत जानिसि टोलिआ   [ ८८ ]   , नन्द किसोर।"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "छुइ बृषभानु-कुँअरिआ, होइगो चोर॥११२॥"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "वचन-चतुर नायक—"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "सघन कुँज अमरैआ, सीतल छाँहि।"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "झगरति आइ कोइलिआ, फिरि उड़ि जाहि॥११३॥"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "मानी-नायक—"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "अब न जनम भरि सखिआ, ताकौं ओहि।"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "ऐंठत गो अभिमनवा, तजि कै मोहि॥११४॥"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "प्रोषित-नायक—"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "करिबै ऊँचि अटरिआ, तिअ सँग केलि।"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "कबधौं पहिरि गजरवा, हार चमेलि॥११५॥"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "इति बरवै नायिका-भेद समाप्त॥"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "↑    मूल।"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "↑    शारदा-सरस्वती।"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "↑    दृग-आँखैं।"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "↑    दोनों,"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "↑    पैदा हो गया,"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "↑    हमजोलियों का-सखियों का।"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "↑    चुन करके,"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "↑    इच्छा,"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "↑    चाह।"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "↑    आँगी-चोली।"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "↑    पीतम,"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "↑    वाटिका।"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "↑    कुसुम के फूल,"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "↑    छोकरी-लड़की।"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "↑    मीत-मित्र-प्रिय।"
    },
    {
      "id": "b_364",
      "type": "p",
      "text": "↑    दीप,"
    },
    {
      "id": "b_365",
      "type": "p",
      "text": "↑    बुझा देती है।"
    },
    {
      "id": "b_366",
      "type": "p",
      "text": "↑    प्रेमी।"
    },
    {
      "id": "b_367",
      "type": "p",
      "text": "↑    नेवते-बुलावे।"
    },
    {
      "id": "b_368",
      "type": "p",
      "text": "↑    मतवाला,"
    },
    {
      "id": "b_369",
      "type": "p",
      "text": "↑    झूमता हुआ,"
    },
    {
      "id": "b_370",
      "type": "p",
      "text": "↑    तरुणी।"
    },
    {
      "id": "b_371",
      "type": "p",
      "text": "↑    दाएँ (इधर-उधर),"
    },
    {
      "id": "b_372",
      "type": "p",
      "text": "↑     बाएँ (इधर-उधर),"
    },
    {
      "id": "b_373",
      "type": "p",
      "text": "↑    पर पुरुष।"
    },
    {
      "id": "b_374",
      "type": "p",
      "text": "↑    कुंज की बेलें-लताएँ तथा बेला।"
    },
    {
      "id": "b_375",
      "type": "p",
      "text": "↑    दावानल।"
    },
    {
      "id": "b_376",
      "type": "p",
      "text": "↑    दुलहन-बहू,"
    },
    {
      "id": "b_377",
      "type": "p",
      "text": "↑    खिन्न।"
    },
    {
      "id": "b_378",
      "type": "p",
      "text": "↑    आरसी—स्त्रियों के अंगूठे में पहिनने का एक आभूषण होता है जिसमें ऊपर की ओर एक गोल शीशा लगा रहता है।"
    },
    {
      "id": "b_379",
      "type": "p",
      "text": "↑    महात्मा तुलसीदासजी के इस दोहे में ऐसाही भाव है:—"
    },
    {
      "id": "b_380",
      "type": "p",
      "text": "जन्म सिंधु पुनि बंधु विष, दिन मलीन सकलंक।\nसिय मुख समता पाव किमि, चन्द्र बापुरो रंक॥"
    },
    {
      "id": "b_381",
      "type": "p",
      "text": "↑    रंगदार,"
    },
    {
      "id": "b_382",
      "type": "p",
      "text": "↑    मूँगा,"
    },
    {
      "id": "b_383",
      "type": "p",
      "text": "↑    पत्थर,"
    },
    {
      "id": "b_384",
      "type": "p",
      "text": "↑    मिठास से भरा हुआ,"
    },
    {
      "id": "b_385",
      "type": "p",
      "text": "↑    अधर।"
    },
    {
      "id": "b_386",
      "type": "p",
      "text": "↑    जावक-महावर।"
    },
    {
      "id": "b_387",
      "type": "p",
      "text": "↑    बेलि-बेला।"
    },
    {
      "id": "b_388",
      "type": "p",
      "text": "↑    मनके हुड़कानेवाली-याद दिलानेवाली।"
    },
    {
      "id": "b_389",
      "type": "p",
      "text": "↑    किससे।"
    },
    {
      "id": "b_390",
      "type": "p",
      "text": "↑    नीचे की ओर,"
    },
    {
      "id": "b_391",
      "type": "p",
      "text": "↑    भूमि,"
    },
    {
      "id": "b_392",
      "type": "p",
      "text": "↑    खोदती है,"
    },
    {
      "id": "b_393",
      "type": "p",
      "text": "↑    भीतर ही भीतर।"
    },
    {
      "id": "b_394",
      "type": "p",
      "text": "↑    अनखानेवाला।"
    },
    {
      "id": "b_395",
      "type": "p",
      "text": "↑    बरजोरी से।"
    },
    {
      "id": "b_396",
      "type": "p",
      "text": "↑    गौना।"
    },
    {
      "id": "b_397",
      "type": "p",
      "text": "↑    कर दिया,"
    },
    {
      "id": "b_398",
      "type": "p",
      "text": "↑    मनाया।"
    },
    {
      "id": "b_399",
      "type": "p",
      "text": "↑    मनको प्रसन्न करने की।"
    },
    {
      "id": "b_400",
      "type": "p",
      "text": "↑    एकान्त स्थान।"
    },
    {
      "id": "b_401",
      "type": "p",
      "text": "↑    नायिका।"
    },
    {
      "id": "b_402",
      "type": "p",
      "text": "↑    बेकल।"
    },
    {
      "id": "b_403",
      "type": "p",
      "text": "↑    दो,"
    },
    {
      "id": "b_404",
      "type": "p",
      "text": "↑    घड़ी,"
    },
    {
      "id": "b_405",
      "type": "p",
      "text": "↑    रात्रि।"
    },
    {
      "id": "b_406",
      "type": "p",
      "text": "↑    देखती है।"
    },
    {
      "id": "b_407",
      "type": "p",
      "text": "↑    तड़का-सबेरा।"
    },
    {
      "id": "b_408",
      "type": "p",
      "text": "↑    हलके-हलके—चुपके-चुपके।"
    },
    {
      "id": "b_409",
      "type": "p",
      "text": "↑    कविवर मतिराम के इस दोहे का भाव इस बरवै से बहुत कुछ मिलता जुलता है:—"
    },
    {
      "id": "b_410",
      "type": "p",
      "text": "सुन्दरि सेज सँवारिकै, सब साजे सिंगार।\nदृग-कमलन के द्वार पर, बाँधे बन्दनवार॥"
    },
    {
      "id": "b_411",
      "type": "p",
      "text": "↑    प्यार।"
    },
    {
      "id": "b_412",
      "type": "p",
      "text": "↑    प्राण।"
    },
    {
      "id": "b_413",
      "type": "p",
      "text": "↑    रात्रि,"
    },
    {
      "id": "b_414",
      "type": "p",
      "text": "↑    आधी के क़रीब"
    },
    {
      "id": "b_415",
      "type": "p",
      "text": "↑    जड़ाऊ।"
    },
    {
      "id": "b_416",
      "type": "p",
      "text": "↑    पीतम,"
    },
    {
      "id": "b_417",
      "type": "p",
      "text": "↑    चेरी-दासी।"
    },
    {
      "id": "b_418",
      "type": "p",
      "text": "↑    अन्दर-घरके भीतर की कोठरी।"
    },
    {
      "id": "b_419",
      "type": "p",
      "text": "↑    टेसू।"
    },
    {
      "id": "b_420",
      "type": "p",
      "text": "↑    सुमिरिनी-माला,"
    },
    {
      "id": "b_421",
      "type": "p",
      "text": "↑    बिरह।"
    },
    {
      "id": "b_422",
      "type": "p",
      "text": "↑    पीतम।"
    },
    {
      "id": "b_423",
      "type": "p",
      "text": "↑    चन्दन की चौकी।"
    },
    {
      "id": "b_424",
      "type": "p",
      "text": "↑    भारी,"
    },
    {
      "id": "b_425",
      "type": "p",
      "text": "↑    मान।"
    },
    {
      "id": "b_426",
      "type": "p",
      "text": "↑    पैरों के पास,"
    },
    {
      "id": "b_427",
      "type": "p",
      "text": "↑    हवा।"
    },
    {
      "id": "b_428",
      "type": "p",
      "text": "↑    वीरा-पान।"
    },
    {
      "id": "b_429",
      "type": "p",
      "text": "↑    सुकुमार स्त्री।"
    },
    {
      "id": "b_430",
      "type": "p",
      "text": "↑    चित्र-सारी,"
    },
    {
      "id": "b_431",
      "type": "p",
      "text": "↑    दिन।"
    },
    {
      "id": "b_432",
      "type": "p",
      "text": "↑    नायक,"
    },
    {
      "id": "b_433",
      "type": "p",
      "text": "↑    प्रवीण चतुर।"
    },
    {
      "id": "b_434",
      "type": "p",
      "text": "↑    अलकैं-बाल,"
    },
    {
      "id": "b_435",
      "type": "p",
      "text": "↑    बंसी-मछली फाँसने का काँटा,"
    },
    {
      "id": "b_436",
      "type": "p",
      "text": "↑    फाँस करके।"
    },
    {
      "id": "b_437",
      "type": "p",
      "text": "↑    मतिराम के इस दोहे का भाव ठीक ऐसाही है:—"
    },
    {
      "id": "b_438",
      "type": "p",
      "text": "सपने हूँ मन भावतो, करत नहीं अपराध।\nमेरे मन ही में रहा, मान करन की साध॥"
    },
    {
      "id": "b_439",
      "type": "p",
      "text": "↑    अपने टोले में।"
    }
  ]
}