{
  "book_id": "rahim-kavitavali",
  "chapter_id": "ch_06",
  "number": 6,
  "title": "मदनाष्टक",
  "word_count": 247,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "बरवै नायिका भेद"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "रहीम-कवितावली    (१९२६)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     रहीम    , संपादक     सुरेन्द्रनाथ तिवारी        नगर-शोभा-वर्णन   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "Layout 2"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "मदनाष्टक"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "[१]"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "मनसि मम नितान्तम् आयकैं बासु कीया।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तन धन सब मेरा मान तैं छीन लीया॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अति चतुर मृगाक्षी देखतैं मौन भागी।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "मदन शिरसि भूयः क्या बला आन लागी॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "[२]"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "बहत मरुति मन्दम् मैं उठी राति जागी।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "शशिकर-कर लागें सेल ते पैन बागी   &#91; १ &#93;   ॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "अहह विगत स्वामी क्या करौं मैं अभागी।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "मदन शिरसि भूयः क्या बला आन लागी॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "[३]"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "हर नयन हुताशम् ज्वालया जो जलाया।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "रति-नयन जलौघै खाख बाकी बहाया॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तदपि दहति चित्तम् मामकम् क्या करौंगी।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "मदन शिरसि भूयः क्या बला आन लागी॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "[४]"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "विगत घन निशीथे चाँद की रोशनाई।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "सघन वन निकुंजे कान्ह बंसी बजाई॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "सुत पति गतनिद्रा स्वामियाँ छोड़ भागीं।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "मदन शिरसि भूयः क्या बला आन लागी॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "[५]"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "हिम ऋतु रतिधामा सेज लोटौं अकेली।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "उठत बिरह ज्वाला क्यों सहौं री सहेली॥"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "चकित नयन बाला तत्र निद्रा नलागी।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "मदन शिरसि भूयः क्या बलाआन लागी॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "[६]"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "कमल मुकुल मध्ये राति को ऐ सयानी।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "लखि मधुकर बंधम् तू भई री दिवानी॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "तदुपरि मधुकाले कोकिला देखि भागी।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "मदन शिरसि भूयः क्या बला आन लागी॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "[७]"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "तव बदन मयंकी ब्रह्म की चोप बाढ़ी।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "मुख कवँ लखि भूपै चाँद ते कांति गाढ़ी॥"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "मदन-मथित रंभा देखतै मोहि भागी।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "मदन शिरसि भूयः क्या बला आन लागी॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "[८]"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "नभासि घन घनान्ते है घनी कैसि छाया।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "पथिक जन बधूनाम् जन्म केता गँवाया॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "इति बदति पठानी मन्मथांगी  विरागी।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "मदन शिरसि भूयः क्या बला आन लागी॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "↑    \"शशि-कर कर लागे सेजको छोड़ भागी।\""
    }
  ]
}