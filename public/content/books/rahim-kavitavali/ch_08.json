{
  "book_id": "rahim-kavitavali",
  "chapter_id": "ch_08",
  "number": 8,
  "title": "खेट-कौतुक",
  "word_count": 177,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "श्लोक"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "यत्पादपङ्कजरेणोः प्रसादमासाद्य सर्वभुवनेषु।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "प्रणमामीष्टसुमूर्तिं तामहममराः प्रभुत्वतां यान्ति॥१॥"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "जिनके चरण कमल-धूलि के प्रसाद से देवता सम्पूर्ण लोकों में बड़ाई पाते हैं, उन अपने इष्टदेव कृष्णचन्द्र को मैं प्रणाम करता हूँ॥१॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कमर्विलाधशालए नरोहि बामुरौवतः।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सदाबली च साबिरः सुकर्मकृद्यदा भवेत्॥२॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "जिसकी कुण्डली के तीसरे स्थान में चन्द्रमा हो वह मनुष्य सन्तोषी, शीलवान्, बली और अच्छे कामों का करनेवाला होता है॥२॥"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "मुश्तरी यदि भवेद् ज़रखाने,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "बुज़रुगः परमपुण्यमतिः स्यात्।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "कामिल: कनकसूनुयुतश्च,"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "ख़ूबरोहि मनुजो ज़रदारः॥३॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जिसके दूसरे घर में बृहस्पति हों वह बड़ा पुण्यात्मा और श्रेष्ठ पुरुष होता है तथा पुत्र, सोना और धन-धान्य से युक्त होता है॥३॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "आयुख़ाने चश्मख़ोरा मालख़ाने मुश्तरी।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "राहु जो पैदावखाने शाह होवे मुल्क का॥४॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "जिसके आठवें शुक्र, दूसरे बृहस्पति हों और राहु लग्न में हो वह राजा होता है॥४॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "रबी शत्रुखाने पड़ै उच्च का।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "करै खाक दौलत फिरै जाबजा॥५॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "सूर्य्य यदि मेष-राशि का होकर कुंडली के छठे घर में पड़ जाय तो धन को नाश करके मनुष्य को मारा-मारा फिराता है॥५॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "↑    इस पुस्तक के पाँच श्लोक नमूने के तौर पर दिए गए हैं। यह प्राप्त है और प्रकाशित भी हो चुकी है।"
    }
  ]
}