{
  "book_id": "vaidehi-vanvas",
  "chapter_id": "ch_04",
  "number": 4,
  "title": "सर्ग ३ — मंत्रणा गृह",
  "word_count": 2049,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "चतुष्पद"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "मंत्रणा गृह में प्रातःकाल ।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "भरत लक्ष्मण रिपुसूदन संग ।।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "राम बैठे थे चिन्ता - मग्न ।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "छिड़ा था जनकात्मजा प्रसंग ॥१॥"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "कथन दुर्मुख का आद्योपान्त ।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "राम ने सुना, कही यह बात ।।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अमूलक जन - रव होवे किन्तु ।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कीर्ति पर करता है पविपात ॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "हुआ है जो उपकृत वह व्यक्ति ।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "दोप को भी न कहेगा दोप ।।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "बना करता है जन - रव हेतु ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "प्रायग. लोक का असन्ताप ॥३॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "३३  तृतीय सर्ग"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "प्रजा - रंजन हित - साधन भाव ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "राज्य - शागन का है वर - अंग ।।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "है प्रकृति प्रकृत नीति प्रतिकृल ।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "लोक आराधन व्रत का भंग ॥४॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "क्यों टले बढा लोक - अपवाद ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "इस विपय मे है क्या कर्तव्य ।।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अधिक हित होगा जो हो ज्ञात ।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "बन्धुओं का क्या है वक्तव्य ॥५॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "भरत सविनय बोले ससार ।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "विभामय होते, है तम - धाम ।।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "वही है अधम जनों का वास ।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "जहाँ है मिलते लोक - ललाम ॥६॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "तो नहीं नीच - मना है अल्प।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "यदि मही मे है महिमावान ।।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "बुरों को है प्रिय पर - अपवाद ।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "भले है करते गौरव गान ।।७।।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "किसी को है विवेक से प्रेम ।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "किसी को प्यारा है अविवेक ।।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "जहाँ है हंस - वंश - अवतंस ।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "वारी पर है बक - वृत्ति अनेक ॥८॥"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "४  वैदेही-वनवास"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "द्वेप परवश होकर ही लोग।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "नहीं करते हैं निन्दावाद ।।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "वृथा दंभी जन भी कर दंभ ।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "सुनाते हैं अप्रिय सम्बाद ।।९॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "दूसरों की रुचि को अवलोक ।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "कही जाती है कितनी बात ।।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "कही पर गतानुगतिक प्रवृत्ति ।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "निरर्थक करती है उत्पात ॥१०॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "लोक - आराधन है नृप - धर्म ।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "किन्तु इसका यह आगय है न ।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "सुनी जाये उनकी भी बात ।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "जो बला ला पाते हैं चैन ॥११॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "प्रजा के सकल-वास्तविक-स्वत्त्व ।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "व्यक्तिगत उसके सब-अधिकार ॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "उसे है प्राप्त सुखी है सर्व।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "सुकृति से कर वैभव - विस्तार ॥१२॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "कहीं है कलह न वैर विरोध ।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "कहाँ पर है धन धरा विवाद ।।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "तिरस्कृत है कलुपित चितवृत्ति ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "त्यक्त है प्रबल - प्रपंच • प्रमाद ।।१३।।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "३५  तृतीय सर्ग"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "सुधा है वहाँ वरसती आज ।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "जहाँ था वरस रहा अंगार ||"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "वहाँ है श्रुत स्वर्गीय निनाद ।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "जहाँ था रोदन हाहाकार ।।१४।।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "गौरवित है मानव समुदाय ।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "गिरा का उर में हुए विकास ।।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "शिवा से है शिवता की प्राप्ति ।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "रमा का है घर घर में वास ॥१५॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "वन गये है पारस सब मेरु ।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "उदधि करते है रत्न प्रदान ।।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "प्रसव करती है वसुधा स्वर्ण ।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "वन बने है नन्दन उद्यान ॥१६॥"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "सुखद - सुविधा से हो सम्पन्न ।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "सरसता है सरिता का गात ।।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "बना रहता है पावन वारि ।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "ज करता है सावन उत्पात ॥१७॥"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "सदा रह हरे भरे तरु - वृन्द ।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "सफल वन करते है सत्कार ॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "दिखाते हैं उत्कुल्ल प्रसून ।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "वहन कर वहु सौरभ संभार ॥१८॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "लोग तने है सुख - सर्वग्न ।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "विकच टनना है नित जलजात ।।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "बार है. बने पर्व के बार।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "गत है दीप - मालिका गत ॥१९।।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "हुआ अज्ञान का तिमिर दर।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "ज्ञान का फैला है आलोक॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "सुखद है सकल लोक को काल।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "बना अवलोकनीय है ओक॥२०॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "शान्ति-मय-वातावरण विलोक।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "रुचिर चर्चा है चारों ओर॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "कीर्त्ति-राका-रजनी को देख।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "विपुल-पुलकित है लोक चकोर॥२१॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "किन्तु देखे राकेन्दु विकास।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "सुखित कब हो पाता है कोक॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "फूटती है"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "दिव्यता दिनमणि की अवलोक"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "जगत जीवनप्रद पावस काल।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "देख उठते हैं अर्क"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "३७  तृतीय सर्ग"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "जगत ही है विचित्रता धाम ।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "विविधता विधि की है विख्यात ॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "नही तो सुन पाता क्यों कान ।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "अरुचिकर परम असंगत बात ॥२४॥"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "निद्य है रघुकुल तिलक चरित्र ।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "लांछिता है पवित्रता मूर्ति ।।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "पूत शासन में कहता कौन ।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "जो न होती पामरता पूर्ति ॥२५॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "आप हैं प्रजा - वृन्द - सर्वस्व ।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "लोक आराधन के अवतार ॥"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "लोकहित - पथ - कण्टक के काल ।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "लोक मर्यादा पारावार ॥२६॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "बन गई देश काल अनुकूल ।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "प्रगति जितनी थी हित विपरीत ॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "प्रजारजन की जो है नीति ।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "वही है आदर सहित गृहीत ॥२७।।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "जानते नही इसे हैं लोग ।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "कहा जाता है किसे अभाव ॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "विलसती है घर घर में भूति ।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "भरा जन - जन मे है सद्भाव ॥२८॥"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "८  वैदेही-वनवास"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "रही जो कण्टक - पूरित राह ।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "वहाँ अब बिछे हुए हैं फूल ॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "लग गये हैं अब वहाँ रसाल।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "जहाँ पहले थे खड़े ववूल ॥२९।।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "प्रजा में व्यापी है प्रतिपत्ति ।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "भर गया है रग रग में ओज ॥"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "शस्य - श्यामला बनी मरु - भूमि ।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "ऊसरों में हैं खिले सरोज ॥३०॥"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "नही पूजित है कोई व्यक्ति।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "आज हैं पूजनीय गुण कर्म ॥"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "वही है मान्य जिसे है ज्ञात ।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "मानसिक पीड़ाओं का मर्म ॥३१॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "इसलिये है यह निश्चित वात ।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "प्रजाजन का यह है न प्रमाद ॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "कुछ अधम लोगों ने ही व्यर्थ ।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "उठाया है यह निन्दावाद ॥३२॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "सर्व साधारण मे अधिकांश ।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "हुआ है जन - रव का विस्तार ॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "मुख्यत. उन लोगों में जो कि ।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "नहीं रखते मति पर अधिकार ॥३३॥"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "३९  तृतीय सर्ग"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "अन्य जन अथवा जो हैं विज्ञ ।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "विवेकी हैं या हैं मतिमान ॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "जानते हैं जो मन का मर्म ।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "जिन्हें है धर्म कर्म का ज्ञान ॥३४॥"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "सुने ऐसा असत्य अपवाद ।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "गूंद लेते हैं अपने कान ॥"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "कथन कर नाना - पूत - प्रसग ।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "दूर करते है जन - अज्ञान ॥३५॥"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "ज्ञात है मुझे न इसका भेद ।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "कहाँ से, क्यों फैली यह बात ॥"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "किन्तु मेरा है यह अनुमान ।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "पतित - मतिका है यह उत्पात ॥३६॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "महानद - सबल - सिधु के पार ।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "रहा जो गन्धर्वो का राज ॥"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "वहाँ था होता महा - अधर्म ।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "प्रायशः सद्धर्मो के व्याज ॥३७॥"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "कहे जाते थे वे गन्धर्व ।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "किन्तु थे दानव सहश दुरंत ॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "न था उनके अवगुण का ओर।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "न था अत्याचारों का अन्त ॥३८॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "वैदेही-वनवास"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "न रक्षित था उनसे धन धाम ।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "न लोगों का आचार विचार ॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "न ललनाकुल का सहज सतीत्त्व ।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "न मानवता का वर व्यवहार ॥३९॥"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "एक कर में थी ज्वलित मशाल ।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "दूसरे कर में थी करवाल ॥"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "एक करता नगरों का दाह ।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "दूसरा करता भू को लाल ॥४०॥"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "किये पग-लेहन, हो, कर-बद्ध ।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "कुजन का होता था प्रतिपाल ॥"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "सुजन पर बिना किये अपराध ।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "वलाये दी जाती थी डाल ॥४१॥"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "अधमता का उड़ता था केतु ।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "सदाशयता पाती थी शूल ॥"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "सदाचारी की खिंचती खाल ।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "कदाचारी पर चढ़ते फूल ॥४२॥"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "राज्य में पूरित था आतंक ।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "गला कर्त्तन था प्रातः - कृत्य ।।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "काल वन होता था सर्वत्र ।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "प्रजा प्रीड़न का ताण्डव नृत्य ॥४३॥"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "४१  तृतीय सर्ग"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "केकयाधिप ने यह अवलोक ।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "शान्ति के नाना किये प्रयत्न ।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "किन्तु वे असफल रहे सदैव ।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "लुटे उनके भी अनुपम - रत्न ॥४४॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "इसलिये हुए वे वहुत क्रुद्ध ।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "और पकड़ी कठोर तलवार ।।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "हुआ उसका भीपण परिणाम ।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "बहुत ही अधिक लोक सहार ॥४५।।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "छिन गये राज्य हुए भयभीत ।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "वचे गधों का सस्थान ।।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "बन गया है पाञ्चाल प्रदेश ।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "और यह अन्तर्वेद महान ।।४६।।"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "इस समर का संचालन सूत्र ।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "हाथ में मेरे था अतएव ।।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "आप से उसका बहु सम्पर्क ।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "मानता है उनका अहमेव ।।४७।।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "अतः यह मेरा है सन्देह ।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "इस अमूलक जन - रव में गुप्त ।।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "हाथ उन सव का भी है क्योंकि ।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "कव हुई हिसा-वृत्ति विलुप्त ॥४८॥"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "४२  वैदेही-वनवास"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "उचित है, है अत्यन्त पुनीत ।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "लोक आराधन की नृप - नीति ।।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "किन्तु है सदा उपेक्षा योग्य ।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "मलिन-मानस की मलिन प्रतीति ।।४९।।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "भरा जिसमें है कुत्सित भाव ।"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "द्वेप हिंसामय जो है उक्ति ।।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "मलिन करने को महती-कीर्ति ।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "गढ़ी जाती है जो बहु युक्ति ॥५०॥"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "वह अवांछित है, है दलनीय।"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "दण्ड्य है दुर्जन का दुर्वाद ॥"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "सदा है उन्मूलन के योग्य ।"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "अमौलिक सकल लोक अपवाद ।।५१।।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "जो भली है, है भव हित पूर्ति ।"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "लोक आराधन सात्विक नीति ॥"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "तो बुरी है, है स्वयं विपत्ति ।"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "लोक - अपवाद - प्रसूत - प्रतीति ॥५२॥"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "फैल कर जन - रव रूपी धूम ।"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "करेगा कैसे उसको म्लान ।।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "गगन में भूतल में है व्याप्त ।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "कीर्ति जो राका-सिता समान ॥५३।।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "४३  तृतीय सर्ग"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "चौपदे"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "बड़े भ्राता की बाते सुन ।"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "विलोका रघुकुल - तिलकानन ॥"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "सुमित्रा सुत फिर यो बोले।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "हो गया व्याकुल मेरा मन ।।५४।।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "आपकी भी निन्दा होगी।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "समझ मैं इसे नही पाता।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "खौलता है मेरा लोहू ।"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "क्रोध से मैं हूँ भर जाता ।।५५।।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "आह । वह सती पुनीता है।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "देवियों सी जिसकी छाया ।।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "तेज जिसकी पावनता का।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "नही पावक भी सह पाया ॥५६।।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "हो सकेगी उसकी कुत्सा।"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "मैं इसे सोच नही सकता ।।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "खड़े हो गये रोंगटे हैं।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "गात भी मेरी है कॅपता ॥५७।।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "यह जगत सदा रहा अंधा।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "सत्य को कब इसने देखा ।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "खीचता ही वह रहता है।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "लांछना की कुत्सित रेखा ।।५८।।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "४४  वैदेही-वनवास"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "आपकी कुत्सा किसी तरह ।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "सहज ममता है सह पाती।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "पर सुने पूज्या की निन्दा।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "आग तन में है लग जाती ॥५९।।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "सँभल कर वे मुँह को खोलें।"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "राज्य में है जिनको बसना ॥"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "चाहता है यह मेरा जी।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "रजक की खिचवाले रसना ॥६०॥"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "प्रमादी होंगे ही कितने ।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "मसल मैं उनको सकता हूँ।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "क्यों न बकनेवाले समझे ।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "बहक कर क्या मैं बकता हूँ ॥६१॥"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "अंध अंधापन से दिव की।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "न दिवता कम होगी जो भर ॥"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "धूल जिसने रवि पर फेकी ।"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "गिरी वह उसके ही मुंह पर ॥६२।।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "जलधि का क्या बिगड़ेगा जो।"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "गरल कुछ अहि उसमें उगले ॥"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "न होगी सरिता में हलचल।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "यदि बहॅक कुछ मेंढक उछले ॥६३॥"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "४५  तृतीय सर्ग"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "विपिन कैसे होगा विचलित ।"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "हुए कुछ कुजन्तुओं का डर ॥"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "किये कुछ पशुओ के पशुता।"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "विकपित होगा क्यों गिरिवर ॥६४॥"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "धरातल क्यों धृति त्यागेगा।"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "कुछ कुटिल काकों के रव से ।।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "गगन तल क्यों विपन्न होगा।"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "केतु के किसी उपद्रव से ॥६५॥"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "मुझे यदि आज्ञा हो तो मैं।"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "पचा दूँ कुजनो की वाई ।।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "छुडा दूं छील छाल करके ।"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "कुरुचि उरकी कुत्सित काई ॥६६।।"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "कहा रिपुसूदन ने सादर ।"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "जटिलता है वढ़ती जाती ।।"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "बात कुछ ऐसी है जिसको ।"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "नहीं रसना है कह पाती ।।६७।।"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "पर कहूँगा, न कहूँ कैसे।"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "आपकी आज्ञा है ऐसी ॥"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "वात मथुरा मण्डल की मैं।"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "सुनाता हूँ वह है जैसी ॥६८।।"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "४७  तृतीय सर्ग"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "लवण अपने उद्योगों में।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "सफल हो कभी नही सकता ।।"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "गये गंधर्व रसातल को।"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "रहा वह जिनका मुंह तकता ॥७४।।"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "बहाता है अब भी ऑसू ।"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "याद कर रावण की बाते ।।"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "पर उसे मिल न सकेगी अब ।"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "पाप से भरी हुई राते ॥७५॥"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "राज्य की नीति यथा संभव ।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "उसे सुचरित्र बनायेगी ।"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "अन्यथा दुष्प्रवृत्ति उसकी।"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "कुकर्मों का फल पायेगी ॥७६।।"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "कठिनता यह है दुर्जनता।"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "मृदुलता से बढ़ जाती है ।"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "शिष्टता से नीचाशयता।"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "बनी दुर्दान्त दिखाती है॥७७।।"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "बिना कुछ दण्ड हुए जड़ की।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "कब भला जड़ता जाती है।"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "मूढ़ता किसी मूढ़ मन की।"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "दमन से ही दब पाती है।॥७८॥"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "४९  तृतीय सर्ग"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "दमन या दण्ड नीति मुझको ।"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "कभी भी रही नही प्यारी ।।"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "न यद्यपि छोड सका उनको ।"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "रहे जो इनके अधिकारी ॥८४॥"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "चतुष्पद"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "रहेगी भव मे कैसे शान्ति ।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "क्रूरता किया करे जो क्रूर ।।"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "तो हुआ लोकाराधन कहाँ।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "लोक - कण्टक जो हुये न दूर ।।८५।।"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "लोक-हित संमृति-शान्ति निमित्त ।"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "हुआ यद्यपि दुरन्त -- संग्राम ।।"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "किन्तु दशमुख, गन्धर्व - विनाश ।"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "पातको का ही था परिणाम ॥८६॥"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "है क्षमा- योग्य न अत्याचार ।"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "उचित है दण्डनीय का दण्ड ।।"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "निवारण करना है कर्तव्य ।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "किसी पाषण्डी का पाषण्ड ॥८७॥"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "आर्त लोगों का मार्मिक - कष्ट ।"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "बहु - निरपराधो का संहार ।।"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "बाल - वृद्धो का करुण - विलाप ।"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "विवश - जनता का हाहाकार ।।८८।।"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "५१  तृतीय सर्ग"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "किसी सम्भावित की अपकीर्ति ।"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "है रजनि - रंजन - अंक - कलक ।।"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "किन्तु है बुध - सम्मत यह उक्ति ।"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "कब भला धुला पंक से पंक ।।९४।।"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "जनकजा मे है दानव - द्रोह ।"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "और मैं उनकी बात मान ।"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "कराया करता हूँ अद्यापि ।"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "लोक - संहार कृतान्त समान ॥९५।।"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "यह कथन है सर्वथा असत्य । ."
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "और है परम श्रवण - कटु-बात ॥"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "किन्तु उसको करता है पुष्ट ।"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "विपुल गंधर्वो पर पविपात ।।९६।।"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "पठन कर लोकाराधन - मत्र ।"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "करूँगा मैं इसका प्रतिकार !!"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "साधकर जनहित - साधन सूत्र ।"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "करूँगा घर घर शान्ति - प्रसार ।।९७।।"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "वन्धु - गण के विचार विज्ञात-"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "हो गये, सुनी उक्तियाँ सर्व ॥"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "प्राप्त कर साम - नीति से सिद्धि ।"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "बनेगा पावन जीवन - पर्व ॥९८॥"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "५२  वैदेही-वनवास"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "करूँगा बड़े से बड़ा त्याग।"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "आत्म - निग्रह का कर उपयोग।"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "हुए आवश्यक जन - मुख देख ।"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "सहूँगा प्रिया असह्य - वियोग ।।९९।।"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "मुझे यह है पूरा विश्वास ।"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "लोक-हित-साधन में सब काल ।।"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "रहेंगे आप लोग अनुकूल ।"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "धर्म - तत्वों पर ऑखे डाल ॥१००॥"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "दोहा"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "इतना कह अनुजों सहित, त्याग मंत्रणा-धाम ।"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "विश्रामालय में गये, राम - लोक - विश्राम ॥१०१॥"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "चतुर्थ सर्ग\n--*-\nवशिष्ठाश्रम\nतिलोकी"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "अवधपुरी के निकट मनोरम - भूमि मे।"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "एक दिव्य-तम-आश्रम था शुचिता-सदन ॥"
    },
    {
      "id": "b_364",
      "type": "p",
      "text": "बड़ी अलौकिक-शान्ति वहाँ थी राजती ।"
    },
    {
      "id": "b_365",
      "type": "p",
      "text": "दिखलाता था विपुल-विकच भवका बदन ॥१॥"
    },
    {
      "id": "b_366",
      "type": "p",
      "text": "प्रकृति वहाँ थी रुचिर दिखाती सर्वदा ।"
    },
    {
      "id": "b_367",
      "type": "p",
      "text": "शीतल - मंद - समीर सतत हो सोरभित ।।"
    },
    {
      "id": "b_368",
      "type": "p",
      "text": "वहता था बहु-ललित दिशाओं को बना।"
    },
    {
      "id": "b_369",
      "type": "p",
      "text": "यावन - सात्विक - सुखद-भाव से हो भरित ॥२॥"
    },
    {
      "id": "b_370",
      "type": "p",
      "text": "५४  वैदेही-वनवास"
    },
    {
      "id": "b_371",
      "type": "p",
      "text": "हरी भरी तरु - राजि कान्त - कुसुमालि से।"
    },
    {
      "id": "b_372",
      "type": "p",
      "text": "विलसित रह फल - पुंज - भार से हो नमित ।।"
    },
    {
      "id": "b_373",
      "type": "p",
      "text": "शोभित हो मन - नयन - विमोहन दलो से ।"
    },
    {
      "id": "b_374",
      "type": "p",
      "text": "दर्शक जन को मुदित वनाती थी अमित ॥३॥"
    },
    {
      "id": "b_375",
      "type": "p",
      "text": "रंग विरंगी अनुपम - कोमलतामयी।"
    },
    {
      "id": "b_376",
      "type": "p",
      "text": "कुसुमावलि थी लसी पूत - सौरभ वसी ।।"
    },
    {
      "id": "b_377",
      "type": "p",
      "text": "किसी लोक - सुन्दर की सुन्दरता दिखा।"
    },
    {
      "id": "b_378",
      "type": "p",
      "text": "जी की कली खिलाती थी उसकी हँसी ॥४॥"
    },
    {
      "id": "b_379",
      "type": "p",
      "text": "कर उसका रसपान मधुप थे घूमते ।"
    },
    {
      "id": "b_380",
      "type": "p",
      "text": "गूंज गूंज कानों को शुचि गाना सुना ।।"
    },
    {
      "id": "b_381",
      "type": "p",
      "text": "आ आ कर तितलियाँ उन्हें थी चूमती ।"
    },
    {
      "id": "b_382",
      "type": "p",
      "text": "अनुरंजन का चाव दिखा कर चौगुना ।।५।।"
    },
    {
      "id": "b_383",
      "type": "p",
      "text": "कमल - कोप में कभी बद्ध होते न थे।"
    },
    {
      "id": "b_384",
      "type": "p",
      "text": "अंधे बनते थे न पुष्प - रज से भ्रमर ।।"
    },
    {
      "id": "b_385",
      "type": "p",
      "text": "कॉटे थे छेदते न उनके गात को।"
    },
    {
      "id": "b_386",
      "type": "p",
      "text": "नही तितिलियो के पर देते थे कतर ।।६।।"
    },
    {
      "id": "b_387",
      "type": "p",
      "text": "लता लहलही लाल लाल दल से लसी ।"
    },
    {
      "id": "b_388",
      "type": "p",
      "text": "भरती थी हग मे अनुराग - ललामता ।।"
    },
    {
      "id": "b_389",
      "type": "p",
      "text": "श्यामल - दल की बेलि बनाती मुग्ध थी।"
    },
    {
      "id": "b_390",
      "type": "p",
      "text": "दिखा किमी धन-नचि-तन की शुचि झ्यामता ॥७॥"
    }
  ]
}