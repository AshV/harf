{
  "book_id": "vaidehi-vanvas",
  "chapter_id": "ch_07",
  "number": 7,
  "title": "सर्ग ६ — कातरोक्ति",
  "word_count": 1791,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "५ सती सीता"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "वैदेही-वनवास    (1939)     द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "कातरोक्ति       ७ मंगल यात्रा   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "षष्ठ सर्ग"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कातरोक्ति"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "पादाकुलक"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "प्रवहमान प्रातः - समीर था।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "उसकी गति में थी मंथरता॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "रजनी - मणिमाला थी टूटी।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "पर प्राची थी प्रभा - विरहिता ॥१॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "छोटे छोटे धन के टुकड़े।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "घूम रहे थे नभ - मण्डल में ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मलिना - छाया पतित हुई थी।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "प्राय जल के अन्तस्तल में ॥२॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "८०  वैदेही-वनवास"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "कुछ कालोपरान्त कुछ लाली ।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "काले घन - खंडों ने पाई॥"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "खड़ी ओट में उनकी ऊपा।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "अलस भाव से भरी दिखाई ॥३॥"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अरुण - अरुणिमा देख रही थी।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "पर था कुछ परदा सा डाला ॥"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "छिक छिक करके भी क्षिति-तल पर।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "फैल रहा था अब उँजियाला॥४॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "दिन-मणि निकले तेजोहत से।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "रुक रुक करके किरणे फूटीं ॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "छूट किसी अवरोधक - कर से ।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "छिटिक छिटिक धरती पर टूटी ।।५।।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "राज - भवन होगया कलरवित ।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "बजने लगा वाद्य तोरण पर ॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "दिव्य - मन्दिरों को कर मुखरित ।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "दूर सुन पड़ा वेद - ध्वनि स्वर ॥६॥"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "इसी समय मंथर गति से चल ।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "पहुंची जनकात्मजा वहाँ पर ।।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "कौशल्या देवी बैठी थी।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "बनी विकलता - मूर्ति जहाँ पर ॥७॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "षष्ठ सर्ग"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "पग - वन्दन कर जनक तान्दना।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "उनके पास बैठ कर वोलीं।।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "धीरज धर कर विनत - भाव से ।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "प्रिय - उक्तियाँ थैलियाँ खोली ॥८॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "कर मंगल - कामना प्रसव की।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "जनन - क्रिया की सद्वांछा से ॥"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "सकल - लोक उपकार - परायण ।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "पुत्र - प्राप्ति की आकांक्षा से॥९॥"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "है पतिदेव भेजते मुझको।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "वाल्मीक के पुण्याश्रम में।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "दीपक वहाँ वलेगा ऐसा ।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "जो आलोक करेगा तम में ॥१०॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "आज्ञा लेने मैं आई है।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "और यह निवेदन है मेरा॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "यह दे आशीर्वाद सदा ही।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "रहे सामने दिव्य सवेरा ॥११॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "दुख है अब मैं कर न सकूँगी।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "कुछ दिन पद - पंकज की सेवा ।।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "आह प्रति-दिवस मिल न सकेगा।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "अब दर्शन मजुल - तम - मेवा ॥१२॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "८२  वैदेही-वनवास"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "माता की ममता है मानी।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "किस मुंह से क्या सकती हूँ कह ।।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "पर मेरा मन नहीं मानता।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "मेरी विनय इसलिये है यह ॥१३॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "मैं प्रति - दिन अपने हाथों से।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "सारे व्यंजन रही बनाती ॥"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "पास बैठ कर पंखा झल झल ।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "प्यार सहित थी उन्हें खिलाती ॥१४॥"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "प्रिय-तम सुख - साधन-आराधन-"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "में थी सारा - दिवस बिताती ॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "उनके पुलके रही पुलकती ।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "उनके कुम्हलाये कुम्हलाती ।।१५।।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "हैं गुणवती दासियाँ कितनी ।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "हैं पाचक पाचिका नही कम ।।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "पर है किसी में नही मिलती।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "जितना वांछनीय है संयम ॥१६॥"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "जरा - जर्जरित स्वयं आप हैं।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "है क्षन्तव्य धृष्टता मेरी॥"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "इतना कह कर जननि आपकी ।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "केवल दृष्टि इधर है फेरी ॥१७॥"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "८३  षष्ठ सर्ग"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "कहा श्रीमती कौशल्या ने।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "मुझे ज्ञात हैं सारी बाते ।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "मंगलमय हो पंथ तुम्हारा।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "बने दिव्य - दिन रंजित - राते ॥१८॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "पुण्य - कार्य है गुरु - निदेश है।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "है यह प्रथा प्रशंसनीय - तम ॥"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "कभी न अविहित - कर्म करेगा।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "रघुकुल - पुंगव प्रथित - नृपोत्तम ॥१९॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "आश्रम - वास - काल होता है।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "कुलपति द्वारा ही अवधारित ॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "बरसों का यह काल हुए, क्यों ?"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "मेरे दिन होंगे अतिवाहित ॥२०॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "मंगल - मूलक महत्कार्य है।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "है विभूतिमय यह शुभ - यात्रा॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "पूरित इसके अवयव में है।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "प्रफुल्लता की पूरी मात्रा ॥२१॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "किन्तु नहीं रोके रुकता है।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "ऑसू ऑखों मे है आता ॥"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "समझाती हूँ पर मेरा मन ।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "मेरी बात नहीं सुन पाता ॥२२॥"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "८४  वैदेही-वनवास"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "तुम्ही राज - भवनों की श्री हो।'"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "तुमसे वे हैं शोभा पाते ।।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "तुम्हें लाभ करके विकसित हो।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "वे हैं हँसते से दिखलाते ॥२३॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "मंगल - मय हो, पर न किसीको ।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "यात्रा - समाचार भाता है।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "ऐसी कौन आँख हैं जिसमें।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "तुरत नहीं ऑसू आता है ॥२४॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "गृह में आज यही चर्चा है।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "जावेगी तो कब आवेगी।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "कौन सुदिन वह होगा जिस दिन ।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "कृपा - वारि आ बरसावेंगी ॥२५॥"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "हो अनाथ - जन की अवलम्बन ।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "हृदय वड़ा कोमल पाया है।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "भरी सरलता है रग रग मे।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "पूत - सुरसरी सी काया है ॥२६॥"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "जव देखा तव हंसते देखा।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "क्रोध नही तुमको आता है।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "कटु वाते कव मुख से निकलीं।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "वचन सुधा - रस वरसाता है ॥२७।।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "८५  षष्ठ सर्ग"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "जैसी तुम में पुत्री वैसी।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "किस जी मे ममता जगती है।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "और को कलपता अवलोके ।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "कौन यों कलपने लगती है ।।२८।।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "विना बुलाये मेरा दुख सुन । '"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "कौन दौड़ती आ जाती थी।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "पास बैठकर कितनी राते ।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "जगकर कौन विता जाती थी ।।२९।।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "मेरा क्या दासी का दुख भी।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "तुम देखने नही पाती थी।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "भगिनी के समान ही उसकी ।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "सेवा में भी लग जाती थी॥३०॥"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "विदा मॉगते समय की कही।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "विनयमयी तव बाते कहकर ।।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "रोई वार वार कैकेयी ।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "बनी सुमित्रा ऑखे निर्झर ।।३१।।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "उनकी आकुलता अवलोके ।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "कल्ह रात भर नीद न आई ॥"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "रह रह घबराती हूँ, जी मे-"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "आज भी उदासी है छाई ॥३२॥"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "८६  वैदेही-वनवास"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "तुम जितनी हो, कैकेयी को।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "है न माण्डवी उतनी प्यारी॥"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "वधुओं बलित सुमित्रा में भी।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "देखी ममता अधिक तुमारी ॥३३॥"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "फिर जिसकी आँखों की पुतली ।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "लकुटी जिस वृद्धा के कर की।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "छिनेगी न कैसे वह कलपे।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "छाया रही न जिसके सिर की ॥३४॥"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "जिसकी हृदय - वल्लभा तुम हो।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "जो तुमको पलकों पर रखता।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "प्रीति - कसौटी पर कस जो है।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "पावन - प्रेम - सुवर्ण परखता ॥३५॥"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "जिसका पत्नी - व्रत प्रसिद्ध है।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "जो है पावन • चरित कहाता ।।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "देख तुमारा अरविन्दानन ।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "जो है विकच - वदन दिखलाता ॥३६॥"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "जिसकी सुख - सर्वस्व तुम्ही हो।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "जिसकी हो आनन्द - विधाता ।।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "जिसकी तुम हो शक्ति - स्वरूपा ।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "जो तुम से पौरुप है पाता ॥३७॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "८७  पष्ठ सर्ग"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "जिसकी सिद्धि-दायिनी तुम हो।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "तुम सच्ची गृहिणी हो जिसकी ।।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "सव तन मन धन अपण कर भी।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "अब तक बनी ऋणी हो जिसकी ॥३८॥"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "अरुचिर कुटिल - नीति से ऊबे ।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "जिसको तुम पुलकित करती हो ।।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "जिसके विचलित-चिन्तित-चित मे ।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "चारु - चित्तता तुम भरती हो ॥३९॥"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "कैसे काल कटेगा उसका।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "उसको क्यों न वेदना होगी।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "होते हृदय मनुज - तन - धर वह ।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "बन पायेगा क्यों न वियोगी ॥४०॥"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "रघुनन्दन है धीर - धुरंधर ।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "धर्म प्राण है भव - हित - रत है।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "लोकाराधन में है तत्पर ।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "सत्य - संध है सत्य - व्रत है ॥४१॥"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "नीति - निपुण है न्याय - निरत है।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "परम - उदार महान - हृदय है।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "पर उसको भी गूढ़ समस्या ।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "विचलित करती यथा समय है॥४२॥"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "८८  वैदेही-वनवास"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "ऐसे अवसर पर सहायता ।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "सच्ची वह तुमसे पाता था।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "मंद मंद बहते मारुत से।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "घिरा घन - पटल टल जाता था ।॥४३॥"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "है विपत्ति - निधि - पोत-स्वरूपा।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "सहकारिणी सिद्धियों की है।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "है पत्नी केवल न गेहिनी।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "सहधर्मिणी मंत्रिणी भी है ॥४४॥"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "खान पान सेवा की बाते ।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "कह तुमने है मुझे रुलाया ।।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "अपनी व्यथा कहूँ मैं कैसे ।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "आह कलेजा मुँह को आया ।।४५।।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "जिस दिन सुत ने आ प्रफुल्ल हो । ."
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "आश्रम - वास प्रसंग सुनाया।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "उस दिन उस प्रफुल्लता में भी।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "मुझको मिली व्यथा की छाया ॥४६॥"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "मिले चतुर्दश - वत्सर का वन ।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "राज्य श्री की हुए विमुखता ।।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "कान्ति-विहीन न जो हो पाया।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "दूर हुई जिसकी न विकचता ।।४७।।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "८९  षष्ठ सर्ग"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "क्यों वह मुख जैसा कि चाहिये ।"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "वैसा नही प्रफुल्ल दिखाता॥"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "तेज - वन्त - रवि के सम्मुख क्या ।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "है रज - पुंज कभी आ जाता ।।४८।।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "आत्मत्याग का बल है सुत को।"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "उसकी सहन - शक्ति है न्यारी॥"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "वह परार्थ - अर्पित - जीवन है।"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "है रघुकुल - मुख - उज्वलकारी ॥४९॥"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "है मम - कातरोक्ति स्वाभाविक ।"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "व्यथित हृदय का आश्वासन है ।।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "शिरोधार्य गुरु - देवाज्ञा है।"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "मांगलिक सुअन - अनुशासन है ।।५०॥"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "रोला"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "जाओ पुत्री परम - पूज्य पति - पथ पहचानो।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "जाओ अनुपम - कीर्ति वितान जगत मे तानो ।।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "जाओ रह पुण्याश्रम मे वांछित फल पाओ।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "पुत्र - रत्न कर प्रसव वंश को वंद्य वनाओ ।।५१।।"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "जाओ मुनि - पुंगव - प्रभाव की प्रभा वढ़ाओ।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "जाओ परम - पुनीत - प्रथा की व्वजा उड़ाओ।"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "जाओ आकर यथा - शीघ्र उर - तिमिर भगाओ।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "निज-विधु-वदन समेत लाल-विधु-वदन दिखाओ ।।५२।।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "९१  षष्ठ सर्ग"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "वाल्मीकाश्रम में जाकर ।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "कब तक तुम वहाँ रहोगी ।।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "यह ज्ञात नही तुमको भी।"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "कुछ कैसे भला कहोगी ।।५८।।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "दस पॉच बरस तक तुमको।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "जो रहना पड़ जायेगा ।।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "'विच्छेद' बलाये कितनी।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "हम लोगों पर लायेगा ।।५९।।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "कर अनुगामिता तुमारी।"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "सुखमय है सदन हमारा ।।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "कलुषित - उर में भी बहती-"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "रहती है सुर - सरि - धारा ॥६०॥"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "जो उलझन सम्मुख आई।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "उसको तुमने सुलझाया ॥"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "जो ग्रंथि न खुलती, उसको-"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "तुमने ही खोल दिखाया ॥६१।।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "अवलोक तुमारा आनन ।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "है शान्ति चित्त में होती ।।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "हृदयों मे बीज सुरुचि का।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "है सूक्ति तुमारी बोती ॥६२।।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "९२  वैदेही-वनवास"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "स्वाभाविक स्नेह"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "भव - जीव - मात्र है पाता ।।"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "कर भला तुमारा मानस ।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "है विकच - कुसुम बन जाता ॥६३॥"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "प्रति दिवस तुमारा दर्शन ।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "देवता - सहश थी करती ।।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "अवलोक - दिव्य - मुख - आभा ।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "निज हृदय – तिमिर थीं हरती ॥६४॥"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "अव रहेगा न यह अवसर ।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "सुविधा दूरीकृत होगी।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "विनता बहनों की विनती।"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "आशा है स्वीकृत होगी ।।६५।।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "माण्डवी का कथन सुन कर ।"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "मुख पर विलोक दुख - छाया ।"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "बोली विदेहजा धीरे।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "नयनों में जल था आया ।।६६।।"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "जर्जरित - गात अति - वृद्धा।"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "हैं तीन तीन माताएँ ।"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "जिन्हें घेरती रहती।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "आ आ कर दुश्चिन्ताये ॥६७॥"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "९३  षष्ठ सर्ग"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "है सुख - मय रात न होती।"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "दिन में है चैन न आता ।।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "दुर्वलता - जनित - उपद्रव ।"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "प्रायः है जिन्हें सताता ॥६८।।"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "मेरी यात्रा से अतिशय ।"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "आकुल वे हैं दिखलाती ।।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "है कभी कराहा करती।"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "है ऑसू कभी वहाती ॥६९॥"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "वहनों उनकी सेवा तज ।"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "क्या उचित है कही जाना ॥"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "तुम लोग स्वयं यह समझो।"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "है । धर्म उन्हें कलपाना ? ।।७०॥"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "है मुख्य - धर्म पत्नी का।"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "पति - पद - पंकज की अर्चा ।।"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "जो स्वय पति - रता होवे ।"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "क्या उससे इसकी चर्चा ॥७१॥"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "पर एक बात कहती हूँ।"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "उसके मर्मों को छूलो ॥"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "निज - प्रीति - प्रपंचों मे पड ।"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "पति - पद सेवा मत भूलो ॥७२॥"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "९४  वैदेही-वनवास"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "अन्य स्त्री 'जा, न सकी यह ।"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "है पूत - प्रथा बतलाती ॥"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "नृप - गर्भवती - पत्नी ही।"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "ऋषि - आश्रम में है जाती ॥७३॥"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "अतएव सुनो प्रिय बहनो।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "क्यों मेरे साथ चलोगी।"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "कर अपने कर्तव्यों को।"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "कल - कीर्ति लोक में लोगी ॥७४॥"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "है मृदु तुम लोगों का उर ।"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "है उसमें प्यार छलकता ॥"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "मुझ से लालित पालित हो।"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "है मेरी ओर ललकता ॥७५॥"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "जैसा ही मेरा हित है।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "तुम लोगों को अति - प्यारा॥"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "वैसी ही मेरे उर में।"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "बहती है हित की धारा ७६॥"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "तुम लोगों का पावन - तम ।"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "अनुराग - राग अवलोके ॥"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "है हृदय हमारा गलता।"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "ऑसू रुक पाया रोके ॥७७॥"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "९५  षष्ट सर्ग"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "क्यों तुम लोगों को बहनो।"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "मैं रो रो अधिक रुलाऊँ॥"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "क्यों आहें भर भर करके।"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "पत्थर को भी पिघलाऊँ ॥७८॥"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "इस जल - प्रवाह को हमको।"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "तुम लोगों को संयत रह ॥"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "सद्बुद्धि बाँध के द्वारा।"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "रोकना पड़ेगा सव सह ॥७९॥"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "दस पाँच बरस आश्रम में।"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "मैं रहूँ या रहूँ कुछ दिन ॥"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "तुम लोग क्या करोगी इन ।"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "आश्रम के दिवसों को गिन ॥८०॥"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "जैसी कि परिस्थिति होगी।"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "वह टलेगी नहीं टाले ॥"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "भोगना पड़ेगा उसको ।"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "क्या होगा कंधा डाले ॥८१॥"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "मांडवी कहो क्या तुमने।"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "यौवन - सुख को कर स्वाहा ॥"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "पति - ब्रह्मचर्य को चौदह-"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "सालों तक नही निबाहा ॥८२॥"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "९६  वैदेही-वनवास"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "इस खिन्न उर्मिला ने है।"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "जो सहन - शक्ति दिखलाई ॥"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "जिसकी सुध आते, मेरा-"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "दिल हिला ऑख भर आई ॥८३॥"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "क्या वह हम लोगों को है।"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "धृति - महिमा नही बताती ॥"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "क्या सत्प्रवृत्ति की शिक्षा ।"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "है सभी को न दे जाती ॥८४॥"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "ऑसू"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "पर सीच"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "तो उनमें"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "जो बूंद"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "आयेगे आवे ।"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "सुकृत - तरु - जावे ।।"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "पर - हित द्युति हो ।"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "वने दिखलाये ॥८५॥"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "श्रुतिकीर्ति मांडवी जैसी।"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "महनीय - कीर्ति तू भी हो।"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "मत विचल समझ मधु - मारुत ।"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "चल रही अगर लू भी हो ॥८६॥"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "उर्मिला सहा तुझ में भी।"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "वसुधावलम्बिनी - धृति हो ।"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "जिससे भव - हित हो ऐसी।"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "तीनों बहनों की कृति हो ।।८७।।"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "षष्ठ सर्ग"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "मत रोना भूल न जाना।"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "कुल - मंगल सदा मनाना ।।"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "कर पूत - साधना अनुदिन ।"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "वसुधा पर सुधा वहाना ॥८८।।"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "दोहा"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "इसी समय आये वहाँ, धीर - वीर - रघुवीर।"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "बहने विदा हुई बरस नयनों से बहु - नीर ॥८९।।"
    }
  ]
}