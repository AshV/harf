{
  "book_id": "vaidehi-vanvas",
  "chapter_id": "ch_08",
  "number": 8,
  "title": "सर्ग ७ — मंगल यात्रा",
  "word_count": 1639,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "६ कातरोक्ति"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "वैदेही-वनवास    (1939)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'        ८ आश्रम प्रवेश   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "सप्तम सर्ग"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "-*-"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मंगल सावा"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "-*-"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "मत्तसमक"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अवध पुरी आज सन्जिता है।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "बनी हुई दिव्य - सुन्दरी है।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "विहँस रही है विकास पाकर ।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अटा अटा में छटा भरी है ॥१॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "दमक रहा है नगर, नागरिक-"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "प्रवाह में मोद के बहे हैं।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "गली गली है गई सँवारी ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "चमक रहे चारु चौरहे हैं ॥२॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "बना राज - पथ परम - रुचिर है।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विमुग्ध है स्वच्छता बनाती ।।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "विभूति उसकी विचित्रता से ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "विचित्र है रंगते दिखाती ॥३॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "९९  सप्तम सर्ग"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "सजल - कलस कान्त - पल्लवों से ।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "बने हुए द्वार थे फबीले ॥"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "सु-छबि मिले छबि-निकेतनों की।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "हुए सभी - सम थे छबीले ॥४॥"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "खिले हुए फूल से लसे थल।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "ललामता को लुभा रहे थे।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "सुतोरणों के हरे - भरे - दल ।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "हरा भरा चित बना रहे थे ॥५॥"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "गड़े हुए स्तंभ कदलियों के ।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "दलावली छबि दिखा रहे थे।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "सुश्य - सौदर्य - पट्टिका पर ।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "सुकीर्ति अपनी लिखा रहे थे ॥६॥"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "प्रदीप जो थे लसे कलस पर ।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "मिली उन्हें भूरि दिव्यता थी॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "पसार कर रवि उन्हें परसता ।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "उन्हे चूमती दिवा - विभा थी॥७॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "नगर गृहों मंदिरों मठों पर ।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "लगी हुई सजिता ध्वजाये ॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "समीर से केलि कर रही थीं।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "उठा उठा भूयसी भुजाये ॥८॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "१००  वैदेही-वनवास"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "सजे हुए राज - मन्दिरों पर।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "लगी पताका विलस रही थी।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "जटित रत्नचय विकास के मिस ।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "चुरा चुरा चित्त हँस रही थी॥९॥"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "न तोरणों पर न मञ्च पर ही।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "अनेक - वादिन बज रहे थे।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "जहाँ तहाँ उच्च - भूमि पर भी।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "नवल - नगारे गरज रहे थे ॥१०॥"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "न गेह में ही कुलांगनाये।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "अपूर्व कल - कंठता दिखाती ॥"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "कही कही अन्य - गायिका भी ।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "बड़ा - मधुर गान थी सुनाती ॥११॥"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "अनेक - मैदान मंजु बन कर ।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "अपूर्व थे मंजुता दिखाते ॥"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "सजावटों से अतीव सज कर ।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "किसे नहीं मुग्ध थे बनाते ॥१२॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "तने रहे जो वितान उनमें ।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "विचित्र उनकी विभूतियाँ थी।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "सदैव उनमें सुगायकों की।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "विराजती मंजु - मूर्तियॉ थी ॥१३॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "१०१  सप्तम सर्ग"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "बनी ठनी थी समस्त - नावे ।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "विनोद - मन्ना सरयू - सरी थी।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "प्रवाह में वीचि मध्य मोहक-"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "उमंग की मत्तता भरी थी॥१४॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "हरे - भरे तरु - समूह से हो।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "समस्त उद्यान थे विलसते ।।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "लसी लता से ललामता ले।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "विकच-कुसुम-व्याज थे विहॅसते ॥१५॥"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "मनोज्ञ मोहक पवित्रतामय ।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "बने विवुध के विधान से थे।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "समस्त - देवायतन अधिकतर ।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "स्वरित बने सामगान से थे ॥१६।।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "प्रमोद से मत्त आज सब थे।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "न पा सका कौन - कंठ पिकता ।।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "सकल नगर मध्य व्यापिता थी।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "सनोमयी मंजु मांगलिकता ॥१७॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "दिनेश अनुराग - राग में रंग।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "नभाक से जगमगा रहे थे।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "उमंग में भर बिहंग तरु पर।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "बड़े - मधुर गीत गा रहे थे॥१८॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "१०२  वैदेही-वनवास"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "इसी समय दिव्य - राज - मन्दिर ।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "ध्वनित हुआ वेद - मंत्र द्वारा ।।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "हुई सकल - मांगलिक क्रियाये ।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "वही रगों में पुनीत - धारा ॥१९॥"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "क्रियान्त में चल गयंद - गति से।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "विदेहजा द्वार पर पधारी ॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "बजी बधाई मधुर स्वरों से।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "सुकीर्ति ने आरती उतारी ॥२०॥"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "खड़ा हुआ सामने सुरथ था।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "सजा हुआ देवयान जैसा ।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "उसे सती ने विलोक सोचा।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "प्रयाण में अब विलम्ब कैसा ॥२१॥"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "वशिष्ठ देवादि को विनय से।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "प्रणाम कर कान्त पास आई।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "इसी समय नन्दिनी जनक की।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "अतीव - विह्वल हुई दिखाई ॥२२॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "परन्तु तत्काल ही संभल कर।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "निदेश मॉगा विनम्र वन के ।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "परन्तु करते पदाब्ज - वन्दन ।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "विविध वने भाव वर - वदन के ॥२३॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "१०३  सप्तम सर्ग"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "कमल - नयन राम ने कमल से-"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "मृदुल करों से पकड़ प्रिया-कर ॥"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "दिखा हृदय - प्रेम की प्रवणता।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "उन्हें बिठाला मनोज्ञ रथ पर ॥२४॥"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "उचित जगह पर विदेहजा को।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "विराजती जब विलोक पाया ।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "सवार सौमित्र भी हुए तब ।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "सुमित्र ने यान को चलाया ॥२५॥"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "बजे मधुर - वाद्य तोरणों पर ।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "सुगान होता हुआ सुनाया ।।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "हुए विविध मंगलाचरण भी।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "सजल - कलस सामने दिखाया ।।२६।।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "निकल सकल राज - तोरणों से ।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "पहुँच गया यान जब वहाँ पर ।।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "जहाँ खड़ी थी अपार - जनता ।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "सजी सड़क पर प्रफुल्ल होकर ॥२७॥"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "बड़ी हुई तव प्रसून - वर्पा।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "पतिव्रता जय गई बुलाई ।।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "सविधि गई आरती उतारी।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "बड़ी धूम से वजी बधाई ॥२८॥"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "१०४  वैदेही-वनवास"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "खड़ी द्वार पर कुलांगनाये ।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "रही मांगलिक - गान सुनाती ॥"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "विनम्र हो हो पसार अञ्चल ।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "रहीं राजकुल कुशल मनाती ॥२९॥"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "शनैः शनैः मंजुराज - पथ पर ।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "चला जा रहा था मनोज्ञ रथ ।।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "अजस्र जयनाद हो रहा था।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "वरस रहा फूल था यथातथ ॥३०॥"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "निमग्न आनन्द में नगर था।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "बनीं सुमनमय अनेक - सड़के ।।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "थके न कर आरती उतारे ।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "दिखे दिव्यता थकी न ललके ।।३१।।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "नगर हुआ जब समाप्त सिय ने ।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "तुरन्त सौमित्र को विलोका ।।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "सुमित्र ने भाव को समझकर ।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "सँभाल ली रास यान रोका ॥३२॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "उतर सुमित्रा - कुमार रथ से।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "अपार - जनता समीप आये ।।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "कहा कृपा है महान जो यों।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "कृपाधिकारी गये वनाये ॥३३॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "१०५  सप्तम सर्ग"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "अनुष्ठिता मांगलिक सुयात्रा।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "भला न क्यों सिद्धि को बरेगी।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "समस्त - जनता प्रफुल्ल हो जो।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "अपूर्व - शुभ - कामना करेगी ॥३४॥"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "कृपा दिखा आप लोग आये।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "कुशल मनाया, हितैपिता की।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "विविध मांगलिक - विधान द्वारा।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "समर्चना की दिवांगना की ॥३५॥"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "हुई कृतज्ञा - अतीव आर्या ।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "विशेष हैं धन्यवाद देती ।।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "विनय यही है वढ़ें न आगे।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "विराम क्यों है ललक न लेती ॥३६।।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "बहुत दूर आ गये ठहरिये ।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "न कीजिये आप लोग अब श्रम ॥"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "सुखित न होंगी कदापि आर्या ।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "न जायेंगे आप लोग जो थम ॥३७॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "कृपा करे आप लोग जाये ।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "विनम्र हो ईश से सनावे ॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "प्रसव करे पुत्र - रत्न आर्या ।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "मयंक नभ - अंक में उगावे ॥३८॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "१०६  वैदेही-वनवास"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "सुने सुमित्रा - कुमार बाते ।।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "दिशा हुई जय - निनाद भरिता ॥"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "बही उरों में सकल - जनों के।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "तरंगिता बन विनोद - सरिता ॥३९।।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "पुनः सुनाई पड़ा राजकुल ।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "सदा कमल सा खिला दिखावे ॥"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "यथा - शीघ्र फिर अवध धाम में ।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "वन्दनीयतम - पद पड़ पावे ॥४०॥"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "चला वेग से अपूर्व स्यंदन ।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "चली गई यत्र तत्र जनता ।।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "विचार - मन्ना हुई जनकजा।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "बड़ी विषम थी विषय - गहनता ॥४१॥"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "कभी सुमित्रा - सुअन ऊबकर ।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "वदन जनकजा का विलोकते ।।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "कभी दिखाते नितान्त - चिन्तित ।"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "कभी विलोचन - वारि रोकते ॥४२॥"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "चला जा रहा दिव्य यान था।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "अजस्र था टाप - रव सुनाता ।।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "सकल - घंटियाँ निनाद रत थी।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "कभी चक्र घरित जनाता ॥४३।।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "१०७  सप्तम सर्ग"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "हरे भरे खेत सामने आ।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "भभर, रहे भागते जनाते ।।"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "विविध रम्य आराम भूरि - तरु ।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "पंक्ति - वद्ध थे खड़े दिखाते ।।४४।।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "कहीं पास के जलाशयों से ।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "विहंग उड़ प्राण थे बचाते ॥"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "लगा लगा व्योम - मध्य चक्कर ।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "अतीव - कोलाहल थे मचाते ॥४५॥"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "कहीं चर रहे पशु विलोक रथ ।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "चौक चौक कर थे घबराते ॥"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "उठा उठा कर स्वकीय पूँछे ।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "इधर उधर दौडते दिखाते ॥४६॥"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "कभी पथ - गता ग्राम - नारियाँ।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "गयंद - गतिता रही दिखाती ।।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "रथाधिरूढ़ा कुलांगना की।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "विमुग्ध वर - मूर्ति थी वनाती ॥४७॥"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "कनक-कान्ति, कोशल-कुमार का।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "दिव्य - रूप सौदर्य - निकेतन ।।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "विलोक किस पांथ का न बनता ।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "प्रफुल्ल अंभोज सा विकच मन ॥४८॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "१०८  वैदेही-वनवास"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "अधीर - सौमित्र को विलोके ।"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "कहा धीर - धर धरांगजा ने ॥"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "बड़ी व्यथा हो रही मुझे है।"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "अवश्य है जी नही ठिकाने ॥४९॥"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "परन्तु कर्त्तव्य है न भूला ।"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "कभी उसे भूल मैं न देंगी।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "नहीं सकी मैं निवाह निज व्रत ।"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "कभी नहीं यह कलंक लूंगी ॥५०॥"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "विपम समस्या सदन विश्व है।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "विचित्र है सृष्टि कृत्य सारा ।।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "तथापि विष - कंठ - शीश पर है।"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "प्रवाहिता स्वर्ग - वारि - धारा ।।५१।।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "राहु केतु हैं जहाँ व्योम में ।"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "जिन्हें पाप ही पसंद आया ।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "वही दिखाती सुधांशुता है।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "वही सहस्रांशु जगमगाया ॥५२॥"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "द्रवण शील है स्नेह सिधु है।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "हृदय सरस से सरस दिखाया ।।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "परन्तु है त्याग - शील भी वह ।"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "उसे न कब पूत - भाव भाया ।।५३॥"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "१०९  सप्तम सर्ग"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "स्वलाभ तज लोक - लाभ - साधन ।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "विपत्ति से भी प्रफुल्ल रहना ।।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "परार्थ करना न स्वार्थ - चिन्ता।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "स्वधर्म - रक्षार्थ क्लेश सहना ॥५४।।"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "मनुष्यता है करणीय कृत्य है।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "अपूर्व - नैतिकता का विलास है।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "प्रयास है भौतिकता विनाश का।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "नरत्व - उन्मेप - क्रिया-विकास है ।।५५।।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "विचार पतिदेव का यही है।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "उन्हे यही नीति है रिझाती ।।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "अशान्त भव में यही रही है।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "सदा शान्ति का स्रोत बहाती ॥५६।।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "उसे भला भूल क्यों सकूँगी।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "यही ध्येय आजन्म रहा है।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "परम - धन्य है वह पुनीत थल ।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "जहाँ सुरसरी सलिल बहा है।।५७।।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "विलोक आँखे मयंक - मुख को।"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "रही सुधा - पान नित्य करती ।।"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "बनी चकोरी अतृप्त रहकर ।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "रही प्रचुर - चाव साथ अरती ॥५८॥"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "११०  वैदेही-वनवास"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "किसी दिवस यदि न देख पातीं।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "अपार आकुल वनी दिखातीं ।।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "विलोकती पंथ उत्सुका हो।"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "ललक ललक काल थी बिताती ॥५९।।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "बहा बहा वारि जो विरह में।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "बने ए नयन वारिवाह से।"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "बार बार बहु व्यथित हुए, जो।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "हृदय विकम्पित रहे आह से ॥६०॥"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "विचित्रता तो भला कौन है।"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "स्वभाव का यह स्वभाव ही है।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "कब न वारि बरसे पयोद बन ।"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "समुद्र की ओर सरि वही है ॥६१॥"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "वियोग का काल है अनिश्चित ।"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "व्यथा - कथा वेदनामयी है।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "बहु - गुणावली रूप - माधुरी।"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "रोम रोम में रमी हुई है ॥६२॥"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "अतः रहूँगी वियोगिनी मैं।"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "नेत्र वारि के मीन बनेगे।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "किन्तु दृष्टि रख लोक - लाभ पर ।"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "सुकीर्ति - मुक्तावली जनेंगे ॥६३॥"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "१११  सप्तम सर्ग"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "सरस सुधा सी भरी उक्ति के।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "नितान्त - लोलुप श्रवण रहेंगे।"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "किन्तु चाव से उसे सुनेगे ।"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "भले - भाव जो भली कहेंगे ॥६४।।"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "हृदय हमारा व्यथित बनेगा।"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "स्वभावतः वेदना सहेगा ।।"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "अतीव - आतुर दिखा पड़ेगा।"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "नितान्त - उत्सुक कभी रहेगा ।।६६।।"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "कभी आह ऑधियाँ उठेगी।"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "कभी विकलता - घटा घिरेगी ।।"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "दिखा चमक चौक - व्याज उससे ।"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "कभी कुचिन्ता - चपला फिरेगी॥६६॥"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "परन्तु होगा न वह प्रवंचित ।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "कदापि गन्तव्य पुण्य - पथ से ॥"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "कभी नहीं भ्रान्त हो गिरेगा।"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "स्वधर्म - आधार दिव्य रथ से ॥६७।।"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "सदा करेगा हित सर्व-भूत का।"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "न लोक आराधन को तजेगा।"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "प्रणय - मूर्ति के लिये मुग्ध हो।"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "आर्त - चित्त आरती सजेगा ॥६८॥"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "११२  वैदेही-वनवास"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "अवश्य सुख वासना मनुज को ।"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "सदा अधिक श्रान्त है वनाती ।।"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "पड़े स्वार्थ - अंधता तिमिर में।"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "न लोक हित-मूर्ति है दिखाती ।।६९।।"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "कहाँ हुआ है उबार किसका।"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "सदा सभी की हुई हार है।"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "अपार - संसार वारिनिधि में।"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "आत्मसुख मॅवर दुर्निवार है॥७०।।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "बड़े बड़े पूज्य - जन जिन्होंने ।"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "गिना स्वार्थ को सदैव सिकता।"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "न रोक पाये प्रकृति प्रकृति को।"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "न त्याग पाये स्वाभाविकता ॥७१॥"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "चौपदे"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "मैं अबला हूँ आत्मसुखों की।"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "प्रबल लालसाये प्रतिदिन आ॥"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "मुझे सताती रहती हैं जो।"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "तो इसमें है विचित्रता क्या ॥७२॥"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "किन्तु सुनो सुत जिस पति-पद की।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "पूजा कर मैंने यह जाना ।।"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "आत्मसुखों से आत्मत्याग । ही।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "सुफलद अधिक गया है माना ॥७३॥"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "सप्तम सर्ग"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "११३"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "उसी पूत - पद - पोत सहारे।"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "विरह - उदधि को पार करूँगी ।"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "विधु - सुन्दर वर - वदन ध्यान कर ।"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "सारा अंतर - तिमिर हरूँगी ॥७४।।"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "सर्वोत्तम साधन है उर मे।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "भव - हित पूत - भाव का भरना ॥"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "स्वाभाविक - सुख - लिप्साओं को।"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "विश्व - प्रेम में परिणत करना ।।७५।।"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "दोहा"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "इतना सुन सौमित्र की दूर हुई दुख - दाह ।"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "देखा सिय ने सामने सरि - गोमती - प्रवाह ॥७६।।"
    }
  ]
}