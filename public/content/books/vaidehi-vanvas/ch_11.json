{
  "book_id": "vaidehi-vanvas",
  "chapter_id": "ch_11",
  "number": 11,
  "title": "सर्ग १० — तपस्विनी आश्रम",
  "word_count": 1512,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "दशम सर्ग\n-*-\nतपस्विनी आश्रम\nचौपदे"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "प्रकृति का नीलाम्बर उतरे ।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "श्वेत - साड़ी उसने पाई ।।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "हटा घन - घूघट शरदाभा।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "विहँसती महि में थी आई ॥१॥"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मलिनता दूर हुए तन की।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "दिशा थी बनी विकच - वदना ।।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अधर में मंजु - नीलिमामय ।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "था गगन - नवल - वितान तना ॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "१४५  दशम सर्ग"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "चॉदनी छिटिक छिटिक छबि से ।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "छबीली बनती रहती थी।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "सुधाकर - कर से वसुधा पर।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सुधा की धारा बहती थी ॥३॥"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "कही थे वहे दुग्ध - सोते।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "कहीं पर मोती थे ढलके ।।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कही था अनुपम - रस वरसा।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "भव - सुधा - प्याला के छलके ॥४॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "मंजुतम गति से हीरक - चय ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "निछावर करती जाती थी।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "जगमगाते ताराओं मे।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "थिरकती ज्योति दिखाती थी ॥५॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "क्षिति - छटा फूली फिरती थी।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "विपुल - कुसुमावलि विकसी थी।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "आज वैकुण्ठ छोड़ कमला।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "विकच - कमलों में विलसी थी॥६॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "पादपों के श्यामल - दल ने।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "प्रभा पारद सी पाई थी।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "दिव्य हो हो नवला - लतिका ।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "विभा सुरपुर से लाई थी॥७॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "१०\n१४६  वैदेही-वनवास"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "मंद - गति से बहती नदियाँ।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "मंजु - रस मिले सरसती थीं।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "पा गये राका सी रजनी ।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "वीचियाँ बहुत विलसती थीं ॥८॥"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "किसी कमनीय - मुकुर जैसा।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "सरोवर विमल - सलिल वाला ॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "मोहता था स्वअंक में ले।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "विधु - सहित मंजुल - उडु-साला ॥९॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "शरद - गौरव नभ - जल - थल में ।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "आज मिलते थे ऑके से ।।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "कीर्ति फैलाते थे हिल हिल ।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "कास के फूल पताके से ॥१०॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "चतुष्पद"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "तपस्विनी - आश्रम समीप थी।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "एक बड़ी रमणीय - बाटिका ।।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "वह इस समय विपुल-विलसित थी।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "मिले सिता की दिव्य साटिका ॥११॥"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "उसमें अनुपम फूल खिले थे।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "मंद मंद जो मुसकाते थे।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "बड़े भले - मावों से भर भर ।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "भली रंगते दिखलाते थे॥१२।।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "१४७  दशम सर्ग"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "छोटे छोटे पौधे उसके।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "थे चुप चाप खड़े छबि पाते ॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "हो कोमल - श्यामल - दल शोभित ।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "रहे श्यामसुंदर कहलाते ।।१३।।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "रंग विरंगी विविध लताये ।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "ललित से ललित बन विलसित थीं।।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "किसी कलित कर से लालित हो।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "विकच - बालिका सी विकसित थी ॥१४॥"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "इसी वाटिका में निर्मित था।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "एक मनोरम - शान्ति - निकेतन ।।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "जो था सहज - विभूति - विभूपित ।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "सात्विकता - शुचिता - अवलम्वन ।।१५।।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "था इसके सामने सुशोभित ।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "एक विशाल - दिव्य - देवालय ॥"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "जिसका ऊँचा - कलस इस समय ।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "बना हुआ था कान्त - कान्तिमय ॥१६॥"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "शान्ति - निकेतन के आगे था।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "एक सित-शिला विरचित - चत्वर ।।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "उस पर बैठी जनक - नन्दिनी ।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "देख रही थी दश्य • मनोहर ।।१७।।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "१४८  वैदेही-वनवास"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "प्रकृति हंस रही थी नभतल में ।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "हिम - दीधित को हँसा हँसा कर ॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "ओस - विन्दु - मुक्तावलि द्वारा।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "गोद सिता की वार बार भर ॥१८॥"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "चारु - हॉसिनी चन्द्र - प्रिया की।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "अवलोकन कर बड़ी रुचिर - रुचि ।।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "देखे उसकी लोक - रंजिनी -"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "कृति, नितान्त-कमनीय परम-शुचि ॥१९॥"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "जनक - सुता उर द्रवीभूत था।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "उनके हग से था जल जाता ।।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "कितने ही अतीत - वृत्तों का।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "ध्यान उन्हें था अधिक सताता ॥२०॥"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "कहने लगी सिते । सीता भी।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "क्या तुम जैसी ही शुचि होगी।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "क्या तुम जैसी ही उसमें भी।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "भव-हित-रता दिव्य - रुचि होगी ॥२१॥"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "तमा तमा है तमोमयी है।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "भाव सपत्नी का है रखती ।।."
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "कभी तुमारी पूत - प्रीति की।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "स्वाभाविकता नहीं परखती ॥२२॥"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "१४९  दशम सर्ग"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "फिर भी 'राका - रजनी' कर तुम ।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "उसको दिव्य बना देती हो।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "कान्ति-हीन को कान्ति - मती कर ।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "कमनीयता दिखा देती हो ॥२३।।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "जिसे नही हंसना आता है।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "चारु - हासिनी वह बनती है।।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "तुमको आलिगन कर असिता।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "स्वर्गिक - सितता में सनती है ॥२४॥"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "ताटंक"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "नभतल में यदि लसती हो तो,"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "भूतल में भी खिलती हो ।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "दिव्य - दिशा को करती हो तो ,"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "विदिशा में भी मिलती हो ॥२५।।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "बहु विकास विलसित हो वारिधि ,"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "यदि पयोधि बन जाता है।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "तो लघु से लघुतम सरवर भी ,"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "तुमसे शोभा पाता है ॥२६॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "गिरि-समूह - शिखरों को यदि तुम ,"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "मणि - मण्डित कर पाती हो।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "छोटे छोटे टीलों पर भी ,"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "तो निज छटा दिखाती हो ॥२७॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "१५०  वैदेही-वनवास"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "सुजला - सुफला - शस्य श्यामला ,"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "भू जो भूपित होती है।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "तुमसे सुधा लाभ कर तो सरु -"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "महि भी मरुता खोती है ॥२८॥"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "रम्य - नगर लघु - ग्राम वरविमा ,"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "दोनों तुमसे पाते हैं।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "राज - भवन हों या कुटीर, सब"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "कान्ति-मान बन जाते हैं ॥२९॥"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "तरु - दल हों प्रसून हों तृण हों ,"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "सबको द्युति तुम देती हो।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "औरों की क्या बात रजत - कण ,"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "रज - कण को कर लेती हो ॥३०।।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "घूम घूम करके धनमाला ,"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "रस बरसाती रहती है।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "मृदुता सहित दिखाती उसमें ,"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "द्रवण - शीलता महती है॥३१॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "है जीवन - दायिनी कहाती ,"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "ताप जगत का हरती है।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "तरु से तृण तक का प्रतिपालन ,"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "जल प्रदान कर करती है ॥३२।।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "दशम सर्ग"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "किन्तु महा - गर्जन जना कर"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "कॅपा कलेजा देती है।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "गिरा गिरा कर बिजली जीवन"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "कितनों का हर लेती है॥३३॥"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "हिम - उपलों से हरी भरी ,"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "खेती का नाश कराती है।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "जल - सावन से नगर ग्राम ,"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "पुर को बहु विकल बनाती है ॥३४॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "अतः सदाशयता तुम जैसी ,"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "उसमें नही दिखाती है।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "केवल सत्प्रवृत्ति ही उसमे ,"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "मुझे नही मिल पाती है ॥३५॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "तुममे जैसी लोकोत्तरता ,"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "सहज - स्निग्धता मिलती है।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "सदा तुमारी कृति - कलिका जिस -"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "अनुपमता से खिलती है॥३६।।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "वैसी अनुरंजनता शुचिता ,"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "किसमे कहाँ दिखाती है।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "केवल प्रियतम दिव्य - कीर्ति ही -"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "मे वह पाई जाती है ॥३७॥"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "१५२  वैदेही-वनवास"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "हाँ प्रायः वियोगिनी तुमसे ,"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "व्यथिता बनती रहती है।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "देख तुमारे जीवनधन को ,"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "मम - वेदना सहती है॥३८॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "यह उसका अन्तर - विकार है,"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "तुम तो सुख ही देती हो।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "आलिगन कर उसके कितने -"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "तापों को हर लेती हो ॥३९।।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "यह निस्वार्थ सदाशयता यह"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "वर - प्रवृत्ति पर - उपकारी ।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "दोष - रहित यह लोकाराधन ,"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "यह उदारता अति - न्यारी ॥४०॥"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "बना सकी है भाग्य - शालिनी ,"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "ऐ सुभगे तुमको जैसी।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "त्रिभुवन में अवलोक न पाई ,"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "मैं अब तक कोई वैसी ॥४१॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "इस धरती से कई लाख कोसों -"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "पर कान्त तुमारा है।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "किन्तु बीच में कभी नहीं"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "बहती वियोग की धारा है ॥४२॥"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "१५३  दशम सर्ग"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "लाखों कोसों पर रहकर भी"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "पति - समीप तुम रहती हो।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "यह फल उन पुण्यो का है,"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "तुम जिसके वल से महती हो ॥४३।।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "क्यों संयोग वाधिका बनती ,"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "लाखों कोसों की दूरी ॥"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "क्या होती हैं नही सती की"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "सकल कामनाये पूरी ? ॥४४॥"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "ऐसी प्रगति मिली है तुमको ,"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "अपनी पूत - प्रकृति द्वारा।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "है हो गया विदूरित जिससे ,"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "प्रिय - वियोग - संकट सारा ।।४५।।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "सुकृतिवती हो सत्य -सुकृति-फल"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "सारे - पातक खोता है।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "उसके पावन - तम - प्रभाव मे,"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "बहता रस का सोता है॥४६॥"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "तुम तो लाखों कोस दूर की ,"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "अवनी पर आ जाती हो।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "फिर भी पति से पृथक न होकर ,"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "पुलकित वनी दिखाती हो ॥४७॥"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "१५४  वैदेही-वनवास"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "मुझे सौ सवा सौ कोसों की ,"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "दूरी भी कलपाती है।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "मेरी आकुल ऑखों को"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "पति - मूर्ति नहीं दिखलाती है॥४८॥"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "जिसकी मुख - छबि को अवलोके ,"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "छबिमय जगत दिखाता है।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "जिसका सुन्दर विकच - वदन ,"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "वसुधा को मुग्ध बनाता है॥४९॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "जिसकी लोक - ललाम - मूर्ति ,"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "भव - ललामता की जननी है।"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "जिसके आनन की अनुपमता ,"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "परम - प्रमोद प्रसविनी है ॥५०॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "जिसकी अति - कमनीय - कान्ति से ,"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "कान्तिमानता लसती है।"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "जिसकी महा - रुचिर - रचना में ,"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "लोक - रुचिरता बसती है ॥५१॥"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "जिसकी दिव्य - मनोरमता में ,"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "रम मन तम को खोता है।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "जिसकी मंजु माधुरी पर ,"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "माधुर्य निछावर होता है ।।५२।।"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "१५५  दशम सर्ग"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "जिसकी आकृति सहज - सुकृति"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "का वीज हृदय मे वोती है।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "जिसकी सरस - वचन की रचना ,"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "मानस का मल धोती है।॥५३॥"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "जिसकी मृदु - मुसकान भुवन -"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "मोहकता की प्रिय - थाती है।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "परमानन्द जनकता जननी ,"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "जिसकी हंसी कहाती है ॥५४॥"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "भले भले भावों से भर भर ,"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "जो भूतल को भाते है।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "बड़े बड़े लोचन जिसके ,"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "अनुराग - रँगे दिखलाते है ।।५५।।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "जिनकी लोकोत्तर लीलाये,"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "लोक - ललक की थाती है।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "ललित - लालसाओ को विलसे ,"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "जो उल्लसित बनाती हैं ॥५६॥"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "आजीवन जिनके चन्द्रानन की -"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "चकोरिका बनी रही।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "जिसकी भव - मोहिनी सुधा प्रति -"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "दिन पी पी कर मैं निबही ।।५७||"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "१५६  वैदेही-वनवास"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "जिन रविकुल - रवि को अवलोके ,"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "रही कमलिनी सी फूली ।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "जिनके परम - पूत भावों की ,"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "भावुकता पर थी भूली ॥५८॥"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "सिते! महीनों हुए नही उनका ,"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "दर्शन मैंने पाया।"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "विधि - विधान ने कभी नही ,"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "था मुझको इतना कलपाया ॥५९।।"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "जैसी तुम हो सुकृतिमयी जैसी -"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "तुममें सहृदयता"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "जैसी हो भवहित विधायिनी ,"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "जैसी तुममें ममता है॥६०॥"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "मैं हूँ अति - साधारण नारी ,"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "कैसे वैसी मैं हूँगी।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "तुम जैसी महती व्यापकता ,"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "उदारता क्यों पाऊँगी ॥६१॥"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "फिर भी आजीवन मैं जनता -"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "का हित करती आई हूँ।"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "अनहित औरों का अवलोके ,"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "कब न बहुत घबराई हूँ ॥६२।।"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "१५७  दशम सर्ग"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "जान बूझ कर कभी किसी का -"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "अहित नही मैं करती हूँ।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "पॉव सर्वदा फूंक फूंक कर ,"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "धरती पर मैं धरती हूँ॥६३॥"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "फिर क्यों लाखों कोसों पर रह ,"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "तुम पति पास विलसती हो।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "बिना विलोके दुख का आनन ,"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "सर्वदैव तुम हँसती हो ॥६४।।"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "और किसलिये थोड़े अन्तर"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "पर रह मैं उकताती हूँ।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "बिना नवल - नीरद-तन देखे ,"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "दृग से नीर बहाती हूँ॥६५॥"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "ऐसी कौन न्यूनता मुझमें है ,"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "जो विरह सताता है।"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "सिते । बता दो मुझे क्यों नही ,"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "चन्द्र - वदन दिखलाता है॥६६॥"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "किसी प्रिय सखी सदृश प्रिये तुम"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "लिपटी हो मेरे तन से।"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "हो जीवन - संगिनी सुखित -"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "करती आती हो शिशुपन से ॥६७॥"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "१५८  वैदेही-वनवास"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "हो प्रभाव - शालिनी कहाती ,"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "प्रभा भरित दिखलाती हो।"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "तमस्विनी का भी तम हरकर,"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "उसको दिव्य वनाती . हो ॥६८॥"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "मेरी तिमिरावृता न्यूनता का"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "निरसन त्योंही कर दो।"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "अपनी पावन ज्योति कृपा -"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "दिखला, मम जीवन में भर दो ॥६९॥"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "कोमलता की मूर्ति सिते हो,"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "हितेरता कहलाओगी।"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "आशा है आई हो तो तुम ,"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "उर में सुधा बहाओगी ||७०॥"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "अधिक क्या कहूँ अति-दुर्लभ है ,"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "तुम जैसी ही हो जाना।"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "किन्तु चाहती हूँ जी से तव -"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "सद्भावों को अपनाना ॥७१॥"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "जो सहायता कर सकती हो"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "करो, प्रार्थना है इतनी ।"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "जिससे उतनी सुखी बन सकूँ ,"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "पहले सुखित रही जितनी ॥७२॥"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "१५९  दशम सर्ग"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "सेवा उसकी करूं साथ रह ,"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "जी से जिसकी दासी हूँ।"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "हूँ न स्वार्थरत, मैं पति के -"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "संयोग - सुधा की प्यासी हूँ॥७३।।"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "दोहा"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "इतने में घंटा बजा उठा आरती - थाल ।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "द्रुत - गति से महिजा गई मंदिर मे तत्काल ॥७४।।"
    }
  ]
}