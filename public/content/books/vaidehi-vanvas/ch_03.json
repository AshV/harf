{
  "book_id": "vaidehi-vanvas",
  "chapter_id": "ch_03",
  "number": 3,
  "title": "सर्ग २ — चिन्तित चित्त",
  "word_count": 1536,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१ उपवन"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "वैदेही-वनवास    (1939)     द्वारा     अयोध्या सिंह उपाध्याय 'हरिऔध'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "चिन्तित चित्त       ३ मंत्रणा गृह   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "द्वितीय सर्ग"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "-*-"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "चिन्तितः पृच्चित्तु"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "चतुष्पद"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अवध के राज मन्दिरों मध्य ।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "एक आलय था बहु-छबि-धाम ॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "खिंचे थे जिसमें ऐसे चित्र ।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "जो कहाते थे लोक-ललाम ॥१॥"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "दिव्य-तम कारु-कार्य अवलोक ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अलौकिक होता था आनन्द ।।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "रत्नमय पञ्चीकारी देख ।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "दिव विभा पड़ जाती थी मन्द ॥२॥"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "१९  द्वितीय सर्ग"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कला कृति इतनी थी कमनीय ।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "दिखाते थे सब चित्र सजीव ॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "भाव की यथातथ्यता देख ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "दृष्टि होती थी मुग्ध अतीव ॥३॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अंग-भंगी, आकृति की व्यक्ति ।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "चित्र के चित्रण की थी पूर्ति ॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "ललित तम कर की खिंची लकीर ।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "बनी थी दिव्य-भूति की मूर्ति ॥४॥"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "देखते हुए मुग्धकर - चिन्न ।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "सदन में राम रहे थे घूम ।।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "चाह थी चित्रकार मिल जाय ।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "हाथ तो उसके लेवे चूम ॥५॥"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "इसी अवसर पर आया एक-"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "गुप्तचर वहाँ विकंपित - गात ।।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "विनत हो चन्दन कर कर जोड़।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "कही दुख से उसने यह बात ॥६॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "प्रभो यह सेवक प्रातःकाल ।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "घूमता फिरता चारों ओर ।।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "उस जगह पहुंचा जिसको लोग।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "इस नगर का कहते हैं छोर ॥७॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "२०  वैदेही-वनवास"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "वहाँ पर एक रजक हो क्रुद्ध ।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "रोक कर गृह प्रवेश का द्वार ॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "त्रिया को कड़ी दृष्टि से देख ।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "पूछता था यह बारम्बार ॥८॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "बिताई गई कहाँ पर रात्रि ।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "लगा कर लोक-लाज को लात ।।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "पापिनी कुल में लगा कलंक ।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "यहाँ क्यों आई हुए प्रभात ॥९॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "चली जा हो आँखों से दूर।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "अब यहाँ क्या है तेरा काम ।।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "कर रही है तू भारी भूल ।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "जो समझती है मुझको राम ॥१०॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "रहीं जो पर-गृह में पट्मास ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "हुई है उनकी उन्हें प्रतीति ॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "वड़ों की बड़ी बात है किन्तु ।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "कलंकित करती है यह नीति ॥११॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "प्रभो बतलाई थी यह बात ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "विनय मैंने की थी वहु वार ।।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "नही माना जाता है ठीक ।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "जनकजा पुनर्ग्रहण व्यापार ॥१२॥"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "२१  द्वितीय सर्ग"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "आदि में थी यह चर्चा अल्प ।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "कभी कोई कहता यह वात ।।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "और कहते भी वे ही लोग ।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "जिन्हे था धर्म-मर्म अज्ञात ॥१३॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "अब नगर भर में वह है व्याप्त ।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "बढ़ रहा है जन चित्त-विकार ।।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "जनपदों ग्रामों में सब ओर ।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "हो रहा है उसका विस्तार ॥१४॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "किन्तु साधारण जनता मध्य ।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "हुआ है उसका अधिक प्रसार ।।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "उन्ही के भावों का प्रतिविम्ब ।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "रजक का है निन्दित - उद्गार ॥१५॥"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "विवेकी विज्ञ सर्व - बुध - वृन्द ।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "कर रहे हैं सद्बुद्धि प्रदान ॥"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "दिखाकर दिव्य - ज्ञान - आलोक ।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "दूर करते हैं तम अज्ञान ॥१६॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "अवांछित हो पर है यह सत्य ।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "बढ़ रहा है वहु - वाद - विवाद ॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "प्रभो मैं जान सका न रहस्य ।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "किन्तु है निद्य लोक - अपवाद ॥१७॥"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "२२  वैदेही-वनवास"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "राम ने बनकर बहु - गंभीर ।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "सुनी दुर्मुख के मुख की बात ।।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "फिर उसे देकर गमन निदेश ।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "सोचने लगे वन वहुत शान्त ॥१८॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "बात क्या है ? क्यों यह अविवेक? ।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "जनकजा पर भी यह आक्षेप ।।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "उस सती पर जो हो अकलंक ।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "क्या बुरा है न पंक - निक्षेप ॥१९॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "निकलते ही मुख से यह बात ।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "पड़ गई एक चित्र पर दृष्टि ।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "देखते ही जिसके तत्काल ।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "हगों में हुई सुधा की वृष्टि ॥२०॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "दारु का लगा हुआ अम्बार ।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "परम-पावक-सय बन हो लाल ।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "जल रहा था धू धू ध्वनि साथ ।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "ज्वालमाला से हो विकराल ॥२१॥"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "एक स्वर्गीय - सुन्दरी स्वच्छ--"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "पूत - तम - बसन किये परिधान ॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "कर रही थी उसमें सुप्रवेश ।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "कमला- मुख था उत्फुल्ल महान ।।२२।।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "२३  द्वितीय सर्ग"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "परम - देदीप्यमान हो अंग।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "बन गये थे वहु - तेज - निधान ।।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "हगों से निकल ज्योति का पुंज ।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "बनाता था पावक को म्लान ।।२३।।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "सामने खड़ा रिक्ष कपि यूथ ।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "कर रहा था बहु जय जय कार ।।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "गगन मे विलसे विवुध विमान ।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "रहे बरसाते सुमन अपार ॥२४॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "बात कहते अंगारक पुंज ।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "बन गये विकच कुसुम उपमान ?"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "लसी दिखलाई उस पर सीय ।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "कमल पर कमलासना समान ॥२५॥"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "देखते रहे राम यह दृश्य ।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "कुछ समय तक हो हो उद्ग्रीव ॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "फिर लगे कहने अपने आप ।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "क्या न यह कृति है दिव्य अतीव ॥२६।।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "मैं कभी हुआ नही संदिग्ध ।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "हुआ किस काल में अविश्वास ।।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "भरा है प्रिया चित्त मे प्रेम ।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "हृदय मे है सत्यता निवास ॥२७॥"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "६४  वैदेही-वनवास"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "राजसी विभवों से मुँह मोड़।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "स्वर्ग - दुर्लभ सुख का कर त्याग ।।"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "सर्व प्रिय सम्बन्धों को भूल ।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "ग्रहण कर नाना विपय विराग ॥२८॥"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "गहन विपिनों में चौदह साल।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "सदा छाया सम रह मम साथ ।।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "साँसते सह खा फल दल मूल ।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "कभी पी करके केवल पाथ ॥२९।।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "दुग्ध फेनोपम अनुपम सेज ।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "छोड़ मणि-मण्डित- कञ्चन - धाम ।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "कुटी में रह सह नाना कष्ट ।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "बिताये हैं किसने वसुयाम ॥३०॥"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "कमलिनी - सी जो है सुकुमार।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "कुसुम कोमल है जिसका गात ॥"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "चटाई पर या भू पर पौढ़ ।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "बिताई उसने है सब रात ॥३१॥"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "देख कर मेरे मुख की ओर ।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "भूलते थे सब दुख के भाव ॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "मिल गये कहीं कंटकित पंथ। ."
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "छिदे किसके पंकज से पॉव.॥३२॥"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "२५  द्वितीय सर्ग"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "नही घबरा पाती थी कौन ।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "देख फल दल के भाजन रिक्त ।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "बनाती थी न किसे उद्विग्न ।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "टपकती कुटी धरा जल सिक्त ॥३३॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "भूल अपना पथ का अवसाद।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "बदन को बना विकच जलजात ।।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "पास आ व्यजन डुलाती कौन ।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "देख कर स्वेद-सिक्त मम गात ॥३४॥"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "हमारे सुख का मुख अवलोक ।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "बना किसको वन सुर - उद्यान ।।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "कुसुम कंटक, चन्दन, तप - ताप ।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "प्रभंजन मलय - समीर समान ॥३५॥"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "कहाँ तुम और कहाँ वनवास ।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "यदि कभी कहता चले प्रसंग ।।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "तो विहँस कहती त्याग सकी न ।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "चन्द्रिका चन्द्र देव का संग ॥३६॥"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "दिखाया किसने अपना त्याग ।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "लगा लंका विभवों को लात ॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "सहे किसने धारण कर धीर ।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "दानवों के अगणित - उत्पात ॥३७॥"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "२६  वैदेही-वनवास"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "दानवी दे दे नाना त्रास ।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "बनाकर रूप बड़ा विकराल ॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "विकम्पित किसको बना सकी न ।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "दिखाकर बदन विनिर्गत ज्वाल ॥३८॥"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "लोक-त्रासक-दशआनन भीति ।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "उठी उसकी कठोर करवाल ॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "बना किसको न सकी बहु त्रस्त ।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "सकी किसका न पतिव्रत टाल ॥३९।।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "कौन कर नाना - व्रत - उपवास ।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "गलाती रहती थी निज गात ।।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "बिताया किसने संकट - काल ।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "तरु तले बैठी रह दिन रात ॥४०॥"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "नहीं सकती जो पर दुख देख ।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "हृदय जिसका है परम - उदार ।।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "सवें जन सुख संकलन निमित्त ।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "भरा है जिसके उर में प्यार ॥४१।।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "सरलता की जो है प्रतिमूर्ति ।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "सहजता है जिसकी प्रिय - नीति ।।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "बड़े कोमल हैं जिसके भाव ।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "परम - पावन है जिसकी प्रीति ।।४२॥"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "२७  द्वितीय सर्ग"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "शान्ति - रत जिसकी मति को देख ।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "लोप होता रहता है कोप ।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "मानसिक - तम करता है दूर ।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "दिव्य जिसके आनन का ओप ॥४३॥"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "सुरुचिमय है जिसकी चित-वृत्ति ।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "कुरुचि जिसको सकती है छू न ।।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "हृदय है इतना सरस दया ।"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "तोड़ पाते कर नहीं प्रसून ॥४४॥"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "करेगा उस पर शंका कौन ।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "क्यों न उसका होगा विश्वास ।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "यही था अग्नि - परीक्षा मर्म ।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "हो न जिससे जग मे उपहास ।।४५।।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "अनिच्छा से हो खिन्न नितान्त ।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "किया था मैंने ही यह काम ।।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "प्रिया का ही था यह प्रस्ताव ।"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "न लाञ्छित हो जिससे मम नाम ॥४६।।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "पर कहाँ सफल हुआ उद्देश ।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "लग रहा है जब वृथा कलंक ।।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "किसी कुल - वाला पर वन वक्र ।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "जब पड़ी लोक - दृष्टि निशंक ॥४७॥"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "८  वैदेही-वनवास"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "सत्य होवे या वह हो झूठ।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "या कि हो कलुपित चित्त प्रमाद ।।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "निद्य है है अपकीर्ति - निकेत ।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "लांछना - निलय लोक - अपवाद ॥४८॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "भले ही कुछ न कहें बुध-वृन्द ।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "सज्जनों को हो सुने विषाद ।"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "किन्तु है यह जन-रव अच्छा न ।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "अवांछित है यह वाद - विवाद ॥४९॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "मिल सका मुझे न इसका भेद ।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "हो रहा है क्यों अधिक प्रसार ॥"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "बन रहा है क्या साधन - हीन ।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "लोक - आराधन का व्यापार ॥५०॥"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "प्रकृति गत है, है उर में व्याप्त ।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "प्रजा - रंजन की नीति - पुनीत ।।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "दण्ड में यथा - उचित सर्वत्र ।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "है सरलता सद्भाव गृहीत ॥५१॥"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "न्याय को सदा मान कर न्याय ।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "किया मैंने न कभी अन्याय ॥"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "दूर की मैंने पाप - प्रवृत्ति ।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "पुण्यमय करके प्रचुर - उपाय ।।५२।।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "२९  द्वितीय सर्ग"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "सवल के सारे अत्याचार ।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "शमन में हूँ अद्यापि प्रवृत्त ।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "निर्बलों का बल बन दल दुःख ।"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "विपुल पुलकित होता है चित्त ॥५३॥"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "रहा रक्षित उत्तराधिकार ।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "छिना मुझसे कब किसका राज ॥"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "प्रजा की बनी प्रजा - सम्पत्ति ।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "ली गई कभी न वह कर व्याज ॥५४॥"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "मुझे है कूटनीति न पसंद ।"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "सरलतम है मेरा व्यवहार ॥"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "वंचना विजितों को कर व्योंत ।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "बचाया मैंने वारंवार ॥५५॥"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "समझ नृप का उत्तर - दायित्व ।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "जान कर राज-धर्म का मर्म ।।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "ग्रहण कर उचित नम्रता भाव ।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "कर्मचारी करते हैं कर्म ॥५६॥"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "भूल कर भेद भाव की बात ।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "विलसिता समता है सर्वत्र ।।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "तुष्ट है प्रजामात्र बन शिष्ट ।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "सीख समुचित स्वतंत्रता मंत्र ॥५७॥"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "वैदेही-वनवास"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "परस्पर प्रीति का समझ लाभ ।"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "हुए मानवता की अनुभूति ॥"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "सुखित है जनता सुख - मुख देख ।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "पा गये वांछित सकल - विभूति ॥५८।।"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "दानवों का हो गया निपात ।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "तिरोहित हुआ प्रबल आतंक ॥"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "दूर हो गया धर्म का द्रोह ।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "शान्तिमय बना मेदिनी अंक ॥५९॥"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "निरापद हुए सर्व - शुभ - कर्म ।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "यज्ञ - वाधा का हुआ विनाश ॥"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "टल गया पाप - पुंज तम - तोम ।"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "विलोके पुण्य - प्रभात - प्रकाश ॥६०॥"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "कर रहे हैं सब कर्म स्वकीय ।"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "समझ कर वर्णाश्रम का मर्म ॥"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "बन गये हैं मर्यादा - शील ।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "धृति सहित धारण करके धर्म ॥६१॥"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "विलसती है घर घर में शांति ।"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "भरा है जन जन में आनन्द ॥"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "कही है कलह न कपटाचार ।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "न निन्दित-वृत्ति-जनित छल-छन्द ॥६२।।"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "३१  द्वितीय सर्ग"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "हुए उत्तेजित मन के भाव ।"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "शान्त बन जाते हैं तत्काल ॥"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "याद कर मानवता का मंत्र ।"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "लोक नियमन पर ऑखें डाल ॥६३॥"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "समय पर जल देते हैं मेघ ।"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "सताती नहीं ईति की भीति ॥"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "दिखाते कही नही दुर्वृत्त ।"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "भरी है सब में प्रीति प्रतीति ॥६४॥"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "फिर हुई जनता क्यों अप्रसन्न ।"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "हुआ क्यों प्रबल लोक - अपवाद ॥"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "सुन रहे हैं क्यों मेरे कान ।"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "असंगत अ - मनोरम सम्वाद ॥६५॥"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "लग रहा है क्यो वृथा कलंक ।"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "खुला कैसे अकीर्ति का द्वार ॥"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "समझ मे आता नही रहस्य ।"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "क्या करूँ मैं इसका प्रतिकार ॥६६॥"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "दोहा"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "इन बातों को सोचते, कहते सिय गुण ग्राम ।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "गये दूसरे गेह में, धीर धुरंधर राम ॥६७।।"
    }
  ]
}