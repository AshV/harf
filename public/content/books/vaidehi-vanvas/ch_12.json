{
  "book_id": "vaidehi-vanvas",
  "chapter_id": "ch_12",
  "number": 12,
  "title": "सर्ग ११ — रिपुसूदनागमन",
  "word_count": 1924,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "एकादश सर्ग\nरिपुसूदनागमन\n-*-\nसखी"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "बादल थे नभ में छाये ।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "बदला था रंग समय का ।।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "थी प्रकृति भरी करुणा में।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कर उपचय मेघ - निचय का ॥१॥"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "वे विविध - रूप धारण कर।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नभ - तल में घूम रहे थे।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "गिरि के ऊँचे शिखरों को।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "गौरव से चूम रहे थे॥२॥"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "वे कभी स्वयं नग - सम बन ।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "थे अद्भुत - दृश्य दिखाते ।।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कर कभी दुंदुभी - वादन ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "चपला को रहे नचाते ॥३॥"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "एकादश सर्ग"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "वे पहन कभी, नीलाम्बर ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "थे बड़े - मुग्धकर बनते ॥"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "मुक्तावलि बलित अधर मे।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "अनुपम - वितान थे तनते ॥४॥"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "बहुश. - खण्डों मे बॅटकर ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "चलते फिरते दिखलाते ॥"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "वे कभी नभ - पयोनिधि के।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "थे विपुल - पोत बन पाते ॥५॥"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "वे रंग बिरंगे रवि की।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "किरणों से थे बन जाते ।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "वे कभी प्रकृति को विलसित ।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "नीली - साड़ियाँ पिन्हाते ॥६॥"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "वे पवन तुरंगम पर चढ़।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "थे दूनी - दौड़ लगाते ॥"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "वे कभी धूप - छाया के।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "थे छबिमय - दृश्य दिखाते ॥७॥"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "घन कभी घेर दिन - मणि को।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "थे इतनी घनता पाते ॥"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "जो द्युति - विहीन कर, दिन को -"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "थे अमा - समान बनाते ॥८॥"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "१६२  वैदेही-वनवास"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "वे धूम - पुंज से फैले।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "थे दिगन्त में दिखलाते ॥"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "अंकस्थ - दामिनी दमके ।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "थे प्रचुर - प्रभा फैलाते ॥९॥"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "सरिता सरोवरादिक में।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "थे स्वर - लहरी उपजाते ॥"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "वे कभी गिरा बहु - बूंदें।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "थे नाना - वाद्य बजाते ॥१०॥"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "पावस सा प्रिय - ऋतु पाकर ।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "बन रही रसा थी सरसा ॥"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "जीवन प्रदान करता था।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "वर - सुधा सुधाधर बरसा ॥११॥"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "थी दृष्टि जिधर फिर जाती।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "हरियाली बहुत लुभाती ॥"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "नाचते मयूर दिखाते ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "अलि- अवली मिलती गाती ॥१२॥"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "थी घटा कभी घिर आती।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "था कभी जल बरस जाता ॥"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "थे जलद कभी खुल जाते ।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "रवि कभी था निकल आता ॥१३॥"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "१६३  एकादश सर्ग"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "था मलिन कभी होता वह ।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "कुछ कान्ति कभी पा जाता ॥"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "कजलित कभी बनता दिन ।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "उज्ज्वल था कभी दिखाता ॥१४॥"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "कर उसे मलिन - बसना फिर ।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "काली ओढ़नी ओढ़ाती ॥"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "थी प्रकृति कभी वसुधा को।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "उज्ज्वल - साटिका पिन्हाती ॥१५॥"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "जल - विन्दु लसित दल - चय से।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "बन बन बहु - कान्त - कलेवर ॥"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "उत्फुल्ल स्नात - जन से थे।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "हो सिक्त सलिल से तरुवर ॥१६॥"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "आ मंद - पवन के झोंके ।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "जब उनको गले लगाते ॥"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "तब वे नितान्त - पुलकित हो।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "थे मुक्तावलि बरसाते ॥१७॥"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "जब पड़ती हुई फुहारे ।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "फूलों को रही रिझाती ॥"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "जव मचल मचल मारुत से ।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "लतिकाये थी लहराती ॥१८॥"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "१६४  वैदेही-वनवास"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "छवि से उड़ते छीटे में।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "जब खिल जाती थी कलियाँ॥"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "चमकीली बूंदों को जब ।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "टपकाती सुन्दर - फलियाँ ॥१९॥"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "जब फल रस से भर भर कर।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "था परम - सरस बन जाता ॥"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "तब हरे-भरे कानन में।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "था अजब समा दिखलाता ॥२०॥"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "वे सुखित हुए जो बहुधा ।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "प्यासे रह रह कर तरसे ॥"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "झूमते . हुए बादल के।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "रिमझिम रिमझिम जल बरसे ॥२१॥"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "तप - ऋतु में जो थे आकुल ।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "वे आज हैं फले - फूले ॥"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "वारिद का बदन विलोके ।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "बासर विपत्ति के भूले ॥२२॥"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "तरु - खग - चय चहक चहक कर।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "थे कलोल - रत दिखलाते ।।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "वे उमग उमग कर मानो।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "थे वारि - वाह गुण गाते ॥२३॥"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "१६५  एकादश सर्ग"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "सारे - पशु बहु - पुलकित थे।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "तृण - चय की देख प्रचुरता ॥"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "अवलोक सजल - नाना - थल।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "बन - अवनी अमित - रुचिरता ॥२४॥"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "सावन - शीला थी हो हो।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "आवर्त - जाल आवरिता ॥"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "थी बड़े वेग से बहती।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "रस से भरिता वन - सरिता ॥२५॥"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "बहुशः सोते वह बह कर ।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "कल कल रख रहे सुनाते ॥"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "सर भर कर विपुल सलिल से।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "थे सागर बने दिखाते ॥२६॥"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "उस पर वन - हरियाली ने। '"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "था अपना झूला डाला ।।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "तृण - राजि विराज रही थी।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "अहने मुक्तावलि - माला ॥२७॥"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "पावस से . प्रतिपालित हो।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "वसुधानुराग प्रिय - पय पी॥"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "रख हरियाली मुख - लाली ।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "बहु - तपी दूव थी पनपी ॥२८॥"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "१६६  वैदेही-वनवास"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "मनमाना पानी पाकर ।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "था पुलकित विपुल दिखाता ॥"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "पी पी रट लगा पपीहा।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "था अपनी प्यास बुझाता ॥२९॥"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "पाकर पयोद से जीवन ।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "तप के तापों से छूटी।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "अनुराग - मूर्ति 'बन, महि में।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "विलसित थी बीर बहूटी ॥३०॥"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "निज - शान्ततम निकेतन में।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "बैठी मिथिलेश - कुमारी ।।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "हो, मुग्ध विलोक रही थीं।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "नव - नील - जलद छबि न्यारी ॥३१॥"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "यह सोच रही थीं प्रियतम ।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "तन सा ही है यह सुन्दर ।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "वैसा ही है हग - रंजन ।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "वैसा ही महा - मनोहर ॥३२॥"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "पर क्षण क्षण पर जो उसमें।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "नवता है देखी जाती ।।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "वह नवल - नील - नीरद में।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "है मुझे नहीं मिल पाती ॥३३॥"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "१६७  एकादश सर्ग"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "श्यामलघन में बक - माला।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "उड़ उड़ है छटा दिखाती ।।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "पर प्रिय • उर - विलसित -"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "मुक्ता - माला है अधिक लुभाती ॥३४॥"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "श्यामावदात को चपला।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "चमका कर है चौकाती ॥"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "पर प्रिय - तन - ज्योति दृगों में।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "- है विपुल - रस बरस जाती ॥३५॥"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "सर्वस्व है करुण - रस का।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "है द्रवण - शीलता - सम्वल ।।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "है मूल भव - सरसता का।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "है जलद आई - अन्तस्तल ॥३६॥"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "पर निरपराध - जन पर भी।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "वह . वज्रपात करता है।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "ओले बरसा कर जीवन ।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "बहु - जीवों का हरता है॥३७॥"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "है जनक प्रबल - प्लावन का।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "है प्रलयंकर बन जाता।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "वह नगर, ग्राम, पुर को है।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "पल में निमग्न कर पाता ॥३८॥"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "१६८  वैदेही-वनवास"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "मैं सारे - गुण जलधर के।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "जीवन - धन में पाती हूँ॥"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "उसकी जैसी ही मृदुता।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "अवलोके बलि जाती हूँ॥३९॥"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "पर निरपराध को प्रियतम -"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "ने कभी नही कलपाया ।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "उनके हाथों से किसने ।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "कब कहाँ, व्यर्थ दुख पाया ||४०॥"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "पुर नगर ग्राम कव उजड़े।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "कब , कहाँ आपदा आई ।।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "अपवाद । लगाकर यों ही।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "कव . जनता गई सताई ॥४१॥"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "प्रियतम समान जन - रंजन ।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "भव - हित - रत कौन दिखाया ।।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "पर सुख निमित्त कब किसने ।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "दुख को यों गले लगाया ॥४२॥"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "घन गरज गरज कर बहुधा।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "भव का है हृदय कपाता ।।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "पर कान्त का मधुर प्रवचन ।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "उर में है सुधा बहाता ।।४।।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "एकादश सर्ग"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "जिस समय जनकजा घन की।"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "अवलोक दिव्य - श्यामलता ।।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "थीं प्रियतम - ध्यान - निमग्ना।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "कर दूर चित्त - आकुलता ॥४४॥"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "आ उसी समय आलय मे। -"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "सौमित्र - अनुज ने सादर ।।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "पग - वन्दन किया सती का।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "बन करुण - भाव से कातर ॥४५।।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "सीतादेवी ने उनको।"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "परमादर से बैठाला ॥"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "लोचन मे आये जल पर -"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "नियमन का परदा डाला ॥४६॥"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "फिर कहा तात बतला दो।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "रघुकुल - पुंगव है कैसे ? ॥"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "जैसे दिन कटते थे क्या।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "अब भी कटते है वैसे ? ॥४७॥"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "क्या कभी याद करते हैं।"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "मुझ वन - निवासिनी को भी।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "उसको जिसका आकुल - मन ।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "है पद - पंकज - रज - लोभी ॥४८॥"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "१७०  वैदेही-वनवास"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "चातक से जिसके हग हैं।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "छबि स्वाति - सुधा के प्यासे॥"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "प्रतिकूल पड़ रहे हैं अब ।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "जिसके सुख - बासर पासे ॥४९॥"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "जो विरह वेदनाओं से।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "व्याकुल होकर है ऊबी॥"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "हग - वारि - वारिनिधि में जो।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "बहु - विवशा बन है डूबी ॥५०॥"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "हैं कीर्ति करों से गुम्फित ।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "जिनकी गौरव - गाथायें ॥"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "हैं सकुशल सुखिता मेरी।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "अनुराग - मूर्ति - माताये ? ॥५१॥"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "होगये महीनों उनके ।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "ममतामय - मुख, न दिखाये ॥"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "पावनतम - युगल पगों को।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "मेरे कर परस न पाये ॥५२॥"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "श्रीमान् भरत - भव - भूषण ।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "स्नेहा सुमित्रा - नन्दन ।"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "सब दिनों रही करती मैं ।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "जिनका सादर अभिनन्दन ॥५३॥"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "१७१  एकादश सर्ग"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "हैं स्वस्थ, सुखित या चिन्तित ।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "या हैं विपन्न - हित - व्रत - रत ।।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "या हैं लोकाराधन में ।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "संलग्न बन परम - संयत ।।५४।।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "कह कह वियोग की बाते ।"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "माण्डवी बहुत थी रोई।।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "उर्मिला गई फिर आई।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "पर रात भर नहीं सोई ॥५५॥"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "श्रुतिकीर्ति का कलपना तो।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "अब तक है मुझे न भूला ॥"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "हो गये याद मेरा उर ।"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "वनता है ममता - झूला ॥५६॥"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "यह वतला दो अब मेरी।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "बहनो की गति है कैसी ?"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "वे उतनी दुखित न हों पर,"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "क्या सुखित नही हैं वैसी ? ॥५७॥"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "क्या दशा दासियों की है।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "वे दुखित तो नही रहती ।।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "या स्नेह - प्रवाहों मे पड़।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "यातना तो नही सहती ।।५८।।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "क्या वैसी ही सुखिता है।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "महि की सर्वोत्तम थाती॥"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "क्या अवधपुरी वैसी ही।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "है दिव्य बनी दिखलाती॥५९॥"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "मिट गई राज्य की हलचल।"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "या है वह अब भी फैली॥"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "कल-कीर्त्ति सिता सी अब तक।"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "क्या की जाती है मैली ॥६०॥"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "बोले रिपुसूदन आर्य्ये।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "हैं धीर धुरंधर प्रभुवर॥"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "नीतिज्ञ, न्यायरत, संयत।"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "लोकाराधन में तत्पर॥६१॥"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "गुरु-भार उन्ही पर सारे-"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "साम्राज्य-संयमन का है।"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "तन मन से भव-हित-साधन।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "व्रत उनके जीवन का है॥६२॥"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "इस दुर्गम-तम कृति-पथ में।"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "थी आप संगिनी ऐसी॥"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "वैसी तुरन्त थीं बनती।"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "प्रियतम-प्रवृत्ति हो जैसी॥६३॥"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "१७३  एकादश सर्ग"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "आश्रम - निवास ही इसका।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "सर्वोत्तम - उदाहरण है।"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "यह है अनुरक्ति - अलौकिक ।"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "भव - वन्दित सदाचरण है॥६४॥"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "यदि रघुकुल - तिलक पुरुप हैं।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "श्रीमती शक्ति हैं उनकी॥"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "जो प्रभुवर त्रिभुवन - पति है।"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "तो आप भक्ति हैं उनकी ॥६५॥"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "."
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "विश्रान्ति सामने आती।"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "तो बिरामदा थी बनती॥"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "अनहित - आतप - अवलोके ।"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "हित - वर - वितान थी तनती ॥६६॥"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "थी पूर्ति न्यूनताओं की।"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "मति - अवगति थी कहलाती ।।"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "आपही विपत्ति विलोके ।"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "थी परम - शान्ति बन पाती ॥६७॥"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "अतएव आप ही सोचे ।"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "वे कितने होंगे विह्वल ॥"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "पर धीर - धुरंधरता का।"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "नृपवर को है सच्चा - बल ॥६८"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "१७४  वैदेही-वनवास"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "वे इतनी तन्मयता से।"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "कर्तव्यों को हैं करते ॥"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "इस भावुकता से वे हैं।"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "बहु - सद्भावों से भरते ॥६९॥"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "इतने हढ़ हैं कि बदन पर ।"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "दुख - छाया नही दिखाती ॥"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "कातरता सम्मुख आये।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "कॅप कर है कतरा जाती ॥७०॥"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "फिर भी तो हृदय हृदय है।"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "वेदना - रहित क्यों होगा।"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "तज हृदय - वल्लभा को क्यों।"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "भव - सुख जायेगा भोगा ॥७१॥"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "जो सज्या - भवन सदा ही।"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "सबको हँसता दिखलाता ॥"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "जिसको विलोक आनन्दित ।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "आनन्द स्वयं हो जाता ||७२।।"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "जिसमें वहती रहती थी।"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "उल्लासमयी - रस - धारा॥"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "जो स्वरित वना करता था।"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "लोकोत्तर - स्वर के द्वारा ।।७३॥"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "१७५  एकादश सर्ग"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "इन दिनों करुण - रस से वह ।"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "परिप्लावित है दिखलाता॥"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "अवलोक म्लानता उसकी ।"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "आँखों में है जल आता ||७४॥"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "अनुरंजन जो करते थे।"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "उनकी रंगत है 'बदली।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "है कान्ति - विहीन दिखाती।"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "अनुपम - रत्नों की अवली ।।७५॥"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "मन मारे बैठी उसमें ।"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "है सुकृतिवती दिखलाती ॥"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "जो गीत करुण - रस - पूरित ।"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "प्रायः रो रो है गाती ॥७६।।"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "हो गये महीनों उसमे।"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "जाते न तात को देखा ।।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "हैं, खिंची न जाने उनके ।"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "उर में कैसी दुख - रेखा ॥७७॥"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "वाते माताओं की मैं।"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "कहकर कैसे बतलाऊँ।"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "उनकी सी ममता कैसे।"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "मैं शब्दों मे भर पाऊँ ॥७८॥"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "१७६  वैदेही-वनवास"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "मेरी आकुल - आँखों को।।"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "कबतक वह कलपायेगी।"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "उनको रट यही लगी है।"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "कब जनक - लली आयेगी ॥७९।।"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "आज्ञानुसार प्रभुवर के।"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "श्रीमती माण्डवी प्रतिदिन ॥"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "भगिनियों, दासियों को ले।"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "उन सब कामों को गिन गिन ॥८०॥"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "करती रहती हैं सादर।"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "थीं आप जिन्हें नित करती ॥"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "सच्चे जी से वे सारे।"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "दुखियों का दुख हैं हरती ॥८१॥"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "माताओं की सेवाये। ."
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "है बड़े लगन से होती ।।"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "फिर भी उनकी ममता नित ।"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "है आपके लिये रोती ॥८२॥"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "सब हो पर कोई कैसे ।"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "भवदीय - हृदय पायेगा।"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "दिव - सुधा सुधाकर का ही।"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "वरतर - कर बरसायेगा ॥८३॥"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "१७७  एकादश सर्ग"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "बहने जनहित व्रतरत रह ।"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "हैं बहुत कुछ स्वदुख भूली ॥"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "पर सत्संगति दृग - गति की।"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "है बनी असंगति फूली ॥८४॥"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "दासियाँ क्या, नगर भर का।"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "यह है मार्मिक - कण्ठ - स्वर ॥"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "जब देवी आयेगी, कव -"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "आयेगा वह वर - बासर ॥८५।।"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "है अवध शान्त अति - उन्नत ।"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "बहु - सुख - समृद्धि - परिपूरित ॥"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "सौभाग्य - धाम सुरपुर - सम ।"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "रघुकुल - मणि - महिमा मुखरित ॥८६॥"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "है साम्य - नीति के द्वारा ।"
    },
    {
      "id": "b_364",
      "type": "p",
      "text": "सारा - साम्राज्य - सुशासित ।।"
    },
    {
      "id": "b_365",
      "type": "p",
      "text": "लोकाराधन - मंत्रों से।"
    },
    {
      "id": "b_366",
      "type": "p",
      "text": "हैं जन - पद् परम - प्रभावित ॥८७||"
    },
    {
      "id": "b_367",
      "type": "p",
      "text": "पर कही कही अब भी है।"
    },
    {
      "id": "b_368",
      "type": "p",
      "text": "कुछ हलचल पाई जाती ॥"
    },
    {
      "id": "b_369",
      "type": "p",
      "text": "उत्पात मचा देते हैं।"
    },
    {
      "id": "b_370",
      "type": "p",
      "text": "अब भी कतिपय उत्पाती ।।८८॥"
    },
    {
      "id": "b_371",
      "type": "p",
      "text": "१२\n१७८  वैदेही-वनवास"
    },
    {
      "id": "b_372",
      "type": "p",
      "text": "सिरधरा उन सबों का है।"
    },
    {
      "id": "b_373",
      "type": "p",
      "text": "पाषाण - हृदय - लवणासुर ॥"
    },
    {
      "id": "b_374",
      "type": "p",
      "text": "जिसने विध्वंस किये हैं।"
    },
    {
      "id": "b_375",
      "type": "p",
      "text": "बहु ग्राम बड़े - सुन्दर - पुर ।।८९॥"
    },
    {
      "id": "b_376",
      "type": "p",
      "text": "उसके वध की ही आज्ञा ।"
    },
    {
      "id": "b_377",
      "type": "p",
      "text": "प्रभुवर ने मुझको दी है।"
    },
    {
      "id": "b_378",
      "type": "p",
      "text": "साथ ही उन्होंने मुझसे ।"
    },
    {
      "id": "b_379",
      "type": "p",
      "text": "यह निश्चित बात कही है॥९०॥"
    },
    {
      "id": "b_380",
      "type": "p",
      "text": "केवल उसका हो वध हो।"
    },
    {
      "id": "b_381",
      "type": "p",
      "text": "कुछ ऐसा कौशल करना।"
    },
    {
      "id": "b_382",
      "type": "p",
      "text": "लोहा दानव से लेना।"
    },
    {
      "id": "b_383",
      "type": "p",
      "text": "भू को न लहू से भरना ।।९१॥"
    },
    {
      "id": "b_384",
      "type": "p",
      "text": "आज्ञानुसार कौशल से।"
    },
    {
      "id": "b_385",
      "type": "p",
      "text": "मैं सारे कार्य करूँगा।"
    },
    {
      "id": "b_386",
      "type": "p",
      "text": "भव के कंटक का वध कर।"
    },
    {
      "id": "b_387",
      "type": "p",
      "text": "भूतल का भार हरूँगा ॥९२।।"
    },
    {
      "id": "b_388",
      "type": "p",
      "text": "हो गया आपका दर्शन ।"
    },
    {
      "id": "b_389",
      "type": "p",
      "text": "आशिष महर्षि से पाई ॥"
    },
    {
      "id": "b_390",
      "type": "p",
      "text": "होगी सफला यह यात्रा।"
    },
    {
      "id": "b_391",
      "type": "p",
      "text": "भू में भर भूरि - भलाई ॥१३॥"
    },
    {
      "id": "b_392",
      "type": "p",
      "text": "१७९  एकादश सर्ग"
    },
    {
      "id": "b_393",
      "type": "p",
      "text": "रिपुसूदन की वातें सुन ।"
    },
    {
      "id": "b_394",
      "type": "p",
      "text": "जी कभी बहुत घबराया॥"
    },
    {
      "id": "b_395",
      "type": "p",
      "text": "या कभी जनक - तनया के ।"
    },
    {
      "id": "b_396",
      "type": "p",
      "text": "आँखों में आंसू आया ॥९४।।"
    },
    {
      "id": "b_397",
      "type": "p",
      "text": "'पर वारम्बार उन्होंने ।"
    },
    {
      "id": "b_398",
      "type": "p",
      "text": "अपने को बहुत सँभाला ॥"
    },
    {
      "id": "b_399",
      "type": "p",
      "text": "धीरज - धर थाम कलेजा।"
    },
    {
      "id": "b_400",
      "type": "p",
      "text": "सब बातों को सुन डाला ॥९५॥"
    },
    {
      "id": "b_401",
      "type": "p",
      "text": "फिर कहा कुँवर - वर जाओ।"
    },
    {
      "id": "b_402",
      "type": "p",
      "text": "यात्रा हो सफल तुम्हारी ॥"
    },
    {
      "id": "b_403",
      "type": "p",
      "text": "पुरहूत का प्रवल - पवि ही।"
    },
    {
      "id": "b_404",
      "type": "p",
      "text": "है पर्वत - गर्व - प्रहारी ॥९६।।"
    },
    {
      "id": "b_405",
      "type": "p",
      "text": "है विनय यही विभुवर से।"
    },
    {
      "id": "b_406",
      "type": "p",
      "text": "हो प्रियतम सुयश सवाया ॥"
    },
    {
      "id": "b_407",
      "type": "p",
      "text": "वसुधा निमित्त बन जाये।"
    },
    {
      "id": "b_408",
      "type": "p",
      "text": "तव विजय कल्पतरुकाया ।।९७॥"
    },
    {
      "id": "b_409",
      "type": "p",
      "text": "दोहा"
    },
    {
      "id": "b_410",
      "type": "p",
      "text": "पग वन्दन कर ले विदा गये दनुजकुल काल ।"
    },
    {
      "id": "b_411",
      "type": "p",
      "text": "इसी दिवस सिय ने जने युगल - अलौकिक-लाल ॥९८।।"
    }
  ]
}