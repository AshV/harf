    },
    {
      "id": "b_29",
      "type": "p",
      "text": "सिकन्दर का सत्रप"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "मौर्य्य-सेनापति—"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "चन्द्रगुप्त का पिता"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "एनोसाक्रीटीज—"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "सिकन्दर का सहचर"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "देवबल"
    },
    {
