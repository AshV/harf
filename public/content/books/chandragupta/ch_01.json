    },
    {
      "id": "b_45",
      "type": "p",
      "text": "दाण्ड्यायन—"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "एक तपस्वी"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "स्त्री-पात्र"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "अलका—"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "तक्षशिला की राजकुमारी"
    },
    {
      "id": "b_50",
