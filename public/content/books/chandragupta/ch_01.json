{
  "book_id": "chandragupta",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "भूमिका एवं पात्र-परिचय",
  "word_count": 60,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "} — मालव गण-तन्त्र के पदाधिकारी"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "नागदत्त"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "गण-मुख्य"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "साइबर्टियस"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "} — यवन-दूत"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मेगास्थनीज"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "गान्धार-नरेश— आम्भीक का पिता"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सिल्यूकस— सिकन्दर का सेनापति"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "दाण्ड्यायन— एक तपस्वी स्त्री-पात्र"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अलका— तक्षशिला की राजकुमारी"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "सुवासिनी— शकटार की कन्या"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कल्याणी— मगध-राजकुमारी"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नीला"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "} — कल्याणी की सहेलिया"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "लीला"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "मालविका— सिन्धु देश की कुमारी"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कार्नेलिया— सिल्यूकस की कन्या"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "मौर्य्य-पत्नी— चन्द्रगुप्त की माता"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "एलिस— कार्नेलिया की सहेली"
    }
  ]
}