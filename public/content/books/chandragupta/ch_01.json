    },
    {
      "id": "b_15",
      "type": "p",
      "text": "मगध का अमात्य"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "वररुचि (कात्यायन)—"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "मगध का अमात्य"
    },
    {
      "id": "b_18",
      "type": "p",
