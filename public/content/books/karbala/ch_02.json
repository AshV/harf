{
  "book_id": "karbala",
  "chapter_id": "ch_02",
  "number": 2,
  "title": "नाटक के पात्र (पात्र-परिचय)",
  "word_count": 163,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "नाटक का कथानक|नाटक का कथानक"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कर्बला    (1924)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "द्वारा     प्रेमचंद        पहला अंक   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "नाटक के पात्र"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "पुरुष"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "हुसैन-हज़रत अली के बेटे और हज़रत मोहम्मद के नवासे । इन्हें"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "फ़र्ज़न्दे-रसूल,शब्बीर,भी कहा गया है।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अब्बास-हज़रत हुसैन के चचेरे भाई ।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अली अकबर-हजरत हुसैन के बड़े बेटे ।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अली असगर-हजरत हुसैन के छोटे बेटे ।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "मुस्लिम-हज़रत हुसैन के चचेरे भाई ।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जुबेर-मक्का का एक रईस ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "वलीद-मदीना का नाज़िम ।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मरवान-वलीन का सहायक अधिकारी ।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "हानी-कूफ़ा का एक रईस ।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "यजीद-खलीफा ।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "नुहाक,शम्स,सरजन रूमी-यजीद के मुसाहिन ।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "जियाद-बसरे और कू के का नाज़िम ।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "साद-यज़ीद की सेना का सेनापति ।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अब्दुल्लाह,वहब,कसीर,मुख्तार,हुर,जहीर,हबीब आदि हजरत हुसैन"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "के सहायक ।          ( २८ )"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "हज्जाज, हारिस, अशअस, कीसे, वलाल आदि यज़ीद के सहायक ।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "साहसराय-अरब-निवासी एक हिन्दू ।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "मुआबिया-यज़ीद का बेटा ।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "स्त्रियाँ"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "जैनब-हुसैन की बहन ।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "शहरबानू-हुसैन की स्त्री।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "सकीना-हुसैन की बेटी।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "क़मर-अब्दुल्लाह की स्त्री।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "तौबा-फा की एक वृद्धा स्त्री।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "हिन्दा-यजीद की बेगम ।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "क़ासिद-सिपाही, जल्लाद आदि ।"
    }
  ]
}