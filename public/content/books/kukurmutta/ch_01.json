{
  "book_id": "kukurmutta",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "कुकुरमुत्ता",
  "word_count": 2234,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "एक थे नव्वाब,"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "फ़ारस से मंगाए थे गुलाब।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "बड़ी बाड़ी में लगाए"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "देशी पौधे भी उगाए"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "रखे माली, कई नौकर"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "गजनवी का बाग मनहर"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "लग रहा था।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "एक सपना जग रहा था"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सांस पर तहजबी की,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "गोद पर तरतीब की।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "क्यारियां सुन्दर बनी"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "चमन में फैली घनी।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "फूलों के पौधे वहाँ"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "लग रहे थे खुशनुमा।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "बेला, गुलशब्बो, चमेली, कामिनी,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "जूही, नरगिस, रातरानी, कमलिनी,"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "चम्पा, गुलमेंहदी, गुलखैरू, गुलअब्बास,"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "गेंदा, गुलदाऊदी, निवाड़, गन्धराज,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "और किरने फ़ूल, फ़व्वारे कई,"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "रंग अनेकों-सुर्ख, धनी, चम्पई,"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "आसमानी, सब्ज, फ़िरोज सफ़ेद,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "जर्द, बादामी, बसन्त, सभी भेद।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "फ़लों के भी पेड़ थे,"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "आम, लीची, सन्तरे और फ़ालसे।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "चटकती कलियां, निकलती मृदुल गन्ध,"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "लगे लगकर हवा चलती मन्द-मन्द,"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "चहकती बुलबुल, मचलती टहनियां,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "बाग चिड़ियों का बना था आशियाँ।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "साफ़ राह, सरा दानों ओर,"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "दूर तक फैले हुए कुल छोर,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "बीच में आरामगाह"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "दे रही थी बड़प्पन की थाह।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "कहीं झरने, कहीं छोटी-सी पहाड़ी,"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "कही सुथरा चमन, नकली कहीं झाड़ी।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "आया मौसिम, खिला फ़ारस का गुलाब,"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "बाग पर उसका पड़ा था रोब-ओ-दाब;"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "वहीं गन्दे में उगा देता हुआ बुत्ता"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "पहाड़ी से उठे-सर ऐंठकर बोला कुकुरमुत्ता-"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "“अब, सुन बे, गुलाब,"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "भूल मत जो पायी खुशबु, रंग-ओ-आब,"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "खून चूसा खाद का तूने अशिष्ट,"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "डाल पर इतरा रहा है केपीटलिस्ट!"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "कितनों को तूने बनाया है गुलाम,"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "माली कर रक्खा, सहाया जाड़ा-घाम,"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "हाथ जिसके तू लगा,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "पैर सर रखकर वो पीछे को भागा"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "औरत की जानिब मैदान यह छोड़कर,"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "तबेले को टट्टू जैसे तोड़कर,"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "शाहों, राजों, अमीरों का रहा प्यारा"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "तभी साधारणों से तू रहा न्यारा।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "वरना क्या तेरी हस्ती है, पोच तू"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "कांटो ही से भरा है यह सोच तू"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "कली जो चटकी अभी"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "सूखकर कांटा हुई होती कभी।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "रोज पड़ता रहा पानी,"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "तू हरामी खानदानी।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "चाहिए तुझको सदा मेहरून्निसा"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "जो निकाले इत्र, रू, ऐसी दिशा"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "बहाकर ले चले लोगो को, नही कोई किनारा"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "जहाँ अपना नहीं कोई भी सहारा"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "ख्वाब में डूबा चमकता हो सितारा"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "पेट में डंड पेले हों चूहे, जबां पर लफ़्ज प्यारा।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "देख मुझको, मैं बढ़ा"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "डेढ़ बालिश्त और ऊंचे पर चढ़ा"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "और अपने से उगा मैं"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "बिना दाने का चुगा मैं"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "कलम मेरा नही लगता"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "मेरा जीवन आप जगता"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "तू है नकली, मै हूँ मौलिक"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "तू है बकरा, मै हूँ कौलिक"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "तू रंगा और मैं धुला"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "पानी मैं, तू बुलबुला"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "तूने दुनिया को बिगाड़ा"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "मैंने गिरते से उभाड़ा"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "तूने रोटी छीन ली जनखा बनाकर"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "एक की दी तीन मैने गुन सुनाकर।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "काम मुझ ही से सधा है"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "शेर भी मुझसे गधा है"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "चीन में मेरी नकल, छाता बना"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "छत्र भारत का वही, कैसा तना"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "सब जगह तू देख ले"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "आज का फिर रूप पैराशूट ले।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "विष्णु का मैं ही सुदर्शनचक्र हूँ।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "काम दुनिया मे पड़ा ज्यों, वक्र हूँ।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "उलट दे, मैं ही जसोदा की मथानी"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "और लम्बी कहानी-"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "सामने लाकर मुझे बेंड़ा"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "देख कैंडा"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "तीर से खींचा धनुष मैं राम का।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "काम का-"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "पड़ा कन्धे पर हूँ हल बलराम का।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "सुबह का सूरज हूँ मैं ही"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "चांद मैं ही शाम का।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "कलजुगी मैं ढाल"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "नाव का मैं तला नीचे और ऊपर पाल।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "मैं ही डांड़ी से लगा पल्ला"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "सारी दुनिया तोलती गल्ला"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "मुझसे मूछें, मुझसे कल्ला"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "मेरे उल्लू, मेरे लल्ला"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "कहे रूपया या अधन्ना"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "हो बनारस या न्यवन्ना"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "रूप मेरा, मै चमकता"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "गोला मेरा ही बमकता।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "लगाता हूँ पार मैं ही"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "डुबाता मझधार मैं ही।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "डब्बे का मैं ही नमूना"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "पान मैं ही, मैं ही चूना"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "मैं कुकुरमुत्ता हूँ,"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "पर बेन्जाइन (Bengoin) वैसे"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "बने दर्शनशास्त्र जैसे।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "ओमफ़लस (Omphalos) और ब्रहमावर्त"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "वैसे ही दुनिया के गोले और पर्त"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "जैसे सिकुड़न और साड़ी,"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "ज्यों सफ़ाई और माड़ी।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "कास्मोपालिटन और मेट्रोपालिटन"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "जैसे फ़्रायड और लीटन।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "फ़ेलसी और फ़लसफ़ा"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "जरूरत और हो रफ़ा।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "सरसता में फ़्राड"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "केपिटल में जैसे लेनिनग्राड।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "सच समझ जैसे रकीब"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "लेखकों में लण्ठ जैसे खुशनसीब"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "मैं डबल जब, बना डमरू"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "इकबगल, तब बना वीणा।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "मन्द्र होकर कभी निकला"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "कभी बनकर ध्वनि छीणा।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "मैं पुरूष और मैं ही अबला।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "मै मृदंग और मैं ही तबला।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "चुन्ने खां के हाथ का मैं ही सितार"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "दिगम्बर का तानपूरा, हसीना का सुरबहार।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "मैं ही लायर, लिरिक मुझसे ही बने"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "संस्कृत, फ़ारसी, अरबी, ग्रीक, लैटिन के जने"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "मन्त्र, गज़लें, गीत, मुझसे ही हुए शैदा"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "जीते है, फिर मरते है, फिर होते है पैदा।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "वायलिन मुझसे बजा"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "बेन्जो मुझसे सजा।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "घण्टा, घण्टी, ढोल, डफ़, घड़ियाल,"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "शंख, तुरही, मजीरे, करताल,"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "करनेट, क्लेरीअनेट, ड्रम, फ़्लूट, गीटर,"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "बजानेवाले हसन खां, बुद्धू, पीटर,"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "मानते हैं सब मुझे ये बायें से,"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "जानते हैं दाये से।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "ताताधिन्ना चलती है जितनी तरह"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "देख, सब में लगी है मेरी गिरह"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "नाच में यह मेरा ही जीवन खुला"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "पैरों से मैं ही तुला।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "कत्थक हो या कथकली या बालडान्स,"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "क्लियोपेट्रा, कमल-भौंरा, कोई रोमान्स"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "बहेलिया हो, मोर हो, मणिपुरी, गरबा,"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "पैर, माझा, हाथ, गरदन, भौंहें मटका"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "नाच अफ़्रीकन हो या यूरोपीयन,"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "सब में मेरी ही गढ़न।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "किसी भी तरह का हावभाव,"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "मेरा ही रहता है सबमें ताव।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "मैने बदलें पैंतरे,"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "जहां भी शासक लड़े।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "पर हैं प्रोलेटेरियन झगड़े जहां,"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "मियां-बीबी के, क्या कहना है वहां।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "नाचता है सूदखोर जहां कहीं ब्याज डुचता,"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "नाच मेरा क्लाईमेक्स को पहुचंता।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "नहीं मेरे हाड़, कांटे, काठ का"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "नहीं मेरा बदन आठोगांठ का।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "रस-ही-रस मैं हो रहा"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "सफ़ेदी का जहन्नम रोकर रहा।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "दुनिया में सबने मुझी से रस चुराया,"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "रस में मैं डूबा-उतराया।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "मुझी में गोते लगाये वाल्मीकि-व्यास ने"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "मुझी से पोथे निकाले भास-कालिदास ने।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "टुकुर-टुकुर देखा किये मेरे ही किनारे खड़े"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "हाफ़िज-रवीन्द्र जैसे विश्वकवि बड़े-बड़े।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "कहीं का रोड़ा, कही का पत्थर"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "टी.एस. एलीयट ने जैसे दे मारा"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "पढ़नेवाले ने भी जिगर पर रखकर"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "हाथ, कहां,’लिख दिया जहां सारा’।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "ज्यादा देखने को आंख दबाकर"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "शाम को किसी ने जैसे देखा तारा।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "जैसे प्रोग्रेसीव का कलम लेते ही"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "रोका नहीं रूकता जोश का पारा"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "यहीं से यह कुल हुआ"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "जैसे अम्मा से बुआ।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "मेरी सूरत के नमूने पीरामेड"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "मेरा चेला था यूक्लीड।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "रामेश्वर, मीनाछी, भुवनेश्वर,"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "जगन्नाथ, जितने मन्दिर सुन्दर"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "मैं ही सबका जनक"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "जेवर जैसे कनक।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "हो कुतुबमीनार,"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "ताज, आगरा या फ़ोर्ट चुनार,"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "विक्टोरिया मेमोरियल, कलकत्ता,"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "मस्जिद, बगदाद, जुम्मा, अलबत्ता"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "सेन्ट पीटर्स गिरजा हो या घण्टाघर,"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "गुम्बदों में, गढ़न में मेरी मुहर।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "एरियन हो, पर्शियन या गाथिक आर्च"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "पड़ती है मेरी ही टार्च।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "पहले के हो, बीच के हो या आज के"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "चेहरे से पिद्दी के हों या बाज के।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "चीन के फ़ारस के या जापान के"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "अमरिका के, रूस के, इटली के, इंगलिस्तान के।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "ईंट के, पत्थर के हों या लकड़ी के"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "कहीं की भी मकड़ी के।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "बुने जाले जैसे मकां कुल मेरे"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "छत्ते के हैं घेरे।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "सर सभी का फ़ांसनेवाला हूं ट्रेप"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "टर्की टोपी, दुपलिया या किश्ती-केप।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "और जितने, लगा जिनमें स्ट्रा या मेट,"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "देख, मेरी नक्ल है अंगरेजी हेट।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "घूमता हूं सर चढ़ा,"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "तू नहीं, मैं ही बड़ा।”"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "बाग के बाहर पड़े थे झोपड़े"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "दूर से जो देख रहे थे अधगड़े।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "जगह गन्दी, रूका, सड़ता हुआ पानी"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "मोरियों मे; जिन्दगी की लन्तरानी-"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "बिलबिलाते किड़े, बिखरी हड्डियां"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "सेलरों की, परों की थी गड्डियां"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "कहीं मुर्गी, कही अण्डे,"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "धूप खाते हुए कण्डे।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "हवा बदबू से मिली"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "हर तरह की बासीली पड़ी गयी।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "रहते थे नव्वाब के खादिम"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "अफ़्रिका के आदमी आदिम-"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "खानसामां, बावर्ची और चोबदार;"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "सिपाही, साईस, भिश्ती, घुड़सवार,"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "तामजानवाले कुछ देशी कहार,"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "नाई, धोबी, तेली, तम्बोली, कुम्हार,"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "फ़ीलवान, ऊंटवान, गाड़ीवान"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "एक खासा हिन्दु-मुस्लिम खानदान।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "एक ही रस्सी से किस्मत की बंधा"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "काटता था जिन्दगी गिरता-सधा।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "बच्चे, बुड्ढे, औरते और नौजवान"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "रह्ते थे उस बस्ती में, कुछ बागबान"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "पेट के मारे वहां पर आ बसे"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "साथ उनके रहे, रोये और हंसे।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "एक मालिन"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "बीबी मोना माली की थी बंगालिन;"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "लड़की उसकी, नाम गोली"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "वह नव्वाबजादी की थी हमजोली।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "नाम था नव्वाबजादी का बहार"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "नजरों में सारा जहां फ़र्माबरदार।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "सारंगी जैसी चढ़ी"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "पोएट्री में बोलती थी"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "प्रोज में बिल्कुल अड़ी।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "गोली की मां बंगालिन, बहुत शिष्ट"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "पोयट्री की स्पेशलिस्ट।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "बातों जैसे मजती थी"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "सारंगी वह बजती थी।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "सुनकर राग, सरगम तान"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "खिलती थी बहार की जान।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "गोली की मां सोचती थी-"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "गुर मिला,"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "बिना पकड़े खिचे कान"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "देखादेखी बोली में"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "मां की अदा सीखी नन्हीं गोली ने।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "इसलिए बहार वहां बारहोमास"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "डटी रही गोली की मां के"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "कभी गोली के पास।"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "सुबहो-शाम दोनों वक्त जाती थी"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "खुशामद से तनतनाई आती थी।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "गोली डांडी पर पासंगवाली कौड़ी"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "स्टीमबोट की डोंगी, फ़िरती दौड़ी।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "पर कहेंगे-"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "‘साथ-ही-साथ वहां दोनो रहती थीं"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "अपनी-अपनी कहती थी।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "दोनों के दिल मिले थे"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "तारे खुले-खिले थे।"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "हाथ पकड़े घूमती थीं"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "खिलखिलाती झूमती थीं।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "इक पर इक करती थीं चोट"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "हंसकर होतीं लोटपोट।"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "सात का दोनों का सिन"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "खुशी से कटते थे दिन।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "महल में भी गोली जाया करती थी"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "जैसे यहां बहार आया करती थी।"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "एक दिन हंसकर बहार यह बोली-"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "“चलो, बाग घूम आयें हम, गोली।”"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "दोनों चली, जैसे धूप, और छांह"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "गोली के गले पड़ी बहार की बांह।"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "साथ टेरियर और एक नौकरानी।"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "सामने कुछ औरतें भरती थीं पानी"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "सिटपिटायी जैसे अड़गड़े मे देखा मर्द को"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "बाबू ने देखा हो उठती गर्दन को।"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "निकल जाने पर बहार के, बोली"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "पहली दूसरी से, “देखो, वह गोली"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "मोना बंगाली की लड़की ।"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "भैंस भड़्की,"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "ऎसी उसकी मां की सूरत"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "मगर है नव्वाब की आंखों मे मूरत।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "रोज जाती है महल को, जगे भाग"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "आखं का जब उतरा पानी, लगे आग,"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "रोज ढोया आ रहा है माल-असबाब"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "बन रहे हैं गहने-जेवर"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "पकता है कलिया-कबाब।”"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "झटके से सिर-आंख पर फ़िर लिये घड़े"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "चली ठनकाती कड़े।"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "बाग में आयी बहार"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "चम्पे की लम्बी कतार"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "देखती बढ़्ती गयी"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "फ़ूल पर अड़ती गयी।"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "मौलसिरी की छांह में"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "कुछ देर बैठ बेन्च पर"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "फ़िर निगाह डाली एक रेन्ज पर"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "देखा फ़िर कुछ उड़ रही थी तितलियां"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "डालों पर, कितनी चहकती थीं चिड़ियां।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "भौरें गूंजते, हुए मतवाले-से"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "उड़ गया इक मकड़ी के फ़ंसकर बड़े-से जाले से।"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "फ़िर निगाह उठायी आसमान की ओर"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "देखती रही कि कितनी दूर तक छोर"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "देखा, उठ रही थी धूप-"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "पड़ती फ़ुनगियों पर, चमचमाया रूप।"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "पेड़ जैसे शाह इक-से-इक बड़े"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "ताज पहने, है खड़े।"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "आया माली, हाथ गुलदस्ते लिये"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "गुलबहार को दिये।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "गोली को इक गुलदस्ता"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "सूंघकर हंसकर बहार ने दिया।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "जरा बैठकर उठी, तिरछी गली"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "होती कुन्ज को चली!"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "देखी फ़ारांसीसी लिली"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "और गुलबकावली।"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "फ़िर गुलाबजामुन का बाग छोड़ा"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "तूतो के पेड़ो से बायें मुंह मोड़ा।"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "एक बगल की झाड़ी"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "बढ़ी जिधर थी बड़ी गुलाबबाड़ी।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "देखा, खिल रहे थे बड़े-बड़े फ़ूल"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "लहराया जी का सागर अकूल।"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "दुम हिलाता भागा टेरियर कुत्ता"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "जैसे दौड़ी गोली चिल्लाती हुई ‘कुकुरमुत्ता’।"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "सकपकायी, बहार देखने लगी"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "जैसे कुकुरमुत्ते के प्रेम से भरी गोली दगी।"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "भूल गयी, उसका था गुलाब पर जो कुछ भी प्यार"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "सिर्फ़ वह गोली को देखती रही निगाह की धार।"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "टूटी गोली जैसे बिल्ली देखकर अपना शिकार"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "तोड़कर कुकुरमुत्तों को होती थी उनके निसार।"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "बहुत उगे थे तब तक"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "उसने कुल अपने आंचल में"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "तोड़कर रखे अब तक।"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "घूमी प्यार से"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "मुसकराती देखकर बोली बहार से-"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "“देखो जी भरकर गुलाब"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "हम खायंगे कुकुरमुत्ते का कबाब।”"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "कुकुरमुत्ते की कहानी"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "सुनी उससे जीभ में बहार की आया पानी।"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "पूछा “क्या इसका कबाब"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "होगा ऎसा भी लजीज?"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "जितनी भाजियां दुनिया में"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "इसके सामने नाचीज?”"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "गोली बोली-”जैसी खुशबू"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "इसका वैसा ही स्वाद,"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "खाते खाते हर एक को"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "आ जाती है बिहिश्त की याद"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "सच समझ लो, इसका कलिया"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "तेल का भूना कबाब,"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "भाजियों में वैसा"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "जैसा आदमियों मे नव्वाब”"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "“नहीं ऎसा कहते री मालिन की"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "छोकड़ी बंगालिन की!”"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "डांटा नौकरानी ने-"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "चढ़ी-आंख कानी ने।"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "लेकिन यह, कुछ एक घूंट लार के"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "जा चुके थे पेट में तब तक बहार के।"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "“नहीं नही, अगर इसको कुछ कहा”"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "पलटकर बहार ने उसे डांटा-"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "“कुकुरमुत्ते का कबाब खाना है,"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "इसके साथ यहां जाना है।”"
    },
    {
      "id": "b_364",
      "type": "p",
      "text": "“बता, गोली” पूछा उसने,"
    },
    {
      "id": "b_365",
      "type": "p",
      "text": "“कुकुरमुत्ते का कबाब"
    },
    {
      "id": "b_366",
      "type": "p",
      "text": "वैसी खुशबु देता है"
    },
    {
      "id": "b_367",
      "type": "p",
      "text": "जैसी कि देता है गुलाब!”"
    },
    {
      "id": "b_368",
      "type": "p",
      "text": "गोली ने बनाया मुंह"
    },
    {
      "id": "b_369",
      "type": "p",
      "text": "बाये घूमकर फ़िर एक छोटी-सी निकाली “उंह!”"
    },
    {
      "id": "b_370",
      "type": "p",
      "text": "कहा,”बकरा हो या दुम्बा"
    },
    {
      "id": "b_371",
      "type": "p",
      "text": "मुर्ग या कोई परिन्दा"
    },
    {
      "id": "b_372",
      "type": "p",
      "text": "इसके सामने सब छू:"
    },
    {
      "id": "b_373",
      "type": "p",
      "text": "सबसे बढ़कर इसकी खुशबु।"
    },
    {
      "id": "b_374",
      "type": "p",
      "text": "भरता है गुलाब पानी"
    },
    {
      "id": "b_375",
      "type": "p",
      "text": "इसके आगे मरती है इन सबकी नानी।”"
    },
    {
      "id": "b_376",
      "type": "p",
      "text": "चाव से गोली चली"
    },
    {
      "id": "b_377",
      "type": "p",
      "text": "बहार उसके पीछे हो ली,"
    },
    {
      "id": "b_378",
      "type": "p",
      "text": "उसके पीछे टेरियर, फ़िर नौकरानी"
    },
    {
      "id": "b_379",
      "type": "p",
      "text": "पोंछती जो आंख कानी।"
    },
    {
      "id": "b_380",
      "type": "p",
      "text": "चली गोली आगे जैसे डिक्टेटर"
    },
    {
      "id": "b_381",
      "type": "p",
      "text": "बहार उसके पीछे जैसे भुक्खड़ फ़ालोवर।"
    },
    {
      "id": "b_382",
      "type": "p",
      "text": "उसके पीछे दुम हिलाता टेरियर-"
    },
    {
      "id": "b_383",
      "type": "p",
      "text": "आधुनिक पोयेट (Poet)"
    },
    {
      "id": "b_384",
      "type": "p",
      "text": "पीछे बांदी बचत की सोचती"
    },
    {
      "id": "b_385",
      "type": "p",
      "text": "केपीटलिस्ट क्वेट।"
    },
    {
      "id": "b_386",
      "type": "p",
      "text": "झोपड़ी में जल्दी चलकर गोली आयी"
    },
    {
      "id": "b_387",
      "type": "p",
      "text": "जोर से ‘मां’ चिल्लायी।"
    },
    {
      "id": "b_388",
      "type": "p",
      "text": "मां ने दरवाजा खोला,"
    },
    {
      "id": "b_389",
      "type": "p",
      "text": "आंखो से सबको तोला।"
    },
    {
      "id": "b_390",
      "type": "p",
      "text": "भीतर आ डलिये मे रक्खे"
    },
    {
      "id": "b_391",
      "type": "p",
      "text": "मोली ने वे कुकुरमुत्ते।"
    },
    {
      "id": "b_392",
      "type": "p",
      "text": "देखकर मां खिल गयी।"
    },
    {
      "id": "b_393",
      "type": "p",
      "text": "निधि जैसे मिल गयी।"
    },
    {
      "id": "b_394",
      "type": "p",
      "text": "कहा गोली ने, “अम्मा,"
    },
    {
      "id": "b_395",
      "type": "p",
      "text": "कलिया-कबाब जल्द बना।"
    },
    {
      "id": "b_396",
      "type": "p",
      "text": "पकाना मसालेदार"
    },
    {
      "id": "b_397",
      "type": "p",
      "text": "अच्छा, खायेंगी बहार।"
    },
    {
      "id": "b_398",
      "type": "p",
      "text": "पतली-पतली चपातियां"
    },
    {
      "id": "b_399",
      "type": "p",
      "text": "उनके लिए सेख लेना।”"
    },
    {
      "id": "b_400",
      "type": "p",
      "text": "जला ज्यों ही उधर चूल्हा,"
    },
    {
      "id": "b_401",
      "type": "p",
      "text": "खेलने लगीं दोनों दुल्हन-दूल्हा।"
    },
    {
      "id": "b_402",
      "type": "p",
      "text": "कोठरी में अलग चलकर"
    },
    {
      "id": "b_403",
      "type": "p",
      "text": "बांदी की कानी को छलकर।"
    },
    {
      "id": "b_404",
      "type": "p",
      "text": "टेरियर था बराती"
    },
    {
      "id": "b_405",
      "type": "p",
      "text": "आज का गोली का साथ।"
    },
    {
      "id": "b_406",
      "type": "p",
      "text": "हो गयी शादी कि फ़िर दूल्हन-बहार से।"
    },
    {
      "id": "b_407",
      "type": "p",
      "text": "दूल्हा-गोली बातें करने लगी प्यार से।"
    },
    {
      "id": "b_408",
      "type": "p",
      "text": "इस तरह कुछ वक्त बीता, खाना तैयार"
    },
    {
      "id": "b_409",
      "type": "p",
      "text": "हो गया, खाने चलीं गोली और बहार।"
    },
    {
      "id": "b_410",
      "type": "p",
      "text": "कैसे कहें भाव जो मां की आंखो से बरसे"
    },
    {
      "id": "b_411",
      "type": "p",
      "text": "थाली लगायी बड़े समादर से।"
    },
    {
      "id": "b_412",
      "type": "p",
      "text": "खाते ही बहार ने यह फ़रमाया,"
    },
    {
      "id": "b_413",
      "type": "p",
      "text": "“ऎसा खाना आज तक नही खाया”"
    },
    {
      "id": "b_414",
      "type": "p",
      "text": "शौक से लेकर सवाद"
    },
    {
      "id": "b_415",
      "type": "p",
      "text": "खाती रहीं दोनो"
    },
    {
      "id": "b_416",
      "type": "p",
      "text": "कुकुरमुत्ते का कलिया-कबाब।"
    },
    {
      "id": "b_417",
      "type": "p",
      "text": "बांदी को भी थोड़ा-सा"
    },
    {
      "id": "b_418",
      "type": "p",
      "text": "गोली की मां ने कबाब परोसा।"
    },
    {
      "id": "b_419",
      "type": "p",
      "text": "अच्छा लगा, थोड़ा-सा कलिया भी"
    },
    {
      "id": "b_420",
      "type": "p",
      "text": "बाद को ला दिया,"
    },
    {
      "id": "b_421",
      "type": "p",
      "text": "हाथ धुलाकर देकर पान उसको बिदा किया।"
    },
    {
      "id": "b_422",
      "type": "p",
      "text": "कुकुरमुत्ते की कहानी"
    },
    {
      "id": "b_423",
      "type": "p",
      "text": "सुनी जब बहार से"
    },
    {
      "id": "b_424",
      "type": "p",
      "text": "नव्वाब के मुंह आया पानी।"
    },
    {
      "id": "b_425",
      "type": "p",
      "text": "बांदी से की पूछताछ,"
    },
    {
      "id": "b_426",
      "type": "p",
      "text": "उनको हो गया विश्वास।"
    },
    {
      "id": "b_427",
      "type": "p",
      "text": "माली को बुला भेजा,"
    },
    {
      "id": "b_428",
      "type": "p",
      "text": "कहा,”कुकुरमुत्ता चलकर ले आ तू ताजा-ताजा।”"
    },
    {
      "id": "b_429",
      "type": "p",
      "text": "माली ने कहा,”हुजूर,"
    },
    {
      "id": "b_430",
      "type": "p",
      "text": "कुकुरमुत्ता अब नहीं रहा है, अर्ज हो मन्जूर,"
    },
    {
      "id": "b_431",
      "type": "p",
      "text": "रहे है अब सिर्फ़ गुलाब।”"
    },
    {
      "id": "b_432",
      "type": "p",
      "text": "गुस्सा आया, कांपने लगे नव्वाब।"
    },
    {
      "id": "b_433",
      "type": "p",
      "text": "बोले;”चल, गुलाब जहां थे, उगा,"
    },
    {
      "id": "b_434",
      "type": "p",
      "text": "सबके साथ हम भी चाहते है अब कुकुरमुत्ता।”"
    },
    {
      "id": "b_435",
      "type": "p",
      "text": "बोला माली,”फ़रमाएं मआफ़ खता,"
    },
    {
      "id": "b_436",
      "type": "p",
      "text": "कुकुरमुत्ता अब उगाया नहीं उगता।”"
    }
  ]
}