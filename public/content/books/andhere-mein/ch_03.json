{
  "book_id": "andhere-mein",
  "chapter_id": "ch_03",
  "number": 3,
  "title": "भाग ३",
  "word_count": 798,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "समझ न पाया कि चल रहा स्वप्न या"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "जाग्रति शुरू है।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "दिया जल रहा है,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "पीतालोक-प्रसार में काल चल रहा है,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "आस-पास फैली हुई जग-आकृतियाँ"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "लगती हैं छपी हुई जड़ चित्रकृतियों-सी"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अलग व दूर-दूर"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "निर्जीव!!"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "यह सिविल लाइन्स है। मैं अपने कमरे में"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "यहाँ पड़ा हुआ हूँ"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "आँखें खुली हुई हैं,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "पीटे गये बालक-सा मार खाया चेहरा"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "उदास इकहरा,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "स्लेट-पट्टी पर खींची गयी तसवीर"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "भूत-जैसी आकृति--"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "क्या वह मैं हूँ"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "मैं हूँ?"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "रात के दो हैं,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "दूर-दूर जंगल में सियारों का हो-हो,"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "पास-पास आती हुई घहराती गूँजती"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "किसी रेल-गाड़ी के पहियों की आवाज़!!"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "किसी अनपेक्षित"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "असंभव घटना का भयानक संदेह,"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "अचेतन प्रतीक्षा,"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "कहीं कोई रेल-एक्सीडेण्ट न हो जाय।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "चिन्ता के गणित अंक"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "आसमानी-स्लेट-पट्टी पर चमकते"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "खिड़की से दीखते।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": ".........................."
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "हाय! हाय! तॉल्सतॉय"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "कैसे मुझे दीख गये"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "सितारों के बीच-बीच"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "घूमते व रुकते"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "पृथ्वी को देखते।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "शायद तॉल्सतॉय-नुमा"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "कोई वह आदमी"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "और है,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "मेरे किसी भीतरी धागे का आख़िरी छोर वह"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "अनलिखे मेरे उपन्यास का"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "केन्द्रीय संवेदन"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "दबी हाय-हाय-नुमा।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "शायद, तॉल्सतॉय-नुमा।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "प्रोसेशन?"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "निस्तब्ध नगर के मध्य-रात्रि-अँधेरे में सुनसान"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "किसी दूर बैण्ड की दबी हुई क्रमागत तान-धुन,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "मन्द-तार उच्च-निम्न स्वर-स्वप्न,"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "उदास-उदास ध्वनि-तरंगें हैं गम्भीर,"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "दीर्घ लहरियाँ!!"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "गैलरी में जाता हूँ, देखता हूँ रास्ता"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "वह कोलतार-पथ अथवा"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "मरी हुई खिंची हुई कोई काली जिह्वा"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "बिजली के द्युतिमान दिये या"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "मरे हुए दाँतों का चमकदार नमूना!!"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "किन्तु दूर सड़क के उस छोर"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "शीत-भरे थर्राते तारों के अँधियाले तल में"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "नील तेज-उद्भास"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "पास-पास पास-पास"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "आ रहा इस ओर!"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "दबी हुई गम्भीर स्वर-स्वप्न-तरंगें,"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "शत-ध्वनि-संगम-संगीत"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "उदास तान-धुन"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "समीप आ रहा!!"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "और, अब"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "गैस-लाइट-पाँतों की बिन्दुएँ छिटकीं,"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "बीचों-बीच उनके"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "साँवले जुलूस-सा क्या-कुछ दीखता!!"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "और अब"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "गैस-लाइट-निलाई में रँगे हुए अपार्थिव चेहरे,"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "बैण्ड-दल,"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "उनके पीछे काले-काले बलवान् घोड़ों का जत्था"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "दीखता,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "घना व डरावना अवचेतन ही"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "जुलूस में चलता।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "क्या शोभा-यात्रा"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "किसी मृत्यु दल की?"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "अजीब!!"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "दोनों ओर, नीली गैस-लाइट-पाँत"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "रही जल, रही जल।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "नींद में खोये हुए शहर की गहन अवचेतना में"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "हलचल, पाताली तल में"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "चमकदार साँपों की उड़ती हुई लगातार"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "लकीरों की वारदात!!"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "सब सोये हुए हैं।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "लेकिन, मैं जाग रहा, देख रहा"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "रोमांचकारी वह जादुई करामात!!"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "विचित्र  प्रोसेशन,"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "गम्भीर क्वीक मार्च...."
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "कलाबत्तूवाला काला ज़रीदार ड्रेस पहने"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "चमकदार बैण्ड-दल--"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "अस्थि-रूप, यकृत-स्वरूप, उदर-आकृति"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "आँतों के जाल से, बाजे वे दमकते हैं भयंकर"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "गम्भीर गीत-स्वप्न-तरंगें"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "उभारते रहते,"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "ध्वनियों के आवर्त मँडराते पथ पर।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "बैण्ड के लोगों के चेहरे"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "मिलते हैं मेरे देखे हुओं-से"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "लगता है उनमें कई प्रतिष्ठित पत्रकार"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "इसी नगर के!!"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "बड़े-बड़े नाम अरे कैसे शामिल हो गये इस बैण्ड-दल में!"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "उनके पीछे चल रहा"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "संगीत नोकों का चमकता जंगल,"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "चल रही पदचाप, ताल-बद्ध दीर्घ पाँत"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "टेंक-दल, मोर्टार, ऑर्टिलरी, सन्नद्ध,"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "धीरे-धीरे बढ़ रहा जुलूस भयावना,"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "सैनिकों के पथराये चेहरे"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "चिढ़े हुए, झुलसे हुए, बिगड़े हुए गहरे!"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "शायद, मैंने उन्हे पहले भी तो कहीं देखा था।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "शायद, उनमें कई परिचित!!"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "उनके पीछे यह क्या!!"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "कैवेलरी!"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "काले-काले घोड़ों पर ख़ाकी मिलिट्री ड्रेस,"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "चेहरे का आधा भाग सिन्दूरी-गेरुआ"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "आधा भाग कोलतारी भैरव,"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "आबदार!!"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "कन्धे से कमर तक कारतूसी बेल्ट है तिरछा।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "कमर में, चमड़े के कवर में पिस्तोल,"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "रोष-भरी एकाग्रदृष्टि में धार है,"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "कर्नल, बिग्रेडियर, जनरल, मॉर्शल"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "कई और सेनापति सेनाध्यक्ष"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "चेहरे वे मेरे जाने-बूझे से लगते,"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "उनके चित्र समाचारपत्रों में छपे थे,"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "उनके लेख देखे थे,"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "यहाँ तक कि कविताएँ पढ़ी थीं"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "भई वाह!"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "उनमें कई प्रकाण्ड आलोचक, विचारक जगमगाते कवि-गण"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "मन्त्री भी, उद्योगपति और विद्वान"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "यहाँ तक कि शहर का हत्यारा कुख्यात"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "डोमाजी उस्ताद"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "बनता है बलवन"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "हाय, हाय!!"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "यहाँ ये दीखते हैं भूत-पिशाच-काय।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "भीतर का राक्षसी स्वार्थ अब"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "साफ़ उभर आया है,"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "छिपे हुए उद्देश्य"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "यहाँ निखर आये हैं,"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "यह शोभायात्रा है किसी मृत-दल की।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "विचारों की फिरकी सिर में घूमती है"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "इतने में प्रोसेशन में से कुछ मेरी ओर"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "आँखें उठीं मेरी ओर-भर"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "हृदय में मानो कि संगीन नोंकें ही घुस पड़ीं बर्बर,"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "सड़क पर उठ खड़ा हो गया कोई शोर--"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "\"मारो गोली, दाग़ो स्साले को एकदम"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "दुनिया की नज़रों से हटकर"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "छिपे तरीक़े से"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "हम जा रहे थे कि"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "आधीरात--अँधेरे में उसने"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "देख लिया हमको"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "व जान गया वह सब"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "मार डालो, उसको खत्म करो एकदम\""
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "रास्ते पर भाग-दौड़ थका-पेल!!"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "गैलरी से भागा मैं पसीने से शराबोर!!"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "एकाएक टूट गया स्वप्न व छिन्न-भिन्न हो गये"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "सब चित्र"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "जागते में फिर से याद आने लगा वह स्वप्न,"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "फिर से याद आने लगे अँधेरे में चेहरे,"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "और, तब मुझे प्रतीत हुआ भयानक"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "गहन मृतात्माएँ इसी नगर की"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "हर रात जुलूस में चलतीं,"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "परन्तु दिन में"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "बैठती हैं मिलकर करती हुई षड्यंत्र"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "विभिन्न दफ़्तरों-कार्यालयों, केन्द्रों में, घरों में।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "हाय, हाय! मैंने उन्हे दैख लिया नंगा,"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "इसकी मुझे और सज़ा मिलेगी।"
    }
  ]
}