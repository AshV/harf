{
  "book_id": "andhere-mein",
  "chapter_id": "ch_06",
  "number": 6,
  "title": "भाग ६",
  "word_count": 2017,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सीन बदलता है"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "सुनसान चौराहा साँवला फैला,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "बीच में वीरान गेरूआ घण्टाघर,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "ऊपर कत्थई बुज़र्ग गुम्बद,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "साँवली हवाओं में काल टहलता है।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "रात में पीले हैं चार घड़ी-चेहरे,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "मिनिट के काँटों की चार अलग गतियाँ,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "चार अलग कोण,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कि चार अलग संकेत"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "(मनस् में गतिमान् चार अलग मतियाँ)"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "खम्भों पर बिजली की गरदनें लटकीं,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "शर्म से जलते हुए बल्बों के आस-पास"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "बेचैन ख़यालों के पंखों के कीड़े"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "उड़ते हैं गोल-गोल"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "मचल-मचलकर।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "घण्टाघर तले ही"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "पंखों के टुकड़े व तिनके।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "गुम्बद-विवर में बैठे हुए बूढ़े"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "असम्भव पक्षी"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "बहुत तेज़ नज़रों से देखते हैं सब ओर,"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "मानो कि इरादे"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "भयानक चमकते।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "सुनसान चौराहा"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "बिखरी हैं गतियाँ, बिखरी है रफ़्तार,"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "गश्त में घूमती है कोई दुष्ट इच्छा।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "भयानक सिपाही जाने किस थकी हुई झोंक में"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "अँधेरे में सुलगाता सिगरेट अचानक"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "ताँबे से चेहरे की ऐंठ झलकती।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "पथरीली सलवट"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "दियासलाई की पल-भर लौ में"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "साँप-सी लगती।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "पर उसके चेहरे का रंग बदलता है हर बार,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "मानो अनपेक्षित कहीं न कुछ हो..."
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "वह ताक रहा है--"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "संगीन नोंकों पर टिका हुआ"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "साँवला बन्दूक़-जत्था"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "गोल त्रिकोण एक बनाये खड़ा जो"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "चौक के बीच में!!"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "एक ओर"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "टैंकों का दस्ता भी खड़े-खड़े ऊँघता,"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "परन्तु अड़ा है!!"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "भागता मैं दम छोड़,"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "घूम गया कई मोड़"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "भागती है चप्पल, चटपट आवाज़"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "चाँटों-सी पड़ती।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "पैरों के नीचे का कींच उछलकर"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "चेहरे पर छाती पर, पड़ता है सहसा,"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "ग्लानि की मितली।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "गलियों का गोल-गोल खोह अँधेरा"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "चेहरे पर आँखों पर करता है हमला।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "अजीब उमस-बास"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "गलियों का रुँधा हुआ उच्छवास"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "भागता हूँ दम छोड़,"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "घूम गया कई मोड़।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "धुँधले-से आकार कहीं-कहीं दीखते,"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "भय के? या घर के? कह नहीं सकता"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "आता है अकस्मात् कोलतार-रास्ता"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "लम्बा व चौड़ा व स्याह व ठंडा,"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "बेचैन आँखें ये देखती हैं सब ओर।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "कहीं कोई नहीं है,"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "नहीं कहीं कोई भी।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "श्याम आकाश में, संकेत-भाषा-सी तारों की आँखें"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "चमचमा रही हैं।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "मेरा दिल ढिबरी-सा टिमटिमा रहा है।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "कोई मुझे खींचता है रास्ते के बीच ही।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "जादू से बँधा हुआ चल पड़ा उस ओर।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "सपाट सूने में ऊँची-सी खड़ी जो"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "तिलक की पाषाण-मूर्ति है निःसंग"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "स्तब्ध जड़ीभूत..."
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "देखता हूँ उसको परन्तु, ज्यों ही मैं पास पहुँचता"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "पाषाण-पीठिका हिलती-सी लगती"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "अरे, अरे यह क्या!!"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "कण-कण काँप रहे जिनमें-से झरते"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "नीले इलेक्ट्रान"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "सब ओर गिर रही हैं चिनगियाँ नीली"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "मूर्ति के तन से झरते हैं अंगार।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "मुस्कान पत्थरी होठों पर काँपी,"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "आँखों में बिजली के फूल सुलगते।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "इतने में यह क्या!!"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "भव्य ललाट की नासिका में से"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "बह रहा ख़ून न जाने कब से"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "लाल-लाल गरमीला रक्त टपकता"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "(ख़ून के धब्बों से भरा अँगरखा)"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "मानो कि अतिशय चिन्ता के कारण"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "मस्तक-कोष ही फूट पड़े सहसा"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "मस्तक-रक्त ही बह उठा नासिका में से।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "हाय, हाय, पितः पितः ओ,"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "चिन्ता में इतने न उलझो"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "हम अभी ज़िन्दा हैं ज़िन्दा,"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "चिन्ता क्या है!!"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "मैं उस पाषाण-मूर्ति के ठण्डे"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "पैरों की छाती से बरबस चिपका"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "रुआँसा-सा होता"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "देह में तन गये करुणा के काँटे"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "छाती पर, सिर पर, बाँहों पर मेरे"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "गिरती हैं नीली"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "बिजली की चिनगियाँ"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "रक्त टपकता है हृदय में मेरे"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "आत्मा में बहता-सा लगता"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "ख़ून का तालाब।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "इतने में छाती के भीतर ठक्-ठक्"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "सिर में है धड़-धड़ !! कट रही हड्डी!!"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "फ़िक्र जबरदस्त!!"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "विवेक चलाता तीखा-सा रन्दा"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "चल रहा बासूला"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "छीले जा रहा मेरा निजत्व ही कोई"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "भयानक ज़िद कोई जाग उठी मेरे भी अन्दर"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "हठ कोई बड़ा भारी उठ खड़ा हुआ है।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "इतने में आसमान काँपा व धाँय-धाँय"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "बन्दूक़ धड़ाका"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "बिजली की रफ़्तार पैरों में घूम गयी।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "खोहों-सी गलियों के अँधेरे में एक ओर"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "मैं थक बैठ गया,"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "सोचने-विचारने।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "अँधेरे में डूबे मकानों के छप्परों के पार से"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "रोने की पतली-सी आवाज़"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "सूने में काँप रही काँप रही दूर तक"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "कराहों की लहरों में पाशव प्राकृत"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "वेदना भयानक थरथरा रही है।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "मैं उसे सुनने का करता हूँ यत्न"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "कि देखता क्या हूँ-"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "सामने मेरे"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "सर्दी में बोरे को ओढ़कर"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "कोई एक अपने"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "हाथ-पैर समेटे"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "काँप रहा, हिल रहा---वह मर जायगा।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "इतने में वह सिर खोलता है सहसा"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "बाल बिखरते"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "दीखते हैं कान कि"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "फिर मुँह खोलता है, वह कुछ"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "बुदबुदा रहा है,"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "किन्तु मैं सुनता ही नहीं हूँ।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "ध्यान से देखता हूँ--वह कोई परिचित"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "जिसे खूब देखा था, निरखा था कई बार"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "पर पाया नहीं था।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "अरे हाँ, वह तो..."
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "विचार उठते ही दब गये,"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "सोचने का साहस सब चला गया है।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "वह मुख--अरे, वह मुख, वे गाँधी जी!!"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "इस तरह पंगु!!"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "आश्चर्य!!"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "नहीं, नहीं वे जाँच-पड़ताल"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "रूप बदलकर करते हैं चुपचाप।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "सुराग़रसी-सी कुछ।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "अँधेरे की स्याही में डूबे हुए देव को सम्मुख पाकर"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "मैं अति दीन हो जाता हूँ पास कि"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "बिजली का झटका"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "कहता है-\"भाग जा, हट जा"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "हम हैं गुज़र गये ज़माने के चेहरे"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "आगे तू बढ़ जा।\""
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "किन्तु मैं देखा किया उस मुख को।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "गम्भीर दृढ़ता की सलवटें वैसी ही,"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "शब्दों में गुरुता।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "वे कह रहे हैं--"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "\"दुनिया न कचरे का ढेर कि जिस पर"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "दानों को चुगने चढ़ा हुआ कोई भी कुक्कुट"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "कोई भी मुरग़ा"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "यदि बाँग दे उठे जोरदार"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "बन जाये मसीहा\""
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "वे कह रहे हैं--"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "मिट्टी के लोंदे में किरगीले कण-कण"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "गुण हैं,"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "जनता के गुणों से ही सम्भव"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "भावी का उद्भव ..."
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "गम्भीर शब्द वे और आगे बढ़ गये,"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "जाने क्या कह गये!!"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "मैं अति उद्विग्न!"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "एकाएक उठ पड़ा आत्मा का पिंजर"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "मूर्ति की ठठरी।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "नाक पर चश्मा, हाथ में डण्डा,"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "कन्धे पर बोरा, बाँह में बच्चा।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "आश्चर्य!! अद्भुत! यह शिशु कैसे!!"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "मुसकरा उस द्युति-पुरुष ने कहा तब--"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "\"मेरे पास चुपचाप सोया हुआ  यह था।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "सँभालना इसको, सुरक्षित रखना\""
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "मैं कुछ कहने को होता हूँ इतने में वहाँ पर"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "कहीं कोई नहीं है, कहीं कोई नहीं है:"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "और ज़्यादा गहरा व और ज़्यादा अकेला"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "अँधेरे का फैलाव!"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "बालक लिपटा है मेरे इस गले से चुपचाप,"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "छाती से कन्धे से चिपका है नन्हा-सा आकाश"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "स्पर्श है सुकुमार प्यार-भरा कोमल"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "किन्तु है भार का गम्भीर अनुभव"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "भावी की गन्ध और दूरियाँ अँधेरी"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "आकाशी तारों को साथ लिये हुए मैं"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "चला जा रहा हूँ"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "घुसता ही जाता हूँ फ़ासलों की खोहों तहों में।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "सहसा रो उठा कन्धे पर वह शिशु"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "अरे, अरे, वह स्वर अतिशय परिचित!!"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "पहले भी कई बार कहीं तो भी सुना था,"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "उसमें तो स्फोटक क्षोभ का आयेगा,"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "गहरी है शिकायत,"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "क्रोध भयंकर।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "मुझे डर यदि कोई वह स्वर सुन ले"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "हम दोनों फिर कहीं नहीं रह सकेंगे।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "मैं पुचकारता हूँ, बहुत दुलारता,"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "समझाने के लिए तब गाता हूँ गाने,"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "अधभूली लोरी ही होठों से फूटती!"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "मैं चुप करने की जितनी भी करता हूँ कोशिश,"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "और-और चीख़ता है क्रोध से लगातार!!"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "गरम-गरम अश्रु टपकते हैं मुझपर।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "किन्तु, न जाने क्यों ख़ुश बहुत हूँ।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "जिसको न मैं जीवन में कर पाया,"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "वह कर रहा है।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "मैं शिशु-पीठ थपथपा रहा हूँ,"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "आत्मा है गीली।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "पैर आगे बढ़ रहे, मन आगे जा रहा।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "डूबता हूँ मैं किसी भीतरी सोच में--"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "हृदय के थाले में रक्त का तालाब,"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "रक्त में डूबी हैं द्युतिमान् मणियाँ,"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "रुधिर से फूट रहीं लाल-लाल किरणें,"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "अनुभव-रक्त में डूबे हैं संकल्प,"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "और ये संकल्प"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "चलते हैं साथ-साथ।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "अँधियारी गलियों में चला जा रहा हूँ।"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "इतने में पाता हूँ अँधेरे में सहसा"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "कन्धे पर कुछ नहीं!!"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "वह शिशु"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "चला गया जाने कहाँ,"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "और अब उसके ही स्थान पर"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "मात्र हैं सूरज-मुखी-फूल-गुच्छे।"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "उन स्वर्ण-पुष्पों से प्रकाश-विकीरण"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "कन्धों पर, सिर पर, गालों पर, तन पर,"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "रास्ते पर, फैले हैं किरणों के कण-कण।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "भई वाह, यह खूब!!"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "इतने गली एक आ गयी और मैं"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "दरवाज़ा खुला हुआ देखता।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "ज़ीना है अँधेरा।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "कहीं कोई ढिबरी-सी टिमटिमा रही है!"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "मैं बढ़ रहा हूँ"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "कन्धों पर फूलों के लम्बे वे गुच्छे"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "क्या हुए, कहाँ गये?"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "कन्धे क्यों वज़न से दुख रहे सहसा।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "ओ हो,"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "बन्दूक आ गयी"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "वाह वा...!!"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "वज़नदार रॉयफ़ल"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "भई खूब!!"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "खुला हुआ कमरा है साँवली हवा है,"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "झाँकते हैं खिड़कियों में से दूर अँधेरे में टँके हुए सितारे"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "फैली है बर्फ़ीली साँस-सी वीरान,"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "तितर-बितर सब फैला है सामान।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "बीच में कोई ज़मीन पर पसरा,"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "फैलाये बाँहें, ढह पड़ा आख़िर।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "मैं उस जन पर फैलाता टार्च कि यह क्या--"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "ख़ून भरे बाल में उलझा है चेहरा,"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "भौहों के बीच में गोली का सूराख़,"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "ख़ून का परदा गालों पर फैला,"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "होठों पर सूखी है कत्थई धारा,"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "फूटा है चश्मा नाक है सीधी,"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "ओफ्फो!! एकान्त-प्रिय यह मेरा"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "परिचित व्यक्ति है, वहीं, हाँ,"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "सचाई थी सिर्फ़ एक अहसास"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "वह कलाकार था"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "गलियों के अँधेरे का, हृदय में, भार था"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "पर, कार्य क्षमता से वंचित व्यक्ति,"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "चलाता था अपना असंग अस्तित्व।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "सुकुमार मानवीय हृदयों के अपने"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "शुचितर विश्व के मात्र थे सपने।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "स्वप्न व ज्ञान व जीवनानुभव जो--"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "हलचल करता था रह-रह दिल में"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "किसी को भी दे नहीं पाया था वह तो।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "शून्य के जल में डूब गया नीरव"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "हो नहीं पाया  उपयोग उसका।"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "किन्तु अचानक झोंक में आकर क्या कर गुज़रा कि"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "सन्देहास्पद समझा गया और"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "मारा गया वह बधिकों के हाथों।"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "मुक्ति का इच्छुक तृषार्त अन्तर"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "मुक्ति के यत्नों के साथ निरन्तर"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "सबका था प्यारा।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "अपने में द्युतिमान।"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "उनका यों वध हुआ,"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "मर गया एक युग,"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "मर गया एक जीवनादर्श!!"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "इतने में मुझको ही चिढ़ाता है कोई।"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "सवाल है-- मैं क्या करता था अब तक,"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "भागता फिरता था सब ओर।"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "(फ़िजूल है इस वक़्त कोसना ख़ुद को)"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "एकदम ज़रूरी-दोस्तों को खोजूँ"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "पाऊँ मैं नये-नये सहचर"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "सकर्मक सत्-चित्-वेदना-भास्कर!!"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "ज़ीने से उतरा"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "एकाएक विद्रूप रूपों से घिर गया सहसा"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "पकड़ मशीन-सी,"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "भयानक आकार घेरते हैं मुझको,"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "मैं आततायी-सत्ता के सम्मुख।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "एकाएक हृदय धड़ककर रुक गया, क्या हुआ!!"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "भयानक सनसनी।"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "पकड़कर कॉलर गला दबाया गया।"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "चाँटे से कनपटी टूटी कि अचानक"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "त्वचा उखड़ गयी गाल की पूरी।"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "कान में भर गयी"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "भयानक अनहद-नाद की भनभन।"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "आँखों में तैरीं रक्तिम तितलियाँ, चिनगियाँ नीली।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "सामने ऊगते-डूबते धूँधले"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "कुहरिल वर्तुल,"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "जिनका कि चक्रिल केन्द्र ही फैलता जाता"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "उस फैलाव में दीखते मुझको"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "धँस रहे, गिर रहे बड़े-बड़े टॉवर"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "घुँघराला धूआँ, गेरूआ ज्वाला।"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "हृदय में भगदड़--"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "सम्मुख दीखा"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "उजाड़ बंजर टीले पर सहसा"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "रो उठा कोई, रो रहा कोई"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "भागता कोई सहायता देने।"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "अन्तर्तत्त्वों का पुनर्प्रबंध और पुनर्व्यवस्था"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "पुनर्गठन-सा होता जा रहा।"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "दृश्य ही बदला, चित्र बदल गया"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "जबरन ले जाया गया मैं गहरे"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "अँधियारे कमरे के स्याह सिफ़र में।"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "टूटे-से स्टूल में बिठाया गया हूँ।"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "शीश की हड्डी जा रही तोड़ी।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "लोहे की कील पर बड़े हथौड़े"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "पड़ रहे लगातार।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "शीश का मोटा अस्थि-कवच ही निकाल डाला।"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "देखा जा रहा--"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "मस्तक-यन्त्र में कौन विचारों की कौन-सी ऊर्जा,"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "कौन-सी शिरा में कौन-सी धक्-धक्,"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "कौन-सी रग में कौन-सी फुरफुरी,"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "कहाँ है पश्यत् कैमरा जिसमें"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "तथ्यों के जीवन-दृश्य उतरते,"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "कहाँ-कहाँ सच्चे सपनों के आशय"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "कहाँ-कहाँ क्षोभक-स्फोटक सामान!"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "भीतर कहीं पर गड़े हुए गहरे"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "तलघर अन्दर"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "छिपे हुए प्रिण्टिंग प्रेस को खोजो।"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "जहाँ कि चुपचाप ख़यालों के परचे"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "छपते रहते हैं, बाँटे जाते।"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "इस संस्था के सेक्रेट्री को खोज निकालो,"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "शायद, उसका ही नाम हो आस्था,"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "कहाँ है सरगना इस टुकड़ी का"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "कहाँ है आत्मा?"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "(और, मैं सुनता हूँ चिढ़ी हुई ऊँची"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "खिझलायी आवाज)"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "स्क्रीनिंग करो मिस्टर गुप्ता,"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "क्रॉस एक्जामिन हिम थॉरोली!!"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "चाबुक-चमकार"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "पीठ पर यद्यपि"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "उखड़े चर्म की कत्थई-रक्तिम रेखाएँ उभरीं"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "पर, यह आत्मा कुशल बहुत है,"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "देह में रेंग रही संवेदना की गरमीली कड़ुई धारा गहरी"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "झनझन थरथर तारों को उसके,"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "समेटकर वह सब"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "वेदना-विस्तार करके इकट्ठा"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "मेरा मन यह"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "जबरन उसकी छोटी-सी कड्ढी"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "गठान बाँधता सख़्त व मज़बूत"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "मानो कि पत्थर।"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "ज़ोर लगाकर,"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "उसी गठान को हथेलियों से"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "करता है चूर-चूर,"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "धूल में बिखरा देता है उसको।"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "मन यह हटता है देह की हद से"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "जाता है कहीं पर अलग जगत् में।"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "विचित्र क्षण है,"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "सिर्फ़ है जादू,"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "मात्र मैं बिजली"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "यद्यपि खोह में खूँटे बँधा हूँ"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "दैत्य है आस-पास"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "फिर भी बहुत दूर मीलों के पार वहाँ"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "गिरता हूँ चुपचाप पत्र के रूप में"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "किसी एक जेब में"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "वह जेब..."
    },
    {
      "id": "b_364",
      "type": "p",
      "text": "किसी एक फटे हुए मन की।"
    },
    {
      "id": "b_365",
      "type": "p",
      "text": "समस्वर, समताल,"
    },
    {
      "id": "b_366",
      "type": "p",
      "text": "सहानुभूति की सनसनी कोमल!!"
    },
    {
      "id": "b_367",
      "type": "p",
      "text": "हम कहाँ नहीं हैं"
    },
    {
      "id": "b_368",
      "type": "p",
      "text": "सभी जगह हम।"
    },
    {
      "id": "b_369",
      "type": "p",
      "text": "निजता हमारी?"
    },
    {
      "id": "b_370",
      "type": "p",
      "text": "भीतर-भीतर बिजली के जीवित"
    },
    {
      "id": "b_371",
      "type": "p",
      "text": "तारों के जाले,"
    },
    {
      "id": "b_372",
      "type": "p",
      "text": "ज्वलन्त तारों की भीषण गुत्थी,"
    },
    {
      "id": "b_373",
      "type": "p",
      "text": "बाहर-बाहर धूल-सी भूरी"
    },
    {
      "id": "b_374",
      "type": "p",
      "text": "ज़मीन की पपड़ी"
    },
    {
      "id": "b_375",
      "type": "p",
      "text": "अग्नि को लेकर, मस्तक हिमवत्,"
    },
    {
      "id": "b_376",
      "type": "p",
      "text": "उग्र प्रभंजन लेकर, उर यह"
    },
    {
      "id": "b_377",
      "type": "p",
      "text": "बिलकुल निश्चल।"
    },
    {
      "id": "b_378",
      "type": "p",
      "text": "भीषण शक्ति को धारण करके"
    },
    {
      "id": "b_379",
      "type": "p",
      "text": "आत्मा का पोशाक दीन व मैला।"
    },
    {
      "id": "b_380",
      "type": "p",
      "text": "विचित्र रूपों को धारण करके"
    },
    {
      "id": "b_381",
      "type": "p",
      "text": "चलता है जीवन, लक्ष्यों के पथ पर।"
    }
  ]
}