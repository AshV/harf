{
  "book_id": "andhere-mein",
  "chapter_id": "ch_07",
  "number": 7,
  "title": "भाग ७",
  "word_count": 785,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "रिहा!!"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "छोड़ दिया गया मैं,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "कोई छाया-मुख अब करते हैं पीछा,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "छायाकृतियाँ न छोड़ी हैं मुझको,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "जहाँ-जहाँ गया वहाँ"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "भौंहों के नीचे के रहस्यमय छेद"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "मारते हैं संगीत--"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "दृष्टि की पत्थरी चमक है पैनी।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "मुझे अब खोजने होंगे साथी--"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "काले गुलाब व स्याह सिवन्ती,"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "श्याम चमेली,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सँवलाये कमल जो खोहों के जल में"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "भूमि के भीतर पाताल-तल में"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "खिले हुए कबसे भेजते हैं संकेत"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "सुझाव-सन्देश भेजते रहते!!"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "इतने में सहसा दूर क्षितिज पर"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "दीखते हैं मुझको"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "बिजली की नंगी लताओं से भर रहे"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "सफ़ेद नीले मोतिया चम्पई फूल गुलाबी"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "उठते हैं वहीं पर हाथ अकस्मात्"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अग्नि के फूलों को समेटने लगते।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "मैं उन्हे देखने लगता हूँ एकटक,"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "अचानक विचित्र स्फूर्ति से मैं भी"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "ज़मीन पर पड़े हुए चमकीले पत्थर"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "लगातार चुनकर"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "बिजली के फूल बनाने की कोशिश"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "करता हूँ। रश्मि-विकिरण--"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "मेरे भी प्रस्तर करते हैं प्रतिक्षण।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "रेडियो-एक्टिव रत्न हैं वे भी।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "बिजली के फूलों की भाँति ही"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "यत्न हैं वे भी,"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "किन्तु, असन्तोष मुझको है गहरा,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "शब्दाभिव्यक्ति-अभाव का संकेत।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "काव्य-चमत्कार उतना ही रंगीन"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "परन्तु, ठण्डा।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "मेरे भी फूल हैं तेजस्क्रिय, पर"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "अतिशय शीतल।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "मुझको तो बेचैन बिजली की नीली"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "ज्वलन्त बाँहों में बाँहों को उलझा"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "करनी है उतनी ही प्रदीप्त लीला"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "आकाश-भर में साथ-साथ उसके घूमना है मुझको"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "मेरे पास न रंग है बिजली का गौर कि"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "भीमाकार हूँ मेघ मैं काला"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "परन्तु, मुझको है गम्भीर आवेश"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "अथाह प्रेरणा-स्रोत का संयम।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "अरे, इन रंगीन पत्थर-फूलों से मेरा"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "काम नहीं चलेगा!!"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "क्या कहूँ,"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "मस्तक-कुण्ड में जलती"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "सत्-चित्-वेदना-सचाई व ग़लती--"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "मस्तक शिराओं में तनाव दिन-रात।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "अब अभिव्यक्ति के सारे ख़तरे"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "उठाने ही होंगे।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "तोड़ने होंगे ही मठ और गढ़ सब।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "पहुँचना होगा दुर्गम पहाड़ों के उस पार"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "तब कहीं देखने मिलेंगी बाँहें"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "जिसमें कि प्रतिपल काँपता रहता"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "अरुण कमल एक"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "ले जाने उसको धँसना ही होगा"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "झील के हिम-शीत सुनील जल में"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "चाँद उग गया है"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "गलियों की आकाशी लम्बी-सी चीर में"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "तिरछी है किरनों की मार"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "उस नीम पर"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "जिसके कि नीचे"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "मिट्टी के गोल चबूतरे पर, नीली"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "चाँदनी में कोई दिया सुनहला"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "जलता है मानो कि स्वप्न ही साक्षात्"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "अदृश्य साकार।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "मकानों के बड़े-बड़े खँडहर जिनके कि सूने"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "मटियाले भागों में खिलती ही रहती"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "महकती रातरानी फूल-भरी जवानी में लज्जित"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "तारों की टपकती अच्छी न लगती।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "भागता मैं दम छोड़"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "घूम गया कई मोड़,"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "ध्वस्त दीवालों के उस पार कहीं पर"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "बहस गरम है"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "दिमाग़ में जान है, दिलों में दम है"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "सत्य से सत्ता के युद्ध को रंग है,"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "पर कमजोरियाँ सब मेरे संग हैं,"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "पाता हूँ सहसा--"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "अँधेरे की सुरंग-गलियों में चुपचाप"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "चलते हैं लोग-बाग"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "दृढ़-पद गम्भीर,"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "बालक युवागण"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "मन्द-गति नीरव"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "किसी निज भीतरी बात में व्यस्त हैं,"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "कोई आग जल रही तो भी अन्तःस्थ।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "विचित्र अनुभव!!"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "जितना मैं लोगों की पाँतों को पार कर"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "बढ़ता हूँ आगे,"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "उतना ही पीछे मैं रहता हूँ अकेला,"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "पश्चात्-पद हूँ।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "पर, एक रेला और"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "पीछे से चला और"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "अब मेरे साथ है।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "आश्चर्य!! अद्भुत!!"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "लोगों की मुट्ठियाँ बँधी हैं।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "अँगुली-सन्धि से फूट रहीं किरनें"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "लाल-लाल"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "यह क्या!!"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "मेरे ही विक्षोभ-मणियों को लिये वे,"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "मेरे ही विवेक-रत्नों को लेकर,"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "बढ़ रहे लोग अँधेरे में सोत्साह।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "किन्तु मैं अकेला।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "बौद्धिक जुगाली में अपने से दुकेला।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "गलियों के अँधेरे में मैं भाग रहा हूँ,"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "इतने में चुपचाप कोई एक"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "दे जाता पर्चा,"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "कोई गुप्त शक्ति"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "हृदय में करने-सी लगती है चर्चा!!"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "मैं बहुत ध्यान से पढ़ता हूँ उसको!"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "आश्चर्य!"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "उसमें तो मेरे ही गुप्त विचार व"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "दबी हुई संवेदनाएँ व अनुभव"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "पीड़ाएँ जगमगा रही हैं।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "यह सब क्या है!!"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "आसमान झाँकता है लकीरों के बीच-बीच"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "वाक्यों की पाँतों में आकाशगंगा-फैली"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "शब्दों के व्यूहों में ताराएँ चमकीं"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "तारक-दलों में भी खिलता है आँगन"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "जिसमें कि चम्पा के फूल चमकते"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "शब्दाकाशों के कानों में गहरे तुलसी श्यामल खिलते हैं"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "चेहरे !!"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "चमकता है आशय मनोज्ञ मुखों से"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "पारिजात-पुष्प महकते ।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "पर्चा पढ़ते हुए उड़ता हूँ हवा में,"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "चक्रवात-गतियों में घूमता हूँ नभ पर,"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "ज़मीन पर एक साथ"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "सर्वत्र सचेत उपस्थित।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "प्रत्येक स्थान पर लगा हूँ मैं काम में,"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "प्रत्येक चौराहे, दुराहे व राहों के मोड़ पर"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "सड़क पर खड़ा हूँ,"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "मानता हूँ, मानता हूँ, मनवाता अड़ा हूँ!!"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "और तब दिक्काल-दूरियाँ"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "अपने ही देश के नक्षे-सी टँगी हुई"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "रँगी हुई लगतीं!!"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "स्वप्नों की कोमल किरनें कि मानो"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "घनीभूत संघनित द्युतिमान"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "शिलाओं में परिणत"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "ये दृढ़ीभूत कर्म-शिलाएँ हैं"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "जिनसे की स्वप्नों की मूर्ति बनेगी"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "सस्मित सुखकर"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "जिसकी कि किरनें,"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "ब्रह्माण्ड-भर में नापेंगी सब कुछ!"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "सचमुच, मुझको तो ज़िन्दगी-सरहद"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "सूर्यों के प्रांगण पार भी जाती-सी दीखती!!"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "मैं परिणत हूँ,"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "कविता में कहने की आदत नहीं, पर कह दूँ"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "वर्तमान समाज में चल नहीं सकता।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "पूँजी से जुड़ा हुआ हृदय बदल नहीं सकता,"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "स्वातन्त्र्य व्यक्ति वादी"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "छल नहीं सकता मुक्ति के मन को,"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "जन को।"
    }
  ]
}