{
  "book_id": "andhere-mein",
  "chapter_id": "ch_05",
  "number": 5,
  "title": "भाग ५",
  "word_count": 301,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "एकाएक मुझे भान !!"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "पीछे से किसी अजनबी ने"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "कन्धे पर रक्खा हाथ।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "चौंकता मैं भयानक"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "एकाएक थरथर रेंग गयी सिर तक,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "नहीं नहीं। ऊपर से गिरकर"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "कन्धे पर बैठ गया बरगद-पात तक,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "क्या वह संकेत, क्या वह इशारा?"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "क्या वह चिट्ठी है किसी की?"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "कौन-सा इंगित?"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "भागता मैं दम छोड़,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "घूम गया कई मोड़!!"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "बन्दूक़ धाँय-धाँय"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मकानों के ऊपर प्रकाश-सा छा रहा गेरुआ।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "भागता मैं दम छोड़"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "घूम गया कई मोड़।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "घूम गयी पृथ्वी, घूम गया आकाश,"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "और फिर, किसी एक मुँदे हुए घर की"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "पत्थर, सीढ़ी दिख गयी, उस पार"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "चुपचाप बैठ गया सिर पकड़कर!!"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "दिमाग में चक्कर"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "चक्कर........भँवरें"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "भँवरों के गोल-गोल केन्द्र में दीखा"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "स्वप्न सरीखा--"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "भूमि की सतहों के बहुत-बहुत नीचे"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "अँधियारी एकान्त"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "प्राकृत गुहा एक।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "विस्तृत खोह के साँवले तल में"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "तिमिर को भेदकर चमकते हैं पत्थर"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "मणि तेजस्क्रिय रेडियो-एक्टिव रत्न भी बिखरे,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "झरता है जिन पर प्रबल प्रपात एक।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "प्राकृत जल वह आवेग-भरा है,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "द्युतिमान् मणियों की अग्नियों पर से"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "फिसल-फिसलकर बहती लहरें,"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "लहरों के तल में से फूटती हैं किरनें"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "रत्नों की रंगीन रूपों की आभा"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "फूट निकलती"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "खोह की बेडौल भीतें हैं झिलमिल!!"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "पाता हूँ निज को खोह के भीतर,"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "विलुब्ध नेत्रों से देखता हूँ द्युतियाँ,"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "मणि तेजस्क्रिय हाथों में लेकर"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "विभोर आँखों से देखता हूँ उनको--"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "पाता हूँ अकस्मात्"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "दीप्ति में वलयित रत्न वे नहीं हैं"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "अनुभव, वेदना, विवेक-निष्कर्ष,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "मेरे ही अपने यहाँ पड़े हुए हैं"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "विचारों की रक्तिम अग्नि के मणि वे"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "प्राण-जल-प्रपात में घुलते हैं प्रतिपल"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "अकेले में किरणों की गीली है हलचल"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "गीली है हलचल!!"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "हाय, हाय! मैंने उन्हे गुहा-वास दे दिया"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "लोक-हित क्षेत्र से कर दिया वंचित"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "जनोपयोग से वर्जित किया और"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "निषिद्ध कर दिया"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "खोह में डाल दिया!!"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "वे ख़तरनाक थे,"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "(बच्चे भीख माँगते) ख़ैर..."
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "यह न समय है,"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "जूझना ही तय है।"
    }
  ]
}