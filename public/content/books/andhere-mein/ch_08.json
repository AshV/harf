{
  "book_id": "andhere-mein",
  "chapter_id": "ch_08",
  "number": 8,
  "title": "भाग ८",
  "word_count": 1024,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "एकाएक हृदय धड़ककर रुक गया, क्या हुआ !!"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "नगर से भयानक  धुआँ उठ रहा है,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "कहीं आग लग गयी, कहीं गोली चल गयी।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "सड़कों पर मरा हुआ फैला है सुनसान,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "हवाओं में अदृश्य ज्वाला की गरमी"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "गरमी का आवेग।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "साथ-साथ घूमते हैं, साथ-साथ रहते हैं,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "साथ-साथ सोते हैं, खाते हैं, पीते हैं,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "जन-मन उद्देश्य !!"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "पथरीले चेहरों के ख़ाकी ये कसे ड्रेस"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "घूमते हैं यंत्रवत्,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "वे पहचाने-से लगते हैं वाक़ई"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कहीं आग लग गयी, कहीं गोली चल गयी !!"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सब चुप, साहित्यिक चुप और कविजन निर्वाक्"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "चिन्तक, शिल्पकार, नर्तक चुप हैं"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "उनके ख़याल से यह सब गप है"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "मात्र किंवदन्ती।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "रक्तपायी वर्ग से नाभिनाल-बद्ध ये सब लोग"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "नपुंसक भोग-शिरा-जालों में उलझे।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "प्रश्न की उथली-सी पहचान"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "राह से अनजान"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "वाक् रुदन्ती।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "चढ़ गया उर पर कहीं कोई निर्दयी,"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "कहीं आग लग गई, कहीं गोली चल गई।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "भव्याकार भवनों के विवरों में छिप गये"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "समाचारपत्रों के पतियों के मुख स्थल।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "गढ़े जाते संवाद,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "गढ़ी जाती समीक्षा,"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "गढ़ी जाती टिप्पणी जन-मन-उर-शूर।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "बौद्धिक वर्ग है क्रीतदास,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "किराये के विचारों का उद्भास।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "बड़े-बड़े चेहरों पर स्याहियाँ पुत गयीं।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "नपुंसक श्रद्धा"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "सड़क के नीचे की गटर में छिप गयी,"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "कहीं आग लग गयी, कहीं गोली चल गयी।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "धुएँ के ज़हरीले मेघों के नीचे ही हर बार"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "द्रुत निज-विश्लेष-गतियाँ,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "एक स्पिलट सेकेण्ड में शत साक्षात्कार।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "टूटते हैं धोखों से भरे हुए सपने।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "रक्त में बहती हैं शान की किरनें"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "विश्व की मूर्ति में आत्मा ही ढल गयी,"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "कहीं आग लग गयी, कहीं गोली चल गयी।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "राह के पत्थर-ढोकों के अन्दर"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "पहाड़ों के झरने"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "तड़पने लग गये।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "मिट्टी के लोंदे के भीतर"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "भक्ति की अग्नि का उद्रेक"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "भड़कने लग गया।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "धूल के कण में"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "अनहद नाद का कम्पन"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "ख़तरनाक !!"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "मकानों के छत से"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "गाडर कूद पड़े धम से।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "घूम उठे खम्भे"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "भयानक वेग से चल पड़े हवा में।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "दादा का सोंटा भी करता दाँव-पेंच"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "नाचता है हवा में"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "गगन में नाच रही कक्का की लाठी।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "यहाँ तक कि बच्चे की पेंपें भी उड़तीं,"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "तेज़ी से लहराती घूमती हैं हवा में"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "सलेट पट्टी।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "एक-एक वस्तु या एक-एक प्राणाग्नि-बम है,"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "ये परमास्त्र हैं, प्रक्षेपास्त्र हैं, यम हैं।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "शून्याकाश में से होते हुए वे"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "अरे, अरि पर ही टूट पड़े अनिवार।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "यह कथा नहीं है, यह सब सच है, भई !!"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "कहीं आग लग गयी, कहीं गोली चल गयी !!"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "किसी एक बलवान् तन-श्याम लुहार ने बनाया"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "कण्डों का वर्तुल ज्वलन्त मण्डल।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "स्वर्णिम कमलों की पाँखुरी-जैसी ही"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "ज्वालाएँ उठती हैं उससे,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "और उस गोल-गोल ज्वलन्त रेखा में रक्खा"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "लोहे का चक्का"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "चिनगियाँ स्वर्णिम नीली व लाल"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "फूलों-सी खिलतीं।कुछ बलवान् जन साँवले मुख के"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "चढ़ा रहे लकड़ी के चक्के पर जबरन"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "लाल-लाल लोहे की गोल-गोल पट्टी"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "घन मार घन मार,"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "उसी प्रकार अब"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "आत्मा के चक्के पर चढ़ाया जा रहा"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "संकल्प शक्ति के लोहे का मज़बूत"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "ज्वलन्त टायर !!"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "अब युग बदल गया है वाक़ई,"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "कहीं आग लग गयी, कहीं गोली चल गयी।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "गेरुआ मौसम उड़ते हैं अंगार,"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "जंगल जल रहे ज़िन्दगी के अब"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "जिनके कि ज्वलन्त-प्रकाशित भीषण"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "फूलों में बहतीं वेदना नदियाँ"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "जिनके कि जल में"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "सचेत होकर सैकड़ों सदियाँ, ज्वलन्त अपने"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "बिम्ब फेंकतीं‍‍ !!"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "वेदना नदियाँ"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "जिनमें कि डूबे हैं युगानुयुग से"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "मानो कि आँसू"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "पिताओं की चिन्ता का उद्विग्न रंग भी,"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "विवेक-पीड़ा की गहराई बेचैन,"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "डूबा है जिनमें श्रमिक का सन्ताप।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "वह जल पीकर"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "मेरे युवकों में होता जाता व्यक्तित्वान्तर,"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "विभिन्न क्षेत्रों में कई तरह से करते हैं संगर,"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "मानो कि ज्वाला-पँखरियों से घिरे हुए वे सब"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "अग्नि के शत-दल-कोष में बैठे !!"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "द्रुत-वेग बहती हैं शक्तियाँ निश्चयी।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "कहीं आग लग गयी, कहीं गोली चल गयी।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "x                    x                     x"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "एकाएक फिर स्वप्न भंग"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "बिखर गये चित्र कि मैं फिर अकेला।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "मस्तिष्क हृदय में छेद पड़ गये हैं।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "पर उन दुखते हुए रन्ध्रों में गहरा"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "प्रदीप्त ज्योति का रस बस गया है।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "मैं उन सपनों का खोजता हूँ आशय,"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "अर्थों की वेदना घिरती है मन में।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "अजीब झमेला।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "घूमता है मन उन अर्थों के घावों के आस-पास"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "आत्मा में चमकीली प्यास भर गयी है।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "जग भर दीखती हैं सुनहली तस्वीरें मुझको"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "मानो कि कल रात किसी अनपेक्षित क्षण में ही सहसा"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "प्रेम कर लिया हो"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "जीवन भर के लिए !!"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "मानो कि उस क्षण"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "अतिशय मृदु किन्ही बाँहों ने आकर"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "कस लिया था इस भाँति कि मुझको"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "उस स्वप्न-स्पर्श की, चुम्बन की याद आ रही है,"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "याद आ रही है !!"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "अज्ञात प्रणयिनी कौन थी, कौन थी?"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "कमरे में सुबह की धूप आ गयी है,"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "गैलरी में फैला है सुनहला रवि छोर"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "क्या कोई प्रेमिका सचमुच मिलेगी?"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "हाय ! यह वेदना स्नेह की गहरी"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "जाग गयी क्यों कर?"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "सब ओर विद्युत्तरंगीय हलचल"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "चुम्बकीय आकर्षण।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "प्रत्येक वस्तु का निज-निज आलोक,"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "मानो कि अलग-अलग फूलों के रंगीन"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "अलग-अलग वातावरण हैं बेमाप,"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "प्रत्येक अर्थ की छाया में अन्य अर्थ"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "झलकता साफ़-साफ़ !"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "डेस्क पर रखे हुए महान् ग्रन्थों के लेखक"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "मेरी इन मानसिक क्रियाओं के बन गये प्रेक्षक,"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "मेरे इस कमरे में आकाश उतरा,"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "मन यह अन्तरिक्ष-वायु में सिहरा।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "उठता हूँ, जाता हूँ, गैलरी में खड़ा हूँ।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "एकाएक वह व्यक्ति"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "आँखों के सामने"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "गलियों में, सड़कों पर, लोगों की भीड़ में"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "चला जा रहा है।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "वही जन जिसे मैंने देखा था गुहा में।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "धड़कता है दिल"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "कि पुकारने को खुलता है मुँह"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "कि अकस्मात्--"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "वह दिखा, वह दिखा"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "वह फिर खो गया किसी जन यूथ में..."
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "उठी हुई बाँह यह उठी रह गयी !!"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "अनखोजी निज-समृद्धि का वह परम उत्कर्ष,"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "परम अभिव्यक्ति"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "मैं उसका शिष्य हूँ"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "वह मेरी गुरू है,"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "गुरू है !!"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "वह मेरे पास कभी बैठा ही नहीं था,"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "वह मेरे पास कभी आया ही नहीं था,"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "तिलस्मी खोह में देखा था एक बार,"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "आख़िरी बार ही।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "पर, वह जगत् की गलियों में घूमता है प्रतिपल"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "वह फटेहाल रूप।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "तडित्तरंगीय वही गतिमयता,"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "अत्यन्त उद्विग्न ज्ञान-तनाव वह"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "सकर्मक प्रेम की वह अतिशयता"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "वही फटेहाल रूप !!"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "परम अभिव्यक्ति"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "लगातार घूमती है जग में"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "पता नहीं जाने कहाँ, जाने कहाँ"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "वह है।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "इसीलिए मैं हर गली में"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "और हर सड़क पर"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "झाँक-झाँक देखता हूँ हर एक चेहरा,"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "प्रत्येक गतिविधि"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "प्रत्येक चरित्र,"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "व हर एक आत्मा का इतिहास,"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "हर एक देश व राजनैतिक परिस्थिति"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "प्रत्येक मानवीय स्वानुभूत आदर्श"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "विवेक-प्रक्रिया, क्रियागत परिणति !!"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "खोजता हूँ पठार...पहाड़...समुन्दर"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "जहाँ मिल सके मुझे"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "मेरी वह खोयी हुई"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "परम अभिव्यक्ति अनिवार"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "आत्म-सम्भवा।"
    }
  ]
}