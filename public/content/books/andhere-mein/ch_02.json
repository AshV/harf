{
  "book_id": "andhere-mein",
  "chapter_id": "ch_02",
  "number": 2,
  "title": "भाग २",
  "word_count": 655,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सूनापन सिहरा,"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अँधेरे में ध्वनियों के बुलबुले उभरे,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "शून्य के मुख पर सलवटें स्वर की,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "मेरे ही उर पर, धँसाती हुई सिर,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "छटपटा रही हैं शब्दों की लहरें"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मीठी है दुःसह!!"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "अरे, हाँ, साँकल ही रह -रह"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "बजती है द्वार पर।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कोई मेरी बात मुझे बताने के लिए ही"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "बुलाता है -- बुलाता है"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "हृदय को सहला मानो किसी जटिल"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "प्रसंग में सहसा होठों पर"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "होठ रख, कोई सच-सच बात"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सीधे-सीधे कहने को तड़प जाय, और फिर"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "वही बात सुनकर धँस जाय मेरा जी--"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "इस तरह, साँकल ही रह-रह बजती है द्वार पर"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "आधी रात, इतने अँधेरे में, कौन आया मिलने?"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "विमन प्रतीक्षातुर कुहरे में घिरा हुआ"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "द्युतिमय मुख - वह प्रेम भरा चेहरा --"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "भोला-भाला भाव--"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "पहचानता हूँ बाहर जो खड़ा है !!"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "यह वही व्यक्ति है, जी हाँ !"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "जो मुझे तिलस्मी खोह में दिखा था।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "अवसर-अनवसर"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "प्रकट जो होता ही रहता"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "मेरी सुविधाओं का न तनिक ख़याल कर।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "चाहे जहाँ,चाहे जिस समय उपस्थित,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "चाहे जिस रूप में"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "चाहे जिन प्रतीकों में प्रस्तुत,"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "इशारे से बताता है, समझाता रहता,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "हृदय को देता है बिजली के झटके !!"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "अरे, उसके चेहरे पर खिलती हैं सुबहें,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "गालों पर चट्टानी चमक पठार की"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "आँखों में किरणीली शान्ति की लहरें"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "उसे देख, प्यार उमड़ता है अनायास!"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "लगता है-- दरवाजा खोलकर"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "बाहों में कस लूँ,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "हृदय में रख लूँ"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "घुल जाऊँ, मिल जाऊँ लिपटकर उससे"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "परन्तु, भयानक खड्डे के अँधेरे में आहत"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "और क्षत-विक्षत, मैं पड़ा हुआ हूँ,"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "शक्ति ही नहीं है कि उठ सकूँ जरा भी"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "(यह भी तो सही है कि"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "कमज़ोरियों से ही लगाव है मुझको)"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "इसीलिए टालता हूँ उस मेरे प्रिय  को"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "कतराता रहता,"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "डरता हूँ उससे।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "वह बिठा देता है तुंग शिखर के"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "ख़तरनाक, खुरदरे कगार-तट पर"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "शोचनीय स्थिति में ही छोड़ देता मुझको।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "कहता है-\"पार करो पर्वत-संधि के गह्वर,"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "रस्सी के पुल पर चलकर"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "दूर उस शिखर-कगार पर स्वयं ही पहुँचो\""
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "अरे भाई, मुझे नहीं चाहिए शिखरों की यात्रा,"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "मुझे डर लगता है ऊँचाइयों से"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "बजने दो साँकल!!"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "उठने दो अँधेरे में ध्वनियों के बुलबुले,"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "वह जन वैसे ही"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "आप चला जायेगा आया था जैसा।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "खड्डे के अँधेरे में मैं पड़ा रहूँगा"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "पीड़ाएँ समेटे !!"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "क्या करूँ क्या नहीं करूँ मुझे बताओ,"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "इस तम-शून्य में तैरती है जगत्-समीक्षा"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "की हुई उसकी"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "(सह नहीं सकता)"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "विवेक-विक्षोभ महान् उसका"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "तम-अन्तराल में (सह नहीं सकता)"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "अँधियारे मुझमें द्युति-आकृति-सा"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "भविष्य का नक्षा दिया हुआ उसका"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "सह नहीं सकता !!"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "नहीं, नहीं, उसको छोड़ नहीं सकूँगा,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "सहना पड़े--मुझे चाहे जो भले ही।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "कमज़ोर घुटनों को बार-बार मसल,"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "लड़खड़ाता हुआ मैं"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "उठता हूँ दरवाज़ा खोलने,"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "चेहरे के रक्त-हीन विचित्र शून्य को गहरे"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "पोंछता हूँ हाथ से,"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "अँधेरे के ओर-छोर टटोल-टटोलकर"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "बढ़ता हूँ आगे,"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "पैरों से महसूस करता हूँ धरती का फैलाव,"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "हाथों से महसूस करता हूँ दुनिया,"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "मस्तक अनुभव करता है, आकाश"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "दिल में तड़पता है अँधेरे का अन्दाज़,"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "आँखें ये तथ्य को सूँघती-सी लगतीं,"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "केवल शक्ति है स्पर्श की गहरी।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "आत्मा में, भीषण"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "सत्-चित्-वेदना जल उठी, दहकी।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "विचार हो गए विचरण-सहचर।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "बढ़ता हूँ आगे,"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "चलता हूँ सँभल-सँभलकर,"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "द्वार टटोलता,"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "ज़ंग खायी, जमी हुई जबरन"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "सिटकनी हिलाकर"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "ज़ोर लगा, दरवाज़ा खोलता"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "झाँकता हूँ बाहर...."
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "सूनी है राह, अजीब है फैलाव,"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "सर्द अँधेरा।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "ढीली आँखों से देखते हैं विश्व"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "उदास तारे।"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "हर बार सोच और हर बार अफ़सोस"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "हर बार फ़िक्र"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "के कारण बढे हुए दर्द का मानो कि दूर वहाँ, दूर वहाँ"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "अँधियारा पीपल देता है पहरा।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "हवाओं की निःसंग लहरों में काँपती"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "कुत्तों की दूर-दूर अलग-अलग आवाज़,"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "टकराती रहती सियारों की ध्वनियों से।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "काँपती हैं दूरियाँ, गूँजते हैं फ़ासले"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "(बाहर कोई नहीं, कोई नहीं बाहर)"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "इतने में अँधियारे सूने में कोई चीख़ गया है"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "रात का पक्षी"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "कहता है--"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "\"वह चला गया है,"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "वह नहीं आएगा, आएगा ही नहीं"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "अब तेरे द्वार पर।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "वह निकल गया है गाँव में शहर में।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "उसको तू खोज अब"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "उसका तू शोध कर!"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "वह तेरी पूर्णतम परम अभिव्यक्ति,"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "उसका तू शिष्य है(यद्यपि पलातक....)"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "वह तेरी गुरू है,"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "गुरू है....\""
    }
  ]
}