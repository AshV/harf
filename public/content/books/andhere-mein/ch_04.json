{
  "book_id": "andhere-mein",
  "chapter_id": "ch_04",
  "number": 4,
  "title": "भाग ४",
  "word_count": 755,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "अकस्मात्"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "चार का ग़जर कहीं खड़का"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "मेरा दिल धड़का,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "उदास मटमैला मनरूपी वल्मीक"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "चल-विचल हुआ सहसा।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "अनगिनत काली-काली हायफ़न-डैशों की लीकें"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "बाहर निकल पड़ीं, अन्दर घुस पड़ीं भयभीत,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सब ओर बिखराव।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "मैं अपने कमरे में यहाँ लेटा हुआ हूँ।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "काले-काले शहतीर छत के"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "हृदय दबोचते।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "यद्यपि आँगन में नल जो मारता,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "जल खखारता।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "किन्तु न शरीर में बल है"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "अँधेरे में गल रहा दिल यह।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "एकाएक मुझे भान होता है जग का,"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अख़बारी दुनिया का फैलाव,"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "फँसाव, घिराव, तनाव है सब ओर,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "पत्ते न खड़के,"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सेना ने घेर ली हैं सड़कें।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "बुद्धि की मेरी रग"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "गिनती है समय की धक्-धक्।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "यह सब क्या है"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "किसी जन-क्रान्ति के दमन-निमित्त यह"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "मॉर्शल-लॉ है!"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "दम छोड़ रहे हैं भाग गलियों में मरे पैर,"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "साँस लगी हुई है,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "ज़माने की जीभ निकल पड़ी है,"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "कोई मेरा पीछा कर रहा है लगातार"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "भागता मैं दम छोड़,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "घूम गया कई मोड़,"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "चौराहा दूर से ही दीखता,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "वहाँ शायद कोई सैनिक पहरेदार"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "नहीं होगा फ़िलहाल"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "दिखता है सामने ही अन्धकार-स्तूप-सा"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "भयंकर बरगद--"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "सभी उपेक्षितों, समस्त वंचितों,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "ग़रीबों का वही घर,वही छत,"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "उसके ही तल-खोह-अँधेरे में सो रहे"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "गृह-हीन कई प्राण।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "अँधेरे में डूब गये"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "डालों में लटके जो मटमैले चिथड़े"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "किसी एक अति दीन"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "पागल के धन वे।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "हाँ, वहाँ रहता है, सिर-फिरा एक जन।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "किन्तु आज इस रात बात अजीब है।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "वही जो सिर फिरा पागल क़तई था"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "आज एकाएक वह"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "जागृत बुद्धि है, प्रज्वलत् धी है।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "छोड़ सिरफिरापन,"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "बहुत ऊँचे गले से,"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "गा रहा कोई पद, कोई गान"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "आत्मोद्बोधमय!!"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "खूब भई,खूब भई,"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "जानता क्या वह भी कि"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "सैनिक प्रशासन है नगर में वाक़ई!"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "क्या उसकी बुद्धि भी जग गयी!"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "(करुण रसाल वे हृदय के स्वर हैं"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "गद्यानुवाद यहाँ उनका दिया जा रहा है)"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "\"ओ मेरे आदर्शवादी मन,"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "ओ मेरे सिद्धान्तवादी मन,"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "अब तक क्या किया?"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "जीवन क्या जिया!!"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "उदरम्भरि बन अनात्म बन गये,"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "भूतों की शादी में क़नात-से तन गये,"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "किसी व्यभिचारी के बन गये बिस्तर,"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "दुःखों के दाग़ों को तमग़ों-सा पहना,"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "अपने ही ख़यालों में दिन-रात रहना,"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "असंग बुद्धि व अकेले में सहना,"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "ज़िन्दगी निष्क्रिय बन गयी तलघर,"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "अब तक क्या किया,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "जीवन क्या जिया!!"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "बताओ तो किस-किसके लिए तुम दौड़ गये,"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "करुणा के दृश्यों से हाय!  मुँह मोड़ गये,"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "बन गये पत्थर,"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "बहुत-बहुत ज़्यादा लिया,"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "दिया बहुत-बहुत कम,"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "मर गया देश, अरे जीवित रह गये तुम!!"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "लो-हित-पिता को घर से निकाल दिया,"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "जन-मन-करुणा-सी माँ को हंकाल दिया,"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "स्वार्थों के टेरियार कुत्तों को पाल लिया,"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "भावना के कर्तव्य--त्याग दिये,"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "हृदय के मन्तव्य--मार डाले!"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "बुद्धि का भाल ही फोड़ दिया,"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "तर्कों के हाथ उखाड़ दिये,"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "जम गये, जाम हुए, फँस गये,"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "अपने ही कीचड़ में धँस गये!!"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "विवेक बघार डाला स्वार्थों के तेल में"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "आदर्श खा गये!"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "अब तक क्या किया,"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "जीवन क्या जिया,"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "ज़्यादा लिया और दिया बहुत-बहुत कम"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "मर गया देश, अरे जीवित रह गये तुम...\""
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "मेरा सिर गरम है,"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "इसीलिए गरम है।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "सपनों में चलता है आलोचन,"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "विचारों के चित्रों की अवलि में चिन्तन।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "निजत्व-माफ़ है बेचैन,"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "क्या करूँ, किससे कहूँ,"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "कहाँ जाऊँ, दिल्ली या उज्जैन?"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "वैदिक ऋषि शुनःशेप के"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "शापभ्रष्ट पिता अजीर्गत समान ही"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "व्यक्तित्व अपना ही, अपने से खोया हुआ"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "वही उसे अकस्मात् मिलता था रात में,"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "पागल था दिन में"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "सिर-फिरा विक्षिप्त मस्तिष्क।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "हाय, हाय!"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "उसने भी यह क्या गा दिया,"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "यह उसने क्या नया ला दिया,"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "प्रत्यक्ष,"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "मैं खड़ा हो गया"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "किसी छाया मूर्ति-सा समक्ष स्वयं के"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "होने लगी बहस और"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "लगने लगे परस्पर तमाचे।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "छिः  पागलपन है,"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "वृथा आलोचन है।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "गलियों में अन्धकार भयावह--"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "मानो मेरे कारण ही लग गया"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "मॉर्शल-लॉ वह,"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "मानो मेरी निष्क्रिय संज्ञा ने संकट बुलाया,"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "मानो मेरे कारण ही दुर्घट"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "हुई यह घटना।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "चक्र से चक्र लगा हुआ है...."
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "जितना ही तीव्र है द्वन्द्व क्रियाओं घटनाओं का"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "बाहरी दुनिया में,"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "उतनी ही तेजी से भीतरी दुनिया में,"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "चलता है द्वन्द्व कि"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "फ़िक्र से फ़िक्र लगी हुई है।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "आज उस पागल ने मेरी चैन भुला दी,"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "मेरी नींद गवाँ दी।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "मैं इस बरगद के पास खड़ा हूँ।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "मेरा यह चेहरा"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "घुलता है जाने किस अथाह गम्भीर, साँवले जल से,"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "झुके हुए गुमसुम टूटे हुए घरों के"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "तिमिर अतल से"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "घुलता है मन यह।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "रात्रि के श्यामल ओस से क्षालित"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "कोई गुरू-गम्भीर महान् अस्तित्व"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "महकता है लगातार"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "मानो खँडहर-प्रसारों में उद्यान"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "गुलाब-चमेली के, रात्रि-तिमिर में,"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "महकते हों, महकते ही रहते हों हर पल।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "किन्तु वे उद्यान कहाँ हैं,"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "अँधेरे में पता नहीं चलता।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "मात्र सुगन्ध है सब ओर,"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "पर, उस महक--लहर में"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "कोई छिपी वेदना, कोई गुप्त चिन्ता"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "छटपटा रही है।"
    }
  ]
}