{
  "book_id": "andhere-mein",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "भाग १",
  "word_count": 398,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "ज़िन्दगी के..."
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "कमरों में अँधेरे"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "लगाता है चक्कर"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "कोई एक लगातार;"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "आवाज़ पैरों की देती है सुनाई"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "बार-बार....बार-बार,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "वह नहीं दीखता... नहीं ही दीखता,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "किन्तु वह रहा घूम"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "तिलस्मी खोह में ग़िरफ्तार कोई एक,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "भीत-पार आती हुई पास से,"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "गहन रहस्यमय अन्धकार ध्वनि-सा"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "अस्तित्व जनाता"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अनिवार कोई एक,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "और मेरे हृदय की धक्-धक्"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "पूछती है--वह कौन"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "सुनाई जो देता, पर नहीं देता दिखाई !"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "इतने में अकस्मात गिरते हैं भीतर से"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "फूले हुए पलस्तर,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "खिरती है चूने-भरी रेत"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "खिसकती हैं पपड़ियाँ इस तरह--"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "ख़ुद-ब-ख़ुद"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "कोई बड़ा चेहरा बन जाता है,"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "स्वयमपि"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "मुख बन जाता है दिवाल पर,"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "नुकीली नाक और"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "भव्य ललाट है,"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "दृढ़ हनु"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "कोई अनजानी अन-पहचानी आकृति।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "कौन वह दिखाई जो देता, पर"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "नहीं जाना जाता है !!"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "कौन मनु ?"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "बाहर शहर के, पहाड़ी के उस पार, तालाब..."
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "अँधेरा सब ओर,"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "निस्तब्ध जल,"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "पर, भीतर से उभरती है सहसा"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "सलिल के तम-श्याम शीशे में कोई श्वेत आकृति"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "कुहरीला कोई बड़ा चेहरा फैल जाता है"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "और मुसकाता है,"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "पहचान बताता है,"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "किन्तु, मैं हतप्रभ,"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "नहीं वह समझ में आता।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "अरे ! अरे !!"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "तालाब के आस-पास अँधेरे में वन-वृक्ष"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "चमक-चमक उठते हैं हरे-हरे अचानक"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "वृक्षों के शीशे पर नाच-नाच उठती हैं बिजलियाँ,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "शाखाएँ, डालियाँ झूमकर झपटकर"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "चीख़, एक दूसरे पर पटकती हैं सिर कि अकस्मात्--"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "वृक्षों के अँधेरे में छिपी हुई किसी एक"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "तिलस्मी खोह का शिला-द्वार"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "खुलता है धड़ से"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "........................"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "घुसती है लाल-लाल मशाल अजीब-सी"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "अन्तराल-विवर के तम में"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "लाल-लाल कुहरा,"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "कुहरे में, सामने, रक्तालोक-स्नात पुरुष एक,"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "रहस्य साक्षात् !!"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "तेजो प्रभामय उसका ललाट देख"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "मेरे अंग-अंग में अजीब एक थरथर"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "गौरवर्ण, दीप्त-दृग, सौम्य-मुख"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "सम्भावित स्नेह-सा प्रिय-रूप देखकर"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "विलक्षण शंका,"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "भव्य आजानुभुज देखते ही साक्षात्"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "गहन एक संदेह।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "वह रहस्यमय व्यक्ति"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "अब तक न पायी गयी मेरी अभिव्यक्ति है"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "पूर्ण अवस्था वह"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "निज-सम्भावनाओं, निहित प्रभावों, प्रतिमाओं की,"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "मेरे परिपूर्ण का आविर्भाव,"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "हृदय में रिस रहे ज्ञान का तनाव वह,"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "आत्मा की प्रतिमा।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "प्रश्न थे गम्भीर, शायद ख़तरनाक भी,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "इसी लिए बाहर के गुंजान"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "जंगलों से आती हुई हवा ने"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "फूँक मार एकाएक मशाल ही बुझा दी-"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "कि मुझको यों अँधेरे में पकड़कर"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "मौत की सज़ा दी !"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "किसी काले डैश की घनी काली पट्टी ही"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "आँखों में बँध गयी,"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "किसी खड़ी पाई की सूली पर मैं टाँग दिया गया,"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "किसी शून्य बिन्दु के अँधियारे खड्डे में"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "गिरा दिया गया मैं"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "अचेतन स्थिति में !"
    }
  ]
}