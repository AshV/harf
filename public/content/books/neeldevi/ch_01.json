{
  "book_id": "neeldevi",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "पहिला दृश्य — मैदान (राजा सूर्यदेव का शिविर)",
  "word_count": 104,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "(तीन अप्सरा गान करती हुई दिखाई देती हैं)"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अप्सरागण––(झिंझौटी जल्द तिताला)"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "&#8288; धन धन भारत की छत्रानी।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "वीरकन्यका वीरप्रसविनी वीरवधू जग-जानी॥"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सतीसिरोमनि धरमधुरंधर बुधि-बल धीरज-खानी।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "इनके जस की तिहूँ लोक में अमल धुजा फहरानी॥"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "&#8288; सब मिलि गाओ प्रेमबधाई।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "यह संसार-रतन इक प्रेमहि और बादि चतुराई॥"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "प्रेम बिना फीकी सब बातैं कहहु न लाख बनाई।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "जोग ध्यान जप तप व्रत पूजा प्रेम बिना बिनसाई॥"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "हाव भाव रस रंग रीति बहु काव्य केलि कुसलाई।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "बिना लोन बिंजन सो सबही प्रेम-रहित दरसाई॥"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "प्रेमहि सो हरि हू प्रगटत हैं जदपि ब्रह्म जगराई।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तासों यह जग प्रेमसार है और न आन उपाई॥"
    }
  ]
}