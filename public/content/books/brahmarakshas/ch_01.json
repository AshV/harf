{
  "book_id": "brahmarakshas",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "ब्रह्मराक्षस",
  "word_count": 844,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "शहर के उस ओर खंडहर की तरफ़"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "परित्यक्त सूनी बावड़ी"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "के भीतरी"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "ठण्डे अंधेरे में"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "बसी गहराइयाँ जल की..."
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सीढ़ियाँ डूबी अनेकों"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "उस पुराने घिरे पानी में..."
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "समझ में आ न सकता हो"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कि जैसे बात का आधार"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "लेकिन बात गहरी हो।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "बावड़ी को घेर"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "डालें खूब उलझी हैं,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "खड़े हैं मौन औदुम्बर।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "व शाखों पर"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "लटकते घुग्घुओं के घोंसले"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "परित्यक्त भूरे गोल।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "विद्युत शत पुण्यों का आभास"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "जंगली हरी कच्ची गंध में बसकर"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "हवा में तैर"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "बनता है गहन संदेह"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "अनजानी किसी बीती हुई उस श्रेष्ठता का जो कि"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "दिल में एक खटके सी लगी रहती।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "बावड़ी की इन मुंडेरों पर"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "मनोहर हरी कुहनी टेक"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "बैठी है टगर"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "ले पुष्प तारे-श्वेत"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "उसके पास"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "लाल फूलों का लहकता झौंर--"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "मेरी वह कन्हेर..."
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "वह बुलाती एक खतरे की तरफ जिस ओर"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "अंधियारा खुला मुँह बावड़ी का"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "शून्य अम्बर ताकता है।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "बावड़ी की उन गहराइयों में शून्य"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "ब्रह्मराक्षस एक पैठा है,"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "व भीतर से उमड़ती गूँज की भी गूँज,"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "हड़बड़ाहट शब्द पागल से।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "गहन अनुमानिता"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "तन की मलिनता"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "दूर करने के लिए प्रतिपल"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "पाप छाया दूर करने के लिए, दिन-रात"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "स्वच्छ करने--"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "ब्रह्मराक्षस"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "घिस रहा है देह"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "हाथ के पंजे बराबर,"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "बाँह-छाती-मुँह छपाछप"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "खूब करते साफ़,"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "फिर भी मैल"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "फिर भी मैल!!"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "और... होठों से"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "अनोखा स्तोत्र कोई क्रुद्ध मंत्रोच्चार,"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "अथवा शुद्ध संस्कृत गालियों का ज्वार,"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "मस्तक की लकीरें"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "बुन रहीं"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "आलोचनाओं के चमकते तार!!"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "उस अखण्ड स्नान का पागल प्रवाह...."
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "प्राण में संवेदना है स्याह!!"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "किन्तु, गहरी बावड़ी"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "की भीतरी दीवार पर"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "तिरछी गिरी रवि-रश्मि"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "के उड़ते हुए परमाणु, जब"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "तल तक पहुँचते हैं कभी"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "तब ब्रह्मराक्षस समझता है, सूर्य ने"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "झुककर नमस्ते कर दिया।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "पथ भूलकर जब चांदनी"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "की किरन टकराये"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "कहीं दीवार पर,"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "तब ब्रह्मराक्षस समझता है"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "वन्दना की चांदनी ने"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "ज्ञान गुरू माना उसे।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "अति प्रफुल्लित कण्टकित तन-मन वही"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "करता रहा अनुभव कि नभ ने भी"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "विनत हो मान ली है श्रेष्ठता उसकी!!"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "और तब दुगुने भयानक ओज से"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "पहचान वाला मन"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "सुमेरी-बेबिलोनी जन-कथाओं से"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "मधुर वैदिक ऋचाओं तक"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "व तब से आज तक के सूत्र छन्दस्, मन्त्र, थियोरम,"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "सब प्रेमियों तक"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "कि मार्क्स, एंजेल्स, रसेल, टॉएन्बी"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "कि हीडेग्गर व स्पेंग्लर, सार्त्र, गाँधी भी"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "सभी के सिद्ध-अंतों का"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "नया व्याख्यान करता वह"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "नहाता ब्रह्मराक्षस, श्याम"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "प्राक्तन बावड़ी की"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "उन घनी गहराईयों में शून्य।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "......ये गरजती, गूँजती, आन्दोलिता"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "गहराईयों से उठ रही ध्वनियाँ, अतः"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "उद्भ्रान्त शब्दों के नये आवर्त में"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "हर शब्द निज प्रति शब्द को भी काटता,"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "वह रूप अपने बिम्ब से भी जूझ"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "विकृताकार-कृति"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "है बन रहा"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "ध्वनि लड़ रही अपनी प्रतिध्वनि से यहाँ"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "बावड़ी की इन मुंडेरों पर"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "मनोहर हरी कुहनी टेक सुनते हैं"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "टगर के पुष्प-तारे श्वेत"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "वे ध्वनियाँ!"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "सुनते हैं करोंदों के सुकोमल फूल"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "सुनता है उन्हे प्राचीन ओदुम्बर"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "सुन रहा हूँ मैं वही"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "पागल प्रतीकों में कही जाती हुई"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "वह ट्रेजिडी"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "जो बावड़ी में अड़ गयी।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "x     x      x"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "खूब ऊँचा एक जीना साँवला"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "उसकी अंधेरी सीढ़ियाँ..."
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "वे एक आभ्यंतर निराले लोक की।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "एक चढ़ना औ' उतरना,"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "पुनः चढ़ना औ' लुढ़कना,"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "मोच पैरों में"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "व छाती पर अनेकों घाव।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "बुरे-अच्छे-बीच का संघर्ष"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "वे भी उग्रतर"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "अच्छे व उससे अधिक अच्छे बीच का संगर"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "गहन किंचित सफलता,"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "अति भव्य असफलता"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "...अतिरेकवादी पूर्णता"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "की व्यथाएँ बहुत प्यारी हैं..."
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "ज्यामितिक संगति-गणित"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "की दृष्टि के कृत"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "भव्य नैतिक मान"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "आत्मचेतन सूक्ष्म नैतिक मान..."
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "...अतिरेकवादी पूर्णता की तुष्टि करना"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "कब रहा आसान"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "मानवी अंतर्कथाएँ बहुत प्यारी हैं!!"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "रवि निकलता"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "लाल चिन्ता की रुधिर-सरिता"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "प्रवाहित कर दीवारों पर,"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "उदित होता चन्द्र"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "व्रण पर बांध देता"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "श्वेत-धौली पट्टियाँ"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "उद्विग्न भालों पर"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "सितारे आसमानी छोर पर फैले हुए"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "अनगिन दशमलव से"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "दशमलव-बिन्दुओं के सर्वतः"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "पसरे हुए उलझे गणित मैदान में"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "मारा गया, वह काम आया,"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "और वह पसरा पड़ा है..."
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "वक्ष-बाँहें खुली फैलीं"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "एक शोधक की।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "व्यक्तित्व वह कोमल स्फटिक प्रासाद-सा,"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "प्रासाद में जीना"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "व जीने की अकेली सीढ़ियाँ"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "चढ़ना बहुत मुश्किल रहा।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "वे भाव-संगत तर्क-संगत"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "कार्य सामंजस्य-योजित"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "समीकरणों के गणित की सीढ़ियाँ"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "हम छोड़ दें उसके लिए।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "उस भाव तर्क व कार्य-सामंजस्य-योजन-"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "शोध में"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "सब पण्डितों, सब चिन्तकों के पास"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "वह गुरू प्राप्त करने के लिए"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "भटका!!"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "किन्तु युग बदला व आया कीर्ति-व्यवसायी"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "...लाभकारी कार्य में से धन,"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "व धन में से हृदय-मन,"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "और, धन-अभिभूत अन्तःकरण में से"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "सत्य की झाईं"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "निरन्तर चिलचिलाती थी।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "आत्मचेतस् किन्तु इस"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "व्यक्तित्व में थी प्राणमय अनबन..."
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "विश्वचेतस् बे-बनाव!!"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "महत्ता के चरण में था"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "विषादाकुल मन!"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "मेरा उसी से उन दिनों होता मिलन यदि"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "तो व्यथा उसकी स्वयं जीकर"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "बताता मैं उसे उसका स्वयं का मूल्य"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "उसकी महत्ता!"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "व उस महत्ता का"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "हम सरीखों के लिए उपयोग,"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "उस आन्तरिकता का बताता मैं महत्व!!"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "पिस गया वह भीतरी"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "औ' बाहरी दो कठिन पाटों बीच,"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "ऐसी ट्रेजिडी है नीच!!"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "बावड़ी में वह स्वयं"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "पागल प्रतीकों में निरन्तर कह रहा"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "वह कोठरी में किस तरह"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "अपना गणित करता रहा"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "औ' मर गया..."
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "वह सघन झाड़ी के कँटीले"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "तम-विवर में"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "मरे पक्षी-सा"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "विदा ही हो गया"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "वह ज्योति अनजानी सदा को सो गयी"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "यह क्यों हुआ!"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "क्यों यह हुआ!!"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "मैं ब्रह्मराक्षस का सजल-उर शिष्य"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "होना चाहता"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "जिससे कि उसका वह अधूरा कार्य,"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "उसकी वेदना का स्रोत"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "संगत पूर्ण निष्कर्षों तलक"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "पहुँचा सकूँ।"
    }
  ]
}