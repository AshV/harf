{
  "book_id": "saroj-smriti",
  "chapter_id": "ch_05",
  "number": 5,
  "title": "भाग ५ (चरम विदा और तर्पण)",
  "word_count": 451,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "वे जो यमुना के-से कछार"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "पद फटे बिवाई के, उधार"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "खाये के मुख ज्यों पिये तेल"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "चमरौधे जूते से सकेल"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "निकले, जी लेते, घोर-गंध,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "उन चरणों को मैं यथा अंध,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "कल ध्राण-प्राण से रहित व्यक्ति"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "हो पूजूं, ऐसी नहीं शक्ति।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "ऐसे शिव से गिरिजा-विवाह"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "करने की मुझको नहीं चाह!\""
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "फिर आई याद -- \"मुझे सज्जन"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "है मिला प्रथम ही विद्वज्जन"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नवयुवक एक, सत्साहित्यिक,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "कुल कान्यकुब्ज, यह नैमित्तिक"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "होगा कोई इंगित अदृश्य,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "मेरे हित है हित यही स्पृश्य"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अभिनन्दनीय।\" बँध गया भाव,"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "खुल गया हृदय का स्नेह-स्राव,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "खत लिखा, बुला भेजा तत्क्षण,"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "युवक भी मिला प्रफुल्ल, चेतन।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "बोला मैं -- \"मैं हूँ रिक्त-हस्त"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "इस समय, विवेचन में समस्त --"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "जो कुछ है मेरा अपना धन"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "पूर्वज से मिला, करूँ अर्पण"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "यदि महाजनों को तो विवाह"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "कर सकता हूँ, पर नहीं चाह"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "मेरी ऐसी, दहेज देकर"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "मैं मूर्ख बनूं यह नहीं सुघर,"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "बारात बुला कर मिथ्या व्यय"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "मैं करूँ नहीं ऐसा सुसमय।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "तुम करो ब्याह, तोड़ता नियम"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "मैं सामाजिक योग के प्रथम,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "लग्न के; पढूंगा स्वयं मंत्र"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "यदि पंडितजी होंगे स्वतन्त्र।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "जो कुछ मेरे, वह कन्या का,"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "निश्चय समझो, कुल धन्या का।\""
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "आये पंडित जी, प्रजावर्ग,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "आमन्त्रित साहित्यिक ससर्ग"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "देखा विवाह आमूल नवल,"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "तुझ पर शुभ पडा़ कलश का जल।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "देखती मुझे तू हँसी मन्द,"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "होंठो में बिजली फँसी स्पन्द"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "उर में भर झूली छवि सुन्दर,"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "प्रिय की अशब्द श्रृंगार-मुखर"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "तू खुली एक उच्छवास संग,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "विश्वास-स्तब्ध बँध अंग-अंग,"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "नत नयनों से आलोक उतर"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "काँपा अधरों  पर थर-थर-थर।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "देखा मैनें वह मूर्ति-धीति"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "मेरे वसन्त की प्रथम गीति --"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "श्रृंगार, रहा जो निराकार,"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "रस कविता में उच्छ्वसित-धार"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "गाया स्वर्गीया-प्रिया-संग --"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "भरता प्राणों में राग-रंग,"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "रति-रूप प्राप्त कर रहा वही,"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "आकाश बदल कर बना मही।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "हो गया ब्याह आत्मीय स्वजन"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "कोई थे नहीं, न आमन्त्रण"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "था भेजा गया, विवाह-राग"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "भर रहा न घर निशि-दिवस जाग;"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "प्रिय मौन एक संगीत भरा"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "नव जीवन के स्वर पर उतरा।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "माँ की कुल शिक्षा मैंने दी,"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "पुष्प-सेज तेरी स्वयं रची,"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "सोचा मन में, \"वह शकुन्तला,"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "पर पाठ अन्य यह अन्य कला।\""
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "कुछ दिन रह गृह तू फिर समोद"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "बैठी नानी की स्नेह-गोद।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "मामा-मामी का रहा प्यार,"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "भर जलद धरा को ज्यों अपार;"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "वे ही सुख-दुख में रहे न्यस्त,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "तेरे हित सदा समस्त, व्यस्त;"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "वह लता वहीं की, जहाँ कली"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "तू खिली, स्नेह से हिली, पली,"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "अंत भी उसी गोद में शरण"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "ली, मूंदे दृग वर महामरण!"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "मुझ भाग्यहीन की तू सम्बल"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "युग वर्ष बाद जब हुई विकल,"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "दुख ही जीवन की कथा रही,"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "क्या कहूँ आज, जो नहीं कही!"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "हो इसी कर्म पर वज्रपात"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "यदि धर्म, रहे नत सदा माथ"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "इस पथ पर, मेरे कार्य सकल"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "हो भ्रष्ट शीत के-से शतदल!"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "कन्ये, गत कर्मों का अर्पण"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "कर, करता मैं तेरा तर्पण!"
    }
  ]
}