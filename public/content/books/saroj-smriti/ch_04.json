{
  "book_id": "saroj-smriti",
  "chapter_id": "ch_04",
  "number": 4,
  "title": "भाग ४ (मातुल-गृह और रुग्णता)",
  "word_count": 435,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "आयेंगे कल।\" दृष्टि थी शिथिल,"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "आई पुतली तू खिल-खिल-खिल"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "हँसती, मैं हुआ पुन: चेतन"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "सोचता हुआ विवाह-बन्धन।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कुंडली दिखा बोला -- \"ए -- लो\""
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "आई तू, दिया, कहा--\"खेलो।\""
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "कर स्नान शेष, उन्मुक्त-केश"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सासुजी रहस्य-स्मित सुवेश"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "आईं करने को बातचीत"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "जो कल होनेवाली, अजीत,"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "संकेत किया मैंने अखिन्न"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जिस ओर कुंडली छिन्न-भिन्न;"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "देखने लगीं वे विस्मय भर"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तू बैठी संचित टुकडों पर।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "धीरे-धीरे फिर बढा़ चरण,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "बाल्य की केलियों का प्रांगण"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कर पार, कुंज-तारुण्य सुघर"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आईं, लावण्य-भार थर-थर"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "काँपा कोमलता पर सस्वर"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "ज्यौं मालकौस नव वीणा पर,"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "नैश स्वप्न ज्यों तू मंद मंद"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "फूटी उषा जागरण छंद"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "काँपी भर निज आलोक-भार,"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "काँपा वन, काँपा दिक् प्रसार।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "परिचय-परिचय पर खिला सकल --"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "नभ, पृथ्वी, द्रुम, कलि, किसलय दल"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "क्या दृष्टि। अतल की सिक्त-धार"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "ज्यों भोगावती उठी अपार,"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "उमड़ता उर्ध्व को कल सलील"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "जल टलमल करता नील नील,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "पर बँधा देह के दिव्य बाँध;"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "छलकता दृगों से साध साध।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "फूटा कैसा प्रिय कंठ-स्वर"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "माँ की मधुरिमा व्यंजना भर"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "हर पिता कंठ की दृप्त-धार"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "उत्कलित रागिनी की बहार!"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "बन जन्मसिद्ध गायिका, तन्वि,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "मेरे स्वर की रागिनी वह्लि"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "साकार हुई दृष्टि में सुघर,"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "समझा मैं क्या संस्कार प्रखर।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "शिक्षा के बिना बना वह स्वर"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "है, सुना न अब तक पृथ्वी पर!"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "जाना बस, पिक-बालिका प्रथम"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "पल अन्य नीड़ में जब सक्षम"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "होती उड़ने को, अपना स्वर"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "भर करती ध्वनित मौन प्रान्तर।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "तू खिंची दृष्टि में मेरी छवि,"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "जागा उर में तेरा प्रिय कवि,"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "उन्मनन-गुंज सज हिला कुंज"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "तरु-पल्लव कलिदल पुंज-पुंज"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "बह चली एक अज्ञात बात"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "चूमती केश--मृदु नवल गात,"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "देखती सकल निष्पलक-नयन"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "तू, समझा मैं तेरा जीवन।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "सासु ने कहा लख एक दिवस :--"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "\"भैया अब नहीं हमारा बस,"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "पालना-पोसना रहा काम,"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "देना 'सरोज' को धन्य-धाम,"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "शुचि वर के कर, कुलीन लखकर,"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "है काम तुम्हारा धर्मोत्तर;"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "अब कुछ दिन इसे साथ लेकर"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "अपने घर रहो, ढूंढकर वर"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "जो योग्य तुम्हारे, करो ब्याह"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "होंगे सहाय हम सहोत्साह।\""
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "सुनकर, गुनकर, चुपचाप रहा,"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "कुछ भी न कहा, -- न अहो, न अहा;"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "ले चला साथ मैं तुझे कनक"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "ज्यों भिक्षुक लेकर, स्वर्ण-झनक"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "अपने जीवन की, प्रभा विमल"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "ले आया निज गृह-छाया-तल।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "सोचा मन में हत बार-बार --"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "\"ये कान्यकुब्ज-कुल कुलांगार,"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "खाकर पत्तल में करें छेद,"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "इनके कर कन्या, अर्थ खेद,"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "इस विषय-बेलि में विष ही फल,"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "यह दग्ध मरुस्थल -- नहीं सुजल।\""
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "फिर सोचा -- \"मेरे पूर्वजगण"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "गुजरे जिस राह, वही शोभन"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "होगा मुझको, यह लोक-रीति"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "कर दूं पूरी, गो नहीं भीति"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "कुछ मुझे तोड़ते गत विचार;"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "पर पूर्ण रूप प्राचीन भार"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "ढोते मैं हूँ अक्षम; निश्चय"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "आयेगी मुझमें नहीं विनय"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "उतनी जो रेखा करे पार"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "सौहार्द्र-बंध की निराधार।"
    }
  ]
}