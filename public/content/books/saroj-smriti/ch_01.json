{
  "book_id": "saroj-smriti",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "भाग १ (जीवन-सिन्धु-तरण)",
  "word_count": 231,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "ऊनविंश पर जो प्रथम चरण"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तेरा वह जीवन-सिन्धु-तरण;"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "तनये, ली कर दृक्पात तरुण"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "जनक से जन्म की विदा अरुण!"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "गीते मेरी, तज रूप-नाम"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "वर लिया अमर शाश्वत विराम"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पूरे कर शुचितर सपर्याय"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "जीवन के अष्टादशाध्याय,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "चढ़ मृत्यु-तरणि पर तूर्ण-चरण"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "कह - \"पित:, पूर्ण आलोक-वरण"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "करती हूँ मैं, यह नहीं मरण,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "'सरोज' का ज्योति:शरण - तरण!\" --"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "अशब्द अधरों का सुना भाष,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मैं कवि हूँ, पाया है प्रकाश"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "मैंने कुछ, अहरह रह निर्भर"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "ज्योतिस्तरणा के चरणों पर।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "जीवित-कविते, शत-शर-जर्जर"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "छोड़ कर पिता को पृथ्वी पर"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तू गई स्वर्ग, क्या यह विचार --"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "\"जब पिता करेंगे मार्ग पार"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "यह, अक्षम अति, तब मैं सक्षम,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "तारूँगी कर गह दुस्तर तम?\" --"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "कहता तेरा प्रयाण सविनय, --"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "कोई न था अन्य भावोदय।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "श्रावण-नभ का स्तब्धान्धकार"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "शुक्ला प्रथमा, कर गई पार!"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "धन्ये, मैं पिता निरर्थक था,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "कुछ भी तेरे हित न कर सका!"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "जाना तो अर्थागमोपाय,"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "पर रहा सदा संकुचित-काय"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "लखकर अनर्थ आर्थिक पथ पर"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "हारता रहा मैं स्वार्थ-समर।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "शुचिते, पहनाकर चीनांशुक"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "रख सका न तुझे अत: दधिमुख।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "क्षीण का न छीना कभी अन्न,"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "मैं लख न सका वे दृग विपन्न;"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "अपने आँसुओं अत: बिम्बित"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "देखे हैं अपने ही मुख-चित।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "सोचा है नत हो बार बार --"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "\"यह हिन्दी का स्नेहोपहार,"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "यह नहीं हार मेरी, भास्वर"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "यह रत्नहार-लोकोत्तर वर!\" --"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "अन्यथा, जहाँ है भाव शुद्ध"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "साहित्य-कला-कौशल प्रबुद्ध,"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "हैं दिये हुए मेरे प्रमाण"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "कुछ वहाँ, प्राप्ति को समाधान"
    }
  ]
}