{
  "book_id": "saroj-smriti",
  "chapter_id": "ch_03",
  "number": 3,
  "title": "भाग ३ (अर्थ-संघर्ष और साहित्य-साधना)",
  "word_count": 268,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "वापस कर देते पढ़ सत्त्वर"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "दे एक-पंक्ति-दो में उत्तर।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "लौटी लेकर रचना उदास"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "ताकता हुआ मैं दिशाकाश"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "बैठा प्रान्तर में दीर्घ प्रहर"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "व्यतीत करता था गुन-गुन कर"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सम्पादक के गुण; यथाभ्यास"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "पास की नोंचता हुआ घास"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अज्ञात फेंकता इधर-उधर"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "भाव की चढी़ पूजा उन पर।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "याद है दिवस की प्रथम धूप"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "थी पडी़ हुई तुझ पर सुरूप,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "खेलती हुई तू परी चपल,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "मैं दूरस्थित प्रवास में चल"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "दो वर्ष बाद हो कर उत्सुक"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "देखने के लिये अपने मुख"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "था गया हुआ, बैठा बाहर"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आँगन में फाटक के भीतर,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "मोढे़ पर, ले कुंडली हाथ"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अपने जीवन की दीर्घ-गाथ।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "पढ़ लिखे हुए शुभ दो विवाह।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "हँसता था, मन में बडी़ चाह"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "खंडित करने को भाग्य-अंक,"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "देखा भविष्य के प्रति अशंक।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "इससे पहिले आत्मीय स्वजन"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "सस्नेह कह चुके थे जीवन"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "सुखमय होगा, विवाह कर लो"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "जो पढी़ लिखी हो -- सुन्दर हो।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "आये ऐसे अनेक परिणय,"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "पर विदा किया मैंने सविनय"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "सबको, जो अडे़ प्रार्थना भर"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "नयनों में, पाने को उत्तर"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "अनुकूल, उन्हें जब कहा निडर --"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "\"मैं हूँ मंगली,\" मुडे़ सुनकर"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "इस बार एक आया विवाह"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "जो किसी तरह भी हतोत्साह"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "होने को न था, पडी़ अड़चन,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "आया मन में भर आकर्षण"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "उस नयनों का, सासु ने कहा --"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "\"वे बडे़ भले जन हैं भैय्या,"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "एन्ट्रेंस पास है लड़की वह,"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "बोले मुझसे -- 'छब्बीस ही तो"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "वर की है उम्र, ठीक ही है,"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "लड़की भी अट्ठारह की है।'"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "फिर हाथ जोडने लगे कहा --"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "' वे नहीं कर रहे ब्याह, अहा,"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "हैं सुधरे हुए बडे़ सज्जन।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "अच्छे कवि, अच्छे विद्वज्जन।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "हैं बडे़ नाम उनके। शिक्षित"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "लड़की भी रूपवती; समुचित"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "आपको यही होगा कि कहें"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "हर तरह उन्हें; वर सुखी रहें।'"
    }
  ]
}