{
  "book_id": "saroj-smriti",
  "chapter_id": "ch_02",
  "number": 2,
  "title": "भाग २ (विवाह और वियोग)",
  "word_count": 253,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "पार्श्व में अन्य रख कुशल हस्त"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "गद्य में पद्य में समाभ्यस्त। --"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "देखें वे; हसँते हुए प्रवर,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "जो रहे देखते सदा समर,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "एक साथ जब शत घात घूर्ण"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "आते थे मुझ पर तुले तूर्ण,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "देखता रहा मैं खडा़ अपल"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "वह शर-क्षेप, वह रण-कौशल।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "व्यक्त हो चुका चीत्कारोत्कल"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "क्रुद्ध युद्ध का रुद्ध-कंठ फल।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "और भी फलित होगी वह छवि,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जागे जीवन-जीवन का रवि,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "लेकर-कर कल तूलिका कला,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "देखो क्या रँग भरती विमला,"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "वांछित उस किस लांछित छवि पर"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "फेरती स्नेह कूची भर।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "अस्तु मैं उपार्जन को अक्षम"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "कर नहीं सका पोषण उत्तम"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "कुछ दिन को, जब तू रही साथ,"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "अपने गौरव से झुका माथ,"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "पुत्री भी, पिता-गेह में स्थिर,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "छोड़ने के प्रथम जीर्ण अजिर।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "आँसुओं सजल दृष्टि की छलक"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "पूरी न हुई जो रही कलक"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "प्राणों की प्राणों में दब कर"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "कहती लघु-लघु उसाँस में भर;"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "समझता हुआ मैं रहा देख,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "हटती भी पथ पर दृष्टि टेक।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "तू सवा साल की जब कोमल"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "पहचान रही ज्ञान में चपल"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "माँ का मुख, हो चुम्बित क्षण-क्षण"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "भरती जीवन में नव जीवन,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "वह चरित पूर्ण कर गई चली"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "तू नानी की गोद जा पली।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "सब किये वहीं कौतुक-विनोद"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "उस घर निशि-वासर भरे मोद;"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "खाई भाई की मार, विकल"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "रोई उत्पल-दल-दृग-छलछल,"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "चुमकारा सिर उसने निहार"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "फिर गंगा-तट-सैकत-विहार"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "करने को लेकर साथ चला,"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "तू गहकर चली हाथ चपला;"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "आँसुओं-धुला मुख हासोच्छल,"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "लखती प्रसार वह ऊर्मि-धवल।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "तब भी मैं इसी तरह समस्त"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "कवि-जीवन में व्यर्थ भी व्यस्त"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "लिखता अबाध-गति मुक्त छंद,"
    }
  ]
}