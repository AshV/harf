    },
    {
      "id": "b_16",
      "type": "p",
      "text": "प्रकाशक का वक्तव्य"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "आज हम हिन्दी-संसार के समक्ष श्रीमान् 'प्रेमचन्द जी की बिलकुल नवीन पाँच कहानियों का एक अभिनव संग्रह उपस्थित"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "कर रहे हैं। यह कहानियाँ किसी अन्य पुस्तक में नहीं हैं। इनमें"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "की एक कहानी 'इस्तीफा' की तारीफ पिछले महीनों बहुत काफ़ी"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "हो चुकी है। हिन्दी के विशेष-विशेष विद्वानों ने कहा था कि\"बाबू प्रेमचन्दजी की यह कहानी, हिन्दी में लिखी गई इधर की सभी कहानियों से श्रेष्ठ और अत्यन्त सामयिक है।” परन्तु हम यह निवेदन करेंगे कि पाठकगण अन्य चार कहानियों को पढ़ें"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "और देखें कि 'कप्तान साहब', 'ज़िहाद', 'फातिहा' और 'मन्त्र'"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "नाम की कहानियाँ भी कितनी उत्तम और मनोहर हैं। हमारा तो"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "खयाल है कि कला और कथानक की दृष्टि से यह कहानियाँ"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "इस्तीफ़ा से कहीं अधिक सुन्दर हैं, जिन्हें हिन्दी-संसार ने शायद"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "अभी तक भलीभाँति नहीं परखा। आशा है, समग्र पुस्तक को"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "पढ़कर हिन्दी-संसार इसका निर्णय स्वतः कर लेगा।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "प्रेमचन्दजी के 'प्रतिज्ञा' नामक सुन्दर उपन्यास को प्रकाशित करते हुए हमने पाठकों को विश्वास दिलाया था कि हम शीघ्र ही उनका लिखा हुआ एक वृहत् उपन्यास भेंट करेंगे। आज हम बड़े गर्व के साथ अपने पाठकों को सन्देश सुनाते हैं कि श्रीमान प्रेमचन्दजी का वह उपन्यास छपना शुरू हो गया है, और शीघ्र ही \"ग़बन\" के नाम से प्रकाशित होगा। पृष्ठ-संख्या ठीक चार सौ होगी और मूल्य २₹ मात्र।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "जो सज्जन अभी से ₹ भेजकर हमारे यहाँ के स्थायी ग्राहक बन जायेंगे, वे इसे पौने मूल्य में पायेंगे और हमारे प्रेस की सभी पुस्तकें उन्हें हमेशा पौने मूल्य में मिलेंगी।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "आगे हम बहुत-सी उत्तम-उत्तम पुस्तकों के प्रकाशन का प्रबन्ध कर रहे हैं। आशा है, हिन्दी-प्रेमी सहृदय सज्जनों से हमें काफी साहाय्य प्राप्त होगा।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "--------"
    },
