    },
    {
      "id": "b_38",
      "type": "p",
      "text": "हो,तो सीधे आप एक कार्ड"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "हमारे पास लिख दीजिए।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "सब पुस्तकें घर बैठे"
