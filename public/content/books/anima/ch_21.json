{
  "book_id": "anima",
  "chapter_id": "ch_21",
  "number": 21,
  "title": "२१. माननीया श्रीमती विजयलक्ष्मी पण्डित के प्रति",
  "word_count": 68,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "से दिन तुमि आमाय डेकेछिले"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "आमार सङ्गे कथा बोलबे बोले।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "भेबेछिलेम, कोनो अछिलाय"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "एड़िये जावो एमन विषम दाय।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "नाना रकम भेबे गेलेम शेषे,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "एले तोमार रूपेर स्रोते भेसे।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "चाहनीते किन्तु विषम लागे,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "प्राणे आमार दुरु-दुरु जागे।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "चरित एकटी धरे बोलले, \"कोवलार,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "जुतो पालिश करते पारो?\" \"पारी\""
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "जेइ बोललेम, बोलले मानिये हार,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "\"तखन तोमार कलम आमी बाड़ी\""
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कलम बाड़ार भावे। गन्ध छोटे"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तोमार चोखे-मुखे गोलाप फोटे।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "'४२"
    }
  ]
}