{
  "book_id": "anima",
  "chapter_id": "ch_45",
  "number": 45,
  "title": "४५. जलाशय के किनारे कुहरी थी",
  "word_count": 93,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "४४. चूँकि यहाँ दाना है"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अणिमा    (1943)     द्वारा     सूर्यकान्त त्रिपाठी 'निराला'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "जलाशय के किनारे कुहरी थी"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "जलाशय के किनारे कुहरी थी,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "हरे-नीले पत्तों का घेरा था,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "पानी पर ग्राम की डाल आई हुई;"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "गहरे अंधेरे का डेरा था,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "किनारे सुनसान थे, जुगनू"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "दल दमके—यहाँ-वहाँ चमके,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "वन का परिमल लिये मलय वहा,"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नारियल के पेड़ हिले क्रम से,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "ताड़ खड़े ताक रहे थे सबको,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "पपोहा पुकार रहा था छिपा,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "स्यार विचरते थे आराम से,"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "उजाला हो गया और—तारा दिपा,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "लहरें उठती थीं सरोवर में,"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "तारा चमकता था अन्तर में।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "'४३"
    }
  ]
}