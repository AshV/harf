{
  "book_id": "anima",
  "chapter_id": "ch_06",
  "number": 6,
  "title": "६. दलित जन पर करो करुणा",
  "word_count": 44,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "दीनता पर उतर आये"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "प्रभु, तुम्हारी शक्ति अरुणा।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "हरे तन-मन प्रीति पावन,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "मधुर हो मुख मनोभावन,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "सहज चितवन पर तरङ्गित"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "हो तुम्हारी किरण तरुणा।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "देख वैभव न हो नत सिर,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "समुद्धत मन सदा हो स्थिर,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "पार कर जीवन निरन्तर"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "रहे बहती भक्ति-वरुणा।"
    }
  ]
}