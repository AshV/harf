  "title": "२. बादल छाये",
  "word_count": 85,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१. नूपुर के सुर मंद रहे"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अणिमा    (1943)     द्वारा     सूर्यकान्त त्रिपाठी 'निराला'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "बादल छाये       ३. जन जन के जीवन के सुंदर   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "बादल छाये,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "ये मेरे अपने सपने"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "&#8288;  &#8288; आँखों से निकले, मडलाये।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "बूँदें जितनी"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "चुनी अधखिली कलियाँ उतनी;"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "बूँदों की लड़ियों के इतने"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "हार तुम्हें मैंने पहनाये।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "गरजे सावन के घन घिर घिर,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "नाचे मोर बनों में फिर फिर"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "जितनी बार"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "चढ़े मेरे भी तार"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "&#8288;  &#8288; छन्द से तरह तरह तिर,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "तुम्हें सुनाने को मैंने भी"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "&#8288; नहीं कहीं कम गाने गाये।"
    }
  ]
}