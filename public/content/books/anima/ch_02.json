{
  "book_id": "anima",
  "chapter_id": "ch_02",
  "number": 2,
  "title": "२. बादल छाये",
  "word_count": 61,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "ये मेरे अपने सपने"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "&#8288;  &#8288; आँखों से निकले, मडलाये।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "बूँदें जितनी"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "चुनी अधखिली कलियाँ उतनी;"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "बूँदों की लड़ियों के इतने"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "हार तुम्हें मैंने पहनाये।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "गरजे सावन के घन घिर घिर,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "नाचे मोर बनों में फिर फिर"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "जितनी बार"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "चढ़े मेरे भी तार"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "&#8288;  &#8288; छन्द से तरह तरह तिर,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "तुम्हें सुनाने को मैंने भी"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "&#8288; नहीं कहीं कम गाने गाये।"
    }
  ]
}