{
  "book_id": "anima",
  "chapter_id": "ch_14",
  "number": 14,
  "title": "१४. संत कवि रविदासजी के प्रति",
  "word_count": 82,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "ज्ञान के आकर मुनीश्वर थे परम"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "धर्म के ध्वज, हुए उनमें अन्यतम,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "पूज्य अग्रज भक्त कवियों के, प्रखर"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "कल्पना की किरण नीरज पर सुघर"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "पड़ी ज्यों अँगड़ाइयाँ लेकर खड़ी"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "हो गई कविता कि आई शुभ घड़ी"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "जाति की, देखा सभी ने मीचकर"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "दृग, तुम्हें श्रद्धा-सलिल से सींचकर।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "रानियाँ अवरोध की घेरी हुई"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "वाणियाँ ज्यों बनीं जब चेरी हुईं।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "छुआ पारस भी नहीं तुमने, रहे"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "कर्म के अभ्यास में, अविरत बहे"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "ज्ञान-गङ्गा में, समुज्ज्वल चर्मकार,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "चरण छूकर कर रहा मैं नमस्कार।"
    }
  ]
}