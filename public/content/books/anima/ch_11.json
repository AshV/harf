  "number": 11,
  "title": "११. मैं अकेला",
  "word_count": 88,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "१०. मैं बैठा था पथ पर"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अणिमा    (1943)     द्वारा     सूर्यकान्त त्रिपाठी 'निराला'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "मैं अकेला       १२. अज्ञता   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "मैं अकेला;"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "देखता हूँ, आ रही"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "&#8288; मेरे दिवस की सान्ध्य वेला।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "&#8288;  &#8288; पके आधे बाल मेरे,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "&#8288;  &#8288; हुए निष्प्रभ गाल मेरे,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288;  &#8288; चाल मेरी मन्द होती आ रही,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "&#8288; हट रहा मेला।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "&#8288;  &#8288; जानता हूँ, नदी-झरने,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "&#8288;  &#8288; जो मुझे थे पार करने,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "&#8288;  &#8288; कर चुका हूँ, हँस रहा यह देख,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "&#8288; कोई नहीं भेला   &#91; १ &#93;   ।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "↑    भेला—पुराने ढंग की नाव।"
    }
  ]
}