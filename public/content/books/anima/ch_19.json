{
  "book_id": "anima",
  "chapter_id": "ch_19",
  "number": 19,
  "title": "१९. उद्‍बोधन",
  "word_count": 381,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "दूर करो भ्रम-भास,"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "खोलो ये पलकें,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "खुला सूर्य, खुला दिगाकाश।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "खुले हुए राजपथ"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "स्थल-जल-व्योम के,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "चलते हैं अविरत"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "यात्री भी सोम के,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "जान ले हथेली में,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "धात्री तुम्हारी किन्तु"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "गाँव की वसुन्धरा"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "आज भी पहेली में"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "खड्ढों से भरी हुई"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "हो रही है प्राणहरा"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "यदि यान-वाहनों की"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "मन्द हो रही है चाल,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "प्रगति में तुम्हारे यदि"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "बिछा काँटों का जाल,"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "उड़ती है सदा धूल,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "हिम्मत न हारो तुम,"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सुधरेगी यह भूल,"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "सुथरा होगा यह पथ,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "उठेंगे शीघ्रगति"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "लक्ष्य को पद श्लथ।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "नहीं वह तुम्हारी गति"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "लोभ-लुण्ठन हो जहाँ"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "नाश जिसकी परिणति,"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "औद्धत्य यौवन"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "हो युद्ध की विघोषणा,"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "हार और मृत्यु के ही"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "उदर की पोषणा।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "कहता है इतिहास,"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "सत्य-ज्ञान-प्रेम का"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "तुम्हारा दिया है प्रकाश।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "उठी नहीं तलवार"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "देश की पराजय को,"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "बहो है सहस्रधार"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "मुक्ति यहाँ से, क्षय को"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "मृत्यु के जड़त्व के;"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "नहीं यहाँ थे गुलाम,"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "देश यह वहीं जहाँ"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "जीते गये क्रोध-काम;"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "भाव उठा लो वही,"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "जीवन का वार एक"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "और सहो तो सही।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "सवल यो नीति से,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "पढ़ो दान विश्व के"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "दिये जो ज्ञान-रीति के,"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "खुले हुए विश्व को"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "समझो तुम देखकर,"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "प्रतिमा विशेषकर"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "ध्यान में समाई हुई—"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "जैसे आकाश में"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "सूर्य-चन्द्र-तारा-ग्रह"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "पृथ्वी और जड़-चेतन"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "बहुरूप रेखाएँ"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "दिखती हैं, वैसे ही"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "ज्ञान में"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "दिखेंगे बीज विश्व के विकास के"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "ज्ञान-विज्ञान के,"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "दर्शनेतिहास गत"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "भिन्न-भिन्न भावों के।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "सम्बद्ध क्रियाशील"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "देखोगे, सलील ही"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "बदल गये हैं रूप—"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "भ व, जो तुम्हारे थे,"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "साथ ही साथ ये"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "बदले हैं घर-द्वार,"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "जीवन के अनिवार"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "नियम से हैं उठे"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "आलोक छाया-प्रद,"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "जीवनद व्यवहार,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "बहता चलता हुआ"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "कलकल ध्वनि कर,"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "अर्थ परमार्थ से"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "मिलते खिलते हुए"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "प्रतिवर्ष के-से फूल,"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "भिन्न-भिन्न रूप के"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "कृषि-शिल्प-व्यापार"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "रक्षण के स्तम्भ-से"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "खड़े, समारम्भ के"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "नगर-समाज,शास्त्र,"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "आज दिव्यास्त्र ज्यों"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "विश्वमानवता के,"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "राजनीति-धर्मनीति"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "वर्जित पाशवता से,"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "सभी बदले हुए—"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "सभी भिन्न रूप के,"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "जर्जरता-स्तूप से"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "मन्त्र निकले हुए,"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "साम्य रखते हुए"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "विश्व के जीवन से;"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "बदले हुए कुम्हार,"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "नाई-धोबी-कहार,"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "ब्राह्मण-क्षत्रिय-वैश्य,"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "पासी-भङ्गी-चमार,"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "परिया और कोल-भील;"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "नहीं आज का यह हिन्दू,"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "आज का यह मुसलमान,"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "आज का ईसाई, सिक्ख,"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "आज का यह मनोभाव,"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "आज की यह रूपरेखा।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "नहीं यह कल्पना,"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "सत्य है मनुष्य का"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "मनुष्यत्व के लिये,"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "वंद हैं जो दल अभी"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "किरण-सम्पात से"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "खुल गये वे सभी।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "'४१"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "———————"
    }
  ]
}