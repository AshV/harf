{
  "book_id": "anima",
  "chapter_id": "ch_05",
  "number": 5,
  "title": "५. सुंदर हे सुंदर",
  "word_count": 41,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "दर्शन से जीवन पर"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "&#8288;  &#8288; बरसे अविनश्वर स्वर।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "परसे ज्यों प्राण,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "फूट पड़ा सहज गान,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "तान-सुरसरिता बही"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "&#8288;  &#8288; तुम्हारे मङ्गल-पद छूकर।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "उठी है तरङ्ग,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "वहा जीवन निस्सङ्ग,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "चला तुमसे मिलन को"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "खिलने को फिर फिर भर भर।"
    }
  ]
}