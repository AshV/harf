{
  "book_id": "anima",
  "chapter_id": "ch_10",
  "number": 10,
  "title": "१०. मैं बैठा था पथ पर",
  "word_count": 36,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "तुम आये चढ़ रथ पर।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "हँसे किरण फूट पड़ी,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "टूटी जुड़ गई कड़ी,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "भूल गये पहर-घड़ी,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "आई इति अथ पर।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "उतरे, बढ़ गही बाँह,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पहले की पड़ी छाँह,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "शीतल हो गई देह,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "बीती अविकथ पर"
    }
  ]
}