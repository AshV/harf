{
  "book_id": "anima",
  "chapter_id": "ch_27",
  "number": 27,
  "title": "२७. मत्त हैं जो प्राण",
  "word_count": 86,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "मत्त है जो प्राण,"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "जानते हैं कब किसी का मान?"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "बेलि विष की फैलकर जो खिल गई,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "गन्ध जिसकी हवा के उर मिल गई,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "वह बिना समझे हृदय में हिल गई,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; कर गई अपमान।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "राह चलते लगेंगे काँटे, सही,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "धूल में उनको मिलाएगी मही,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "डाल की वह बात हटकर ही रही,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; फिर कहाँ उत्थान?"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "है व्यथा में स्नेह निर्भर जो, सुखी;"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जो नहीं कुछ चाहता, सच्चा दुखी;"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "एक पथ ज्यों जगत में, है बहुमुखी,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; सर्वदिक् प्रस्थान।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "'४२"
    }
  ]
}