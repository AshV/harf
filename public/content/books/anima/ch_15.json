{
  "book_id": "anima",
  "chapter_id": "ch_15",
  "number": 15,
  "title": "१५. श्रद्धाञ्जलि",
  "word_count": 98,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "(आचार्य शुक्ल जी के प्रति)"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अमा निशा थी समालोचना के अम्बर पर"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "उदित हुए जब तुम हिन्दी के दिव्य कलाधर।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "दीप्ति-द्वितीया हुई लीन खिलने से पहले"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "किन्तु निशाचर सन्ध्या के अन्तर में दहले।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "स्पष्ट तृतीया, खिंची दृष्टि लोगों की सहसा,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "छिड़ी सिद्ध साहित्यिक से तुमसे जब वचसा।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "मुक्त चतुर्थी, समालोचना वधू ब्याहकर"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "लाये तुम, पञ्चमी काव्यवाणी अपने घर।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "षष्टी; छः ऐश्वर्य प्रदर्शित कोष प्राण में;"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "शिक्षण की सप्तमी, महार्णव सप्त ज्ञान में।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "दिये अष्टमी आठों वसु टीकाओं में भर,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नवमी शान्ति ग्रहों की, दशमी विजित दिगम्बर।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "एकादशी रुद्रता, रामा कला द्वादशी,"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "त्रयोदशी-प्रदोष-गत चतुदशी-रत्न शशी।"
    }
  ]
}