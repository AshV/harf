  "title": "७. भाव जो छलके पदों पर",
  "word_count": 74,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "६. दलित जन पर करो करुणा"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अणिमा    (1943)     द्वारा     सूर्यकान्त त्रिपाठी 'निराला'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "भाव जो छलके पदों पर       ८. धूलि में तुम मुझे भर दो   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "भाव जो छलके पदों पर,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "न हों हलके, न हों नश्वर।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "चित्त चिर-निर्मल करे वह,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "देह-मन शीतल करे वह,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "ताप सब मेरे हरे वह"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "नहा आई जो सरोवर।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "गन्धवह हे, घूप मेरी"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "हो तुम्हारी प्रिय चितेरी,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "आरती की सहज फेरी"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "रवि, न कम कर दे कहीं कर।"
    }
  ]
}