{
  "book_id": "anima",
  "chapter_id": "ch_44",
  "number": 44,
  "title": "४४. चूँकि यहाँ दाना है",
  "word_count": 74,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "इसीलिए दीन है, दीवाना है।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "लोग हैं, महफ़िल है,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "नग़्मे हैं, साज़ है, दिलदार है और दिल है,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "शम्मा है, परवाना है,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  &#8288; चूँकि यहाँ दाना है।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "आँख है, लगा हुई;"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "जान है, जीवट भी है भगी हुई,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "दोनों आँखोंवाला है, काना है,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288;  &#8288; चूँकि यहाँ दाना है।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अम्मा है, बप्पा है,"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "झापड़ है और गोलगप्पा है,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "नौजवान मामा है और बुड्ढा नाना है,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "&#8288;  &#8288; चू कि यहाँ दाना है।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "'४३"
    }
  ]
}