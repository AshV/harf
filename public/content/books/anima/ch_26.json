{
  "book_id": "anima",
  "chapter_id": "ch_26",
  "number": 26,
  "title": "२६. द्रुम-दल-शोभी फुल्ल नयन ये",
  "word_count": 93,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "द्रम-दल-शोभी फुल्ल नयन ये,"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "जीवन के मधु-गन्ध-चयन ये।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "&#8288; रवि के पूरक, रङ्ग रङ्ग के,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288; छाया छवि कवि के अनङ्ग के,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288; स्नेह व्यङ्ग्य के, सङ्ग सङ्ग के,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "&#8288; अङ्ग अङ्ग के शमित शयन ये।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "&#8288;  &#8288; देह-भूमि के सजल श्याम घन,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "&#8288;  &#8288; प्रणय-पवन से ज्योतिर्वर्षण,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288;  &#8288; उर के उत्पल के हर्षण-क्षण,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "&#8288;  &#8288; आन्दोलन के सृष्ट अयन ये।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "प्रेम-पाठ के पृष्ठ उभय ज्यों"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "खुले भी न अबतलक खुले हों,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नित्य अनित्य हो रहे हैं, यों"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "विविध-विश्व-दर्शन-प्रणयन ये।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "'४२"
    }
  ]
}