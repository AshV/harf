{
  "book_id": "anima",
  "chapter_id": "ch_03",
  "number": 3,
  "title": "३. जन जन के जीवन के सुंदर",
  "word_count": 60,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "&#8288;  &#8288; हे चरणों पर"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "&#8288;  &#8288; भाव-वरण भर"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "दूँ तन-मन-धन न्योछावर कर।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;  &#8288; दाग़-दग़ा की"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  &#8288; आग लगा दी"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "तुमने जो जन-जन की, भड़की;"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "करूँ आरती मैं जल-जल कर।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "&#8288;  &#8288; गीत जगा जो"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288;  &#8288; गले लगा लो,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "हुआ गैर जो, सहज सगा हो,"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "करे पार जो है अति दुस्तर।"
    }
  ]
}