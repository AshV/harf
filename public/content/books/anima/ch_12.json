{
  "book_id": "anima",
  "chapter_id": "ch_12",
  "number": 12,
  "title": "१२. अज्ञता",
  "word_count": 75,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "मन के तिनके"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "नहीं जले अब तक भी जिनके,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "देखा नहीं उन्होंने अब तक कोना-कोना"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "अपने जीवन का, दुनिया की चाँदी, सोना,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "लाल, जवाहर, हीरे, मोती"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "छिपे हुए हैं अब तक उनसे, अब तक सोती"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "जगती भी आकाङ्क्षा उनकी,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अब तक धुन की"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "नहीं उठी लौ,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "उनके आसमान की अब तक नहीं फटी पौ,"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नहीं दिखा"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "उनके जीवन की पुस्तक में है कहाँ क्या लिखा,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मिले तार"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "उनके औरों से नहीं, नहीं बजती बहार।"
    }
  ]
}