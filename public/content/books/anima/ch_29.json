{
  "book_id": "anima",
  "chapter_id": "ch_29",
  "number": 29,
  "title": "२९. गया अँधेरा",
  "word_count": 73,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "&#8288; गया अंधेरा"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "&#8288; देख, हृदय, हुआ है सबेरा।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "चलना है बहुत दूर रे,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "नहीं वहाँ परी, नहीं हूर,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "मूसा का जैसा, कुछ देने के लिए है,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "निर्जीवन जीवदहन तूर;"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "और कहीं डाल अपना डेरा—"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; गया अँधेरा!"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कोई नहीं पूछता, न पूछे,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "भरे रह गये हैं वे, इसलिए"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "तेरी नज़रों में हैं छूँ छे;"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "ढलकाता चल उनका जल रे,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "भर जैसे मिलना है तेरा—"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "&#8288;  &#8288;  &#8288; गया अँधेरा!"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "'४३"
    }
  ]
}