{
  "book_id": "anima",
  "chapter_id": "ch_08",
  "number": 8,
  "title": "८. धूलि में तुम मुझे भर दो",
  "word_count": 46,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "धूलि-धूसर जो हुए पर"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "उन्हीं के वर वरण कर दो"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "दूर हो अभिमान, संशय,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "वर्ण-आश्रम-गत महाभय,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "जाति-जीवन हो निरामय"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "वह सदाशयता प्रखर दो।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "फूल जो तुमने खिलाया,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सदल क्षिति में ला मिलाया,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "मरण से जीवन दिलाया"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "सुकर जो वह मुझे वर दो।"
    }
  ]
}