{
  "book_id": "anima",
  "chapter_id": "ch_28",
  "number": 28,
  "title": "२८. मरण को जिसने वरा है",
  "word_count": 67,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "उसी ने जीवन भरा है।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "परा भी उसकी, उसीके"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "अङ्क सत्य यशोधरा है।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "सुकृत के जल से विसिञ्चित"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कल्प-किञ्चित विश्व-उपवन,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "उसीकी निस्तन्द्र चितवन"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "चयन करने को हरा है।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "गिरिपताक उपत्यका पर"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "हरित तृण से घिरी तन्वी"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "जो खड़ी है वह उसी की"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "पुष्पभरणा अप्सरा है।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "जब हुआ वञ्चित जगत में"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "स्नेह से, आमर्ष के क्षण,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "स्पर्श देती है किरण जो,"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "उसी की कोमलकरा है।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "'४२"
    }
  ]
}