{
  "book_id": "anima",
  "chapter_id": "ch_42",
  "number": 42,
  "title": "४२. निशा का यह स्पर्श शीतल",
  "word_count": 75,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "भर रहा है हर्ष उत्कल।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "तारिकाओं की विभा से स्नात"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "आलियों की कुन्द-कलिका-गात ;"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "हिल रहा है श्वेत अञ्चल शात"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "पवन से अज्ञात प्रतिपल।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "चन्द्र-प्रिय-मुख से लगे हैं नयन,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "शिखर-शेखर भवन पर है शयन,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "वायु व्याकुल कर रही है चयन"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "अलक-उपवन-गन्ध अन्ध-चपल।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "शिखर के पद पर प्रखर जल-धार"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "बह रही है सरित,—सुस्त विचार"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "प्रणयियों के, हैं हृदय पर हार"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "शब्द-सुमनों के, अमल छल-दल।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "'४३"
    }
  ]
}