{
  "book_id": "anima",
  "chapter_id": "ch_09",
  "number": 9,
  "title": "९. तुम्हें चाहता वह भी सुंदर",
  "word_count": 103,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "जो द्वार-द्वार फिरकर"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "भीख मागता कर फैलाकर।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "भूख अगर रोटी की ही मिटी,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "भूख की ज़मीन न चौरस पिटी,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "और चाहता है वह कौर उठाना कोई,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "देखो, उसमें उसकी इच्छा कैसे रोई,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "द्वार-द्वार फिर कर"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "भीख मागता कर फैला कर—"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "तुम्हें चाहता वह भी सुन्दर।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "देश का, समाज का"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "कर्णधार हो किसी जहाज़ का।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "पार करे कैसा भी सागर,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "फिर भी रहता है चलना उसे,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "फिर भी रहता है पीछे डर;"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "चाहता वहाँ जाना वह भी"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "नहीं चलाना जहाँ जहाज़, नहीं सागर,"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "नहीं डूबने का भी जहाँ डर।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "तुम्हें चाहता है वह, सुन्दर,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "जो द्वार-द्वार फिरकर"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "भीख माँगता कर फैलाकर।"
    }
  ]
}