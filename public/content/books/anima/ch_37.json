{
  "book_id": "anima",
  "chapter_id": "ch_37",
  "number": 37,
  "title": "३७. भारत ही जीवन-धन",
  "word_count": 49,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "ज्योतिर्मय परम-रमण"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "सर-सरिता वन-उपवन।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "तपः-पुञ्ज गिरि-कन्दर,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "निर्झर के स्वर पुष्कर,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "दिक्प्रान्तर मर्म-मुखर,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मानव मानव-जीवन।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "धौत-धवल ऋतु के पल,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सञ्चारण चरण चपल,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कारण-वारण, वल्कल-"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "धारण, सुकृतोच्चारण।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नहीं कहीं जाड़-जघन्य,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "नहीं कहीं अहम्मन्य,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "नहीं कहीं स्तन्य वन्य,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "चिन्मय केवल चिन्तन।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "'४२"
    }
  ]
}