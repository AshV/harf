  "number": 37,
  "title": "३७. भारत ही जीवन-धन",
  "word_count": 85,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "३६. घेर लिया जीवों को जीवन के पाश ने"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अणिमा    (1943)     द्वारा     सूर्यकान्त त्रिपाठी 'निराला'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "भारत ही जीवन-धन       ३८. स्वामी प्रेमानन्दजी महाराज   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "भारत ही जीवन-धन,"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "ज्योतिर्मय परम-रमण"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "सर-सरिता वन-उपवन।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "&#8288; तपः-पुञ्ज गिरि-कन्दर,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "&#8288; निर्झर के स्वर पुष्कर,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "&#8288; दिक्प्रान्तर मर्म-मुखर,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "&#8288; मानव मानव-जीवन।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "धौत-धवल ऋतु के पल,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "सञ्चारण चरण चपल,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "कारण-वारण, वल्कल-"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "धारण, सुकृतोच्चारण।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "&#8288; नहीं कहीं जाड़-जघन्य,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "&#8288; नहीं कहीं अहम्मन्य,"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "&#8288; नहीं कहीं स्तन्य वन्य,"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "&#8288; चिन्मय केवल चिन्तन।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "'४२"
    }
  ]
}