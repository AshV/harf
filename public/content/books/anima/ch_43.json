{
  "book_id": "anima",
  "chapter_id": "ch_43",
  "number": 43,
  "title": "४३. तुम चले ही गये प्रियतम",
  "word_count": 73,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "हृदय में प्रियछवि नहीं ली।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "व्यर्थ ऋतु के दृश्य-दर्शन,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "व्यर्थ यह रचना रसीली।"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "खुले उर की प्रेमिका की"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "गन्ध का वाहक नहीं अब,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "मुक्त-नयना सङ्गिनी का"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पथिक परिचायक नहीं अब;"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "खुली जो मुरझा चली कलि,"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "बँधी छवि हो गई ढीली।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "बरसने को गरजते थे"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "वे न जाने किस हवा से"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "उड़ गये हैं गगन में घन,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "रह गये हैं नयन प्यासे,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "उड़ रही है धूल, धाराधर,"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "धरा होगी न गीली।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "'४३"
    }
  ]
}