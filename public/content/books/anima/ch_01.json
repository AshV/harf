{
  "book_id": "anima",
  "chapter_id": "ch_01",
  "number": 1,
  "title": "१. नूपुर के सुर मंद रहे",
  "word_count": 53,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "जब न चरण स्वच्छन्द रहे।"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "&#8288;  &#8288; उतरी नभ से निर्मल राका,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "&#8288;  &#8288; पहले जब तुमने हँस ताका"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "&#8288;  &#8288; बहुविध प्राणों को झंकृत कर"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "&#8288;  &#8288; बजे छन्द जो बन्द रहे।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "नयनों के ही साथ फिरे वे"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "मेरे घेरे नहीं घिरे वे,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "तुमसे चल तुममें ही पहुँचे"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "जितने रस आनन्द रहे।"
    }
  ]
}