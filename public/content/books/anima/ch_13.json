{
  "book_id": "anima",
  "chapter_id": "ch_13",
  "number": 13,
  "title": "१३. तुम और मैं",
  "word_count": 160,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "झुकता है सर,"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "दुनिया से मैं धोखा खाकर"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "गिरता हूँ जब,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "मुझे उठा लेते हो तुम तब"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "ज्यों पानी को किरन, तपाकर।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "फिर दुनिया की आँखों से मुझको ओझल कर"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "रखते आसमान पर,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "बादल मुझे बनाते"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "रंग किरनों से भरते हो सुन्दर;"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "मुझे उड़ाते रहते हो फिर हवा-हवा पर;"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "तर सागर-वन"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "नदी आर्द्र घन"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मैं देखता देश-देशान्तर;"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तब यह जग आहें भर-भर"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "कहता है, 'आओ, जलधर!'"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "गरज-गरज बिजली कड़काकर"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "(जब कहते हो, जाओ, प्यारे,)"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "लाख-लाख बूँदों से मैं टूटता गगन से"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "जैसे तारे।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "मिट जाती है जलन"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "मगर मैं आ जाता हूँ फिर मिट्टी पर,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "पर तुम मुझे! उठाते हो फिर"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "छिपे कली के दिल के अन्दर।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "जड़ से चढ़कर,"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "तने-शाख-डण्ठल से होकर,"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "रहता हूँ अविकच कलिका के"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "जीवन में मैं जीवन खोकर।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "जब वह खिलती,"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "आँखें लड़ा-लड़ाकर मिलती,"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "उसे तोड़कर,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "मालिन सुई चलाती है मुँह मोड़ मोड़कर,"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "मैं खुशबू में उड़ता हूँ तब,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "उसी गगन पर, मुक्त-पङ्खभर,"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "धरा छोड़कर।"
    }
  ]
}