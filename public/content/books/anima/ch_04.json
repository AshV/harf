      "id": "b_1",
      "type": "p",
      "text": "३. जन जन के जीवन के सुंदर"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अणिमा    (1943)     द्वारा     सूर्यकान्त त्रिपाठी 'निराला'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "उन चरणों में दो मुझे शरण       ५. सुंदर हे सुंदर   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "उन चरणों में मुझे दो शरण।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "इस जीवन को करो हे मरण।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "बोलूँ अल्प, न करूँ जल्पना,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "सत्य रहे, मिट जाय कल्पना,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "मोह-निशा की स्नेह-गोद पर"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "सोये मेरा भरा जागरण"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "आगे-पीछे दाँयें-बाँयें"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "जो आये थे वे हट जायें,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "उठे सृष्टि से दृष्टि, सहज मैं"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "करूँ लोक-आलोक-सन्‍तरण।"
    }
  ]
}