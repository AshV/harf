{
  "book_id": "anima",
  "chapter_id": "ch_41",
  "number": 41,
  "title": "४१. सड़क के किनारे दूकान है",
  "word_count": 109,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "४०. मेरे घर के पच्छिम ओर रहती है"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "अणिमा    (1943)     द्वारा     सूर्यकान्त त्रिपाठी 'निराला'"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "सड़क के किनारे दूकान है       ४२. निशा का यह स्पर्श शीतल   →"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "सड़क के किनारे दूकान है।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "पान की, दूर एक्कावान है"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "घोड़े की पीठ ठोंकता हुआ,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "पीरबख़्स एक बच्चे को दुआ"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "दे रहा है, पीपल की डाल पर"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "कूक रही है कोयल, माल पर"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "बैलगाड़ी चली ही जा रही है।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "नीम फूली है, खुशबू आ रही है,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "डालों से छन-छनकर राह पर"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "किरने पड़ रही हैं, बाह पर"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "बाह किये जा रहा है खेत में"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "दाहनी तरफ़ किसान, रेत में"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "बांई तरफ़ चिड़ियाँ कुछ बैठी हैं,"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "खुली जड़ें सिरसे की ऐंठी हैं।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "'४३"
    }
  ]
}