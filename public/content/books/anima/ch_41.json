{
  "book_id": "anima",
  "chapter_id": "ch_41",
  "number": 41,
  "title": "४१. सड़क के किनारे दूकान है",
  "word_count": 78,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "पान की, दूर एक्कावान है"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "घोड़े की पीठ ठोंकता हुआ,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "पीरबख़्स एक बच्चे को दुआ"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "दे रहा है, पीपल की डाल पर"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "कूक रही है कोयल, माल पर"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "बैलगाड़ी चली ही जा रही है।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "नीम फूली है, खुशबू आ रही है,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "डालों से छन-छनकर राह पर"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "किरने पड़ रही हैं, बाह पर"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "बाह किये जा रहा है खेत में"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "दाहनी तरफ़ किसान, रेत में"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "बांई तरफ़ चिड़ियाँ कुछ बैठी हैं,"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "खुली जड़ें सिरसे की ऐंठी हैं।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "'४३"
    }
  ]
}