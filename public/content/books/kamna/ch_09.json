{
  "book_id": "kamna",
  "chapter_id": "ch_09",
  "number": 9,
  "title": "2.3",
  "word_count": 497,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "तीसरा दृश्य"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "स्थान-कुटीर"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "(विनोद और लीला)"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "लीला—मेरा स्वर्ण-पट्ट ?"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "विनोद—अभी तक तो नहीं मिला।"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "लीला—आज तक तो आशा-ही-श्राशा है।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "विनोद—परंतु अब सफलता भी होगी।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "लीला—कैसे?"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "विनोद-अपराध होना आरम्भ हो गया है।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "अब तो एक दिन विचार भी होगा। देखो, कौन-कौन"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "खेल होते है।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "लीला-तुम उन दोनों को कहाँ रख आये ?"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "विनोद-पहले विचार हुआ कि उपासना-गृह"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "५५"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "कामना"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "या संग्रहालय मे रक्खे जायें । फिर यह निश्चित हुआ"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "कि नहीं, मित्र-कुटुम्ब के लिए जो नया घर बन रहा"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "है, उसी में रखना चाहिये । और, उन शिकारियों को"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "वहाँ रक्षक नियत किया गया है।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "लीला-इस विचार-योजना मे कुछ-न-कुछ"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "तुम्हे मिलेगा।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "विनोद-परंतु लीला, हम लोग कहाँ चले जा"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "रहे हैं, कुछ समझ रही हो ? समझ मे आने की ये"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "बाते हैं?"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "लीला-अच्छी तरह । ( मदिरा का पात्र भरती"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "हुई ) कहीं नीचे, कहीं बड़े अंधकार में ।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "विनोद-फिर मुझे क्यो प्रोत्साहित कर रही हो ?"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "(लीला पात्र मुंह से लगा देती है, विनोद पीता है)"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "लीला-आज तुम्हे गाना सुनाऊँगी।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "विनोद-(मद-विह्वल होकर) सुनाओ प्रिये !"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "(लीला गाती है)"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "छटा कैसी सलोनी निराली है,"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "&#8288; देखो आई घटा मतवाली है।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "आओ साजन मधु पियें, पहन फूल के हार ;"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "फूल-सदृश यौवन खिला, है फूल की बहार ।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "&#8288; भरी फूलों से बेले की डाली है ॥ छटा० ॥"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "५६"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "शीतल धरती हो गई, शीतल पड़ी फुहार ;"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "शीतल छाती से लगी, शीतल चली बयार ।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "&#8288; सभी ओर नई हरियाली है ॥ छटा० ॥"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "(सहसा कामना का कई युवकों के साथ प्रवेश)"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "कामना—फूल"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "के हार कहाँ लीला | तपा हुआ"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "सोने का हार है । शीतलता कहाँ, ज्वाला धधक उठी"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "है। यह आनंद करने का समय नही है ।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "विनोद—क्या है रानी ?"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "कामना—विनोद, ये शिकारी उन अपराधियो"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "के रक्षक है, इन्हे दिन-रात वहाँ रहना चाहिये । तब"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "इनके जीवन-निर्वाह का प्रबंध—"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "विनोद—जैसी आज्ञा हो ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "(विलास का प्रवेश)"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "विलास—ये शिकारी नहीं, सैनिक हैं, शांति-"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "रक्षक"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "है । सार्वजनिक संग्रहालय पर अधिकार करो।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "इनमे से कुछ उसकी रक्षा करेगे, और बचे हुए"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "कारागार की।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "विनोद—कारागार क्या ?"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "विलास—वही, जहाँ अपराधी रक्खे जाते है,"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "जो शासन का मूल है, जो राज्य का अमोघ शस्त्र है।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "लीला—(विनोद से) यह तो बड़ी अच्छी बात है।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "५७"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "कामना"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "कामना-विनोद, मैं तुमको सेनानी बनाती हूँ।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "देखो, प्रबंध करो। आतंक न फैलने पावे ।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "विलास-यह लो सेनापति का चिन्ह ।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "(एक छोटा-सा स्वर्ण-पट्ट पहनाता है। कामना तलवार"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "हाथ मे देती है । सब भय और आश्चर्य से देखते हैं)"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "कामना-(शिकारियों से ) देखो, आन से जो"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "लोग इसकी आज्ञा नही मानेगे, उन्हे दंड मिलेगा।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "(सब घुटने टेकते हैं)"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "विलास-परंतु सेनापति, स्मरण रखना, तुम"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "इस राजमुकुट के अन्यतम सेवक हो। रानसेवा में"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "प्राण तक दे देना तुम्हारा धर्म होगा।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "विनोद-(घुटने टेककर) मै अनुगृहीत हुआ।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "लीला-(धीरे से) परंतु यह तो बड़ा भया-"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "नक धर्म है।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "कामना-हाँ विलासनी।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "विलास-आज राजसभा होगी। उसी में कई"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "पद प्रतिष्ठित किये जायेंगे। वहीं सम्मान किया जाय ।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "कामना-अच्छी बात है।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "(विनोद अपने सैनिकों के साथ परिक्रमण करता है)"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "[ पट-परिवर्तन ]"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "५८"
    }
  ]
}