{
  "book_id": "sau-ajaan-aur-ek-sujaan",
  "chapter_id": "ch_24",
  "number": 24,
  "title": "शब्दार्थ-सूची",
  "word_count": 1966,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "सौ अजान और एक सुजान    (1944)"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "द्वारा     बालकृष्ण भट्ट"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "टिप्पणी-सहित कठिन-शब्दार्थ-सूची"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "सांकेतिक शब्द— (सं॰ से संस्कृत। अलं॰ से अलंकार। अ॰ से अरबी। फ़ा॰ से फ़ारसी। अँग॰ से अँगरेज़ी।)"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "पहला प्रस्ताव"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "खोटा— (सं॰ क्षुद्र) दुष्ट।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "तातो— (सं॰ तप्त) जलता हुआ, गरम।"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "दुर्व्यसनी— बुरा शौक़ करनेवाला; फ़िज़ूल-ख़र्च; अपव्ययी।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "\"दुर्व्यसनी……लगे हैं\"— यहाँ पर उपमा अलंकार है।"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "\"मानो प्रकृतिदेवी……चाहती है\"— इसमें उत्प्रेक्षा अलंकार है।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "प्रेयसी— प्यारी, प्रियतमा।"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "\"मानो हँस-सा रहे हैं\"— उत्प्रेक्षा अलं॰।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "\"जिसकी सम-विषम……व्याप रही है\"— उपमा अलं॰।"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "सम-विषम भू-भाग— ऊबड़-खाबड़ धरती।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "वितान— चँदवा।"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "\"मानो वितान रूप……दिया गया है।\" …उत्प्रेक्षा अलं॰।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "\"मालूम होता है……होड़ लगाए हुए हैं\"— उत्प्रेक्षा अलं॰।"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "होड़— स्पर्धा।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "\"मोती-से चमकते……उपहार बन रहे हैं\"— समासोक्ति अलं॰।"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "निशानाथ— (निशा=रात, नाथ=स्वामी); चंद्रमा।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "निशा-वधूटी— रात्रिरूपी नव (नई) वधू (बहू)।"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "\"चाँदनी……धरती\"— अपह्रुति अलं॰।"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "\"यहाँ कन्या……प्रस्तुत है\"— समासोक्ति अलं॰।"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "कचलपटी— (सं॰ कछलंपटता)—आवारगी।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "छिछोरपन— क्षुद्रता; नीचता।"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "आय— (पुरानी हिंदी के 'आसना' 'आहना' [होना] क्रिया का पूर्वकालिक रूप; शुद्ध शब्द 'आहि' है। प्रायः भट्टजी ने पुरानी हिंदी के अनुसार धातुओं का पूर्वकालिक रूप ऐसा ही लिखा है। अन्य स्थानों में भी जैसे \"पकड़ाय\", \"बुलाय\" इसी तरह से समझना चाहिए) आकर।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "सोवत हैं— सोते हैं (प्रयाग के आस-पास की यही भाषा है)।"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "दूसरा प्रस्ताव"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "जलप्राय— जलमय, वह प्रदेश या स्थान, जहाँ जल अधिकता से हो।"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "हरित-तृण-आच्छादित— हरी-हरी घास से ढँकी हुई।"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "मरकतमई-सी— मानो पन्ने (एक प्रकार का हरा मणि) से जड़ी।"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "बाँकुरे— बंक, बाँका (यह शब्द प्रायः वीर शब्द के साथ आता है, जैसे \"वीर बाँकुरे\")।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "पुण्यतोया— पवित्र जलवाली।"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "सरिद्वरा— नदियों में श्रेष्ठ।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "अनुशीलन— अभ्यास, अध्ययन।"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "बहुश्रुत— (बहु=बहुत; श्रुत=सुना हुआ या शास्त्र) जिसने बहुत सुना हो, अर्थात् विद्वान्, पंडित।"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "ग्रंथ-चुंबक— (ग्रंथ=पुस्तक; चुंबक=चूमनेवाला) जो किसी विषय का पूर्ण विद्वान् न हो, वरन् ग्रंथो का केवल पाठ-मात्र कर गया हो, उसके विषय को समझा न हो। अल्पज्ञ।"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "साक्षर-मात्र— जो थोड़ा भी पढ़ा-लिखा हो।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "वृत्ति— दान।"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "वेदरेग— बिना सोचे-समझे।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "वेजा— अनुचित।"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "ज़नख़ा— (फ्रा॰-शब्द) हिजड़ा, नपुंसक।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "सुमिरनी— जपने की २७ दानों की माला।"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "नितांत— अत्यंत।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "स्फूर्ति— प्रकाश, प्रतिभा।"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "नवनता— नम्रता।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "तीसरा प्रस्ताव"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "विद्वन्मंडली-मंडनशिरोमणि— विद्वानों के समूह में सवश्रेष्ठ।"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "दुरूह— कठिन।"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "अनुपपन्न— असमर्थ।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "गुज़रान— (फ्रा॰-शब्द) व्यतीत, जीविका-निर्वाहार्थ।"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "श्रुताध्ययनसंपन्न— विद्वान्।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "सद‍्वृत्त— अच्छा चरित्रवाला, सदाचारी।"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "लिलार— (सं॰ ललाट) मस्तक, माथा।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "दामिनि— (सं॰ दामिनी) बिजुली।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "आर्ष— ऋषियों का बनाया हुआ।"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "संथा— पाठ।"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "भासती थी— मालूम होता था।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "मनमानस— मनरूपी मानसरोवर; रूपक अलंकार।"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "कायिक— शरीर-संबंधी।"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "मानसिक— मन-संबंधी।"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "मोतकिद— कायल।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "\"शांति और क्षमा……कुसुमाकर\"— इसमें रूपक अलंकारों की लढी की लड़ी है।"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "तृष्णालता गहन वन— लोभरूपी लताओं का घना जंगल।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "अज्ञानतिमिर— मूर्खतारूपी अंधकार।"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "सहस्रांशु— (सहस्र=हज़ार; अंशु=किरण) हज़ार किरणवाला; सूर्य।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "दुराग्रह— किसी बात पर मूर्खता के साथ हठ करना।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "कूरग्रह— पापग्रह (सितारे); शनिश्चर, राहु, केतु आदि।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "अस्ताचल— (अस्त=डूबना; छिपना। अचल=जो न चले; पर्वत या पहाड़ ) पुराने सिद्धांत के अनुसार जहाँ सूर्य, चंद्रमा आदि ग्रह अस्त (छिप) हो जाते हैं।"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "उदयगिरि— वह पर्वत, जहाँ से सूर्य आदि ग्रह उदय होते है।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "उपशम— शांति।"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "सौजन्य-सुमन— साधुतारूपी फूल।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "कुसुमाकर— वसंत; वाटिका।"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "रीझ गए— प्रसन्न हो गए।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "पट्टशिष्य— मुख्य शिष्य।"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "अनुहार— समानता।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "वाक्पाटव— बोलने में चतुराई।"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "चौथा प्रस्ताव"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "बेइंतिहा— असंख्य।"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "आकृति— शकल, सूरत।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "\"मानो……महीने हैं\"— यहाँ उत्प्रेक्षा अलंकारों की एक लड़ी है, जिसमें रूपक अलंकार भी गौण रूप से विद्यमान है।"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "सुकृत-सागर— पुण्य का समुद्र।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "बीजांकुर-न्याय— बीज और अंकुर में जो परस्पर में संबध है, उसी को देखकर इस न्याय की उत्पत्ति हुई है, अर्थात् बीज अंकुर का कारण है, उसी तरह से अंकुर भी बीज का कारण है। यह न्याय ऐसे स्थान पर व्यवहार होता है, जहाँ दो चीज़ों के बीच से कार्य और कारण का संबंध होता है।"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "अंक— चिह्न; चंद्रमा में कलंक।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "सामुद्रिकशास्त्र— ज्योतिषशास्त्र का एक अंग, जिससे हस्त-रेखा आदि का विचार किया जाता है।"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "समाय सके— समा सके (इस तरह का रूप भी भट्टजी की हिंदी की खास विशेषता है। इसी तरह से \"जाय सके\", \"खाय सके\" इत्यादि)।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "लल्लोपत्तो— चापलूसी, ख़ुशामद।"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "खुचुर— (सं॰ कुचर) व्यर्थ का दोष निकालना।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "खुसूसियत— विशेषता।"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "ख़ार खाते हैं— डाह करते हैं।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "अल्हड़पन— अक्खड़पन, बेपरवाही।"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "दर्पदाह ज्वर— अभिमानरूपी जलन पैदा करनेवाला ज्वर।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "दाह— जलन।"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "सदुपदेश शीतलोपचार— अच्छे-अच्छे उपदेशरूपी ठंडक पहुँचानेवाले सामान।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "कारगर— (फ़ा॰-शब्द)उपयोगी, लाभकारक, असर करनेवाली।"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "मीर शिकार— (अमीर शिकार) अमीरों का शिकार करनेवाला। जब एक अमीर के लड़के को बिगाड़ चुके, तब दूसरे, फिर तीसरे, इसी तरह अमीरों के लड़कों को बिगाड़कर उनके धन द्वारा जो आप मज़ा लूटते हैं।"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "खूसट— (सं॰ कौशिक) उल्लू, मनहूस।"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "कलामतों— (सं॰ कलावंत) किसी फ़न या हुनर में उस्ताद।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "दोग़ले— (अरबी-शब्द) वर्ण-संकर"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "पाँचवाँ प्रस्ताव"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "चहले— (सं॰ किचिल) कीचड़।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "नै बै— (सं॰ नै=नई। बै (वय)=उमर) नई उमर, जवानी।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "दारुण— कठोर।"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "सुखद— सुख देनेवाला।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "ऊष्मा— गर्मी।"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "कुसुमबान— जिसका बाण कुसुम (फूल) का हो; जिसे पुष्पधन्वा भी कहते हैं, कामदेव।"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "सलोनापन— लावण्य, लुनाई।"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "उमंग— इच्छा, जोश, उल्लास।"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "अनिर्वचनीय— अकथनीय, जिसका वर्णन न हो सके।"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "दाख— (फ़ा॰-शब्द) अंगूर।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "वयस्संधि— लड़कपन और जवानी की उमर के मिलने का समय, नवयौवन।"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "तरेर— डुबाकर।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "अपिच— बल्कि।"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "तरल तरंगिणी-तुल्य— चंचल नदी के समान।"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "तारुण्यकुतर्की— जवानीरूपी दुष्ट बकवादी।"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "चोखा (चोक्ष)— शुद्ध और उत्तम।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "अज़हद— बहुत अधिक।"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "तिउरी— निगाह, दृष्टि।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "बरहम— क्रोधित।"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "रब्तज़प्त— मेलजोल।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "तक़रीब— (अं॰-शब्द) उत्सव, जलसा।"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "शीशे आलात— (फा॰-शब्द) शीशे के यंत्र—झाड़, फानूस आदि।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "छठा प्रस्ताव"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "सन्नहटा— नीरव, शब्दाभाव।"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "तिग्मांशु— (तिग्म=तेज़। अंशु=किरण) सूर्य।"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "तीखी— (सं॰ तीक्ष्ण) तेज़।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "खरतर— तेज़।"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "ब्रह्मांड— जगत्, संसार।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "तचा— तप्त।"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "लोहपिंड— लोहे का गोला।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "अनुहार— समानता।"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "स्थावर— अचल, स्थिर, जो चले नहीं, जैसे पेड़ इत्यादि।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "जंगम— चलनेवाला, चरिष्णु, जैसे मनुष्य, पशु इत्यादि।"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "यावत्— जितने।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "त्वगिंद्रिय— स्पर्शेंद्रिय, जिस इंद्रिय से स्पर्श का ज्ञान हो।"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "शीतस्पर्शवत्याप— कणाद मुनि ने पाँचों तत्वों में से जल तत्व की परिभाषा में लिखा है कि जल वह तत्व है, जो छूने में शीतल हो।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "दंडायमान— लंबा।"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "ललाटंतप— ललाट (खोपड़ी) को तपानेवाला, अत्यंत गरम, चैलाफाढ़ घाम।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "चडांशु— (चंड=तेज, गरम। अंशु-किरण) सूर्य।"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "उच्चाटन— तंत्र के छै अभिचारी या प्रयोगों में से एक; नाश।"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "रूपगर्विता— अपने सुंदरापे के घमंड में भरी हुई।"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "जगरैतिन— परिश्रम करनेवाली, मेहनतिन।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "विक्षेप— ख़लल।"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "कर्कशा— लड़ाकिन, कटुभाषिणी।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "प्रेमालाप— प्रेम की बातचीत।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "सहिष्णुता— सहन करने की शक्ति।"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "सौहार्द— प्रेम।"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "अठखेली— (सं॰ अष्टक्रीड़ा) मस्तानी या मतवाली चाल।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "अकालजलदोदय— असमय में मेघों का उदय होना।"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "कदर्य— नीच, तुच्छ हृदय"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "घिष्टपिष्ट— हरा मेलजोल।"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "केड़े— (सं॰ करीर) नया पौधा या अंकुर, नवयुवक।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "गुलछर्रे— आनंद, भोग-विलास।"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "निर्गधोज्झित पुष्प— वह फूल, जो सुगंध न रहने से फेंक दिया गया हो।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "ठौर— (सं॰ स्थान) जगह।"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "कुलप्रसूत— उत्तम वंश में पैदा हुआ।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "नटखट— धूर्त, कपटी।"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "वलीअहद— स्थानापन्न, वारिस।"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "उद्घाटन— प्रकट करना, खोल देना।"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "सातवाँ प्रस्ताव"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "ईशानकोण— पूर्व और उत्तर के बीच की दिशा।"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "देवखात— किसी मंदिर के पास का कुंड।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "हलक़ा— घेरा।"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "लहलहे— विकसित, हरे-भरे।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "विटप— वृक्ष।"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "आतप— घाम।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "ज़ियारत— पूजा।"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "परिशिष्ट— बची हुई।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "तीर्थलियों— (सं॰ तीर्थस्थली) तीर्थ के पुजारी और पंडे।"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "फूटीझंझी— फूटी कौड़ी, (यहाँ के दलालों की बोली)।"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "चिरबत्ती— चिथड़ा-चिथड़ा।"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "बइयरबानी— कुलीन स्त्री।"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "अभिसंधि— षड्यंत्र, चुपचाप कई आदमियों के मिलकर एक कोई ख़ास काम करने की सलाह।"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "आठवाँ प्रस्ताव"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "धृष्टता— ढिठाई, निर्लज्जता।"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "अशालीनता— निर्लज्जता; ढिठाई।"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "निरंकुश— स्वतंत्र, स्वेच्छाचारी।"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "हृद्‍गत भाव— वह भाव, जो हृदय के भीतर हो।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "हरकसे बाशद— चाहे कोई हो।"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "आज़ुर्दा— (फ़ा॰-शब्द) खिन्न, दुखी।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "बेनज़ीर— अनुपम; बेजोड़; लासानी।"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "जहूड़ा— (अ॰ ज़हूर) ठाठ, दृश्य, दिखाव।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "मनहूस-कदम— चौपटचरण, जिनका आना अशुभदायक हो।"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "कुंदेनातराश— जाहिल, मूर्ख।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "ब्राह्मी बेला— सूर्योदय के पहले की चार घड़ी।"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "मंगला आरती— वैष्णव संप्रदाय में प्रातःकाल की पहली आरती।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "पौफट— (स॰ प्रस्फुट) सूर्य का उदय।"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "\"पौफट……छा गई\"— रूपक अलं॰।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "\"बने बने के……गायब होने लगे।\"— उत्प्रेक्षा अलं॰।"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "कालकैवर्त्त— कालरूपी मल्लाह।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "\"कालकैवर्त्त…समेट लिया।\"— रूपक अलं॰।"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "\"सूर्य लक्का कबूतर…चुग गया\"— उपमा अलं॰।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "रक्तोत्पल-सदृश— लाल कमल के समान।"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "वासर-श्री— दिन की शोभा।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "\"प्रात: संध्या……इकट्ठा कर रही है\"— समासोक्ति अलं॰।"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "प्रभाकर— सूर्य।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "\"अपने विजयी…होगया\"— उत्प्रेक्षा अलं॰।"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "शनैः शनैः— धीरे-धीरे।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "उदयाचल बालमंदार— उदयाचल पर्वत पर उगा हुआ छोटा मंदार नामी स्वर्गीय वृक्ष।"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "पूर्वदिगंगना— पूर्वदिशारूपी अंगना (स्त्री)"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "श्रोत्रिय— वेदज्ञ, वेदपाठी ब्राह्मण।"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "ख़ुमारी— नशा।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "फ़ारिग़— छुट्टी।"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "खैरख्वाही— भलाई चाहना।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "नुमाइश— बनावट।"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "गुंजायश— स्थान, जगह, समाई।"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "पैरा— (पैर) आगमन; आना।"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "परख— (सं॰ परीक्षा) जाँच।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "तीर्थोदक— तीर्थ जैसे गंगा, यमुना का जल।"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "ओछा— (सं॰ तुच्छ। प्राकृत उच्छ) क्षुद्र, छिछोरा।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "टुच्चा— (सं॰ तुच्छ) नीच, कमीना, छिछोर।"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "तिहीदस्ती— तंग हाथ, ग़रीबी।"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "तरहदारी— शौक़ीनी।"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "नफीस— उम्दा।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "नवाँ प्रस्ताव"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "सरहंग— धृष्ट, प्रगल्भ, बाग़ी।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "दाँताकिटकिट— लड़ाई, झगड़ा।"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "दसवाँ प्रस्ताव"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "ग़ैरत— लज्जा।"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "शिष्टता— भलमनसाहत।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "पस्तकद— नाटा।"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "परिचारक— सेवक; भृत्य।"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "जघन्य— नीच।"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "तरहदारी— सजधज का ढंग।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "हमशीरा— बहन।"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "तस्बी— मुसलमानी माला।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "ज़प्त किए था— चुप था।"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "रुख़सत— बिदा।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "ग्यारहवाँ प्रस्ताव"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "वसीह— लंबा-चौड़ा।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "आरास्ता— (फ़ा॰-शब्द) सजा हुआ, सुसज्जित।"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "ड्राइंग रूम— (अँग॰ शब्द) सजने या कपड़ा पहनने का कमरा, दर्शनगृह, लोगों से मिलने जुलने का कमरा।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "हुस्नपरस्त— सौंदर्योपासक।"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "वयक्रम— उम्र।"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "संजीदगी— गांभीर्य।"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "शऊर— सलीक़ा।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "अलकावली— छल्लेदार बाल।"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "विकसित-पुंडरीक-नेत्र— खिले हुए कमल-समान नेत्र।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "\"यह अपने…कर रही थी\"— उपमा अलं॰।"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "कोकिलकंठी— कोयल समान शब्दवाली।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "मुश्ताक़— इच्छुक।"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "बारहवाँ प्रस्ताव"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "नेचरिये— (अंग॰ Nature) नास्तिक, जो ईश्वर को न मानकर केवल प्रकृति या नेचर ही को संसार का कर्ता-धर्ता मानते हैं।"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "हाफकास्ट— (अँग॰-शब्द) केरानी, यूरेशियन, दोग़ले।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "कुम्मेद— (तुर्की कुमैत) वह घोड़ा, जिसका रंग स्याही लिए लाल हो। इस रंग का घोड़ा बहुत मज़बूत और तेज़ होता है।"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "आठो गाँठ कुम्मैद— अत्यंत चतुर, छटा हुआ, चालाक, धूर्त्त।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "सरिश्ते— विभाग।"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "तदीही— सख़्ती, सज़ा।"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "बर्क— चतुर, चमकीला।"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "बेलौस— पक्षपात-रहित।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "तर्रार— चालाक।"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "लियाकत में ख़ाम— बुद्धि में कमी।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "दामनगीर— संलग्न।"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "तुहफ़े— नज़र, भेट, सौग़ात।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "गौं— (सं॰ गम्य) घात, दाँव, मतलब।"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "गुर्गा— (सं॰ गुरुग) गुरु का अनुगामी, जासूस, दूत।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "मरदूद— जड़-बुद्धि; मूर्ख।"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "उपासनाकांड— आराधना, पूजा।"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "दारमदार— निर्भर।"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "गुट्ट— (सं॰ गोष्टी) समूह; झुंड, दल।"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "केंडिडेट— (अँग॰-शब्द) उम्मेदवार।"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "फ़रमाइशें— आदेश, माँग।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "मुहैया— उपस्थित करना।"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "सिफतें— गुण।"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "मुहताज— दरिद्र, निष्किंचन।"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "ज़ेहननशीन— (फ़ा॰-शब्द) दिल में बैठ जाना।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "ताड़बाज़— भाँपनेवाला।"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "असरैत— आसरे या भरोसे पर रहनेवाले, सहारा पानेवाले, नौकर-चाकर।"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "गदहपचीसी— प्रायः १६ से २५ वर्ष तक की अवस्था। जिसमें लोगों का विश्वास है कि मनुष्य अनुभव-हीन रहता है, और उसकी बुद्धि अपरिपक्व रहती है।"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "तेरहवाँ प्रस्ताव"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "फ़ितनाअंगेज़ी— (फ़ा॰-शब्द) दुष्टता।"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "सकलगुणवरिष्ठ— सब गुणों में श्रेष्ठ।"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "श्रावक— जैन गृहस्थ, सरावगी।"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "थाती— धरोहर, अमानत।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "कीमियागर— (फ़ा॰-शब्द) रसायन बनानेवाला।"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "खुशनवीसी— सुंदर अक्षर लिखने की कला।"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "उजरत— मेहनताना।"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "समानसख्यम्— समान शील स्वभाव के तथा समान दुख में पड़े हुए लोगों में मैत्री होती है।"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "घात— दाँव।"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "अभिप्राय— मतलब।"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "चौदहवाँ प्रस्ताव"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "ताबड़तोड़— लगातार, बराबर, शीघ्र।"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "अबतरी— घटाव, बिगाड़, अवनति, बुराई।"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "यक्षवित्त— कुबेर के समान धनवाला।"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "पलित— जर्जर, शिथिल।"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "चोली-दामन का साथ— बहुत अधिक साथ या घनिष्ठता।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "इश्तियालक— उत्तेजना।"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "बेख़रख़शे— बेखटके।"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "देहक़ानी— ग्रामीण।"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "पंद्रहवाँ प्रस्ताव"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "ऊटकटारा— (सं॰ उष्ट्रकंट) एक कटीली झाड़ी, जिसे ऊँट बडे चाव से खाता है।"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "नीचैर्गच्छति…\"चक्रनेमि-क्रमेण— मनुष्य की दशा पहिए के चाके के समान कभी ऊपर कभी नीचे को जाती है, अर्थात् कभी अच्छी दशा होती है, और कभी ख़राब।"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "ग्रीष्म-संताप-तापित— गर्मी की ताप से जली हुई।"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "वसुधा— पृथ्वी।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "नववारिद— नए बादल।"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "वन-उपवन— बाग़-बग़ीचे।"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "वदान्य— उदार।"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "कथानक— उपन्यास, क़िस्सा।"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "\"नदी-नाले…बह निकले\"— उपमा अलं॰।"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "कलध्वनि— मीठा शब्द।"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "\"विमल-जल……लायक हुए\"— उपमा अलं॰।"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "\"सूर्य-चंद्रमा……पुजवाने लगे\"— उपमा अलं॰।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "घुणाक्षर-न्याय— ऐसी कृति या रचना, जो अनजान में उसी प्रकार हो जाय, जिस प्रकार घुनों के खाते-खाते लकड़ी में अक्षरों की तरह से बहुत-से चिह्न या लकीरें बन जाती हैं। इस न्याय का प्रयोग ऐसे स्थलों पर करते हैं, जहाँ किसी के द्वारा ऐसा आकस्मिक कार्य हो जाता है, जो उसे ज्ञात व अभीष्ट न रहा हो।"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "\"दिन में…हो जाता है\"— उपमा अलं॰।"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "सम-विषम-भाव— ऊबड़-खाबड़ स्वरूप या दशा।"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "तत्त्वदर्शी— ब्रह्म का जाननेवाला, ब्रह्मज्ञानी।"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "\"पृथ्वी पर…जाता ही रहा\"— उपमा अलं॰।"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "शगल— काम।"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "नववारिद-समागम— नए बादल का आगमन।"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "भेकमंडली— मेंढकों का समूह।"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "वाचाट— मुखर, बकवादी, गपोडिया।"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "पखेरुओं— पक्षियों।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "जशन— (फ़ा॰-शब्द) जलसा।"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "कज़्जाक— (तुर्की शब्द) डाकू, लुटेरा, चालाक।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "सोलहवाँ प्रस्ताव"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "पैग़ंबर— अवतार, ईश्वर-दूत।"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "गुनहगार— पापी।"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "सत्रहवाँ प्रस्ताव"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "चंपत हुआ— ग़ायब हुआ।"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "छनक— भड़क।"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "हैरतअंगेज— भय-जनक।"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "साज़नादिर— कभी को या कभी-कभी।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "डामिल— (अ-दायमुल्ह हब्स) जन्म कैद।"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "फरोग़— उन्नति, वृद्धि।"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "तकमीला— पूर्णता।"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "अठारहवाँ प्रस्ताव"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "सुर्ख़रुई— प्रशंसा।"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "हमनिवाले— सहभोजी।"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "हकीर— (फा॰-शब्द) तुच्छ।"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "उन्नीसवाँ प्रस्ताव"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "अवसान— अंत, ओर।"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "ईर्षा-कलुषित— डाह से काली।"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "बहिर्भूमि— बाहर की ओर; बहिरी ओर।"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "भौचक्की— घबराई हुई।"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "बीसवाँ प्रस्ताव"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "निस्स्वार्थ— बिना मतलब के।"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "नामसंकीर्तन— नामोल्लेख।"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "चारुचंचरीक— भ्रमर, भवँरा।"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "अद्यप्रातरेवानिष्टदर्शनम्— आज सबेरे ही अशुभ दर्शन हुआ।"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "आलबाल— थावला।"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "तोफ़गी— उम्दगी।"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "इक्कीसवाँ प्रस्ताव"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "बानीमुबानी— जड़ जमानेवाला।"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "तौहीन— अपमान।"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "बाईसवाँ प्रस्ताव"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "तजवीज— (फा॰-शब्द ) राय, फैसला।"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "कातिव— (अ॰-शब्द) लेखक।"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "तेईसवाँ प्रस्ताव"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "यत्रास्ते…तदपि मृत्यवे— जिस अमृत में विष की कुछ भी मिलावट है, उससे भी मृत्यु ही होती है।"
    }
  ]
}