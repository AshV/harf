{
  "book_id": "kamayani",
  "chapter_id": "ch_12",
  "number": 12,
  "title": "दर्शन सर्ग",
  "word_count": 1825,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "वह चंद्रहीन थी एक रात ,"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "जिसमें सोया था स्वच्छ प्रात ,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "उजले - उजले तारक झलमल"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "प्रतिबिंबित सरिता वक्षस्थल ;"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "धारा बह जाती बिंब अटल ;"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "खुलता था धीरे पवन-पटल ,"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "चुपचाप खड़ी थी वृक्ष पाँत ,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "सुनती जैसे कुछ निजी बात ।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "धूमिल छायाएँ रहीं घूम ,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "लहरी पैरों को रही चूम।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "\"माँ ! तू चल आयी दूर इधर ,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "संध्या कब की चल गयी उधर ।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "इस निर्जन में अब क्या सुंदर--"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "तू देख रही, हाँ बस चल घर"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "उसमें से उठता गंध-धूम\""
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "श्रद्धा ने वह मुख लिया चूम।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "\"माँ ! क्यों तू है इतनी उदास ,"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "क्या मैं हूँ तेरे नहीं पास ,"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "तु कई दिनों से यों चुप रह ;"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "क्या सोच रही है ? कुछ तो कह ;"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "यह कैसा तेरा दुःख-दुसह ,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "जो बाहर-भीतर देता दह ,"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "लेती ढीली-सी भरी सांस ,"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "जैसे होती जाती हताश।\""
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "वह बोली--\"नील गगन अपार ,"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "जिसमें अवनत घन सजल भार ,"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "आते जाते, सुख, दिशि, पल ,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "शिशु-सा आता कर खेल अनिल ,"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "फिर झलमल सुंदर तारक दल ,"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "नभ रजनी के जुगुनू अविरल ,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "यह विश्व अरे कितना उदार !"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "मेरा गृह रे उन्मुक्त-द्वार ।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "यह लोचन-गोचर-सकल-लोक ,"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "संसृति के कल्पित हर्ष शोक ,"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "भावोदधि से किरनों के मग ,"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "स्वाती कन से बन भरते जग ,"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "उत्थान-पतनमय सतत सजग ,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "झरने झरते आलिंगित नग ,"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "उलझन की मीठी रोक टोक ,"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "यह सब उसकी है नोक-झोंक ।"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "जग, जगता आँखें किये लाल ,"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "सोता ओढ़े तम-नींद-जाल ,"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "सुरधनु-सा अपना रंग बदल ,"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "मृति, संसृति, नति, उन्नति में ढल ,"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "अपनी सुषमा में यह झलमल ,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "इस पर लिखता झरता उडुदल ,"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "अवकाश-सरोवर का मराल।"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "कितना सुंदर कितना विशाल ;"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "इसके स्तर-स्तर में मौन शांति ,"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "शीतल अगाध है, ताप-भ्रांति ,"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "परिवर्त्तनमय यह चिर-मंगल ,"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "मुसक्याते इसमें भाव सकल ,"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "हँसता है इसमें कोलाहल ,"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "उल्लास भरा सा अंतस्तल ,"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "मेरा निवास अति-मधुर-कांति ।"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "यह एक नीड़ है सुखद शांति ।\""
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "\"अंबे फिर क्यों इतना विराग ,"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "मुझ पर न हुई क्यों सानुराग ?\""
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "पीछे मुड़ श्रद्धा ने देखा ,"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "वह इड़ा मलिन छबि की रेखा ,"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "ज्यों राहुग्रस्त-सी शशि-लेखा ,"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "जिस पर विषाद की विष-रेखा ,"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "कुछ ग्रहण कर रहा दीन त्याग ,"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "सोया जिसका है भाग्य, जाग।"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "बोली--\"तुमसे कैसी विरक्ति ,"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "तुम जीवन की अंधानुरक्ति ,"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "मुझसे बिछड़े को अवलंबन ।"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "देकर, तुमने रक्खा जीवन ,"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "तुम आशामयि ! चिर आकर्षण ,"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "तुम मादकता की अवगत घन ,"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "मनु के मस्तक की चिर-अतृप्ति ,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "तुम उत्तेजित चंचला-शक्ति!"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "मैं क्या दे सकती तुम्हें मोल ,"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "यह हृदय ! अरे दो मधुर बोल ,"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "मैं हँसती हूँ रो लेती हूँ ,"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "मैं पाती हूँ खो देती हूँ ,"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "इससे ले उसको देती हूँ ,"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "मैं दु:ख को सुख कर लेती हूँ ,"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "अनुराग भरी हूँ मधुर घोल ,"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "चिर-विस्मृति-सी हूँ रही डोल।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "यह प्रभापूर्ण तब मुख निहार ,"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "मनु हत-वेतन से एक बार ,"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "नारी माया-ममता का बल ,"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "वह शक्तिमयी छाया शीतल ,"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "फिर कौन क्षमा कर दे निश्छल ,"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "जिससे यह धन्य बने भूतल ,"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "तुम क्षमा करोगी' यह विचार ,"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "मैं छोड़ूँ कैसे साधिकार ?\""
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "\"अब मैं रह सकती नहीं मौन ,"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "अपराधी किंतु यहाँ न कौन ?"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "सुख-दुःख जीवन में सब सहते ,"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "पर केवल सुख अपना कहते"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "अधिकार न सीमा में रहते ,"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "पावस - निर्भर - से वे बहते ,"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "रोके फिर उनको भला कौन ?"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "सबको वे कहते—शत्रु हो न !'"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "अग्रसर हो रही यहाँ फूट ,"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "सीमाएँ कृत्रिम रहीं टूट ,"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "श्रम-भाग वर्ग, बन गया जिन्हें ,"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "अपने बल का है गर्व उन्हें ,"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "नियमों की करनी सष्टि जिन्हें ।"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "विप्लव की करनी वृष्टि उन्हें ,"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "सब पिये मत्त लालसा घूँट ;"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "मेरा साहस अब गया छूट।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "मैं जनपद-कल्याणी प्रसिद्ध ,"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "अब अवनति कारण हूँ निषिद्ध ,"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "मेरे सुविभाजन हुए विषम ,"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "टूटते, नित्य बन रहे नियम ,"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "नाना केंद्रों में जलधर-सम ,"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "घिर हट, बरसे ये उपलोपम ।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "यह ज्वाला इतनी है समिद्ध ,"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "आाहुति बस चाह रही समृद्ध ।"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "तो क्या मैं भ्रम में थी नितांत ,"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "संहार-बध्य, असहाय दांत ,"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "प्राणी विनाश-मुख में अविरल ,"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "चुपचाप चलें होकर निर्बल !"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "संघर्ष कर्म का मिथ्या बल ,"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "ये शक्ति-चिह्न, ये यज्ञ विफल ,"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "भय की उपासना ! प्रणति भ्रांत !"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "अनुशासन की छाया अशांत !"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "तिस पर मैंने छीना सुहाग ,"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "हे देवि ! तुम्हारा दिव्य-राग ,"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "मैं आज अकिंचन पाती हूँ ,"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "अपने को नहीं सुहाती हूँ ,"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "</poem>"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "मैं जो कुछ भी स्वर गाती हूँ ,"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "वह स्वयं नहीं सुन पाती हूँ ,"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "दो क्षमा, न दो अपना विराग ,"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "सोयी चेतनता उठे जाग।\""
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "\"है रुद्र-रोष अब तक अशांत ”,"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "श्रद्धा बोली, \"बन विषम ध्वांत !"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "सिर चढ़ी रही ! पाया न हृदय"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "तू विकल कर रही है अभिनय ,"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "अपनापन चेतन का सुखमय ,"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "खो गया, नहीं आलोक उदय ,"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "सब अपने पथ पर चलें श्रांत ,"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "प्रत्येक विभाजन बना भ्रांत।\""
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "जीवन धारा सुन्दर प्रवाह ,"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "सत्, सतत, प्रकाश सुखद अथाह ,"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "ओ तर्कमयी ! तू गिने लहर ,"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "प्रतिबिंबित तारा पकड़, ठहर ,"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "तू रुक-रुक देखे आठ पहर ,"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "वह जड़ता की स्थिति, भूल न कर ,"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "सुख-दुख का मधुमय धूप-छाँह ,"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "तूने छोड़ी यह सरल राह।"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "चेतनता का भौतिक विभाग--"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "कर, जग को बाँट दिया विराग ,"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "चिति का स्वरूप यह नित्य-जगत ,"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "वह रूप बदलता है शत-शत ,"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "कण विरह-मिलन-मय नृत्य-निरत"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "उल्लासपूर्ण आनंद सतत"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "</poem>"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "तल्लीन-—पूर्ण है एक राग,"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "झंकृत है केवल 'जाग जाग !'"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "मैं लोक-अग्नि में तप नितांत ,"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "आहुति प्रसन्न देती प्रशांत ,"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "तू क्षमा न कर कुछ चाह रही ,"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "जलती छाती की दाह रही ,"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "तो ले ले जो निधि पास रही ,"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "मुझको बस अपनी राह रही,"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "रह सौम्य ! यहीं, हो सुखद प्रांत ,"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "विनिमय कर दे कर कर्म कांत।"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "तुम दोनों देखो राष्ट्र-नीति ,"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "शासक बन फैलाओ न भीति ,"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "मैं अपने मनु को खोज चली ,"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "सरिता, मरु, नग या कुंज-गली,"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "वह भोला इतना नहीं छली !"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "मिल जायेगा, हूँ प्रेम-पली ,"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "तब देख कैसी चली रीति ,"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "मानव ! तेरी हो सुयश गीति ।\""
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "बोला बालक, \"ममता न तोड़ ,"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "जननी ! मुझसे मुँह यों न मोड़ ,"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "तेरी आज्ञा का कर पालन ,"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "वह स्नेह सदा करता लालन--"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "मैं मरूँ जिऊँ पर छुटे न प्रण,"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "वरदान बने मेरा जीवन !"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "जो मुझको तू यों चली छोड़ ,"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "तो मुझे मिले फिर यही क्रोड़ !\""
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "\"हे सौम्य ! इड़ा का शुचि दुलार ,"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "हर लेगा तेरा व्यथा-भार ,"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "यह तर्कमयी तू श्रद्धामय ,"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "तू मननशील कर कर्म अभय ,"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "इसका तू सब संताप निश्चय ,"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "हर ले, हो मानव भाग्य उदय ,"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "सब की समरसता का प्रचार ,"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "मेरे सुत ! सुन माँ की पुकार ।\""
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "\"अति मधुर वचन विश्वास मूल ,"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "मुझको न कभी ये जायें भूल ;"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "हे देवि ! तुम्हारा स्नेह प्रबल ,"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "बन दिव्य श्रेय-उद्गम अविरल ,"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "आकर्षण धन-सा वितरे जल ,"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "निर्वासित हों संताप सकल !\""
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "कह इड़ा प्रणत ले चरण धूल ,"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "पकड़ा कुमार-कर मृदुल फूल ।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "वे तीनों ही क्षण एक मौन--"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "विस्मृत से थे, हम कहाँ कौन !"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "विच्छेद बाह्य, था आलिंगन--"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "वह हृदयों का अति मधुर मिलन ,"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "मिलते आहत होकर जलकन ,"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "लहरों का यह परिणत जीवन ,"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "दो लौट चले पुर ओर मौन ,"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "जब दूर हुए तब रहे दो न !"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "निस्तब्ध गगन था, दिशा शांत ,"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "वह था असीम का चित्र कांत।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "कुछ शून्य बिंदु उर के ऊपर ,"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "व्यथिता रजनी के श्रमसीकर ,"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "झलके कब से पर पड़े न झर ,"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "गंभीर मलिन छाया भू पर ,"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "सरिता तट तरु का क्षितिज प्रांत ,"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "केवल बिखेरता दीन ध्वांत ।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "शत-शत तारा मंडित अनंत ,"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "कुसुमों का स्तबक खिला वसंत ,"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "हँसता ऊपर का विश्व मधुर ,"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "हलके प्रकाश से पूरित उर,"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "बहती माया सरिता ऊपर ,"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "उठती किरणों की लोल लहर ,"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "निचले स्तर पर छाया दुरंत ,"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "आती चुपके, जाती तुरन्त ।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "सरिता का वह एकांत कूल ,"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "था पवन हिंडोले रहा झूल ,"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "धीरे-धीरे लहरों का दल ,"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "तट से टकरा होता ओझल ,"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "छप छप का होता शब्द विरल ,"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "थर थर कैंप रहती दीप्ति तरल ;"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "संसृति अपने में रही भूल ,"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "वह गंध-विधुर अम्लान फूल ।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "तब सरस्वती-सा फेंक साँस ,"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "श्रद्धा ने देखा आसपास ,"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "थे चमक रहे दो खुले नयन ,"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "ज्यों शिलालग्न अनगढ़े रतन,"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "वह क्या तम में करता सनसन ?"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "धारा का ही क्या हय निस्वन !"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "ना, गुहा लतावृत एक पास ,"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "कोई जीवित ले रहा साँस !"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "वह निर्जन तट था एक चित्र ,"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "कितना सुन्दर, कितना पवित्र ?"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "कुछ उन्नत थे वे शैलशिखर ,"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "फिर भी ऊँचा श्रद्धा का सिर ,"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "वह लोक-अग्नि में तप गल कर ,"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "थी ढली स्वर्ण-प्रतिमा बन कर ,"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "मनु ने देखा कितना विचित्र !"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "वह मातृ-मूर्त्ति थी विश्व-मित्र ।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "बोले, \"रमणी तुम नहीं आह !"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "जिसके मन में हो भरी चाह ,"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "तुमने अपना सब कुछ खोकर ,"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "वंचिते ! जिसे पाया रोकर ,"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "मैं भगा प्राण जिनसे लेकर ,"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "उसको भी उन सबको देकर ,"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "निर्दय मन क्या न उठा करह ?"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "अद्भुत है तब मन का प्रवाह !"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "ये श्वापद से हिंसक अधीर ,"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "कोमल शावक वह बाल वीर ,"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "सुनता था वह वाणी शीतल ,"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "कितना दुलार कितना निर्मल !"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "कैसा कठोर है तब हृत्तल !"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "वह इड़ा कर गयी फिर भी छल,"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "तुम बनी रही हो अभी धीर ,"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "छुट गया हाथ से आाह तीर ।\""
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "प्रिय ! अब तक हो इतने सशंक ,"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "देकर कुछ कोई नहीं रंक ,"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "यह विनिमय है या परिवर्त्तन ,"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "बन रहा तुम्हारा ऋण अब धन ,"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "अपराध तुम्हारा वह बंधन--"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "लो बना मुक्ति, अब छोड़ स्वजन--"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "निर्वासित तुम, क्यों लगे डंक ?"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "दो लो प्रसन्न, यह स्पष्ट अंक ।”"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "\"तुम देवि ! आह कितनी उदार ,"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "यह मातृ-मूर्त्ति है निर्विकार ,"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "हे सर्वमंगले ! तुम महती ,"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "सबका दुःख अपने पर सहती ,"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "कल्याणमयी वाणी कहती ,"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "तुम क्षमा निलय में हो रहती ,"
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "मैं भूला हूँ तुमको निहार--"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "नारी-सा ही, वह लघु विचार ।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "मैं इस निर्जन तट में अधीर ,"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "सह भूख व्यथा तीखा समीर ,"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "हाँ भावचक्र में पिस पिस कर,"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "चलता ही आया हूँ बढ़ कर ,"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "इनके विकार सा ही बन कर ,"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "मैं शून्य बना सत्ता खोकर ,"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "लघुता मत देखो वक्ष चीर ,"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "जिसमें अनुशय बन घुसा तीर।\""
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "\"प्रियतम ! यह नत निस्तब्ध रात ,"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "है स्मरण कराती विगत बात ,"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "वह प्रलय शांति वह कोलाहल ,"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "जब अर्पित कर जीवन संबल ,"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "मैं हुई तुम्हारी थी निश्छल ,"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "क्या भूलूँ मैं , इतनी दुर्बल ?"
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "तब चलो जहाँ पर शांति प्रात ,"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "मैं नित्य तुम्हारी, सत्य बात।"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "इस देव-द्वंद्व का वह प्रतीक--"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "मानव ! कर ले सब भूल ठीक ,"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "यह विष जो फैला महा-विषम ,"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "निज कर्मोन्नति से करते सम ,"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "सब मुक्त बनें, काटेंगे भ्रम ,"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "उनका रहस्य हो शुभ-संयम ,"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "गिर जायेगा जो है अलीक ,"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "चल कर मिटती है पड़ी लीक । \""
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "वह शून्य असत या अंधकार ,"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "अवकाश पटल का वार पार ,"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "बाहर - भीतर उन्मुक्त सघन ,"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "था अचल महा नीला अंजन ,"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "भूमिका बनी वह स्निग्ध मलिन ,"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "थे निनिमेष मनु के लोचन ,"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "इतना अनंत था शून्य-सार ,"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "दीखता न जिसके परे पार।"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "सत्ता का स्पंदन चला डोल ,"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "आवरण पटल की ग्रंथि खोल,"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "तम जलनिधि का बन मधुमथन,"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "ज्योत्स्ना सरिता का आलिंगन,"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "वह रजत गौर, उज्ज्वल जीवन,"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "आलोक पुरुष! मंगल चेतन!"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "केवल प्रकाश का था कलोल,"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "मधु किरणों की थी लहर लोल।"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "बन गया तमस था अलक जाल,"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "सर्वांग ज्योतिमय था विशाल,"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "अंतनिनाद ध्वनि से पूरित,"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "थी शन्य-भेदिनी--सत्ता चित्,"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "नटराज स्वयं थे नृत्य-निरत,"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "था अंतरिक्ष प्रहसित मुखरित,"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "स्वर लय होकर दे रहे ताल,"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "थे लुप्त हो रहे दिशाकाल।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "लीला का स्पंदित आह्लाद,"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "वह प्रजा-पुंज चितिमय प्रसाद,"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "आनंद पूर्ण तांडव सुन्दर,"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "करते थे उज्ज्वल श्रम सीकर,"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "बनते तारा, हिमकर, दिनकर,"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "उड़ रहे धूलिकण-से भूधर,"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "संहार सृजन से युगल पाद--"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "गतिशील, अनाहत हुआ नाद।"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "बिखरे असंख्य ब्रह्मांड गोल,"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "युग त्याग ग्रहण कर रहे तोल,"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "विद्युत् कटाक्ष चल गया जिधर,"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "कंपित संसृति बन रही उधर,"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "चेतन परमाणु अनंत बिखर ,"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "बनते विलीन होते क्षण भर !"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "यह विश्व झूलता महा दोल ,"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "परिवर्त्तन का पट रहा खोल ।"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "उस शक्ति-शरीरी का प्रकाश ,"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "सब शाप पाप का कर विनाश--"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "नर्त्तन में निरत, प्रकृति गल कर"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "उस कांति सिंधु में घुल-मिलकर ,"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "अपना स्वरूप धरती सुन्दर ,"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "कमनीय बना था भीषणतर"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "हीरक-गिरि पर विद्युत-विलास ,"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "उल्लसित महा हिम धवल हास ।"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "देखा मनु ने नर्त्तित नटेश ,"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "हत चेत पुकार उठे विशेष--"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "यह क्या ! श्रद्घे ! बस तू ले चल ,"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "उन चरणों तक, दे निज संबल ,"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "सब पाप-पुण्य जिसमें जलजल ,"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "पावन बन जाते हैं निर्मल ,"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "मिटते असत्य-से ज्ञान-लेश ,"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "समरस, अखंड, आनंद-वेश\"!"
    }
  ]
}