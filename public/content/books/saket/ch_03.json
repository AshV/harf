{
  "book_id": "saket",
  "chapter_id": "ch_03",
  "number": 3,
  "title": "द्वितीय सर्ग",
  "word_count": 2511,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "लेखनी, अब किस लिए विलम्ब?"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "बोल,--जय भारति, जय जगदम्ब।"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "प्रकट जिसका यों हुआ प्रभात,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "देख अब तू उस दिन की रात।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "धरा पर धर्मादर्श-निकेत,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "धन्य है स्वर्ग-सदृश साकेत।"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "बढ़े क्यों आज न हर्षोद्रेक?"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "राम का कल होगा अभिषेक।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "दशों दिक्पालों के गुणकेन्द्र,"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "धन्य हैं दशरथ मही-महेन्द्र।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "त्रिवेणी-तुल्य रानियाँ तीन,"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "बहाती सुखप्रवाह नवीन।"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "मोद का आज न ओर न छोर;"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "आम्र-वन-सा फूला सब ओर।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "किन्तु हा! फला न सुमनक्षेत्र,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "कीट बन गये मन्थरा-नेत्र।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "देख कर कैकेयी यह हाल,"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "आप उससे बोली तत्काल--"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "\"अरी, तू क्यों उदास है आज,"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "वत्स जब कल होगा युवराज?\""
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "मन्थरा बोली निस्संकोच--"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "\"आपको भी तो है कुछ सोच?\""
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "हँसी रानी सुन कर वह बात,"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "उठी अनुपम आभा अवदात।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "\"सोच है मुझको निस्सन्देह,"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "भरत जो है मामा के गेह।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "सफल करके निज निर्मल-दृष्टि,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "देख वह सका न यह सुख-सृष्टि!\""
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "ठोक कर अपना क्रूर-कपाल,"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "जता कर यही कि फूटा भाल,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "किंकरी ने तब कहा तुरन्त--"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "\"हो गया भोलेपन का अन्त!\""
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "न समझी कैकेयी यह बात;"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "कहा उसने--\"यह क्या उत्पात?"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "वचन क्यों कहती है तू वाम?"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "नहीं क्या मेरा बेटा राम?\""
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "\"और वे औरस भरत कुमार?\""
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "कुदासी बोली कर फटकार।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "कहा रानी ने पाकर खेद--"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "\"भला दोनों में है क्या भेद?\""
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "\"भेद?\"-दासी ने कहा सतर्क--"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "\"सबेरे दिखला देगा अर्क।"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "राजमाता होंगी जब एक,"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "दूसरी देखेंगी अभिषेक!\""
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "रोक कर कैकेयी ने रोष,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "कहा--\"देती है किसको दोष?"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "राम की माँ क्या कल या आज"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "कहेगा मुझे न लोक-समाज?\""
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "कहा दासी ने धीरज त्याग--"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "\"लगे इस मेरे मुहँ में आग।"
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "मुझे क्या, मैं होती हूँ कौन?"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "नहीं रहती हूँ फिर क्यों मौन?"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "देख कर किन्तु स्वामि-हित-घात,"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "निकल ही जाती है कुछ बात।"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "इधर भोली हैं जैसी आप,"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "समझती सब को वैसी आप!"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "नहीं तो यह सीधा षड्यन्त्र,"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "रचा क्यों जाता यहाँ स्वतन्त्र?"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "महारानी कौसल्या आज,"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "सहज सज लेतीं क्या सब साज?\""
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "कहा रानी ने--\"क्या षड्यन्त्र?"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "वचन हैं तेरे मायिक मन्त्र।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "हुई जाती हूँ मैं उद्भ्रान्त;"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "खोल कर कह तू सब वृत्तान्त।\""
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "मन्थरा ने फिर ठोका भाल--"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "\"शेष है अब भी क्या कुछ हाल?"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "सरलता भी ऐसी है व्यर्थ,"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "समझ जो सके न अर्थानर्थ।"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "भरत को करके घर से त्याज्य,"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "राम को देते हैं नृप राज्य।"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "भरत-से सुत पर भी सन्देह,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "बुलाया तक न उन्हें जो गेह!\""
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "कहा कैकेयी ने सक्रोध--"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "\"दूर हो दूर अभी निर्बोध!"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "सामने से हट, अधिक न बोल,"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "द्विजिह्वे, रस में विष मत घोल।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "उड़ाती है तू घर में कीच;"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "नीच ही होते हैं बस नीच।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "हमारे आपस के व्यवहार,"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "कहाँ से समझे तू अनुदार?\""
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "हुआ भ्रू-कुंजित भाल विशाल,"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "कपोलों पर हिलते थे बाल।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "प्रकट थी मानों शासन-नीति;"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "मन्थरा सहमी देखि सभीति।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "तीक्ष्ण थे लोचन अटल अडोल;"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "लाल थे लाली भरे कपोल।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "न दासी देख सकी उस ओर;"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "जला दे कहीं न कोप कठोर!"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "किन्तु वह हटी न अपने आप,"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "खड़ी ही रही नम्र चुपचाप।"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "अन्त में बोली स्वर-सा साध--"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "\"क्षमा हो मेरा यह अपराध।"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "स्वामि-सम्मुख सेवक या भृत्य,"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "आप ही अपराधी हैं नित्य।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "दण्ड दें कुछ भी आप समर्थ;"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "कहा क्या मैंने अपने अर्थ?"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "समझ में आया जो कुछ मर्म,"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "उसे कहना था मेरा धर्म।"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "न था यह मेरा अपना कृत्य;"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "भर्तृ हैं भर्तृ, भृत्य हैं भृत्य।\""
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "मही पर अपना माथा टेक,"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "भरा था जिसमें अति अविवेक,"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "किया दासी ने उसे प्रणाम,"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "और वह चली गई अविराम।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "गई दासी, पर उसकी बात"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "दे गई मानों कुछ आघात--"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "’भरत-से सुत पर भी सन्देह,"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "बुलाया तक न उन्हें जो गेह!’"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "पवन भी मानों उसी प्रकार"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "शून्य में करने लगा पुकार--"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "’भरत-से सुत पर भी सन्देह,"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "बुलाया तक न उन्हें जो गेह!’"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "गूँजते थे रानी के कान,"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "तीर-सी लगती थी वह तान--"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "’भरत-से सुत पर भी सन्देह,"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "बुलाया तक न उन्हें जो गेह!’"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "मूर्ति-सी बनी हुई उस ठौर"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "खड़ी रह सकी न अब वह और।"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "गई शयनालय में तत्काल;"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "गभीरा सरिता-सी थी चाल।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "न सह कर मानों तनु का भार,"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "लेट कर करने लगी विचार।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "कहा तब उसने--\"हे भगवान,"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "आज क्या सुनते हैं ये कान?"
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "मनोमन्दिर की मेरी शान्ति"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "बनी जाती है क्यों उत्क्रान्ति?"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "लगा दी किसने आकर आग?"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "कहाँ था तू संशय के नाग?"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "नाथ, कैकेयी के वर-वित्त,"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "चीर कर देखो उसका चित्त।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "स्वार्थ का वहाँ नहीं है लेश,"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "बसे हो एक तुम्हीं प्राणेश!"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "सदा थे तुम भी परमोदार,"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "हुआ क्यों सहसा आज विकार?"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "भरत-से सुत पर भी सन्देह,"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "बुलाया तक न उसे जो गेह!"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "न थी हम माँ-बेटे की चाह,"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "आह! तो खुली न थी क्या राह?"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "मुझे भी भाई के घर नाथ,"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "भेज क्यों दिया न सुत के साथ?"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "राज्य का अधिकारी है ज्येष्ठ,"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "राम में गुण भी हैं सब श्रेष्ठ।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "भला फिर भी क्या मेरा वत्स"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "शान्त रस में बनता वीभत्स?"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "तुम्हारा अनुज भरत हे राम,"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "नहीं है क्या नितान्त निष्काम?"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "जानते जितना तुम कुलधन्य,"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "भरत को कौन जानता अन्य?"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "भरत रे भरत, शील-समुदाय,"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "गर्भ में आकर मेरे हाय!"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "हुआ यदि तू भी संशय-पात्र,"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "दग्ध हो तो मेरा यह गात्र!"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "चली जा पृथिवी, तू पाताल,"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "आप को संशय में मत डाल।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "कहीं तुझ पर होता विश्वास,"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "भरत में पहले करता वास।"
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "अरे विश्वास, विश्व-विख्यात,"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "किया है किसने तेरा घात?"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "भरत ने? वह है तेरी मूर्ति,"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "राम ने? वह है प्राणस्फूर्ति।"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "देव ने? वे हैं सदय सदैव,"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "दैव ने? हा घातक दुर्दैव!"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "तुझे क्या हे अदृष्ट, है इष्ट?"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "सूर्य-कुल का हो आज अनिष्ट?"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "बाँध सकता है कहाँ परन्तु--"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "राघवों को अदृष्ट का तन्तु?"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "भाग्य-वश रहते हैं बस दीन,"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "वीर रखते हैं उसे अधीन।"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "हाय! तब तूने अरे अदृष्ट,"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "किया क्या जीजी को आकृष्ट?"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "जान कर अबला, अपना जाल--"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "दिया है उस सरला पर डाल?"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "किन्तु हा! यह कैसा सारल्य?"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "सालता है जो बनकर शल्य।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "भरत-से सुत पर भी सन्देह,"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "बुलाया तक न उसे जो गेह!"
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "बहन कौसल्ये, कह दो सत्य,"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "भरत था मेरा कभी अपत्य?"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "पुत्र था कभी तुम्हारा राम?"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "हाय रे! फिर भी यह परिणाम?"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "किन्तु चाहे जो कुछ हो जाय,"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "सहूँगी कभी न यह अन्याय।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "करूँगी मैं इसका प्रतिकार,"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "पलट जावे चाहे संसार।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "नहीं है कैकेयी निर्बोध,"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "पुत्र का भूले जो प्रतिशोध।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "कहें सब मुझको लोभासक्त,"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "किन्तु सुत, हूजो तू न विरक्त।"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "भरत की माँ हो गई अधीर,"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "क्षोभ से जलने लगा शरीर।"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "दाह से भरा सौतिया डाह,"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "बहाता है बस विषप्रवाह।"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "मानिनी कैकेयी का कोप"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "बुद्धि का करने लगा विलोप।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "और रह सकी न अब वह शान्त,"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "उठी आँधी-सी होकर भ्रान्त।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "एड़ियों तक आ छूटे केश,"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "हुआ देवी का दुर्गा-वेश।"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "पड़ा तब जिस पदार्थ पर हस्त"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "उसे कर डाला अस्त-व्यस्त।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "तोड़ कर फेंके सब श्रृंगार,"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "अश्रुमय-से थे मुक्ता-हार।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "मत्त कारिणी-सी दल कर फूल"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "घूमने लगी आपको भूल।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "चूर कर डाले सुन्दर चित्र,"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "हो गये वे भी आज अमित्र!"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "बताते थे आ आ कर श्वास--"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "हृदय का ईर्ष्या-वह्नि-विकास।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "पतन का पाते हुए प्रहार"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "पात्र करते थे हाहाकार--"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "\"दोष किसका है, किस पर रोष,"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "किन्तु यदि अब भी हो परितोष!\""
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "इसी क्षण कौसल्या अन्यत्र,"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "सजा कर पट-भूषण एकत्र--"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "बधू को युवराज्ञी के योग्य,"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "दे रही थीं उपदेश मनोज्ञ।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "इधर कैकेयी उनका चित्र"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "खींचती थी सम्मुख अपवित्र।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "दोष-दर्शी होता है द्वेष,"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "गुणों को नहीं देखता त्वेष।"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "राजमाता होकर प्रत्यक्ष,"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "उसे करके वे मानों लक्ष"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "खड़ी हँसती हैं वारंवार"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "हँसी है वह या असि की धार?"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "उठी तत्क्षण कैकेयी काँप,"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "अधर-दंशन करके कर चाँप।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "भूमि पर पटक पटक कर पैर,"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "लगी प्रकटित करने निज वैर।"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "अन्त में सारे अंग समेट"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "गई वह वहीं भूमि पर लेट।"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "छोड़ती थी जब जब हुंकार,"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "चुटीली फणिनी-सी फुंकार!"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "इधर यों हुआ रंग में भंग,"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "उर्मिला उधर प्राणपति-संग,"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "भरत-विषयक ही वार्त्तालाप"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "छेड़ कर सुनती थी चुपचाप।"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "बताते थे लक्ष्मण वह भेद"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "कि \"इसका है हम सबको खेद।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "किन्तु अवसर था इतना अल्प"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "न आ सकते वे शुभ-संकल्प।"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "परे थी और न ऐसी लग्न,"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "पिता भी थे आतुरता-मग्न।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "चलो, अविभिन्न आर्य की मूर्ति"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "करेगी भरत-भाव की पूर्ति।\""
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "इस समय क्या करते थे राम?"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "हृदय के साथ हृदय-संग्राम।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "उच्च हिमगिरि से  भी वे धीर"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "सिन्धु-सम थे सम्प्रति गम्भीर।"
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "उपस्थित वह अपार अधिकार"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "दीख पड़ता था उनको भार।"
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "पिता का निकट देख वन-वास"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "हो रहे थे वे आप उदास।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "हाय! वह पितृ-वत्सलता-भोग,"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "और निज बाल्यभाव का योग,"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "विगत-सा समझ एक ही संग,"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "शिथिल-से थे उनके सब अंग।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "कहा वैदेही ने--\"हे नाथ,"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "अभी तक चारों भाई साथ"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "भोगते थे तुम सम-सुख-भोग,"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "व्यवस्था मेट रही वह योग।"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "भिन्न-सा करके कोसलराज--"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "राज्य देते हैं तुमको आज।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "तुम्हें रुचता है यह अधिकार?\""
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "\"राज्य है प्रिये, भोग या भार?"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "बड़े के लिए बड़ा ही दण्ड,"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "प्रजा की थाती रहे अखण्ड।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "तदपि निश्चिन्त रहो तुम नित्य,"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "यहाँ राहित्य नहीं, साहित्य।"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "रहेगा साधु भरत का मन्त्र,"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "मनस्वी लक्ष्मण का बल-तन्त्र।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "तुम्हारे लघु देवर का धाम,"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "मात्र दायित्व-हेतु है राम।\""
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "\"नाथ, यह राज-नियुक्ति पुनीत,"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "किन्तु लघु देवर की है जीत।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "हुआ जिसके अधीन नृप-गेह,"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "सचिव-सेनापति-सह सस्नेह!\""
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "कोपना कैकेयी की बात--"
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "किसी को न थी अभी तक ज्ञात।"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "न जाने, पृथ्वी पर प्रच्छन्न"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "कहाँ क्या होता है प्रतिपन्न!"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "भूप क्या करते थे इस काल?"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "लेखनी, लिख उनका भी हाल।"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "भूप बैठे थे कुलगुरु-संग,"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "भरत का ही था छिड़ा प्रसंग।"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "कहा कुलगुरु ने--\"निस्सन्देह"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "खेद है भरत नहीं जो गेह।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "किन्तु यह अवसर था उपयुक्त"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "कि नृप हो जावें चिन्तामुक्त।\""
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "भूप बोले--\"हाँ मेरा चित्त"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "विकल था आत्म-भविष्य-निमित्त।"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "इसीसे था मैं अधिक अधीर,"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "आज है तो कल नहीं शरीर।"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "मार कर धोखे में मुनि-बाल"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "हुआ था मुझको शाप कराल।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "कि ’तुमको भी निज पुत्र-वियोग"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "बनेगा प्राण-विनाशक रोग।’"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "अस्तु यह भरत-विरह अक्लिष्ट"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "दुःखमय होकर भी था इष्ट।"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "इसी मिष पाजाऊँ चिरशान्ति"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "सहज ही समझूँ तो निष्क्रान्ति!\""
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "दिया नृप को वसिष्ठ ने धैर्य,"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "कहा--\"यह उचित नहीं अस्थैर्य।"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "ईश के इंगित के अनुसार"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "हुआ करते हैं सब व्यापार।\""
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "\"ठीक है,\" इतना कह कर भूप"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "शान्त हो गये सौम्य शुभरूप।"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "हो रहा था उस समय दिनान्त,"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "वायु भी था मानों कुछ श्रान्त।"
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "गोत्र-गुरु और देव भी आद्य"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "प्रणति युत पाकर अर्ध्य सपाद्य"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "गये तब जाना था जिस ओर,"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "चले नृप भी भीतर इस ओर।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "अरुण संध्या को आगे ठेल,"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "देखने को कुछ नूतन खेल,"
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "सजे विधु की बेंदी से भाल,"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "यामिनी आ पहुँची तत्काल।"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "सामने कैकेयी का गेह"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "शान्त देखा नृप ने सस्नेह।"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "मन्थरा किन्तु गई थी ताड़"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "कि यह है ज्वालामुखी पहाड़!"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "पधारे तब भीतर भूपाल,"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "वहाँ जाकर देखा जो हाल"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "रह गये उससे वे जड़-तुल्य;"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "बढ़ा भय-विस्मय का बाहुल्य।"
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "न पाकर मानों आज शिकार"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "सिंहिनी सोती थी सविकार।"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "कोप क्या इसका यह एकान्त"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "प्राण लेकर भी होगा शान्त?"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "कुशल है यदि ऐसा हो जाय,"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "भूप-मुख से निकला बस \"हाय!\""
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "टूट कर यह तारा इस रात"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "न जाने, करे न क्या उत्पात!"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "पड़ी थी बिजली-सी विकराल,"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "लपेटे थे घन-जैसे बाल।"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "कौन छेड़े ये काले साँप?"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "अवनिपति उठे अचानक काँप।"
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "किन्तु क्या करते, धीरज धार,"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "बैठ पृथिवी पर पहली बार,"
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "खिलाते-से वे व्याल विशाल,"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "विनय पूर्वक बोले भूपाल--"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "\"प्रिये, किसलिये आज यह क्रोध?"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "नहीं होता कुछ मुझको बोध।"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "तुम्हारा धन है मान अवश्य;"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "किन्तु हूँ मैं तो यों ही वश्य।"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "जान पड़ता यह नहीं विनोद,"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "आज यद्यपि सबको है मोद।"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "सजे जाते हैं सुख के साज,"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "तुम्हें क्या दुःख हुआ है आज?"
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "अम्ल हो कर भी मधुर रसाल,"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "गया निज प्रणय-कलह का काल।"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "आज हो कर हम रागातीत,"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "हुए प्रेमी से पितर पुनीत।"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "भरत की अनुपस्थिति का खेद,"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "किन्तु है इसमें ऐसा भेद,"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "निहित है जिसमें मेरा क्षेम,"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "प्रिये, प्रत्यय रखता है प्रेम।"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "हुआ हो यदि कुछ रोग-विकार,"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "बुलाऊँ वैद्य, करूँ उपचार।"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "अमृत भी मुझको नहीं अलभ्य,"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "कि मैं हूँ अमर-सभा का सभ्य।"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "किया हो कहीं किसी ने दोष"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "कि जिसके कारण है यह रोष,"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "बता दो तो तुम उसका नाम,"
    },
    {
      "id": "b_364",
      "type": "p",
      "text": "दैव है निश्चय उस पर वाम।"
    },
    {
      "id": "b_365",
      "type": "p",
      "text": "सुनूँ मैं उसका नाम सुमिष्ट,"
    },
    {
      "id": "b_366",
      "type": "p",
      "text": "कौन सी वस्तु तुम्हें है ईष्ट?"
    },
    {
      "id": "b_367",
      "type": "p",
      "text": "जहाँ तक दिनकर-कर-प्रसार,"
    },
    {
      "id": "b_368",
      "type": "p",
      "text": "वहाँ तक समझो निज अधिकार।"
    },
    {
      "id": "b_369",
      "type": "p",
      "text": "किसीको करना हो कुछ दान,"
    },
    {
      "id": "b_370",
      "type": "p",
      "text": "करो तो दुगुना आज प्रदान,"
    },
    {
      "id": "b_371",
      "type": "p",
      "text": "भरा रत्नाकर-सा भण्डार"
    },
    {
      "id": "b_372",
      "type": "p",
      "text": "रीत सकता है किसी प्रकार?"
    },
    {
      "id": "b_373",
      "type": "p",
      "text": "माँगना हो तुमको जो आज"
    },
    {
      "id": "b_374",
      "type": "p",
      "text": "माँग लो, करो न कोप न लाज।"
    },
    {
      "id": "b_375",
      "type": "p",
      "text": "तुम्हें पहले ही दो वरदान"
    },
    {
      "id": "b_376",
      "type": "p",
      "text": "प्राप्य हैं, फिर भी क्यों यह मान?"
    },
    {
      "id": "b_377",
      "type": "p",
      "text": "याद है वह संवर-रण-रंग,"
    },
    {
      "id": "b_378",
      "type": "p",
      "text": "विजय जब मिली व्रणों के संग?"
    },
    {
      "id": "b_379",
      "type": "p",
      "text": "किया था किसने मेरा त्राण?"
    },
    {
      "id": "b_380",
      "type": "p",
      "text": "विकल क्यों करती हो अब प्राण?\""
    },
    {
      "id": "b_381",
      "type": "p",
      "text": "हुआ सचमुच यह प्रिय संवाद,"
    },
    {
      "id": "b_382",
      "type": "p",
      "text": "आ गई कैकेयी को याद।"
    },
    {
      "id": "b_383",
      "type": "p",
      "text": "बिना खोले फिर भी वह नेत्र"
    },
    {
      "id": "b_384",
      "type": "p",
      "text": "चलाने लगी वचन मय वेत्र।"
    },
    {
      "id": "b_385",
      "type": "p",
      "text": "\"चलो, रहने दे झूठी प्रीति,"
    },
    {
      "id": "b_386",
      "type": "p",
      "text": "जानती हूँ मैं यह नृप-नीति।"
    },
    {
      "id": "b_387",
      "type": "p",
      "text": "दिया तुमने मुझको क्या मान,"
    },
    {
      "id": "b_388",
      "type": "p",
      "text": "वचन मय वही न दो वरदान?\""
    },
    {
      "id": "b_389",
      "type": "p",
      "text": "भूप ने कहा--\"न मारो बोल,"
    },
    {
      "id": "b_390",
      "type": "p",
      "text": "दिखाऊँ कहो हृदय को खोल?"
    },
    {
      "id": "b_391",
      "type": "p",
      "text": "तुम्हीं ने माँगा कब क्या आप?"
    },
    {
      "id": "b_392",
      "type": "p",
      "text": "प्रिये, फिर भी क्यों यह अभिशाप?"
    },
    {
      "id": "b_393",
      "type": "p",
      "text": "भला, माँगो तो कुछ इस बार,"
    },
    {
      "id": "b_394",
      "type": "p",
      "text": "कि क्या दूँ दान नहीं, उपहार?\""
    },
    {
      "id": "b_395",
      "type": "p",
      "text": "मानिनी बोली निज अनुरूप--"
    },
    {
      "id": "b_396",
      "type": "p",
      "text": "\"न दोगे वे दो वर भी भूप!\""
    },
    {
      "id": "b_397",
      "type": "p",
      "text": "कहा नृप ने लेकर निःश्वास--"
    },
    {
      "id": "b_398",
      "type": "p",
      "text": "\"दिलाऊँ मैं कैसे विश्वास?"
    },
    {
      "id": "b_399",
      "type": "p",
      "text": "परीक्षा कर देखो कमलाक्षि,"
    },
    {
      "id": "b_400",
      "type": "p",
      "text": "सुनो तुम भी सुरगण, चिरसाक्षि!"
    },
    {
      "id": "b_401",
      "type": "p",
      "text": "सत्य से ही स्थिर है संसार,"
    },
    {
      "id": "b_402",
      "type": "p",
      "text": "सत्य ही सब धर्मों का सार,"
    },
    {
      "id": "b_403",
      "type": "p",
      "text": "राज्य ही नहीं, प्राण-परिवार,"
    },
    {
      "id": "b_404",
      "type": "p",
      "text": "सत्य पर सकता हूँ सब वार।\""
    },
    {
      "id": "b_405",
      "type": "p",
      "text": "सरल नृप को छलकर इस भाँति,"
    },
    {
      "id": "b_406",
      "type": "p",
      "text": "गरल उगले उरगी जिस भाँति।"
    },
    {
      "id": "b_407",
      "type": "p",
      "text": "भरत-सुत-मणि की माँ मुद मान,"
    },
    {
      "id": "b_408",
      "type": "p",
      "text": "माँगने चली उभय वरदान--"
    },
    {
      "id": "b_409",
      "type": "p",
      "text": "\"नाथ, मुझको दो यह वर एक--"
    },
    {
      "id": "b_410",
      "type": "p",
      "text": "भरत का करो राज्य-अभिषेक।"
    },
    {
      "id": "b_411",
      "type": "p",
      "text": "दूसरा यह दो, न हो उदास,"
    },
    {
      "id": "b_412",
      "type": "p",
      "text": "चतुर्दश वर्ष राम-वन-वास!\""
    },
    {
      "id": "b_413",
      "type": "p",
      "text": "वचन सुन ऐसे क्रूर-कराल,"
    },
    {
      "id": "b_414",
      "type": "p",
      "text": "देखते ही रह गये नृपाल।"
    },
    {
      "id": "b_415",
      "type": "p",
      "text": "वज्र-सा पड़ा अचानक टूट,"
    },
    {
      "id": "b_416",
      "type": "p",
      "text": "गया उनका शरीर-सा छूट!"
    },
    {
      "id": "b_417",
      "type": "p",
      "text": "उन्हें यों हतज्ञान-सा देख,"
    },
    {
      "id": "b_418",
      "type": "p",
      "text": "ठोकती-सी छाती पर मेख,"
    },
    {
      "id": "b_419",
      "type": "p",
      "text": "पुनः बोली वह भोंहें तान--"
    },
    {
      "id": "b_420",
      "type": "p",
      "text": "\"मौन हो गये, कहो हाँ या न!\""
    },
    {
      "id": "b_421",
      "type": "p",
      "text": "भूप फिर भी न सके कुछ बोल,"
    },
    {
      "id": "b_422",
      "type": "p",
      "text": "मूर्ति-से बैठे रहे अडोल।"
    },
    {
      "id": "b_423",
      "type": "p",
      "text": "दृष्टि ही अपनी करुण-कठोर"
    },
    {
      "id": "b_424",
      "type": "p",
      "text": "उन्होंने डाली उसकी ओर!"
    },
    {
      "id": "b_425",
      "type": "p",
      "text": "कहा फिर उसने देकर क्लेश--"
    },
    {
      "id": "b_426",
      "type": "p",
      "text": "\"सत्य-पालन है यही नरेश?"
    },
    {
      "id": "b_427",
      "type": "p",
      "text": "उलट दो बस तुम अपनी बात,"
    },
    {
      "id": "b_428",
      "type": "p",
      "text": "मरूँ मैं करके अपना घात।\""
    },
    {
      "id": "b_429",
      "type": "p",
      "text": "कहा तब नृप ने किसी प्रकार--"
    },
    {
      "id": "b_430",
      "type": "p",
      "text": "\"मरो तुम क्यों, भोगो अधिकार।"
    },
    {
      "id": "b_431",
      "type": "p",
      "text": "मरूँगा तो मैं अगति-समान,"
    },
    {
      "id": "b_432",
      "type": "p",
      "text": "मिलेंगे तुम्हें तीन वरदान!\""
    },
    {
      "id": "b_433",
      "type": "p",
      "text": "देख ऊपर को अपने आप"
    },
    {
      "id": "b_434",
      "type": "p",
      "text": "लगे नृप करने यों परिताप--"
    },
    {
      "id": "b_435",
      "type": "p",
      "text": "\"दैव, यह सपना है कि प्रतीति?"
    },
    {
      "id": "b_436",
      "type": "p",
      "text": "यही है नर-नारी की प्रीति?"
    },
    {
      "id": "b_437",
      "type": "p",
      "text": "किसीको न दें कभी वर देव;"
    },
    {
      "id": "b_438",
      "type": "p",
      "text": "वचन देना छोड़ें नर-देव।"
    },
    {
      "id": "b_439",
      "type": "p",
      "text": "दान में दुरुपयोग का वास,"
    },
    {
      "id": "b_440",
      "type": "p",
      "text": "किया जावे किसका विश्वास?"
    },
    {
      "id": "b_441",
      "type": "p",
      "text": "जिसे चिन्तामणि-माला जान"
    },
    {
      "id": "b_442",
      "type": "p",
      "text": "हृदय पर दिया प्रधानस्थान;"
    },
    {
      "id": "b_443",
      "type": "p",
      "text": "अन्त में लेकर यों विष-दन्त"
    },
    {
      "id": "b_444",
      "type": "p",
      "text": "नागिनी निकली वह हा हन्त!"
    },
    {
      "id": "b_445",
      "type": "p",
      "text": "राज्य का ही न तुझे था लोभ,"
    },
    {
      "id": "b_446",
      "type": "p",
      "text": "राम पर भी था इतना क्षोभ?"
    },
    {
      "id": "b_447",
      "type": "p",
      "text": "न था वह निस्पृह तेरा पुत्र?"
    },
    {
      "id": "b_448",
      "type": "p",
      "text": "भरत ही था क्या मेरा पुत्र?"
    },
    {
      "id": "b_449",
      "type": "p",
      "text": "राम-से सुत को भी वनवास,"
    },
    {
      "id": "b_450",
      "type": "p",
      "text": "सत्य है यह अथवा परिहास?"
    },
    {
      "id": "b_451",
      "type": "p",
      "text": "सत्य है तो है सत्यानाश,"
    },
    {
      "id": "b_452",
      "type": "p",
      "text": "हास्य है तो है हत्या-पाश!\""
    },
    {
      "id": "b_453",
      "type": "p",
      "text": "प्रतिध्वनि-मिष ऊँचा प्रासाद"
    },
    {
      "id": "b_454",
      "type": "p",
      "text": "निरन्तर करता था अनुनाद।"
    },
    {
      "id": "b_455",
      "type": "p",
      "text": "पुनः बोले मुँह फेर महीप--"
    },
    {
      "id": "b_456",
      "type": "p",
      "text": "\"राम, हा राम, वत्स, कुल-दीप!\""
    },
    {
      "id": "b_457",
      "type": "p",
      "text": "हो गये गद्गद वे इस वार,"
    },
    {
      "id": "b_458",
      "type": "p",
      "text": "तिमिरमय जान पड़ा संसार।"
    },
    {
      "id": "b_459",
      "type": "p",
      "text": "गृहागत चन्द्रालोक-विधान"
    },
    {
      "id": "b_460",
      "type": "p",
      "text": "जँचा निज भावी शव-परिधान!"
    },
    {
      "id": "b_461",
      "type": "p",
      "text": "सौध बन गया श्मशान-समान,"
    },
    {
      "id": "b_462",
      "type": "p",
      "text": "मृत्यु-सी पड़ी केकयी जान।"
    },
    {
      "id": "b_463",
      "type": "p",
      "text": "चिता के अंगारे-से दीप,"
    },
    {
      "id": "b_464",
      "type": "p",
      "text": "जलाते थे प्रज्वलित समीप!"
    },
    {
      "id": "b_465",
      "type": "p",
      "text": "\"हाय! कल क्या होगा?\" कह काँप,"
    },
    {
      "id": "b_466",
      "type": "p",
      "text": "रहे वे घुटनों में मुँह ढाँप।"
    },
    {
      "id": "b_467",
      "type": "p",
      "text": "आप से ही अपने को आज"
    },
    {
      "id": "b_468",
      "type": "p",
      "text": "छिपाते थे मानों नरराज!"
    },
    {
      "id": "b_469",
      "type": "p",
      "text": "वचन पलटें कि भेजें राम को वन में,"
    },
    {
      "id": "b_470",
      "type": "p",
      "text": "उभय विध मृत्यु निश्चित जान कर मन में"
    },
    {
      "id": "b_471",
      "type": "p",
      "text": "हुए जीवन-मरण के मध्य धृत से वे;"
    },
    {
      "id": "b_472",
      "type": "p",
      "text": "रहे बस अर्द्ध जीवित अर्द्ध मृत-से वे।"
    },
    {
      "id": "b_473",
      "type": "p",
      "text": "इसी दशा में रात कटी,"
    },
    {
      "id": "b_474",
      "type": "p",
      "text": "छाती-सी पौ प्रात फटी।"
    },
    {
      "id": "b_475",
      "type": "p",
      "text": "अरुण भानु प्रतिभात हुआ,"
    },
    {
      "id": "b_476",
      "type": "p",
      "text": "विरुपाक्ष-सा ज्ञात हुआ!"
    }
  ]
}