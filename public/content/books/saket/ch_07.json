{
  "book_id": "saket",
  "chapter_id": "ch_07",
  "number": 7,
  "title": "षष्ठ सर्ग",
  "word_count": 2249,
  "blocks": [
    {
      "id": "b_1",
      "type": "p",
      "text": "तुलसी, यह दास कृतार्थ तभी--"
    },
    {
      "id": "b_2",
      "type": "p",
      "text": "मुँह में हो चाहे स्वर्ण न भी,"
    },
    {
      "id": "b_3",
      "type": "p",
      "text": "पर एक तुम्हारा पत्र रहे,"
    },
    {
      "id": "b_4",
      "type": "p",
      "text": "जो निज मानस-कवि-कथा कहे।"
    },
    {
      "id": "b_5",
      "type": "p",
      "text": "उपमे, यह है साकेत यहाँ,"
    },
    {
      "id": "b_6",
      "type": "p",
      "text": "पर सौख्य, शान्ति, सौभाग्य कहाँ?"
    },
    {
      "id": "b_7",
      "type": "p",
      "text": "इसके वे तीनों चले गये,"
    },
    {
      "id": "b_8",
      "type": "p",
      "text": "अनुगामी पुरजन छले गये।"
    },
    {
      "id": "b_9",
      "type": "p",
      "text": "पुरदेवी-सी यह कौन पड़ी?"
    },
    {
      "id": "b_10",
      "type": "p",
      "text": "उर्मिला मूर्च्छिता मौन पड़ी।"
    },
    {
      "id": "b_11",
      "type": "p",
      "text": "किन तीक्ष्ण करों से छिन्न हुई--"
    },
    {
      "id": "b_12",
      "type": "p",
      "text": "यह कुमुद्वती जल-भिन्न हुई?"
    },
    {
      "id": "b_13",
      "type": "p",
      "text": "सीता ने अपना भाग लिया,"
    },
    {
      "id": "b_14",
      "type": "p",
      "text": "पर इसने वह भी त्याग दिया।"
    },
    {
      "id": "b_15",
      "type": "p",
      "text": "गौरव का भी है भार यही,"
    },
    {
      "id": "b_16",
      "type": "p",
      "text": "उर्वी भी गुर्वी हुई मही।"
    },
    {
      "id": "b_17",
      "type": "p",
      "text": "नव वय में ही विश्लेष हुआ;"
    },
    {
      "id": "b_18",
      "type": "p",
      "text": "यौवन में ही यति-वेष हुआ।"
    },
    {
      "id": "b_19",
      "type": "p",
      "text": "किस हत विधि का यह योग हुआ,"
    },
    {
      "id": "b_20",
      "type": "p",
      "text": "सुख-भोग भयंकर रोग हुआ।"
    },
    {
      "id": "b_21",
      "type": "p",
      "text": "होता है हित के लिए सभी,"
    },
    {
      "id": "b_22",
      "type": "p",
      "text": "करते हैं हरि क्या अहित कभी?"
    },
    {
      "id": "b_23",
      "type": "p",
      "text": "इसमें क्या हित है, कहें जिसे,"
    },
    {
      "id": "b_24",
      "type": "p",
      "text": "बतलावेगा बस समय इसे।"
    },
    {
      "id": "b_25",
      "type": "p",
      "text": "भर भर कर भीति-भरी अँखियाँ,"
    },
    {
      "id": "b_26",
      "type": "p",
      "text": "करती थीं उसे सजग सखियाँ।"
    },
    {
      "id": "b_27",
      "type": "p",
      "text": "पर शोक भयंकर खरतर था,"
    },
    {
      "id": "b_28",
      "type": "p",
      "text": "चैतन्य मोह से बढ़ कर था।"
    },
    {
      "id": "b_29",
      "type": "p",
      "text": "वह नई बधू भोली-भाली,"
    },
    {
      "id": "b_30",
      "type": "p",
      "text": "जिसमें सु-राग की थी लाली,"
    },
    {
      "id": "b_31",
      "type": "p",
      "text": "कुम्हलाई यथा कैरवाली,"
    },
    {
      "id": "b_32",
      "type": "p",
      "text": "या ग्रस्त चन्द्र की उजियाली।"
    },
    {
      "id": "b_33",
      "type": "p",
      "text": "मुख-कान्ति पड़ी पीली पीली,"
    },
    {
      "id": "b_34",
      "type": "p",
      "text": "आँखें अशान्त नीली नीली।"
    },
    {
      "id": "b_35",
      "type": "p",
      "text": "क्या हाय! यही वह कृशकाया,"
    },
    {
      "id": "b_36",
      "type": "p",
      "text": "या उसकी शेष सूक्ष्म छाया?"
    },
    {
      "id": "b_37",
      "type": "p",
      "text": "सखियाँ अवश्य समझाती थीं,"
    },
    {
      "id": "b_38",
      "type": "p",
      "text": "आँखें परन्तु भर आती थीं।"
    },
    {
      "id": "b_39",
      "type": "p",
      "text": "बोली सुलक्षणा नाम सखी--"
    },
    {
      "id": "b_40",
      "type": "p",
      "text": "\"है धीरज का ही काम सखी!"
    },
    {
      "id": "b_41",
      "type": "p",
      "text": "विधि भी न रहेगा वाम सखी,"
    },
    {
      "id": "b_42",
      "type": "p",
      "text": "फिर आवेंगे श्रीराम सखी!"
    },
    {
      "id": "b_43",
      "type": "p",
      "text": "नृप ने सुमन्त्र को भेजा है,"
    },
    {
      "id": "b_44",
      "type": "p",
      "text": "मृगयोचित साज सहेजा है।"
    },
    {
      "id": "b_45",
      "type": "p",
      "text": "यह कहा है कि ’श्रीराम बिना,"
    },
    {
      "id": "b_46",
      "type": "p",
      "text": "जावेगा पल पल वर्ष गिना।"
    },
    {
      "id": "b_47",
      "type": "p",
      "text": "होंगे यथेष्ट चौदह पल ही,"
    },
    {
      "id": "b_48",
      "type": "p",
      "text": "ले आना उन्हें आज कल ही।’"
    },
    {
      "id": "b_49",
      "type": "p",
      "text": "इस लिए न इतना सोच करो,"
    },
    {
      "id": "b_50",
      "type": "p",
      "text": "अब भी आशा है, धैर्य धरो।\""
    },
    {
      "id": "b_51",
      "type": "p",
      "text": "बोली उर्म्मिला विषादमयी--"
    },
    {
      "id": "b_52",
      "type": "p",
      "text": "\"सब गया, हाय! आशा न गई।"
    },
    {
      "id": "b_53",
      "type": "p",
      "text": "आशे, निष्फल भी बनी रहो,"
    },
    {
      "id": "b_54",
      "type": "p",
      "text": "तुम हो हीरे की कनी अहो!"
    },
    {
      "id": "b_55",
      "type": "p",
      "text": "रखती हो मूल्य मार कर भी,"
    },
    {
      "id": "b_56",
      "type": "p",
      "text": "उज्वल हो अन्धकार कर भी!"
    },
    {
      "id": "b_57",
      "type": "p",
      "text": "अब भी सुलक्षणे, आशा है?"
    },
    {
      "id": "b_58",
      "type": "p",
      "text": "यदि है, विश्वास-विनाशा है।"
    },
    {
      "id": "b_59",
      "type": "p",
      "text": "लौटेगें क्या प्रभु और बहन?"
    },
    {
      "id": "b_60",
      "type": "p",
      "text": "उनके पीछे--हा! दुःख दहन!"
    },
    {
      "id": "b_61",
      "type": "p",
      "text": "जो ज्ञाता हैं, वे जान चुके,"
    },
    {
      "id": "b_62",
      "type": "p",
      "text": "उनके महत्व को मान चुके।"
    },
    {
      "id": "b_63",
      "type": "p",
      "text": "जिस व्रत पर छोड़ गये सब वे,"
    },
    {
      "id": "b_64",
      "type": "p",
      "text": "लौटेगें उसे छोड़ अब वे?"
    },
    {
      "id": "b_65",
      "type": "p",
      "text": "निकली अभागिनी मैं ऐसी,"
    },
    {
      "id": "b_66",
      "type": "p",
      "text": "त्रैलोक्य में न होगी जैसी।"
    },
    {
      "id": "b_67",
      "type": "p",
      "text": "दे सकी न साथ नाथ का भी,"
    },
    {
      "id": "b_68",
      "type": "p",
      "text": "ले सकी न हाय! हाथ का भी!"
    },
    {
      "id": "b_69",
      "type": "p",
      "text": "यदि स्वामि-संगिनी रह न सकी,"
    },
    {
      "id": "b_70",
      "type": "p",
      "text": "तो क्यों इतना भी कह न सकी--"
    },
    {
      "id": "b_71",
      "type": "p",
      "text": "’हे नाथ, साथ दो भ्राता का,"
    },
    {
      "id": "b_72",
      "type": "p",
      "text": "बल रहे मुझे उस त्राता का।"
    },
    {
      "id": "b_73",
      "type": "p",
      "text": "है त्राण आज भी इष्ट मुझे,"
    },
    {
      "id": "b_74",
      "type": "p",
      "text": "ये प्राण आज भी इष्ट मुझे।"
    },
    {
      "id": "b_75",
      "type": "p",
      "text": "रह कर वियोग से अस्थिर भी,"
    },
    {
      "id": "b_76",
      "type": "p",
      "text": "देखूँ मैं तुम्हें यहाँ फिर भी।"
    },
    {
      "id": "b_77",
      "type": "p",
      "text": "है प्रेम स्वयं कर्तव्य बड़ा,"
    },
    {
      "id": "b_78",
      "type": "p",
      "text": "जो खींच रहा है तुम्हें खड़ा।"
    },
    {
      "id": "b_79",
      "type": "p",
      "text": "यह भ्रातृ-स्नेह न ऊना हो,"
    },
    {
      "id": "b_80",
      "type": "p",
      "text": "लोगों के लिए नमूना हो।"
    },
    {
      "id": "b_81",
      "type": "p",
      "text": "सुन कर जीजी की मर्म-कथा,"
    },
    {
      "id": "b_82",
      "type": "p",
      "text": "गिर पड़ी मैं, न सह सकी व्यथा।"
    },
    {
      "id": "b_83",
      "type": "p",
      "text": "वह नारि-सुलभ दुर्बलता थी,"
    },
    {
      "id": "b_84",
      "type": "p",
      "text": "आकस्मिक-वेग-विकलता थी।"
    },
    {
      "id": "b_85",
      "type": "p",
      "text": "करना न सोच मेरा इससे,"
    },
    {
      "id": "b_86",
      "type": "p",
      "text": "व्रत में कुछ विघ्न पड़े जिससे।"
    },
    {
      "id": "b_87",
      "type": "p",
      "text": "आने का दिन है दूर सही,"
    },
    {
      "id": "b_88",
      "type": "p",
      "text": "पर है, बस अब अवलम्ब यही।"
    },
    {
      "id": "b_89",
      "type": "p",
      "text": "आराध्य युग्म के सोने पर,"
    },
    {
      "id": "b_90",
      "type": "p",
      "text": "निस्तब्ध निशा के होने पर,"
    },
    {
      "id": "b_91",
      "type": "p",
      "text": "तुम याद करोगे मुझे कभी,"
    },
    {
      "id": "b_92",
      "type": "p",
      "text": "तो बस फिर मैं पा चुकी सभी।’"
    },
    {
      "id": "b_93",
      "type": "p",
      "text": "प्रिय-उत्तर भी सुन सकी न मैं,"
    },
    {
      "id": "b_94",
      "type": "p",
      "text": "निज चिर गति भी चुन सकी न मैं।"
    },
    {
      "id": "b_95",
      "type": "p",
      "text": "यह दीर्घ काल काटूँ जिससे,"
    },
    {
      "id": "b_96",
      "type": "p",
      "text": "पूछूँ अब हाय! और किससे!"
    },
    {
      "id": "b_97",
      "type": "p",
      "text": "सजनी सुलक्षणे, धैर्य धरूँ,"
    },
    {
      "id": "b_98",
      "type": "p",
      "text": "तो कहो क्या करूँ, क्या न करूँ?"
    },
    {
      "id": "b_99",
      "type": "p",
      "text": "जिससे महत्व से मण्डित फिर,"
    },
    {
      "id": "b_100",
      "type": "p",
      "text": "देखूँ वह विकसित वदन रुधिर।"
    },
    {
      "id": "b_101",
      "type": "p",
      "text": "मैं अपने लिए अधीर नहीं,"
    },
    {
      "id": "b_102",
      "type": "p",
      "text": "स्वार्थी यह लोचन-नीर नहीं।"
    },
    {
      "id": "b_103",
      "type": "p",
      "text": "क्या से क्या हाय! हो गया यह,"
    },
    {
      "id": "b_104",
      "type": "p",
      "text": "रस में विष कौन बो गया यह।"
    },
    {
      "id": "b_105",
      "type": "p",
      "text": "जो यों निज प्राप्य छोड़ देंगे--"
    },
    {
      "id": "b_106",
      "type": "p",
      "text": "अप्राप्य अनुग उनके लेंगे?"
    },
    {
      "id": "b_107",
      "type": "p",
      "text": "माँ ने न तनिक समझा-बूझा,"
    },
    {
      "id": "b_108",
      "type": "p",
      "text": "यह उन्हें अचानक क्या सूझा?"
    },
    {
      "id": "b_109",
      "type": "p",
      "text": "अभिषेक कहाँ, वनवास कहाँ?"
    },
    {
      "id": "b_110",
      "type": "p",
      "text": "है नहीं क्षणिक विश्वास यहाँ।"
    },
    {
      "id": "b_111",
      "type": "p",
      "text": "भावी समीप भी दृष्ट नहीं,"
    },
    {
      "id": "b_112",
      "type": "p",
      "text": "क्या है जो सहसा सृष्ट नहीं!"
    },
    {
      "id": "b_113",
      "type": "p",
      "text": "दुरदृष्ट, बता दे स्पष्ट मुझे--"
    },
    {
      "id": "b_114",
      "type": "p",
      "text": "क्यों है अनिष्ट ही इष्ट तुझे?"
    },
    {
      "id": "b_115",
      "type": "p",
      "text": "तू है बिगाड़ता काम बना,"
    },
    {
      "id": "b_116",
      "type": "p",
      "text": "रहता है बहुधा वाम बना।"
    },
    {
      "id": "b_117",
      "type": "p",
      "text": "प्रतिकार-समय तक दिये बिना,"
    },
    {
      "id": "b_118",
      "type": "p",
      "text": "छिप कर, कुछ अकधक किये बिना--"
    },
    {
      "id": "b_119",
      "type": "p",
      "text": "करता प्रहार तू यहाँ वहाँ,"
    },
    {
      "id": "b_120",
      "type": "p",
      "text": "धोखा देता है जहाँ तहाँ।"
    },
    {
      "id": "b_121",
      "type": "p",
      "text": "तू ने जो कुछ दुरदृष्ट, किया,"
    },
    {
      "id": "b_122",
      "type": "p",
      "text": "आभास स्वप्न में भी न दिया।"
    },
    {
      "id": "b_123",
      "type": "p",
      "text": "कुछ शमन-यत्न करते हम भी;"
    },
    {
      "id": "b_124",
      "type": "p",
      "text": "है योगसाध्य दुर्दम यम भी।\""
    },
    {
      "id": "b_125",
      "type": "p",
      "text": "नभ-ओर उर्मिला ने देखा,"
    },
    {
      "id": "b_126",
      "type": "p",
      "text": "थी ईर्ष्या-भरी दृष्टि-रेखा।"
    },
    {
      "id": "b_127",
      "type": "p",
      "text": "तब नभ भी मानों धधक उठा;"
    },
    {
      "id": "b_128",
      "type": "p",
      "text": "सन्ध्यारुणिमा-मिस भभक उठा।"
    },
    {
      "id": "b_129",
      "type": "p",
      "text": "रीता दिन बीता, रात हुई;"
    },
    {
      "id": "b_130",
      "type": "p",
      "text": "ज्यों त्यों वह रात प्रभात हुई।"
    },
    {
      "id": "b_131",
      "type": "p",
      "text": "फिर सूनी सूनी साँझ हुई,"
    },
    {
      "id": "b_132",
      "type": "p",
      "text": "मानों सब वेला बाँझ हुई।"
    },
    {
      "id": "b_133",
      "type": "p",
      "text": "उर्मिला कभी तो रोती थी,"
    },
    {
      "id": "b_134",
      "type": "p",
      "text": "फिर कभी शान्त-सी होती थी।"
    },
    {
      "id": "b_135",
      "type": "p",
      "text": "देता प्रबोध जो, सुनती थी,"
    },
    {
      "id": "b_136",
      "type": "p",
      "text": "मन में अतर्क्य कुछ गुनती थी।"
    },
    {
      "id": "b_137",
      "type": "p",
      "text": "उन माताओं की करुण-कथा,"
    },
    {
      "id": "b_138",
      "type": "p",
      "text": "देती थी दुगनी मनोव्यथा।"
    },
    {
      "id": "b_139",
      "type": "p",
      "text": "सुत गये तथा पति पड़े यथा,"
    },
    {
      "id": "b_140",
      "type": "p",
      "text": "रोने तक का अवकाश न था!"
    },
    {
      "id": "b_141",
      "type": "p",
      "text": "आँधी से उखड़े वॄक्ष-सदृश,"
    },
    {
      "id": "b_142",
      "type": "p",
      "text": "थे भूप शोक-हत जर्जर-कृश।"
    },
    {
      "id": "b_143",
      "type": "p",
      "text": "ज्यों हृतप्रसूना लतिकाएँ,"
    },
    {
      "id": "b_144",
      "type": "p",
      "text": "वे थीं समीप दायें-बायें।"
    },
    {
      "id": "b_145",
      "type": "p",
      "text": "ज्यों त्यों कर शोक सहन करके,"
    },
    {
      "id": "b_146",
      "type": "p",
      "text": "अंचल से वायु वहन करके"
    },
    {
      "id": "b_147",
      "type": "p",
      "text": "बोलीं प्रभुवरप्रसू तब यों,--"
    },
    {
      "id": "b_148",
      "type": "p",
      "text": "\"हे नाथ, अधीर न हो अब यों।"
    },
    {
      "id": "b_149",
      "type": "p",
      "text": "तुमने निज सत्य धर्म्म पाला;"
    },
    {
      "id": "b_150",
      "type": "p",
      "text": "सुत ने स्वापत्य-धर्म्म पाला।"
    },
    {
      "id": "b_151",
      "type": "p",
      "text": "पत्नी पति-संग बनी देवी;"
    },
    {
      "id": "b_152",
      "type": "p",
      "text": "प्रिय अनुज हुआ अग्रज-सेवी।"
    },
    {
      "id": "b_153",
      "type": "p",
      "text": "जो हुआ सभी अविचित्र हुआ,"
    },
    {
      "id": "b_154",
      "type": "p",
      "text": "पर धन्य मनुष्य-चरित्र हुआ।"
    },
    {
      "id": "b_155",
      "type": "p",
      "text": "गौरव-बल से यह शोक सहो;"
    },
    {
      "id": "b_156",
      "type": "p",
      "text": "देखो हम सबकी ओर अहो!\""
    },
    {
      "id": "b_157",
      "type": "p",
      "text": "भूपति ने आँखें खोल कहा,--"
    },
    {
      "id": "b_158",
      "type": "p",
      "text": "\"यह कौन है कि जो बोल रहा?"
    },
    {
      "id": "b_159",
      "type": "p",
      "text": "कौशल्ये, धन्य राम-मातः,"
    },
    {
      "id": "b_160",
      "type": "p",
      "text": "क्या कहूँ, हाय रे! धिक धातः!"
    },
    {
      "id": "b_161",
      "type": "p",
      "text": "यह शोक कहाँ तक रोकूँ मैं?"
    },
    {
      "id": "b_162",
      "type": "p",
      "text": "किस मुँह से तुम्हें विलोकूँ मैं?"
    },
    {
      "id": "b_163",
      "type": "p",
      "text": "हा! आज दृष्टि भी कहाँ गई?"
    },
    {
      "id": "b_164",
      "type": "p",
      "text": "वह बधू जानकी जहाँ गई।"
    },
    {
      "id": "b_165",
      "type": "p",
      "text": "सीता भी नाता तोड़ गई,"
    },
    {
      "id": "b_166",
      "type": "p",
      "text": "इस वृद्ध ससुर को छोड़ गई।"
    },
    {
      "id": "b_167",
      "type": "p",
      "text": "उर्मिला बहू की बड़ी बहन!"
    },
    {
      "id": "b_168",
      "type": "p",
      "text": "किस भाँति करूँ मैं शोक सहन?"
    },
    {
      "id": "b_169",
      "type": "p",
      "text": "उर्मिला कहाँ है, हाय बहू!"
    },
    {
      "id": "b_170",
      "type": "p",
      "text": "तू रधुकुल की असहाय बहू!"
    },
    {
      "id": "b_171",
      "type": "p",
      "text": "मैं ही अनर्थ का हेतु हुआ,"
    },
    {
      "id": "b_172",
      "type": "p",
      "text": "रविकुल में सचमुच \"केतु\" हुआ!"
    },
    {
      "id": "b_173",
      "type": "p",
      "text": "यदि राम न लौटेंगे वन से,"
    },
    {
      "id": "b_174",
      "type": "p",
      "text": "तो भेट न होगी इस जन से।"
    },
    {
      "id": "b_175",
      "type": "p",
      "text": "कैकेयि, भोग कर बलि मेरी,"
    },
    {
      "id": "b_176",
      "type": "p",
      "text": "राज्यश्री तृप्त रहे तेरी!\""
    },
    {
      "id": "b_177",
      "type": "p",
      "text": "दोनों सु-रानियाँ रोती थीं,"
    },
    {
      "id": "b_178",
      "type": "p",
      "text": "पति के पद-पद्म भिगोती थीं।"
    },
    {
      "id": "b_179",
      "type": "p",
      "text": "नृप राम राम ही रटते थे,"
    },
    {
      "id": "b_180",
      "type": "p",
      "text": "युग के समान पल कटते थे।"
    },
    {
      "id": "b_181",
      "type": "p",
      "text": "फिर भी सुमन्त्र हैं साथ गये,"
    },
    {
      "id": "b_182",
      "type": "p",
      "text": "गृह-दशा देख रघुनाथ गये।"
    },
    {
      "id": "b_183",
      "type": "p",
      "text": "अटकी थी आशा एक यही,"
    },
    {
      "id": "b_184",
      "type": "p",
      "text": "जो थी अब उनको जिला रही।"
    },
    {
      "id": "b_185",
      "type": "p",
      "text": "आशा अवलम्बदायिका है,"
    },
    {
      "id": "b_186",
      "type": "p",
      "text": "क्या ही कल-गीत-गायिका है।"
    },
    {
      "id": "b_187",
      "type": "p",
      "text": "वह आप क्यों न नाता तोड़े,"
    },
    {
      "id": "b_188",
      "type": "p",
      "text": "पर कौन है कि उसको छोड़े?"
    },
    {
      "id": "b_189",
      "type": "p",
      "text": "ऊँचे अट्टों पर चढ़ चढ़ कर--"
    },
    {
      "id": "b_190",
      "type": "p",
      "text": "सब ओर पथों में बढ़ बढ़ कर,"
    },
    {
      "id": "b_191",
      "type": "p",
      "text": "रथ-मार्ग देखने लगे सभी,"
    },
    {
      "id": "b_192",
      "type": "p",
      "text": "फिर आवें राघव कहीं अभी!"
    },
    {
      "id": "b_193",
      "type": "p",
      "text": "पर यदि रघुनाथ लौट आते--"
    },
    {
      "id": "b_194",
      "type": "p",
      "text": "तो प्रथम ही न वे वन जाते।"
    },
    {
      "id": "b_195",
      "type": "p",
      "text": "लौटे सुमन्त्र ही बेचारे,"
    },
    {
      "id": "b_196",
      "type": "p",
      "text": "अनुरोध-तर्क भी सब हारे।"
    },
    {
      "id": "b_197",
      "type": "p",
      "text": "कर में घोड़ों की रास लिये,"
    },
    {
      "id": "b_198",
      "type": "p",
      "text": "निज जीवन का उपहास किये;"
    },
    {
      "id": "b_199",
      "type": "p",
      "text": "होकर मानों परतन्त्र निरे,"
    },
    {
      "id": "b_200",
      "type": "p",
      "text": "सूना रथ लिये सुमन्त्र फिरे।"
    },
    {
      "id": "b_201",
      "type": "p",
      "text": "रथ मानों एक रिक्त घन था,"
    },
    {
      "id": "b_202",
      "type": "p",
      "text": "जल भी न था, न वह गर्जन था।"
    },
    {
      "id": "b_203",
      "type": "p",
      "text": "वह बिजली भी थी हाय! नहीं,"
    },
    {
      "id": "b_204",
      "type": "p",
      "text": "विधि-विधि पर कहीं उपाय नहीं।"
    },
    {
      "id": "b_205",
      "type": "p",
      "text": "जो थे समीर के जोड़ों के,--"
    },
    {
      "id": "b_206",
      "type": "p",
      "text": "उठते न पैर थे घोड़ों के!"
    },
    {
      "id": "b_207",
      "type": "p",
      "text": "थे राम बिना वे भी रोते,"
    },
    {
      "id": "b_208",
      "type": "p",
      "text": "पशु भी प्रेमानुरक्त होते।"
    },
    {
      "id": "b_209",
      "type": "p",
      "text": "जो भीषण रण में भी न हटे,"
    },
    {
      "id": "b_210",
      "type": "p",
      "text": "मानों अब उनके पैर कटे।"
    },
    {
      "id": "b_211",
      "type": "p",
      "text": "अति भार हुआ रीता रथ था,"
    },
    {
      "id": "b_212",
      "type": "p",
      "text": "गृह-पथ मानों अरण्य-पथ था!"
    },
    {
      "id": "b_213",
      "type": "p",
      "text": "अवसन्न सचिव का तन-मन था;"
    },
    {
      "id": "b_214",
      "type": "p",
      "text": "करता समीर भी सन सन था।"
    },
    {
      "id": "b_215",
      "type": "p",
      "text": "सिर पर अनन्त-सा आ टूटा,"
    },
    {
      "id": "b_216",
      "type": "p",
      "text": "कटि टूटी और भाग्य फूटा।"
    },
    {
      "id": "b_217",
      "type": "p",
      "text": "धरती मानों थी मरी पड़ी,"
    },
    {
      "id": "b_218",
      "type": "p",
      "text": "थी प्रकृति भीति से भरी पड़ी।"
    },
    {
      "id": "b_219",
      "type": "p",
      "text": "सम्मुख मानों मुख खोल बड़ा,"
    },
    {
      "id": "b_220",
      "type": "p",
      "text": "खाने को था दिग्दैत्य खड़ा!"
    },
    {
      "id": "b_221",
      "type": "p",
      "text": "था सोच यही मुख-सरसिज को,"
    },
    {
      "id": "b_222",
      "type": "p",
      "text": "किस भाँति दिखाऊँगा निज को?"
    },
    {
      "id": "b_223",
      "type": "p",
      "text": "इस लिए श्यामता लाता था--"
    },
    {
      "id": "b_224",
      "type": "p",
      "text": "उसमें निज मूर्त्ति छिपाता था।"
    },
    {
      "id": "b_225",
      "type": "p",
      "text": "मन विकल हुआ क्या करता था?"
    },
    {
      "id": "b_226",
      "type": "p",
      "text": "साँसें शरीर में भरता था।"
    },
    {
      "id": "b_227",
      "type": "p",
      "text": "सन्देश सुनाये बिना कहीं,"
    },
    {
      "id": "b_228",
      "type": "p",
      "text": "गिर जाय न हा! यह देह नहीं!"
    },
    {
      "id": "b_229",
      "type": "p",
      "text": "जब रजनी आकर प्राप्त हुई,"
    },
    {
      "id": "b_230",
      "type": "p",
      "text": "बाहर ही साँझ समाप्त हुई,"
    },
    {
      "id": "b_231",
      "type": "p",
      "text": "नीरव गति से, उदास उर में,"
    },
    {
      "id": "b_232",
      "type": "p",
      "text": "तब सचिव प्रविष्ट हुए पुर में।"
    },
    {
      "id": "b_233",
      "type": "p",
      "text": "थी पड़ी पुरी भी काली-सी,"
    },
    {
      "id": "b_234",
      "type": "p",
      "text": "(जगती थी जहाँ दिवाली-सी।)"
    },
    {
      "id": "b_235",
      "type": "p",
      "text": "खोले थी मानों केश पुरी,"
    },
    {
      "id": "b_236",
      "type": "p",
      "text": "रक्खे थी विधवा-वेश पुरी!"
    },
    {
      "id": "b_237",
      "type": "p",
      "text": "क्या घुसे सुमन्त्र रसातल में?"
    },
    {
      "id": "b_238",
      "type": "p",
      "text": "रुक उठी साँस भी पल पल में।"
    },
    {
      "id": "b_239",
      "type": "p",
      "text": "यह तमी हटेगी क्या न कभी,"
    },
    {
      "id": "b_240",
      "type": "p",
      "text": "पौ यहाँ फटेगी क्या न कभी?"
    },
    {
      "id": "b_241",
      "type": "p",
      "text": "सब चौक बन्द थे, पथ सूनें,"
    },
    {
      "id": "b_242",
      "type": "p",
      "text": "हो गई अमावस-सी पूनें।"
    },
    {
      "id": "b_243",
      "type": "p",
      "text": "रहती जो गीत-गुंजरित सी,"
    },
    {
      "id": "b_244",
      "type": "p",
      "text": "गृह-राजि आज भी स्तम्भित सी।"
    },
    {
      "id": "b_245",
      "type": "p",
      "text": "पुर-रक्षक नीरव फिरते थे,"
    },
    {
      "id": "b_246",
      "type": "p",
      "text": "आँसू अमात्य के गिरते थे।"
    },
    {
      "id": "b_247",
      "type": "p",
      "text": "\"हो चुकी लूट घर की गहरी,"
    },
    {
      "id": "b_248",
      "type": "p",
      "text": "अब किसे रखाते हैं प्रहरी?\""
    },
    {
      "id": "b_249",
      "type": "p",
      "text": "उत्तर में ’नहीं’ सुनें न कहीं,"
    },
    {
      "id": "b_250",
      "type": "p",
      "text": "इस लिए \"राम लौटे कि नहीं?\""
    },
    {
      "id": "b_251",
      "type": "p",
      "text": "यह पूँछ न सके सचिव-वर से;"
    },
    {
      "id": "b_252",
      "type": "p",
      "text": "पुरवासी मौन रहे डर से।"
    },
    {
      "id": "b_253",
      "type": "p",
      "text": "नीरवता ही अमात्य वर की,"
    },
    {
      "id": "b_254",
      "type": "p",
      "text": "थी शोक-सूचना उत्तर की।"
    },
    {
      "id": "b_255",
      "type": "p",
      "text": "कोई अनिष्ट कहते-कहते,"
    },
    {
      "id": "b_256",
      "type": "p",
      "text": "बहुधा मनुष्य चुप ही रहते।"
    },
    {
      "id": "b_257",
      "type": "p",
      "text": "रथ देख सभी ने शीश धुना,"
    },
    {
      "id": "b_258",
      "type": "p",
      "text": "ऊपर अमरों ने स्पष्ट सुना,--"
    },
    {
      "id": "b_259",
      "type": "p",
      "text": "’क्या फिरे हमारे आर्य नहीं?’"
    },
    {
      "id": "b_260",
      "type": "p",
      "text": "सुर बोले--’था सुर-कार्य वहीं।’"
    },
    {
      "id": "b_261",
      "type": "p",
      "text": "देवों के वाक्य सुधा-सींचे,"
    },
    {
      "id": "b_262",
      "type": "p",
      "text": "सुन पड़े न उसी समय नीचे।"
    },
    {
      "id": "b_263",
      "type": "p",
      "text": "वे कोलाहल में लीन हुए,"
    },
    {
      "id": "b_264",
      "type": "p",
      "text": "पुरवासी दुख से दीन हुए।"
    },
    {
      "id": "b_265",
      "type": "p",
      "text": "कर के सुमन्त्र ने सिर नीचा,"
    },
    {
      "id": "b_266",
      "type": "p",
      "text": "आँखों को एक बार मींचा।"
    },
    {
      "id": "b_267",
      "type": "p",
      "text": "जिस रथ पर से प्रसून झड़ते,"
    },
    {
      "id": "b_268",
      "type": "p",
      "text": "उस पर थे आज अश्रु पड़ते।"
    },
    {
      "id": "b_269",
      "type": "p",
      "text": "जब नृप समीप उपनीत हुए,"
    },
    {
      "id": "b_270",
      "type": "p",
      "text": "तब शोक भूल वे भीत हुए।"
    },
    {
      "id": "b_271",
      "type": "p",
      "text": "\"यह पोत डूब ही जावेगा--"
    },
    {
      "id": "b_272",
      "type": "p",
      "text": "या कूल-किनारा पावेगा?\""
    },
    {
      "id": "b_273",
      "type": "p",
      "text": "गजराज पंक में धँसा हुआ,"
    },
    {
      "id": "b_274",
      "type": "p",
      "text": "छटपट करता था फँसा हुआ।"
    },
    {
      "id": "b_275",
      "type": "p",
      "text": "हथनियाँ पास चिल्लाती थीं,"
    },
    {
      "id": "b_276",
      "type": "p",
      "text": "वे विवश, विकल बिल्लाती थीं।"
    },
    {
      "id": "b_277",
      "type": "p",
      "text": "बोले नृप--\"राम नहीं लौटे?\""
    },
    {
      "id": "b_278",
      "type": "p",
      "text": "गूँजा सब धाम--’नहीं लौटे।’"
    },
    {
      "id": "b_279",
      "type": "p",
      "text": "नृप ने सशंक जो कुछ पूछा,"
    },
    {
      "id": "b_280",
      "type": "p",
      "text": "बस उत्तर हुआ वही छूछा।"
    },
    {
      "id": "b_281",
      "type": "p",
      "text": "यद्यपि सुमन्त्र ने कुछ न कहा,"
    },
    {
      "id": "b_282",
      "type": "p",
      "text": "प्रतिनाद तदपि नीरव न रहा।"
    },
    {
      "id": "b_283",
      "type": "p",
      "text": "पर सचिव-मौन ही अधिक खला,"
    },
    {
      "id": "b_284",
      "type": "p",
      "text": "भर आया सूखा हुआ गला।"
    },
    {
      "id": "b_285",
      "type": "p",
      "text": "बोले फिर वे कि--\"कहाँ छोड़ा,"
    },
    {
      "id": "b_286",
      "type": "p",
      "text": "ले चलो मुझे कि जहाँ छोड़ा।"
    },
    {
      "id": "b_287",
      "type": "p",
      "text": "मुझको भी वहीं छोड़ आओ,"
    },
    {
      "id": "b_288",
      "type": "p",
      "text": "वह रामचन्द्र-मुख दिखलाओ।\""
    },
    {
      "id": "b_289",
      "type": "p",
      "text": "टूटी महीप की हृत्तन्त्री;"
    },
    {
      "id": "b_290",
      "type": "p",
      "text": "बोले विषाद पूर्वक मन्त्री--"
    },
    {
      "id": "b_291",
      "type": "p",
      "text": "\"हे आर्य, राम-मुख देखोगे,"
    },
    {
      "id": "b_292",
      "type": "p",
      "text": "दुख देख क्या न सुख देखोगे?"
    },
    {
      "id": "b_293",
      "type": "p",
      "text": "आवेंगे वे यश को लेकर,"
    },
    {
      "id": "b_294",
      "type": "p",
      "text": "सुख पावेंगे तुमको देकर।"
    },
    {
      "id": "b_295",
      "type": "p",
      "text": "नभ में भी नया नाम होगा,"
    },
    {
      "id": "b_296",
      "type": "p",
      "text": "पर चिन्ता से न काम होगा।"
    },
    {
      "id": "b_297",
      "type": "p",
      "text": "अवसर ही उन्हें मिलावेगा,"
    },
    {
      "id": "b_298",
      "type": "p",
      "text": "यह शोक न हमें जिलावेगा।"
    },
    {
      "id": "b_299",
      "type": "p",
      "text": "राघव ने हाथ जोड़ करके,"
    },
    {
      "id": "b_300",
      "type": "p",
      "text": "तुमसे यह कहा धैर्य धरके--"
    },
    {
      "id": "b_301",
      "type": "p",
      "text": "’आता है जी में तात यही,--"
    },
    {
      "id": "b_302",
      "type": "p",
      "text": "पीछे पिछेल व्यवधान-मही--"
    },
    {
      "id": "b_303",
      "type": "p",
      "text": "झट लोटूँ चरणों में आकर,"
    },
    {
      "id": "b_304",
      "type": "p",
      "text": "सुख पाऊँ करस्पर्श पाकर।"
    },
    {
      "id": "b_305",
      "type": "p",
      "text": "पर धर्म रोकता है वन में;"
    },
    {
      "id": "b_306",
      "type": "p",
      "text": "करना न सोच मेरा मन में।"
    },
    {
      "id": "b_307",
      "type": "p",
      "text": "देगा मुझको विश्रान्ति वही,"
    },
    {
      "id": "b_308",
      "type": "p",
      "text": "दे तात तुम्हें भी शान्ति वही।’\""
    },
    {
      "id": "b_309",
      "type": "p",
      "text": "\"क्या शान्ति? शान्ति, हा शान्ति कहाँ?"
    },
    {
      "id": "b_310",
      "type": "p",
      "text": "बन गई केकयी क्रान्ति यहाँ।"
    },
    {
      "id": "b_311",
      "type": "p",
      "text": "हो गया पुण्य ही पाप मुझे,"
    },
    {
      "id": "b_312",
      "type": "p",
      "text": "दे रहा धर्म ही ताप मुझे।"
    },
    {
      "id": "b_313",
      "type": "p",
      "text": "कुछ नहीं कहा क्या सीता ने,"
    },
    {
      "id": "b_314",
      "type": "p",
      "text": "वैदेही बधू विनीता ने?\""
    },
    {
      "id": "b_315",
      "type": "p",
      "text": "बोले सुमन्त्र वे कह न सकीं,"
    },
    {
      "id": "b_316",
      "type": "p",
      "text": "कहने जाकर भी रुकीं, थकीं।"
    },
    {
      "id": "b_317",
      "type": "p",
      "text": "साकेतस्मृति में मग्न हुईं,"
    },
    {
      "id": "b_318",
      "type": "p",
      "text": "करके प्रणाम भूलग्न हुईं।"
    },
    {
      "id": "b_319",
      "type": "p",
      "text": "फिर नभ की ओर हाथ जोड़े,"
    },
    {
      "id": "b_320",
      "type": "p",
      "text": "दृग सजल हुए थोड़े थोड़े।"
    },
    {
      "id": "b_321",
      "type": "p",
      "text": "आँसू बरोनियों तक आये,"
    },
    {
      "id": "b_322",
      "type": "p",
      "text": "नीचे न किन्तु गिरने पाये।"
    },
    {
      "id": "b_323",
      "type": "p",
      "text": "जा खड़ी हुईं पति के पीछे,"
    },
    {
      "id": "b_324",
      "type": "p",
      "text": "ज्यों मुक्ति महा यति के पीछे।\""
    },
    {
      "id": "b_325",
      "type": "p",
      "text": "नृप रोने लगे--\"हाय! सीते,"
    },
    {
      "id": "b_326",
      "type": "p",
      "text": "हम हैं कठोर अब भी जीते।"
    },
    {
      "id": "b_327",
      "type": "p",
      "text": "सह कर भी घोर कष्ट तन पर,"
    },
    {
      "id": "b_328",
      "type": "p",
      "text": "आया न मैल तेरे मन पर।"
    },
    {
      "id": "b_329",
      "type": "p",
      "text": "गृह-योग्य बने हैं वनस्पृही,"
    },
    {
      "id": "b_330",
      "type": "p",
      "text": "वन-योग्य हाय! हम बने गृही।"
    },
    {
      "id": "b_331",
      "type": "p",
      "text": "हे विधे, व्यतिक्रम यह तेरा,"
    },
    {
      "id": "b_332",
      "type": "p",
      "text": "किस लिए बता श्रम यह तेरा?"
    },
    {
      "id": "b_333",
      "type": "p",
      "text": "यदि मन्थरा न पहचान सकी,"
    },
    {
      "id": "b_334",
      "type": "p",
      "text": "तो क्यों न केकयी जान सकी?"
    },
    {
      "id": "b_335",
      "type": "p",
      "text": "कोई उससे जा कहे अभी,--"
    },
    {
      "id": "b_336",
      "type": "p",
      "text": "ले, तेरे कण्टक टले सभी!\""
    },
    {
      "id": "b_337",
      "type": "p",
      "text": "बोले सुमन्त्र सहसा कि \"हहा--"
    },
    {
      "id": "b_338",
      "type": "p",
      "text": "लक्ष्मण ने भी है यही कहा।\""
    },
    {
      "id": "b_339",
      "type": "p",
      "text": "भूपति को जीवन भार हुआ;"
    },
    {
      "id": "b_340",
      "type": "p",
      "text": "बस यह अन्तिम उद्गार हुआ--"
    },
    {
      "id": "b_341",
      "type": "p",
      "text": "\"मेरे कर युग हैं टूट चुके,"
    },
    {
      "id": "b_342",
      "type": "p",
      "text": "कटि टूट चुकी, सुख छूट चुके।"
    },
    {
      "id": "b_343",
      "type": "p",
      "text": "आँखों की पुलती निकल पड़ी,"
    },
    {
      "id": "b_344",
      "type": "p",
      "text": "वह यहीं कहीं है विफल पड़ी!"
    },
    {
      "id": "b_345",
      "type": "p",
      "text": "खाकर भी बार बार झटके--"
    },
    {
      "id": "b_346",
      "type": "p",
      "text": "क्यों प्राण अभी तक हैं अटके?"
    },
    {
      "id": "b_347",
      "type": "p",
      "text": "हे जीव, चलो अब दिन बीते,"
    },
    {
      "id": "b_348",
      "type": "p",
      "text": "हा राम, राम, लक्ष्मण, सीते!\""
    },
    {
      "id": "b_349",
      "type": "p",
      "text": "बस, यहीं दीप-निर्वाण हुआ,"
    },
    {
      "id": "b_350",
      "type": "p",
      "text": "सुत-विरह वायु का बाण हुआ।"
    },
    {
      "id": "b_351",
      "type": "p",
      "text": "धुँधला पड़ गया चन्द्र ऊपर,"
    },
    {
      "id": "b_352",
      "type": "p",
      "text": "कुछ दिखलाई न दिया भू पर।"
    },
    {
      "id": "b_353",
      "type": "p",
      "text": "अति भीषण हाहाकार हुआ,"
    },
    {
      "id": "b_354",
      "type": "p",
      "text": "सूना-सा सब संसार हुआ।"
    },
    {
      "id": "b_355",
      "type": "p",
      "text": "अर्द्धांग रानियाँ शोककृता"
    },
    {
      "id": "b_356",
      "type": "p",
      "text": "मूर्च्छिता हुईं या अर्द्ध-मृता?"
    },
    {
      "id": "b_357",
      "type": "p",
      "text": "हाथों से नेत्र बन्द करके,"
    },
    {
      "id": "b_358",
      "type": "p",
      "text": "सहसा यह दृश्य देख, डरके,"
    },
    {
      "id": "b_359",
      "type": "p",
      "text": "’हा स्वामी!’ कह ऊँचे रव से,"
    },
    {
      "id": "b_360",
      "type": "p",
      "text": "दहके सुमन्त्र मानों दव से।"
    },
    {
      "id": "b_361",
      "type": "p",
      "text": "अनुचर अनाथ-से रोते थे,"
    },
    {
      "id": "b_362",
      "type": "p",
      "text": "जो थे अधीर सब होते थे।"
    },
    {
      "id": "b_363",
      "type": "p",
      "text": "थे भूप सभी के हितकारी,"
    },
    {
      "id": "b_364",
      "type": "p",
      "text": "सच्चे परिवार-भार धारी।"
    },
    {
      "id": "b_365",
      "type": "p",
      "text": "\"माँ, कहाँ गये वे पूज्य पिता?\""
    },
    {
      "id": "b_366",
      "type": "p",
      "text": "करके पुकार यों शोक-सिता,"
    },
    {
      "id": "b_367",
      "type": "p",
      "text": "उर्मिला सभी सुध-बुध त्यागे,"
    },
    {
      "id": "b_368",
      "type": "p",
      "text": "जा गिरी केकयी के आगे।"
    },
    {
      "id": "b_369",
      "type": "p",
      "text": "कैकेयी का मुँह भी न खुला,"
    },
    {
      "id": "b_370",
      "type": "p",
      "text": "पाषाण-शरीर हिला न डुला।"
    },
    {
      "id": "b_371",
      "type": "p",
      "text": "बस फट-सी गईं बड़ी आँखें,"
    },
    {
      "id": "b_372",
      "type": "p",
      "text": "मानों थीं नई जड़ी आँखें।"
    },
    {
      "id": "b_373",
      "type": "p",
      "text": "रोना उसको उपहास हुआ,"
    },
    {
      "id": "b_374",
      "type": "p",
      "text": "निज कृत वैधव्य-विकास हुआ।"
    },
    {
      "id": "b_375",
      "type": "p",
      "text": "तब वह अपने से आप डरी,"
    },
    {
      "id": "b_376",
      "type": "p",
      "text": "किस कुसमय में मन्थरा मरी!"
    },
    {
      "id": "b_377",
      "type": "p",
      "text": "भूपति-पद का विच्छेद हुआ,"
    },
    {
      "id": "b_378",
      "type": "p",
      "text": "यह सुन कर किसे न खेद हुआ?"
    },
    {
      "id": "b_379",
      "type": "p",
      "text": "नभ भी रोया चुपचाप हहा!"
    },
    {
      "id": "b_380",
      "type": "p",
      "text": "हिम-कण-मिस अश्रु-समूह बहा!"
    },
    {
      "id": "b_381",
      "type": "p",
      "text": "दानव-भय-हारी देह मिटा,"
    },
    {
      "id": "b_382",
      "type": "p",
      "text": "वह राज-गुणों का गेह मिटा।"
    },
    {
      "id": "b_383",
      "type": "p",
      "text": "ऊपर सुरांगनाएँ रोईं,"
    },
    {
      "id": "b_384",
      "type": "p",
      "text": "भू पर पुरांगनाएँ रोईं।"
    },
    {
      "id": "b_385",
      "type": "p",
      "text": "थे मुनि वसिष्ठ तत्वज्ञानी,"
    },
    {
      "id": "b_386",
      "type": "p",
      "text": "पर व्यथा उन्होंने भी मानी।"
    },
    {
      "id": "b_387",
      "type": "p",
      "text": "होकर भी जन्म-मृत्यु संगी"
    },
    {
      "id": "b_388",
      "type": "p",
      "text": "रखते हैं भिन्न भाव-भंगी।"
    },
    {
      "id": "b_389",
      "type": "p",
      "text": "वह डील अपूर्व मनोहारी,"
    },
    {
      "id": "b_390",
      "type": "p",
      "text": "हेमाद्रि-शृंग-समताकारी,"
    },
    {
      "id": "b_391",
      "type": "p",
      "text": "रहता जो मानों सदा खड़ा,"
    },
    {
      "id": "b_392",
      "type": "p",
      "text": "था आज निरा निश्चेष्ट पड़ा।"
    },
    {
      "id": "b_393",
      "type": "p",
      "text": "मुख पर थे शोक-चिह्न अब भी,"
    },
    {
      "id": "b_394",
      "type": "p",
      "text": "नृप गये, न भाव गये तब भी!"
    },
    {
      "id": "b_395",
      "type": "p",
      "text": "या इसी लिये वे थे सोये,"
    },
    {
      "id": "b_396",
      "type": "p",
      "text": "सुत मिलें स्वप्न में ही खोये!"
    },
    {
      "id": "b_397",
      "type": "p",
      "text": "मुँह छिपा पदों में प्रिय पति के,"
    },
    {
      "id": "b_398",
      "type": "p",
      "text": "आधार एक जो थे गति के,"
    },
    {
      "id": "b_399",
      "type": "p",
      "text": "कर रहीं विलाप रानियाँ थीं;"
    },
    {
      "id": "b_400",
      "type": "p",
      "text": "जीवन-धन-मयी हानियाँ थीं।"
    },
    {
      "id": "b_401",
      "type": "p",
      "text": "देखा वसिष्ठ ने और कहा--"
    },
    {
      "id": "b_402",
      "type": "p",
      "text": "\"क्षर देह यहाँ का यहीं रहा।"
    },
    {
      "id": "b_403",
      "type": "p",
      "text": "वह श्वास-शृंखला टूट गई;"
    },
    {
      "id": "b_404",
      "type": "p",
      "text": "आत्मा बंधन से छूट गई!\""
    },
    {
      "id": "b_405",
      "type": "p",
      "text": "बोले सुमन्त्र कातर होकर--"
    },
    {
      "id": "b_406",
      "type": "p",
      "text": "\"क्या हुआ देखिए, यह गुरुवर!"
    },
    {
      "id": "b_407",
      "type": "p",
      "text": "हा! अमर पूज्य इस भाँति मरें!"
    },
    {
      "id": "b_408",
      "type": "p",
      "text": "सुत चार कहाँ जो क्रिया करें?\""
    },
    {
      "id": "b_409",
      "type": "p",
      "text": "धैर्य देकर धीर मुनि ने ज्ञान के प्रस्ताव से,"
    },
    {
      "id": "b_410",
      "type": "p",
      "text": "तेल में रखवा दिया नृप-शव सुरक्षित भाव से।"
    },
    {
      "id": "b_411",
      "type": "p",
      "text": "दूत भेजे दक्ष फिर संदेश के अक्षर गिना--"
    },
    {
      "id": "b_412",
      "type": "p",
      "text": "जो बुला लावें भरत को प्रकृत वृत्त कहे बिना।"
    },
    {
      "id": "b_413",
      "type": "p",
      "text": "इस शोक के सम्बन्ध से--"
    },
    {
      "id": "b_414",
      "type": "p",
      "text": "सब देखते थे अन्ध से--"
    },
    {
      "id": "b_415",
      "type": "p",
      "text": "बस एक मूर्ति घृणामयी,"
    },
    {
      "id": "b_416",
      "type": "p",
      "text": "वह थी कठोरा केकयी!"
    }
  ]
}